package space.app.gui
import "gui-widget.in"

component GuiCalc {
  target "x86_64-unknown-none"
  capability memory: GuiMemory(map)
  capability display: GuiDisplay(present)
}

// Bounded integer calculator: one binary +,-,*,/ expression, Enter evaluates.
fn gui-calc-evaluate() -> void {
  let length = load64(0x80000080)
  let i = 0
  let first = 0
  let second = 0
  let operator = 0
  let valid = 1
  let digits = 0
  while i < length {
    let ch = load8(0x80000000 + i)
    if ch >= 48 && ch <= 57 {
      if operator == 0 { first = first * 10 + ch - 48 } else { second = second * 10 + ch - 48 }
      digits += 1
    } else {
      if operator != 0 || digits == 0 || (ch != 43 && ch != 45 && ch != 42 && ch != 47) { valid = 0 }
      operator = ch
      digits = 0
    }
    i += 1
  }
  let result = first
  if digits == 0 { valid = 0 }
  if operator == 43 { result = first + second }
  if operator == 45 { result = first - second }
  if operator == 42 { result = first * second }
  if operator == 47 { if second == 0 { valid = 0 } else { result = first / second } }
  i = 0
  while i < 8 { store8(0x80000010 + i, 0); i += 1 }
  if valid == 0 || result > 9999999 || result < -999999 {
    store8(0x80000010, 101); store8(0x80000011, 114); store8(0x80000012, 114)
    return
  }
  let start = 0
  if result < 0 { store8(0x80000010, 45); result = 0 - result; start = 1 }
  let count = 0
  while result > 0 || count == 0 {
    store8(0x80000040 + count, 48 + result % 10)
    result = result / 10
    count += 1
  }
  i = 0
  while i < count { store8(0x80000010 + start + i, load8(0x80000040 + count - 1 - i)); i += 1 }
  return
}

fn client-entry(info: Int) -> Int {
  if widget-info-valid(info) != 1 { return 1 }
  let args = load64(info + 64)
  if args != 0 && load8(args) == 105 {
    if widget-start(info) != 1 { return 2 }
  } else {
    let code = widget-event()
    if code < 0 { return 3 }
    if code == 27 { return widget-close() }
    let length = load64(0x80000080)
    if code == 8 && length > 0 { length -= 1; store8(0x80000000 + length, 0) }
    if code >= 32 && code < 127 && length < 8 { store8(0x80000000 + length, code); length += 1 }
    store64(0x80000080, length)
    if code == 10 || code == 13 { gui-calc-evaluate() }
  }
  return widget-draw()
}
