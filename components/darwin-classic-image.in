package space.kernel
import "darwin-image-plan.in"

// Classic fixed-address Mach-O edge. No dyld execution, lazy resolver, TLS or
// reexports. Admit only complete, validated UNIXTHREAD + indirect-symbol plans.
fn dc-command(image:Int,kind:Int)->Int{let p=image+32;let end=p+load32(image+20);while p<end{if load32(p)==kind{return p;}p+=load32(p+4);}return 0;}
fn dc-import(image:Int,index:Int)->Int{
 let sym=dc-command(image,2);let p=image+load32(sym+8)+index*16;let name=image+load32(sym+16)+load32(p);let end=image+load32(sym+16)+load32(sym+20);
 if darwin-image-string(name,end,"_fopen")!=0{return 1;}if darwin-image-string(name,end,"_fclose")!=0{return 2;}
 if darwin-image-string(name,end,"_fread")!=0{return 3;}if darwin-image-string(name,end,"_fwrite")!=0{return 4;}
 if darwin-image-string(name,end,"_fseek")!=0{return 5;}if darwin-image-string(name,end,"_ftell")!=0{return 6;}
 if darwin-image-string(name,end,"_time")!=0{return 7;}if darwin-image-string(name,end,"_write")!=0{return 8;}
 if darwin-image-string(name,end,"_mmap")!=0{return 9;}if darwin-image-string(name,end,"_munmap")!=0{return 10;}
 if darwin-image-string(name,end,"_getenv")!=0{return 11;}if darwin-image-string(name,end,"_gettimeofday")!=0{return 12;}
 if darwin-image-string(name,end,"_exit")!=0{return 13;}return 0;
}
fn dc-address(image:Int,address:Int,bytes:Int,permission:Int)->Int{
 let p=image+32;let end=p+load32(image+20);while p<end{
  if load32(p)==25 && load32(p+60)!=0{let va=load64(p+24);let vm=load64(p+32);if address>=va && address - va<=vm && bytes<=vm - (address - va) && (load32(p+60)&permission)==permission{return 1;}}
  p+=load32(p+4);
 }return 0;
}
fn dc-image-check(image:Int,size:Int)->Int{
 if image<65536 || size<32 || size>0x1000000 || image>0x100000000 - size{return -8;}
 if load32(image)!=0xfeedfacf || load32(image+4)!=0x1000007 || (load32(image+8)&0x7fffffff)!=3 || load32(image+12)!=2 || load32(image+24)!=5 || load32(image+28)!=0{return -8;}
 let commands=load32(image+16);let bytes=load32(image+20);if commands<4 || commands>32 || bytes>size - 32{return -8;}
 let p=image+32;let end=p+bytes;let i=0;let seen=0;let segments=0;let pages=0;
 while i<commands{
  if p>end - 8{return -8;}let kind=load32(p);let length=load32(p+4);if length<8 || (length&7)!=0 || length>end - p{return -8;}
  let bit=0;if kind==5{bit=1;if length!=184 || load32(p+8)!=4 || load32(p+12)!=42{return -8;}
   let r=0;while r<21{if r!=16 && load64(p+16+r*8)!=0{return -38;}r+=1;}
  }else if kind==14 || kind==12{
   if kind==14{bit=2;}else{bit=4;}
   let minimum=12;if kind==12{minimum=24;if load32(p+16)!=0x10000 || load32(p+20)!=0x10000{return -38;}}
   if length<minimum+1 || load32(p+8)<minimum || load32(p+8)>=length{return -8;}
   let ok=0;if kind==14{ok=darwin-image-string(p+load32(p+8),p+length,"/usr/lib/dyld");}else{ok=darwin-image-string(p+load32(p+8),p+length,"/usr/lib/libSystem.B.dylib");}if ok==0{return -38;}
  }else if kind==2{
   bit=8;if length!=24 || load32(p+12)==0 || load32(p+12)>128 || darwin-image-range(size,load32(p+8),load32(p+12)*16)==0 || darwin-image-range(size,load32(p+16),load32(p+20))==0{return -8;}
  }else if kind==11{
   bit=16;if length!=80 || load32(p+4*2)!=0 || load32(p+4*3)!=0 || load32(p+4*4)!=0 || load32(p+4*5)!=0 || load32(p+4*6)!=0{return -38;}
   let f=8;while f<20{if f!=14 && f!=15 && load32(p+f*4)!=0{return -38;}f+=1;}
   if load32(p+60)>256 || darwin-image-range(size,load32(p+56),load32(p+60)*4)==0{return -8;}
  }else if kind==25{
   if length<72 || load32(p+64)>16 || length!=72+load32(p+64)*80 || load32(p+68)!=0{return -8;}
   let va=load64(p+24);let vm=load64(p+32);let fo=load64(p+40);let fs=load64(p+48);let prot=load32(p+60);
   if vm<=0 || (va&4095)!=0 || (vm&4095)!=0 || vm>0x1800000 || va<0 || va>0x2000000 - vm || fs>vm || darwin-image-range(size,fo,fs)==0{return -8;}
   if prot==0{if va!=0 || vm!=4096 || fs!=0 || load32(p+56)!=0 || load32(p+64)!=0{return -8;}}
   else{
    if va<4096 || (prot!=1 && prot!=3 && prot!=5) || (load32(p+56)&prot)!=prot || load32(p+56)>7{return -8;}
    let prior=image+32;while prior<p{if load32(prior)==25 && load32(prior+60)!=0 && va<load64(prior+24)+load64(prior+32) && load64(prior+24)<va+vm{return -8;}prior+=load32(prior+4);}
    pages+=vm/4096;segments+=1;
   }
   let j=0;while j<load32(p+64){let s=p+72+j*80;let sa=load64(s+32);let sn=load64(s+40);let sf=load32(s+48);let type=load32(s+64)&255;
    if sa<va || sa - va>vm || sn<0 || sn>vm - (sa - va) || load32(s+52)>12 || load32(s+56)!=0 || load32(s+60)!=0 || load32(s+76)!=0{return -8;}
    if type!=1 && (darwin-image-range(size,sf,sn)==0 || sf<fo || sf - fo>fs || sn>fs - (sf - fo) || sa - va!=sf - fo){return -8;}
    if type!=0 && type!=1 && type!=2 && type!=6 && type!=8{return -38;}
    if type==6 && ((sn&7)!=0 || prot!=3){return -8;}if type==8 && (load32(s+72)!=6 || sn%6!=0 || prot!=5){return -8;}
    j+=1;
   }
  }else{return -38;}
  if bit!=0{if (seen&bit)!=0{return -8;}seen=seen|bit;}p+=length;i+=1;
 }
 if p!=end || seen!=31 || segments<1 || pages>7000{return -8;}
 let thread=dc-command(image,5);let entry=load64(thread+16+16*8);if dc-address(image,entry,1,5)==0{return -8;}
 let sym=dc-command(image,2);let dys=dc-command(image,11);let count=load32(sym+12);if load32(dys+28)!=count{return -8;}
 i=0;while i<count{let n=image+load32(sym+8)+i*16;if load8(n+4)!=1 || load8(n+5)!=0 || load16(n+6)!=0 || load32(n)>=load32(sym+20){return -38;}
  if load64(n+8)!=0 && dc-address(image,load64(n+8),6,5)==0{return -8;}if dc-import(image,i)==0{return -38;}i+=1;}
 p=image+32;let pointers=0;while p<end{if load32(p)==25{let j=0;while j<load32(p+64){let s=p+72+j*80;let type=load32(s+64)&255;
   if type==6 || type==8{let width=8;if type==8{width=6;}let n=load64(s+40)/width;let first=load32(s+68);if first>load32(dys+60) || n>load32(dys+60) - first{return -8;}i=0;while i<n{if load32(image+load32(dys+56)+(first+i)*4)>=count{return -38;}i+=1;}if type==6{pointers+=n;}}
   j+=1;}}p+=load32(p+4);}
 if pointers==0{return -8;}return entry;
}
