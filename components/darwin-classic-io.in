package space.kernel
import "user-address-space.in"
import "darwin-classic-image.in"
const DC-STATE-BYTES=32768
const DC-MAGIC=0x44434c4153530001
const DC-STUB=0x71000000
const DC-FILES=0x71002000
const DC-ARGS=0x71003000
const DC-STACK=0x70000000
var dc-active:Int=0

// State owns metadata; native VFS owns descriptors and offsets; native VM owns
// every guest frame. FILE pointers name mapped per-activation records only.
fn dc-in(s:Int,a:Int,b:Int,n:Int)->Int{return user-space-copy-in(load64(s+72),load64(s+32),a,b,n);}
fn dc-out(s:Int,a:Int,b:Int,n:Int)->Int{return user-space-copy-out(load64(s+72),load64(s+32),a,b,n);}
fn dc-span(s:Int,a:Int,n:Int,w:Int)->Int{
 if a<4096 || a>=0x100000000 || n<0 || n>0x100000 || n>0x100000000 - a{return 0;}
 let row=user-space-service-row(load64(s+72),load64(s+32));if row<0{return 0;}let permission=USER-SPACE-READ;if w!=0{permission=USER-SPACE-WRITE;}
 let done=0;while done<n{let part=n - done;if part>65536{part=65536;}if user-space-span(row,a+done,part,permission)!=0{return 0;}done+=part;}return 1;
}
fn dc-string(s:Int,address:Int,target:Int,limit:Int)->Int{
 let i=0;while i<limit{if dc-in(s,address+i,target+i,1)!=0{return -1;}if load8(target+i)==0{return i;}i+=1;}return -1;
}
fn dc-file-ready(s:Int)->Int{return cap-check(load64(s+48),cap-storage())!=0 && sf-disk-ready!=0 && volume-ready==0;}
fn dc-file-row(s:Int,handle:Int)->Int{if handle<DC-FILES || handle>=DC-FILES+16*160 || (handle - DC-FILES)%160!=0{return 0;}let row=s+1024+((handle - DC-FILES)/160)*32;if load64(row)==0{return 0;}return row;}
fn dc-file-open(s:Int,path:Int,mode:Int)->Int{
 if dc-file-ready(s)==0{return 0;}let index=0;while index<16 && load64(s+1024+index*32)!=0{index+=1;}if index==16{return 0;}
 let name=s+2048+index*256;store8(name,47);let length=dc-string(s,path,name+1,254);if length<=0{return 0;}
 if load8(name+1)==47{let i=0;while i<length{store8(name+i,load8(name+i+1));i+=1;}length-=1;store8(name+length+1,0);}
 let i=1;while i<=length{let c=load8(name+i);if c<32 || c>126 || c==47 || c==92 || c==58{return 0;}i+=1;}if sf-path-name-valid(name)==0{return 0;}
 let m=s+8192;let ml=dc-string(s,mode,m,5);if ml<1 || ml>3{return 0;}let first=load8(m);if first!=114 && first!=119 && first!=97{return 0;}
 let plus=0;let binary=0;i=1;while i<ml{let c=load8(m+i);if c==43 && plus==0{plus=1;}else if c==98 && binary==0{binary=1;}else{return 0;}i+=1;}
 let exists=fs-stat(name,s+20480)>=0;if exists!=0 && load32(s+20480+SF-ST-TYPE)!=SF-TYPE-FILE{return 0;}if first==114 && exists==0{return 0;}
 let flags=VFS-O-RDONLY;let access=1;if first!=114{flags=VFS-O-WRONLY;access=2;}if plus!=0{flags=VFS-O-RDWR;access=3;}if first!=114 && exists==0{flags=flags|VFS-O-CREAT;}
 if vfs-fd-alloc()<0{return 0;}let fd=vfs-open-borrowed-path(name,flags);if fd<3{return 0;}
 if first==119 && exists!=0 && fs-write-file(name,name,0)!=0{vfs-close(fd);return 0;}
 if first==97 && vfs-lseek(fd,0,2)<0{vfs-close(fd);return 0;}
 let row=s+1024+index*32;store64(row,1);store64(row+8,fd);store64(row+16,access);let append=0;if first==97{append=1;}store64(row+24,append);
 return DC-FILES+index*160;
}
fn dc-file-close(s:Int,file:Int)->Int{let row=dc-file-row(s,file);if row==0 || dc-file-ready(s)==0{return -1;}if vfs-close(load64(row+8))!=0{return -1;}store64(row,0);return 0;}
fn dc-file-io(s:Int,pointer:Int,size:Int,count:Int,file:Int,write:Int)->Int{
 let row=dc-file-row(s,file);if row==0 || dc-file-ready(s)==0{return 0;}
 let access=1;if write!=0{access=2;}if (load64(row+16)&access)==0{return 0;}
 if size<0 || count<0 || size>0x100000 || (size!=0 && count>0x100000/size){return 0;}let bytes=size*count;if bytes==0{return 0;}
 if dc-span(s,pointer,bytes,1 - write)==0{return 0;}
 let fd=load64(row+8);if write!=0 && load64(row+24)!=0 && vfs-lseek(fd,0,2)<0{return 0;}
 let done=0;while done<bytes{let part=bytes - done;if part>4096{part=4096;}let result=0;
  if write!=0{if dc-in(s,pointer+done,s+20480,part)!=0{return done/size;}result=vfs-write(fd,s+20480,part);}
  else{result=vfs-read(fd,s+20480,part);if result>0 && result<=part && dc-out(s,pointer+done,s+20480,result)!=0{return done/size;}}
  if result<0 || result>part{return done/size;}done+=result;if result<part{return done/size;}
 }return done/size;
}
fn dc-file-seek(s:Int,file:Int,offset:Int,whence:Int)->Int{
 let row=dc-file-row(s,file);if row==0 || dc-file-ready(s)==0 || whence<0 || whence>2{return -1;}
 let fd=load64(row+8);let origin=0;if whence==1{origin=vfs-fd-offset(fd);}if whence==2{origin=vfs-sparkfs-file-size(load64(vfs-fd-table+fd*32));}
 if origin<0 || (offset<0 && offset<0 - origin) || (offset>0 && offset>0x7fffffffffffffff - origin){return -1;}
 if vfs-lseek(fd,offset,whence)<0{return -1;}return 0;
}
fn dc-files-release(s:Int)->Int{let i=0;let failed=0;while i<16{let row=s+1024+i*32;if load64(row)!=0{if vfs-close(load64(row+8))==0{store64(row,0);}else{failed=1;}}i+=1;}return failed;}
