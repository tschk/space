package space.kernel

import "darwin-process-startup.in"

// Immutable native adapter identity, not a libSystem executable or host lookup.
const DARWIN-EAGER-IDENTITY = 0x4457414249000001
var darwin-eager-context: Int = 0
var darwin-eager-last-kind: Int = 0

fn darwin-eager-symbol(image: Int, start: Int, end: Int) -> Int {
  if darwin-protected-import-name(image,start,end,"___error") != 0 { return 4 }
  let bit = darwin-protected-import-symbol(image,start,end)
  if bit == 4 { return 0 }
  return bit
}

fn darwin-eager-entry(image: Int, size: Int, identity: Int) -> Int {
  if identity != DARWIN-EAGER-IDENTITY { return -8 }
  if image <= 0 || size < 272 || size > 0x200000 || image > 0x100000000 - size { return -8 }
  if load32(image) != 0xFEEDFACF || load32(image + 4) != 0x1000007 || load32(image + 8) != 3 || load32(image + 12) != 2 { return -8 }
  if load32(image + 16) != 5 || load32(image + 20) != 240 || load32(image + 24) != 1 || load32(image + 28) != 0 { return -8 }
  let off = 32
  while off < 176 {
    let p = image + off
    let prot = 5
    if off == 104 { prot = 3 }
    if load32(p) != 0x19 || load32(p + 4) != 72 || load32(p + 56) != prot || load32(p + 60) != prot || load64(p + 64) != 0 { return -8 }
    let va = load64(p + 24)
    let vm = load64(p + 32)
    let file = load64(p + 40)
    let bytes = load64(p + 48)
    if va < DARWIN-PROTECTED-LOW || vm <= 0 || vm > DARWIN-PROTECTED-MAX-SEGMENT || va > DARWIN-PROTECTED-HIGH - vm || (va & 4095) != 0 || (vm & 4095) != 0 { return -8 }
    if file < 0 || file > size || bytes < 0 || bytes > vm || bytes > size - file { return -8 }
    if off == 32 && (file != 0 || bytes < 272) { return -8 }
    off += 72
  }
  let tv = load64(image + 56)
  let ts = load64(image + 64)
  let dv = load64(image + 128)
  let ds = load64(image + 136)
  if tv < dv + ds && dv < tv + ts { return -8 }
  if load64(image + 152) > 0 && load64(image + 144) < load64(image + 80) { return -8 }
  if load32(image + 176) != 0x80000028 || load32(image + 180) != 24 || load64(image + 192) != 0 { return -8 }
  let entry = load64(image + 184)
  if entry < 272 || entry >= load64(image + 80) { return -8 }
  if load32(image + 200) != 0x80000034 || load32(image + 204) != 16 { return -8 }
  if load32(image + 216) != 0xC || load32(image + 220) != 56 || load32(image + 224) != 24 || load32(image + 228) != 0 { return -8 }
  // This descriptor's finite ABI revision, not a claim about Apple's library.
  if load32(image + 232) != 0x10000 || load32(image + 236) != 0x10000 { return -8 }
  let name = "/usr/lib/libSystem.B.dylib"
  let i = 0
  while i < 26 { if load8(image + 240 + i) != load8(name + i) { return -8 }; i += 1 }
  while i < 32 { if load8(image + 240 + i) != 0 { return -8 }; i += 1 }
  if darwin-eager-fixups(image,size,0) != 0 { return -8 }
  return tv + entry
}

// Decode the original jq's format6/format1 seam, within a stricter finite
// layout. Every import is resolved before allocation, even if no chain uses it.
fn darwin-eager-fixups(image: Int, size: Int, apply: Int) -> Int {
  let file = load32(image + 208)
  let bytes = load32(image + 212)
  if bytes < 68 || bytes > 4096 || file < load64(image + 80) || file < load64(image + 144) + load64(image + 152) || file > size - bytes { return -8 }
  let h = image + file
  if load32(h) != 0 || load32(h + 4) != 32 || load32(h + 20) != 1 || load64(h + 24) != 0 { return -8 }
  let imports = load32(h + 8)
  let symbols = load32(h + 12)
  let count = load32(h + 16)
  let pages = load64(image + 136) / 4096
  let record = 44
  let record-size = 22 + pages * 2
  if count <= 0 || count > 16 || imports < record + record-size || (imports & 3) != 0 || imports > bytes - count * 4 || symbols < imports + count * 4 || symbols >= bytes { return -8 }
  if load32(h + 32) != 2 || load32(h + 36) != 0 || load32(h + 40) != 12 { return -8 }
  if load32(h + record) != record-size || load16(h + record + 4) != 4096 || load16(h + record + 6) != 6 { return -8 }
  if load64(h + record + 8) != load64(image + 128) - load64(image + 56) || load32(h + record + 16) != 0 || load16(h + record + 20) != pages { return -8 }
  let i = 0
  while i < count {
    let item = load32(h + imports + i * 4)
    if (item & 511) != 1 { return -8 }
    let name = item >> 9
    if name >= bytes - symbols || darwin-eager-symbol(image,file + symbols + name,file + bytes) == 0 { return -8 }
    i += 1
  }
  let total = 0
  let page = 0
  while page < pages {
    let start = load16(h + record + 22 + page * 2)
    if start != 65535 {
      if start > 4088 || (start & 7) != 0 { return -8 }
      let slot = start
      let done = 0
      while done == 0 {
        total += 1
        if total > 512 { return -8 }
        let offset = page * 4096 + slot
        if offset > load64(image + 152) - 8 { return -8 }
        let raw = load64(image + load64(image + 144) + offset)
        let next = (raw >> 51) & 4095
        let value = 0
        if raw < 0 {
          if ((raw >> 24) & 0x7FFFFFF) != 0 { return -8 }
          let ordinal = raw & 0xFFFFFF
          if ordinal >= count { return -8 }
          let item = load32(h + imports + ordinal * 4)
          let symbol = darwin-eager-symbol(image,file + symbols + (item >> 9),file + bytes)
          value = 0x40007000 + darwin-protected-import-index(symbol) * 64
        } else {
          if ((raw >> 36) & 0x7FFF) != 0 { return -8 }
          let target = raw & 0xFFFFFFFFF
          let tv = load64(image + 56)
          let dv = load64(image + 128)
          value = tv + target
          if (value < tv || value >= tv + load64(image + 64)) && (value < dv || value >= dv + load64(image + 136)) { return -8 }
        }
        if apply != 0 {
          let target = darwin-protected-physical(load64(image + 128) + offset)
          if target == 0 { return -8 }
          store64(target,value)
        }
        if next == 0 { done = 1 }
        else {
          let step = next * 4
          if step < 8 || (step & 7) != 0 || step > 4088 - slot { return -8 }
          slot += step
        }
      }
    }
    page += 1
  }
  if total == 0 { return -8 }
  return 0
}

fn darwin-eager-run(image: Int, size: Int, input: Int, bytes: Int, identity: Int, serial: Int, storage: Int, budget: Int) -> Int {
  if budget <= 0 || budget > 10000 { return -22 }
  let entry = darwin-eager-entry(image,size,identity)
  if entry < 0 { return entry }
  let valid = darwin-startup-input(input,bytes)
  if valid != 0 { return valid }
  if domain-current != 0 || darwin-protected-busy != 0 || domain-user-syscall-hook != 0 || user-context-active != 0 { return -16 }
  if serial >= 0 && cap-check(serial,cap-serial()) == 0 { return -13 }
  if storage >= 0 && cap-check(storage,cap-storage()) == 0 { return -13 }
  if load64(0x41a8) == 0 { return -38 }
  // Retained scratch uses the bump allocator, not the frame free list. Reserve
  // its exact rounded bytes separately, including first-use file-service state.
  let retained = 0
  if darwin-protected-frames == 0 { retained += DARWIN-PROTECTED-MAX-FRAMES * 16 + 32 }
  if darwin-eager-context == 0 { retained += (USER-CONTEXT-BYTES + 30) & -16 }
  if storage >= 0 && darwin-file-table == 0 { retained += VFS-MAX-FDS * 264 + 4096 }
  if heap-next < 0 || heap-next > heap-end || retained > heap-end - heap-next { return -12 }
  // At most 40 owned pages and 17 page-table frames, plus conservative slack.
  // Count complete frame space only after reserving the retained bump bytes.
  let available = (heap-end - ((heap-next + retained + 4095) & -4096)) / 4096
  let free = free-list
  while free != 0 && available < 65 { available += 1; free = load64(free) }
  if available < 65 { return -12 }
  if darwin-protected-frames == 0 {
    darwin-protected-frames = alloc(DARWIN-PROTECTED-MAX-FRAMES * 8)
    darwin-protected-context = alloc(32)
    darwin-protected-virtuals = alloc(DARWIN-PROTECTED-MAX-FRAMES * 8)
  }
  if darwin-eager-context == 0 { darwin-eager-context = (alloc(USER-CONTEXT-BYTES + 15) + 15) & -16 }
  let domain = domain-create-user()
  if domain <= 0 { return -12 }
  darwin-protected-busy = 1
  darwin-protected-domain = domain
  darwin-protected-last-domain = domain
  darwin-protected-count = 0
  darwin-protected-authority = serial
  darwin-protected-storage = storage
  if storage >= 0 { darwin-file-init() }
  domain-set-cap(domain,-1)
  let status = darwin-protected-map-segment(image,32,domain)
  if status == 0 { status = darwin-protected-map-segment(image,104,domain) }
  let page = 0
  while status == 0 && page < 6 {
    let frame = darwin-protected-take-frame()
    if frame == 0 { status = -12 }
    else {
      let va = 0x4F000000 + page * 4096
      domain-map-user-data(domain,va,frame)
      store64(darwin-protected-virtuals + (darwin-protected-count - 1) * 8,va)
    }
    page += 1
  }
  if status == 0 {
    let stub = darwin-protected-take-frame()
    if stub == 0 { status = -12 } else {
      // mov rdi,rax; mov eax,0x2000001; syscall; ud2, owned user exit.
      store8(stub,0x48);store8(stub + 1,0x89);store8(stub + 2,0xC7)
      store8(stub + 3,0xB8);store32(stub + 4,0x2000001)
      store8(stub + 8,0x0F);store8(stub + 9,0x05);store8(stub + 10,0x0F);store8(stub + 11,0x0B)
      domain-map-user-code(domain,0x40006000,stub)
      store64(darwin-protected-virtuals + (darwin-protected-count - 1) * 8,0x40006000)
      let imports = darwin-protected-take-frame()
      if imports == 0 { status = -12 } else {
        darwin-protected-build-imports(imports)
        domain-map-user-code(domain,0x40007000,imports)
        store64(darwin-protected-virtuals + (darwin-protected-count - 1) * 8,0x40007000)
        status = darwin-eager-fixups(image,size,1)
      }
      if status == 0 {
        darwin-startup-copy(input)
        let stack = 0x4F003FF8
        let argc = load64(input)
        store64(darwin-protected-physical(stack),0x40006000)
        status = user-context-init(darwin-eager-context,USER-CONTEXT-BYTES,domain,entry,0,stack)
        if status == 0 {
          if load32(image + 176) == 0x80000028 {
            store64(darwin-eager-context + 72,argc)
            store64(darwin-eager-context + 80,DARWIN-STARTUP-DATA)
            store64(darwin-eager-context + 88,DARWIN-STARTUP-DATA + 136)
            store64(darwin-eager-context + 96,DARWIN-STARTUP-DATA + 272)
          }
          domain-user-syscall-hook = darwin-protected-dispatch
          darwin-eager-last-kind = user-context-resume(darwin-eager-context,budget)
          domain-user-syscall-hook = 0
          if darwin-eager-last-kind == USER-CONTEXT-EXIT { status = load64(darwin-eager-context + 720) }
          else if darwin-eager-last-kind == USER-CONTEXT-DEADLINE { status = 124 }
          else if darwin-eager-last-kind == USER-CONTEXT-FAULT { status = 128 + load64(darwin-eager-context + 696) }
          else { status = -5 }
        }
      }
    }
  }
  darwin-file-release()
  if darwin-protected-release(domain) != 0 { return -5 }
  darwin-protected-busy = 0
  darwin-protected-domain = 0
  darwin-protected-authority = -1
  darwin-protected-storage = -1
  return status
}
