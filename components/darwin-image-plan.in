    else if kind == 0x80000033 { mark = 2;if bytes != 16 { return -8 } }
    else if kind == 2 { mark = 4;if bytes != 24 { return -8 };symbols-command = off }
    else if kind == 11 { mark = 8;if bytes != 80 { return -8 };indirect-command = off }
    else if kind == 14 {
      mark = 16
      if bytes != 32 || load32(p + 8) != 12 || darwin-image-string(p + 12,p + bytes,"/usr/lib/dyld") == 0 || darwin-image-zeros(p + 25,p + bytes) == 0 { return -38 }
    } else if kind == 27 { mark = 32;if bytes != 24 { return -8 } }
    else if kind == 50 {
      mark = 64
      if bytes != 32 || load32(p + 8) != 1 || load32(p + 12) != 0xE0000 || load32(p + 16) < load32(p + 12) || load32(p + 20) != 1 || load32(p + 24) != 3 { return -38 }
    } else if kind == 42 { mark = 128;if bytes != 16 || load64(p + 8) != 0 { return -38 } }
    else if kind == 0x80000028 { mark = 256;if bytes != 24 || load64(p + 16) != 0 { return -38 };entry = load64(p + 8) }
    else if kind == 12 {
      mark = 512
      if bytes != 56 || load32(p + 8) != 24 || load32(p + 12) != 2 || load32(p + 20) != 0x10000 || load32(p + 16) < load32(p + 20) || darwin-image-string(p + 24,p + bytes,"/usr/lib/libSystem.B.dylib") == 0 || darwin-image-zeros(p + 50,p + bytes) == 0 { return -38 }
      dependency = off
    } else if kind == 38 { mark = 1024;if bytes != 16 { return -8 } }
    else if kind == 41 { mark = 2048;if bytes != 16 || load32(p + 12) != 0 { return -38 } }
    else { return -38 }
    if mark != 0 { if (seen-commands & mark) != 0 { return -8 };seen-commands = seen-commands | mark }
    if out != 0 { store64(out + 3328 + index * 16,off);store64(out + 3336 + index * 16,kind) }
    off += bytes;index += 1
  }
  if off != end || seen-segments != 62 || seen-commands != 4095 || text-code == 0 || entry < text-code - text-base || entry >= text-code - text-base + text-code-size { return -8 }
  let sym = image + symbols-command
  let symbol-file = load32(sym + 8)
  let symbol-count = load32(sym + 12)
  let strings = load32(sym + 16)
  let string-bytes = load32(sym + 20)
  if symbol-count > 4096 || string-bytes > 65536 || symbol-file < link-file || strings < link-file || darwin-image-range(link-file + link-size,symbol-file,symbol-count * 16) == 0 || darwin-image-range(link-file + link-size,strings,string-bytes) == 0 || symbol-file + symbol-count * 16 > strings { return -8 }
  let symbol = 0
  while symbol < symbol-count {
    let p = image + symbol-file + symbol * 16
    let name = load32(p)
    if name >= string-bytes || darwin-image-name-end(image + strings + name,image + strings + string-bytes) < 0 { return -8 }
    let typ = load8(p + 4)
    let section = load8(p + 5)
    if typ == 1 { if section != 0 || load16(p + 6) != 256 || load64(p + 8) != 0 { return -38 } }
    else if typ == 15 { if section < 1 || section > sections || load64(p + 8) < text-base || load64(p + 8) >= DARWIN-IMAGE-PREFERRED + 0x200000 { return -8 } }
    // N_OSO/STAB value is descriptive object provenance, not a mapped VA.
    else if typ == 60 { if section != 0 || load16(p + 6) != 0 { return -38 } }
    else { return -38 }
    symbol += 1
  }
  let dys = image + indirect-command
  if load32(dys + 8) != 0 || load32(dys + 16) != load32(dys + 12) || load32(dys + 24) != load32(dys + 16) + load32(dys + 20) || load32(dys + 24) + load32(dys + 28) != symbol-count { return -8 }
  symbol = 0
  while symbol < symbol-count {
    let typ = load8(image + symbol-file + symbol * 16 + 4)
    if symbol < load32(dys + 12) { if typ != 60 { return -38 } }
    else if symbol < load32(dys + 24) { if typ != 15 { return -38 } }
    else { if typ != 1 { return -8 } }
