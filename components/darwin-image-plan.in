          store64(row,off + 72 + n * 80);store64(row + 8,address);store64(row + 16,amount);store64(row + 24,at);store64(row + 32,attributes)
          store64(row + 40,align);store64(row + 48,segments);store64(row + 56,reserved1);store64(row + 64,reserved2);store64(row + 72,sk)
        }
