package space.kernel

import "darwin-owned-heap.in"

// Internal supervisor plan, not a guest pointer/registry service. The source
// remains immutable until a trusted mapper has consumed the plan.
const DARWIN-IMAGE-PLAN-MAGIC = 0x4457504C414E0001
const DARWIN-IMAGE-PLAN-BYTES = 3840
const DARWIN-IMAGE-PREFERRED = 0x100000000

fn darwin-image-range(size: Int, offset: Int, bytes: Int) -> Int {
  if offset < 0 || bytes < 0 || offset > size || bytes > size - offset { return 0 }
  return 1
}

fn darwin-image-field(base: Int, name: String) -> Int {
  let i = 0
  let ended = 0
  while i < 16 {
    let wanted = 0
    if ended == 0 { wanted = load8(name + i);if wanted == 0 { ended = 1 } }
    if load8(base + i) != wanted { return 0 }
    i += 1
  }
  return ended
}

fn darwin-image-string(base: Int, end: Int, name: String) -> Int {
  let i = 0
  while i < 256 {
    if base + i >= end { return 0 }
    let c = load8(name + i)
    if load8(base + i) != c { return 0 }
    if c == 0 { return 1 }
    i += 1
  }
  return 0
}

fn darwin-image-name-end(base: Int, end: Int) -> Int {
  let i = 0
  while i < 256 && base + i < end {
    let c = load8(base + i)
    if c == 0 { return base + i + 1 }
    if c < 33 || c > 126 { return -8 }
    i += 1
  }
  return -8
}

fn darwin-image-zeros(base: Int, end: Int) -> Int {
  while base < end { if load8(base) != 0 { return 0 };base += 1 }
  return 1
}

fn darwin-image-uleb-end(base: Int, end: Int) -> Int {
  let n = 0
  while n < 9 && base + n < end {
    if load8(base + n) < 128 { return base + n + 1 }
    n += 1
  }
  return -8
}

fn darwin-image-uleb(base: Int, end: Int) -> Int {
  let stop = darwin-image-uleb-end(base,end)
  if stop < 0 { return -8 }
  let value = 0
  let shift = 0
  while base < stop { value = value | ((load8(base) & 127) << shift);shift += 7;base += 1 }
  return value
}

fn darwin-image-address(image: Int, address: Int, bytes: Int) -> Int {
  if bytes <= 0 { return 0 }
  let off = 32
  let end = 32 + load32(image + 20)
  while off < end {
    let p = image + off
    if load32(p) == 0x19 && darwin-image-segment-kind(p) != 1 {
      let va = load64(p + 24)
      let vm = load64(p + 32)
      if address >= va && address - va <= vm && bytes <= vm - (address - va) { return 1 }
    }
    off += load32(p + 4)
  }
  return 0
}

// Closed executable exports are descriptive: no reexports/resolvers/dlsym.
// Ordered, disjoint, forward child nodes bound traversal by the trie byte size.
fn darwin-image-export-node(image: Int, base: Int, bytes: Int, offset: Int, depth: Int) -> Int {
  if depth >= 32 || offset < 0 || offset >= bytes { return -8 }
  let node = base + offset
  let cursor = darwin-image-uleb-end(node,base + bytes)
  let terminal = darwin-image-uleb(node,base + bytes)
  if cursor < 0 || terminal < 0 || terminal > base + bytes - cursor { return -8 }
  if terminal != 0 {
    let flags = darwin-image-uleb(cursor,cursor + terminal)
    let value-at = darwin-image-uleb-end(cursor,cursor + terminal)
    if flags != 0 || value-at < 0 { return -38 }
    let value-end = darwin-image-uleb-end(value-at,cursor + terminal)
    let value = darwin-image-uleb(value-at,cursor + terminal)
    if value < 0 || value >= 0x200000 || value-end != cursor + terminal || darwin-image-address(image,DARWIN-IMAGE-PREFERRED + value,1) == 0 { return -8 }
  }
  cursor += terminal
  if cursor >= base + bytes { return -8 }
  let children = load8(cursor)
  cursor += 1
  let header = cursor
  let i = 0
  while i < children {
    let name-end = darwin-image-name-end(cursor,base + bytes)
    if name-end < 0 || name-end == cursor + 1 { return -8 }
    cursor = darwin-image-uleb-end(name-end,base + bytes)
    if cursor < 0 { return -8 }
    i += 1
  }
  let used-end = cursor
  cursor = header
  i = 0
  while i < children {
    let name-end = darwin-image-name-end(cursor,base + bytes)
    let child = darwin-image-uleb(name-end,base + bytes)
    cursor = darwin-image-uleb-end(name-end,base + bytes)
    if child < used-end - base || child >= bytes || darwin-image-zeros(used-end,base + child) == 0 { return -8 }
    used-end = darwin-image-export-node(image,base,bytes,child,depth + 1)
    if used-end < 0 { return used-end }
    i += 1
  }
  return used-end
}

fn darwin-image-segment-kind(command: Int) -> Int {
  if darwin-image-field(command + 8,"__PAGEZERO") != 0 { return 1 }
  if darwin-image-field(command + 8,"__TEXT") != 0 { return 2 }
  if darwin-image-field(command + 8,"__DATA_CONST") != 0 { return 3 }
  if darwin-image-field(command + 8,"__DATA") != 0 { return 4 }
  if darwin-image-field(command + 8,"__LINKEDIT") != 0 { return 5 }
  return 0
}

fn darwin-image-section-kind(section: Int) -> Int {
  if darwin-image-field(section,"__text") != 0 { return 1 }
  if darwin-image-field(section,"__stubs") != 0 { return 2 }
  if darwin-image-field(section,"__const") != 0 { return 3 }
  if darwin-image-field(section,"__cstring") != 0 { return 4 }
  if darwin-image-field(section,"__ustring") != 0 { return 5 }
  if darwin-image-field(section,"__unwind_info") != 0 { return 6 }
  if darwin-image-field(section,"__got") != 0 { return 7 }
  if darwin-image-field(section,"__data") != 0 { return 8 }
  if darwin-image-field(section,"__bss") != 0 { return 9 }
  return 0
}

// Validate first with out=0. A second pass fills descriptors; magic is published
// only by darwin-image-plan after every check completes.
fn darwin-image-scan(image: Int, size: Int, out: Int) -> Int {
  if image <= 0 || size < 32 || size > 0x200000 || image > 0x100000000 - size { return -8 }
  if load32(image) != 0xFEEDFACF || load32(image + 4) != 0x1000007 || load32(image + 12) != 2 || load32(image + 24) != 0x200085 || load32(image + 28) != 0 { return -8 }
