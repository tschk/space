  let indirect-count = load32(dys + 60)
  if indirect-count > 8192 || indirect < link-file || darwin-image-range(link-file + link-size,indirect,indirect-count * 4) == 0 { return -8 }
  let i = 0
  while i < indirect-count { let value = load32(image + indirect + i * 4);if value >= symbol-count && value != 0x80000000 { return -8 };i += 1 }
