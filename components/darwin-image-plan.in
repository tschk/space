  if out != 0 {
    store64(out + 8,1);store64(out + 16,size);store64(out + 24,image);store64(out + 32,text-base);store64(out + 40,text-base + entry)
    store64(out + 48,segments);store64(out + 56,sections);store64(out + 64,commands);store64(out + 72,load32(image + fix-command + 8));store64(out + 80,load32(image + fix-command + 12))
    store64(out + 88,dependency);store64(out + 96,pages);store64(out + 104,DARWIN-IMAGE-PREFERRED);store64(out + 112,0x200085);store64(out + 120,DARWIN-IMAGE-PLAN-BYTES)
  }
