  let command-bytes = load32(image + 20)
  if commands < 1 || commands > 32 || command-bytes > 4096 || darwin-image-range(size,32,command-bytes) == 0 { return -8 }
  let end = 32 + command-bytes
  let off = 32
  let index = 0
  let segments = 0
  let sections = 0
  let pages = 0
  let seen-segments = 0
  let seen-commands = 0
  let entry = 0
  let text-base = 0
  let text-size = 0
  let text-code = 0
  let text-code-size = 0
  let link-file = 0
  let link-size = 0
  let symbols-command = 0
  let indirect-command = 0
  let fix-command = 0
  let dependency = 0
  while index < commands {
