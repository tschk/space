      seen-segments = seen-segments | bit
      let va = load64(p + 24)
      let vm = load64(p + 32)
      let file = load64(p + 40)
      let file-bytes = load64(p + 48)
      let maxprot = load32(p + 56)
      let prot = load32(p + 60)
      let count = load32(p + 64)
      let flags = load32(p + 68)
      if count > 32 - sections || bytes != 72 + count * 80 { return -8 }
      if which == 1 {
        if va != 0 || vm != DARWIN-IMAGE-PREFERRED || file != 0 || file-bytes != 0 || maxprot != 0 || prot != 0 || count != 0 || flags != 0 { return -8 }
      } else {
        if va < DARWIN-IMAGE-PREFERRED || va - DARWIN-IMAGE-PREFERRED > 0x200000 || vm <= 0 || vm > 0x200000 - (va - DARWIN-IMAGE-PREFERRED) || (va & 4095) != 0 || (vm & 4095) != 0 || (file & 4095) != 0 || file-bytes > vm || darwin-image-range(size,file,file-bytes) == 0 { return -8 }
        let expected = 3
        if which == 2 { expected = 5 }
        if which == 5 { expected = 1 }
        let wanted-flags = 0
        if which == 3 { wanted-flags = 16 }
        if prot != expected || maxprot != expected || flags != wanted-flags { return -38 }
        if which == 2 { if file != 0 || file-bytes < end || va != DARWIN-IMAGE-PREFERRED { return -8 };text-base = va;text-size = file-bytes }
        if which == 5 { if count != 0 { return -8 };link-file = file;link-size = file-bytes }
        let previous = 32
        while previous < off {
          let q = image + previous
          if load32(q) == 0x19 && darwin-image-segment-kind(q) != 1 {
            let qva = load64(q + 24)
            let qvm = load64(q + 32)
            let qfile = load64(q + 40)
            let qbytes = load64(q + 48)
            if va < qva + qvm && qva < va + vm { return -8 }
            if file-bytes != 0 && qbytes != 0 && file < qfile + qbytes && qfile < file + file-bytes { return -8 }
          }
          previous += load32(q + 4)
        }
        pages += vm / 4096
        if pages > 512 { return -8 }
      }
      if out != 0 {
        let row = out + 128 + segments * 80
        store64(row,off);store64(row + 8,va);store64(row + 16,vm);store64(row + 24,file);store64(row + 32,file-bytes)
        store64(row + 40,maxprot);store64(row + 48,prot);store64(row + 56,sections);store64(row + 64,count);store64(row + 72,which)
      }
      let n = 0
      while n < count {
        let s = p + 72 + n * 80
        let sk = darwin-image-section-kind(s)
        if sk == 0 { return -38 }
        let j = 0
        while j < 16 { if load8(s + 16 + j) != load8(p + 8 + j) { return -8 };j += 1 }
        let address = load64(s + 32)
        let amount = load64(s + 40)
        let at = load32(s + 48)
        let align = load32(s + 52)
        let attributes = load32(s + 64)
        let reserved1 = load32(s + 68)
        let reserved2 = load32(s + 72)
        if address < va || amount <= 0 || address - va > vm || amount > vm - (address - va) || align > 16 || (address & ((1 << align) - 1)) != 0 || load32(s + 56) != 0 || load32(s + 60) != 0 || load32(s + 76) != 0 { return -8 }
        if sk == 9 {
