          if sk == 7 { if which != 3 || (amount & 7) != 0 || reserved2 != 0 { return -38 } }
          else if sk == 2 { if reserved2 != 6 || amount % 6 != 0 { return -8 } }
          else { if reserved1 != 0 || reserved2 != 0 { return -8 } }
