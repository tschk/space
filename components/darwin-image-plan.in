}

fn darwin-image-plan(image: Int, size: Int, out: Int, bytes: Int) -> Int {
  if out <= 0 || bytes < DARWIN-IMAGE-PLAN-BYTES || bytes > 4096 || out > 0x100000000 - bytes { return -14 }
  if image > 0 && size > 0 && out < image + size && image < out + bytes { return -14 }
  let result = darwin-image-scan(image,size,0)
  if result != 0 { return result }
  let n = 0
  while n < DARWIN-IMAGE-PLAN-BYTES { store8(out + n,0);n += 1 }
  result = darwin-image-scan(image,size,out)
  if result == 0 { store64(out,DARWIN-IMAGE-PLAN-MAGIC) }
  return result
}

fn darwin-image-segment(image: Int, ordinal: Int) -> Int {
  let off = 32
  let index = 0
  let end = 32 + load32(image + 20)
  while off < end {
    let p = image + off
    if load32(p) == 0x19 { if index == ordinal { return p };index += 1 }
    off += load32(p + 4)
  }
  return 0
}

// Full chained-format validation independent of the selected symbol provider.
// Unsupported chain features return -38; this does not resolve/load libraries.
fn darwin-image-chain-preflight(plan: Int) -> Int {
  if plan <= 0 || plan > 0x100000000 - DARWIN-IMAGE-PLAN-BYTES || load64(plan) != DARWIN-IMAGE-PLAN-MAGIC || load64(plan + 8) != 1 || load64(plan + 120) != DARWIN-IMAGE-PLAN-BYTES { return -8 }
  let image = load64(plan + 24)
  let size = load64(plan + 16)
  let check = darwin-image-scan(image,size,0)
  if check != 0 { return check }
  let file = load64(plan + 72)
  let bytes = load64(plan + 80)
  let command = 32
  let command-end = 32 + load32(image + 20)
  let matched = 0
  while command < command-end {
    if load32(image + command) == 0x80000034 {
      if file != load32(image + command + 8) || bytes != load32(image + command + 12) { return -8 }
      matched = 1
    }
    command += load32(image + command + 4)
  }
  if matched == 0 || load64(plan + 48) != 5 { return -8 }
  if bytes < 32 || darwin-image-range(size,file,bytes) == 0 { return -8 }
  let h = image + file
  let starts = load32(h + 4)
  let imports = load32(h + 8)
  let symbols = load32(h + 12)
  let count = load32(h + 16)
  if load32(h) != 0 || starts != 32 || load32(h + 20) != 1 || load32(h + 24) != 0 || load32(h + 28) != 0 || count < 1 || count > 256 { return -8 }
  let segment-count = load32(h + starts)
  if segment-count != load64(plan + 48) || segment-count > 8 || darwin-image-range(bytes,starts + 4,segment-count * 4) == 0 || imports < starts + 4 + segment-count * 4 || darwin-image-range(bytes,imports,count * 4) == 0 || symbols < imports + count * 4 || symbols >= bytes { return -8 }
  let i = 0
  while i < count {
    let item = load32(h + imports + i * 4)
    let name = item >> 9
    if (item & 511) != 1 || name >= bytes - symbols || darwin-image-name-end(h + symbols + name,h + bytes) < 0 { return -8 }
    i += 1
  }
  let links = 0
  i = 0
  let last-record = starts + 4 + segment-count * 4
  while i < segment-count {
    let record = load32(h + starts + 4 + i * 4)
    if record != 0 {
      let at = starts + record
      if at < last-record || darwin-image-range(imports,at,22) == 0 { return -8 }
      let record-size = load32(h + at)
      let pages = load16(h + at + 20)
      let segment = darwin-image-segment(image,i)
      if segment == 0 || darwin-image-segment-kind(segment) < 3 || darwin-image-segment-kind(segment) > 4 { return -8 }
      if record-size != 22 + pages * 2 || darwin-image-range(imports,at,record-size) == 0 || load16(h + at + 4) != 4096 || load16(h + at + 6) != 6 || load64(h + at + 8) != load64(segment + 24) - DARWIN-IMAGE-PREFERRED || load32(h + at + 16) != 0 || pages != load64(segment + 32) / 4096 { return -8 }
      last-record = at + record-size
      let page = 0
      while page < pages {
        let position = load16(h + at + 22 + page * 2)
        if position != 65535 {
          if (position & 7) != 0 || position > 4088 { return -8 }
          let done = 0
          while done == 0 {
            links += 1
            if links > 4096 { return -8 }
            let relative = page * 4096 + position
            if relative > load64(segment + 48) - 8 { return -8 }
            let raw = load64(image + load64(segment + 40) + relative)
            if raw < 0 {
              if (raw & 0xFFFFFF) >= count || ((raw >> 32) & 0x7FFFF) != 0 { return -8 }
              if ((raw >> 24) & 255) != 0 { return -38 }
            } else {
              if ((raw >> 36) & 0x7FFF) != 0 || darwin-image-address(image,DARWIN-IMAGE-PREFERRED + (raw & 0xFFFFFFFFF),1) == 0 { return -8 }
            }
            let step = ((raw >> 51) & 4095) * 4
            if step == 0 { done = 1 } else { if (step & 7) != 0 || step > 4088 - position { return -8 };position += step }
          }
        }
        page += 1
      }
    }
    i += 1
  }
  if links == 0 { return -8 }
  return 0
}

// Preserve the original image/heap profile's closed import policy.
fn darwin-image-import-preflight(plan: Int) -> Int {
  let status = darwin-image-chain-preflight(plan)
  if status != 0 { return status }
  if darwin-image-unknown-import(plan) != 0 { return -38 }
  return 0
}

fn darwin-image-unknown-import(plan: Int) -> Int {
  // Call only after successful structural preflight of this immutable plan.
  if plan <= 0 || plan > 0x100000000 - DARWIN-IMAGE-PLAN-BYTES || load64(plan) != DARWIN-IMAGE-PLAN-MAGIC || load64(plan + 8) != 1 { return 0 }
  let image = load64(plan + 24)
  let h = image + load64(plan + 72)
  let bytes = load64(plan + 80)
  let imports = load32(h + 8)
  let symbols = load32(h + 12)
  let count = load32(h + 16)
  let i = 0
  while i < count {
    let name = load32(h + imports + i * 4) >> 9
    if darwin-heap-symbol(image,load64(plan + 72) + symbols + name,load64(plan + 72) + bytes) == 0 { return h + symbols + name }
    i += 1
  }
  return 0
}
