package space.kernel

import "user-budget.in"

// Protected bounded Mach-O process slice, with explicit typed libSystem imports.
// The trusted in-place fixture loader remains separate. Caller owns the input image.
const DARWIN-PROTECTED-LOW = 0x41000000
const DARWIN-PROTECTED-HIGH = 0x48000000
const DARWIN-PROTECTED-MAX-SEGMENT = 65536
const DARWIN-PROTECTED-MAX-FRAMES = 64
var darwin-protected-frames: Int = 0
var darwin-protected-context: Int = 0
var darwin-protected-virtuals: Int = 0
var darwin-protected-domain: Int = 0
var darwin-protected-authority: Int = -1
var darwin-protected-count: Int = 0
var darwin-protected-busy: Int = 0
var darwin-protected-last-domain: Int = 0

fn darwin-protected-segment(image: Int, kind: Int) -> Int {
  let off = 32
  let i = 0
  while i < load32(image + 16) {
    let p = image + off
    if load32(p) == 0x19 && load32(p + 60) == kind { return off }
    off = off + load32(p + 4)
    i = i + 1
  }
  return 0
}

// Bounded RX/RW/LC_MAIN profile, optionally with classic dyld bind info and
// one explicitly provided libSystem image. Validate everything before mapping.
fn darwin-protected-entry(image: Int, size: Int) -> Int {
  if image <= 0 || size < 200 || size > 0x200000 || image > 0x100000000 - size { return -8 }
  if load32(image) != 0xFEEDFACF || load32(image + 4) != 0x1000007 { return -8 }
  if load32(image + 8) != 3 || load32(image + 12) != 2 { return -8 }
  let commands = load32(image + 16)
  let command-bytes = load32(image + 20)
  if (commands != 3 || command-bytes != 168) && (commands != 5 || command-bytes != 272) { return -8 }
  let command-end = 32 + command-bytes
  if size < command-end { return -8 }
  if load32(image + 24) != 1 || load32(image + 28) != 0 { return -8 }
  let text = 0
  let data = 0
  let entry = -1
  let off = 32
  let i = 0
  let dylib = 0
  let bind = 0
  while i < commands {
    if off > command-end - 8 { return -8 }
    let p = image + off
    let cmd = load32(p)
    let len = load32(p + 4)
    if len < 8 || len > command-end - off || (len & 7) != 0 { return -8 }
    if cmd == 0x19 {
      if len != 72 || load32(p + 64) != 0 || load32(p + 68) != 0 { return -8 }
      let prot = load32(p + 60)
      if load32(p + 56) != prot || (prot != 3 && prot != 5) { return -8 }
      let va = load64(p + 24)
      let vm = load64(p + 32)
      let file = load64(p + 40)
      let bytes = load64(p + 48)
      if va < DARWIN-PROTECTED-LOW || vm <= 0 || vm > DARWIN-PROTECTED-MAX-SEGMENT { return -8 }
      if va > DARWIN-PROTECTED-HIGH - vm || (va & 4095) != 0 || (vm & 4095) != 0 { return -8 }
      if file < 0 || file > size || bytes < 0 || bytes > vm || bytes > size - file { return -8 }
      if prot == 5 {
        if text != 0 || file != 0 || bytes < command-end { return -8 }
        text = off
      } else {
        if data != 0 { return -8 }
        data = off
      }
    } else if cmd == 0x80000028 {
      if len != 24 || entry != -1 || load64(p + 16) != 0 { return -8 }
      entry = load64(p + 8)
    } else if cmd == 0xC {
      if len != 56 || dylib != 0 || load32(p + 8) != 24 { return -8 }
      if load32(p + 12) != 0 || load32(p + 16) != 0 || load32(p + 20) != 0 { return -8 }
      let name = "/usr/lib/libSystem.B.dylib"
      let j = 0
      while j < 26 {
        if load8(p + 24 + j) != load8(name + j) { return -8 }
        j = j + 1
      }
      while j < 32 { if load8(p + 24 + j) != 0 { return -8 }; j = j + 1 }
      dylib = off
    } else if cmd == 0x80000022 {
      if len != 48 || bind != 0 { return -8 }
      // This profile owns ordinary pointer binding only, never host lazy/dyld execution.
      if load64(p + 8) != 0 || load64(p + 24) != 0 || load64(p + 32) != 0 || load64(p + 40) != 0 { return -8 }
      bind = off
    } else { return -8 }
    off = off + len
    i = i + 1
  }
  if off != command-end || text == 0 || data == 0 || entry < command-end { return -8 }
  if commands == 5 && (dylib == 0 || bind == 0 || text != 32 || data != 104) { return -8 }
  if commands == 3 && (dylib != 0 || bind != 0) { return -8 }
  let t = image + text
  let d = image + data
  let tv = load64(t + 24)
  let dv = load64(d + 24)
  let ts = load64(t + 32)
  let ds = load64(d + 32)
  if tv < dv + ds && dv < tv + ts { return -8 }
  let df = load64(d + 40)
  let db = load64(d + 48)
  if db > 0 && df < load64(t + 48) { return -8 }
  if entry >= load64(t + 48) { return -8 }
  if bind != 0 && darwin-protected-bind(image, size, bind, data, 0) != 0 { return -8 }
  return tv + entry
}

fn darwin-protected-take-frame() -> Int {
  if darwin-protected-count >= DARWIN-PROTECTED-MAX-FRAMES { return 0 }
  let frame = frame-alloc()
  store64(darwin-protected-frames + darwin-protected-count * 8, frame)
  store64(darwin-protected-virtuals + darwin-protected-count * 8, 0)
  darwin-protected-count = darwin-protected-count + 1
  return frame
}

fn darwin-protected-map-segment(image: Int, offset: Int, domain: Int) -> Int {
  let p = image + offset
  let va = load64(p + 24)
  let vm = load64(p + 32)
  let file = load64(p + 40)
  let bytes = load64(p + 48)
  let prot = load32(p + 60)
  let done = 0
  while done < vm {
    let frame = darwin-protected-take-frame()
    if frame == 0 { return -12 }
    store64(darwin-protected-virtuals + (darwin-protected-count - 1) * 8, va + done)
    let n = bytes - done
    if n > 4096 { n = 4096 }
    let i = 0
    while i < n {
      store8(frame + i, load8(image + file + done + i))
      i = i + 1
    }
    if prot == 5 { domain-map-user-code(domain, va + done, frame) }
    else { domain-map-user-data(domain, va + done, frame) }
    done = done + 4096
  }
  return 0
}

fn darwin-protected-release(domain: Int) -> Int {
  if domain-destroy-user(domain) != 0 { return -1 }
  let i = 0
  while i < darwin-protected-count {
    frame-free(load64(darwin-protected-frames + i * 8))
    store64(darwin-protected-frames + i * 8, 0)
    store64(darwin-protected-virtuals + i * 8, 0)
    i = i + 1
  }
  darwin-protected-count = 0
  return 0
}

fn darwin-protected-run-budgeted(image: Int, size: Int, authority: Int, budget: Int) -> Int {
  if budget <= 0 || budget > 10000 { return -22 }
  let entry = darwin-protected-entry(image, size)
  if entry < 0 { return entry }
  if domain-current != 0 || darwin-protected-busy != 0 || domain-user-syscall-hook != 0 { return -16 }
  if authority >= 0 && cap-check(authority, cap-serial()) == 0 { return -13 }
  if load64(0x4160) == 0 { return -38 }
  // Bound the maximum page requirement before the allocator can panic. The
  // small fixed context/ledger allocation is also covered by this reserve.
  let available = (heap-end - ((heap-next + 4095) & -4096)) / 4096
  let free = free-list
  while free != 0 && available < 65 {
    available = available + 1
    free = load64(free)
  }
  if available < 65 { return -12 }
  if darwin-protected-frames == 0 {
    darwin-protected-frames = alloc(DARWIN-PROTECTED-MAX-FRAMES * 8)
    darwin-protected-context = alloc(32)
    darwin-protected-virtuals = alloc(DARWIN-PROTECTED-MAX-FRAMES * 8)
  }
  let domain = domain-create-user()
  if domain <= 0 { return -12 }
  darwin-protected-busy = 1
  darwin-protected-count = 0
  darwin-protected-last-domain = domain
  darwin-protected-domain = domain
  darwin-protected-authority = authority
  // Native application authority stays empty. The scoped ABI hook checks
  // explicitly borrowed serial authority and private frame translations.
  domain-set-cap(domain, -1)
  let text = darwin-protected-segment(image, 5)
  let data = darwin-protected-segment(image, 3)
  let status = darwin-protected-map-segment(image, text, domain)
  if status == 0 { status = darwin-protected-map-segment(image, data, domain) }
  if status == 0 {
    let page = 0
    while page < 5 {
      let frame = darwin-protected-take-frame()
      domain-map-user-data(domain, 0x4F000000 + page * 4096, frame)
      store64(darwin-protected-virtuals + (darwin-protected-count - 1) * 8, 0x4F000000 + page * 4096)
      if page == 3 { store64(frame + 4088, 0x40006000) }
      page = page + 1
    }
    let stub = darwin-protected-take-frame()
    // mov rdi,rax; mov rax,2; int80; ud2. Return uses native runtime exit.
    store8(stub, 0x48); store8(stub + 1, 0x89); store8(stub + 2, 0xC7)
    store8(stub + 3, 0x48); store8(stub + 4, 0xC7); store8(stub + 5, 0xC0)
    store8(stub + 6, 2); store8(stub + 7, 0); store8(stub + 8, 0); store8(stub + 9, 0)
    store8(stub + 10, 0xCD); store8(stub + 11, 0x80)
    store8(stub + 12, 0x0F); store8(stub + 13, 0x0B)
    domain-map-user-code(domain, 0x40006000, stub)
    store64(darwin-protected-virtuals + (darwin-protected-count - 1) * 8, 0x40006000)
    if load32(image + 16) == 5 {
      let imports = darwin-protected-take-frame()
      // _write: mov eax,0x2000004; syscall; ret. _exit is nonreturning.
      store8(imports,0xB8);store32(imports+1,0x2000004);
      store8(imports+5,0x0F);store8(imports+6,0x05);
      store8(imports+7,0x73);store8(imports+8,14);
      // libc _write returns -1 on failure; preserve errno in private single-thread errno scratch.
      store8(imports+9,0x89);store8(imports+10,4);store8(imports+11,0x25);store32(imports+12,0x4F004000);
      store8(imports+16,0x48);store8(imports+17,0xC7);store8(imports+18,0xC0);store32(imports+19,-1);
      store8(imports+23,0xC3);
      store8(imports+32,0xB8);store32(imports+33,0x2000001);
      store8(imports+37,0x0F);store8(imports+38,0x05);store8(imports+39,0x0F);store8(imports+40,0x0B);
      // _error returns this single-thread process's private errno address.
      store8(imports+48,0xB8);store32(imports+49,0x4F004000);store8(imports+53,0xC3);
      domain-map-user-code(domain,0x40007000,imports)
      store64(darwin-protected-virtuals+(darwin-protected-count - 1)*8,0x40007000)
      let bind=32;let j=0;
      while j<5{if load32(image+bind)==0x80000022{j=5;}else{bind=bind+load32(image+bind+4);j=j+1;}}
      status=darwin-protected-bind(image,size,bind,data,1)
    }
    domain-user-syscall-hook = darwin-protected-dispatch
    if status == 0 { status = domain-enter-user-budgeted(entry, 0, domain, 0x4F003FF8, darwin-protected-context, budget) }
    domain-user-syscall-hook = 0
  }
  if darwin-protected-release(domain) != 0 { return -5 }
  darwin-protected-busy = 0
  darwin-protected-domain = 0
  darwin-protected-authority = -1
  return status
}

fn darwin-protected-run-granted(image: Int, size: Int, authority: Int) -> Int {
  return darwin-protected-run-budgeted(image, size, authority, 1000)
}

fn darwin-protected-run(image: Int, size: Int) -> Int {
  return darwin-protected-run-granted(image, size, -1)
}

fn darwin-protected-physical(addr: Int) -> Int {
  if addr < 0 { return 0 }
  let page = addr & -4096
  let i = 0
  while i < darwin-protected-count {
    if load64(darwin-protected-virtuals + i * 8) == page {
      return load64(darwin-protected-frames + i * 8) + (addr & 4095)
    }
    i = i + 1
  }
  return 0
}

fn darwin-protected-write(fd: Int, addr: Int, len: Int) -> Int {
  if fd != 1 && fd != 2 { return -9 }
  if cap-check(darwin-protected-authority, cap-serial()) == 0 { return -13 }
  if len < 0 || len > 4096 || addr < 0 || addr > 0x50000000 - len { return -14 }
  // Validate the complete span before serial output. Guest VAs are translated
  // through this invocation's private frame ledger, never dereferenced by CPL0.
  let i = 0
  while i < len {
    if darwin-protected-physical(addr + i) == 0 { return -14 }
    i = i + 1
  }
  i = 0
  while i < len {
    serial-put(com1(), load8(darwin-protected-physical(addr + i)))
    i = i + 1
  }
  return len
}

// Action 1 resumes the guest, action 0 completes its synchronous invocation.
// Saved IRET RFLAGS lives at136; changing R11 alone would lose carry on return.
fn darwin-protected-dispatch(frame: Int) -> Int {
  let num = load64(frame + 112)
  let a0 = load64(frame + 72)
  if darwin-protected-busy == 0 || domain-current != darwin-protected-domain {
    store64(frame + 112, -1)
    return 0
  }
  if num == 2 && load64(frame + 120) == 0x4000600C {
    store64(frame + 112, a0)
    return 0
  }
  if num == 0x2000001 {
    store64(frame + 112, a0 & 255)
    return 0
  }
  let result = -78
  if num == 0x2000004 {
    result = darwin-protected-write(a0, load64(frame + 80), load64(frame + 88))
  } else if num == 0x2000014 {
    result = darwin-protected-domain
  }
  let flags = load64(frame + 136) & -2
  if result < 0 { result = 0 - result; flags = flags | 1 }
  store64(frame + 112, result)
  store64(frame + 136, flags)
  return 1
}


// Explicitly typed libSystem _write, _exit and optional _error imports. Classic dyld opcodes are bounded to
// one-byte ULEBs in this initial profile. Unknown symbols/opcodes fail closed.
// Validation runs before allocation; application runs only after private fixups.
fn darwin-protected-bind(image:Int,size:Int,command:Int,data:Int,apply:Int)->Int{
 let p=image+command;let off=load32(p+16);let bytes=load32(p+20);
 if off<32+load32(image+20) || bytes<=0 || bytes>128 || off>size - bytes{return -8;}
 let end=off+bytes;let cursor=off;let ordinal=0;let symbol=0;let kind=0;let slot=-1;let seen=0;
 while cursor<end{
  let op=load8(image+cursor);cursor=cursor+1;
  if op==0{if cursor!=end || (seen!=3 && seen!=7){return -8;};return 0;}
  else if op==0x11{ordinal=1;}
  else if op==0x51{kind=1;}
  else if op==0x40{
   symbol=0;
   if cursor+7<=end && load8(image+cursor)==95{
    if load8(image+cursor+1)==119 && load8(image+cursor+2)==114 && load8(image+cursor+3)==105 && load8(image+cursor+4)==116 && load8(image+cursor+5)==101 && load8(image+cursor+6)==0{symbol=1;cursor=cursor+7;}
   }
   if symbol==0 && cursor+6<=end{
    if load8(image+cursor)==95 && load8(image+cursor+1)==101 && load8(image+cursor+2)==120 && load8(image+cursor+3)==105 && load8(image+cursor+4)==116 && load8(image+cursor+5)==0{symbol=2;cursor=cursor+6;}
   }
   if symbol==0 && cursor+7<=end{
    if load8(image+cursor)==95 && load8(image+cursor+1)==101 && load8(image+cursor+2)==114 && load8(image+cursor+3)==114 && load8(image+cursor+4)==111 && load8(image+cursor+5)==114 && load8(image+cursor+6)==0{symbol=4;cursor=cursor+7;}
   }
   if symbol==0{return -8;}
  }else if op==0x71{
   if cursor>=end{return -8;};slot=load8(image+cursor);cursor=cursor+1;
   if slot>=128 || (slot&7)!=0 || slot>load64(image+data+32)-8{return -8;}
  }else if op==0x90{
   if ordinal!=1 || kind!=1 || symbol==0 || slot<0 || (seen&symbol)!=0{return -8;}
   // Distinct ABI slots avoid aliasing _exit over _write or mutable code/header pointers.
   if (symbol==1 && slot!=32) || (symbol==2 && slot!=40) || (symbol==4 && slot!=48){return -8;}
   if apply!=0{
    let target=darwin-protected-physical(load64(image+data+24)+slot);
    if target==0{return -8;}
    if symbol==1{store64(target,0x40007000);}else if symbol==2{store64(target,0x40007020);}else{store64(target,0x40007030);}
   }
   seen=seen|symbol;slot=slot+8;
  }else{return -8;}
 }
 return -8;
}
