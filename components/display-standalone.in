package space.display

import "display.in"

// Standalone display SCI shim — now dynamic. The functions display.in needs
// from the nanokernel are declared here with empty bodies: the compiler
// records them as SCI v2 imports and the loader binds them to the kernel's
// own export table (dynamic nanokernel) before the component's entry runs.
// Component-owned state stays local: the component heap mirror, the input
// stubs used before the input component exists (kernel versions read mouse
// state variables that are kernel-owned, so they are not importable), and
// the kernel-state mirrors. This file is used ONLY by the SCI build
// (build-runtime-components.sh). The kernel build links display.in directly
// against the kernel's own modules.

const COM1-PORT = 0x3F8
const SPACE-VERSION-MAJOR = 0
const SPACE-VERSION-MINOR = 1
const SPACE-VERSION-PATCH = 0

fn com1() -> Int {
  return COM1-PORT
}

// --- nanokernel service imports (bound by the loader) ------------------------
interrupt fn serial-wait-tx(port: Int) -> void {
}

interrupt fn serial-init(port: Int) -> void {
}

interrupt fn serial-put(port: Int, ch: Int) -> void {
}

interrupt fn serial-nl(port: Int) -> void {
}

interrupt fn serial-write-cstr(port: Int, addr: Int) -> void {
}

interrupt fn serial-write-dec-wide(port: Int, value: Int) -> void {
}

interrupt fn serial-write-hex(port: Int, value: Int) -> void {
}

interrupt fn pci-read32(bus: Int, dev: Int, func: Int, off: Int) -> Int {
}

interrupt fn pci-write32(bus: Int, dev: Int, func: Int, off: Int, val: Int) -> void {
}

interrupt fn pci-bar-mmio(bus: Int, dev: Int, func: Int, off: Int, need: Int) -> Int {
}

interrupt fn chan-count(c: Int) -> Int {
}

interrupt fn chan-recv(c: Int) -> Int {
}

interrupt fn frame-alloc() -> Int {
}

// --- serial input probe (shell.in owns the kernel copy; local here) ----------
fn serial-has-byte(port: Int) -> Int {
  return 0
}

// --- heap (SCI components get their own heap from cap-info) ------------------
var heap-next: Int = 0x300000
var heap-end: Int = 0x400000

fn display-heap-init(base: Int, size: Int) -> void {
  heap-next = base
  heap-end = base + size
  return
}

fn alloc(n: Int) -> Int {
  let aligned = (n + 15) & -16
  let p = heap-next
  let next = heap-next + aligned
  if next > heap-end {
    return 0
  }
  heap-next = next
  return p
}

// --- input stubs (SCI display gets input via channel from input component) ---
var mouse-x: Int = 0
var mouse-y: Int = 0

fn mouse-poll() -> Int {
  return 0
}

fn mouse-left-pressed() -> Int {
  return 0
}

fn usb-kbd-ready() -> Int {
  return 0
}

fn usb-kbd-getchar() -> Int {
  return -1
}

fn ps2-kbd-getchar() -> Int {
  return -1
}

// --- kernel state stubs (SCI display has no kernel context) ------------------
var total-ram: Int = 0
var proc-count: Int = 0
var domain-count: Int = 0
var nvme-ready: Int = 0
