package space.display

import "../protocol/display.in"
import "font.in"
import "font-desktop-atlas.in"
import "font-desktop-render.in"
import "display-output.in"
import "display-text.in"
import "display-commandbar.in"
import "display-utilities.in"
import "display-terminal.in"
import "display-seat.in"
import "display-spdp.in"
import "font-ttf.in"
import "font-asset-spacesans.in"

interface DisplayDevice {
  fn map(phys: Int, size: Int) -> void
  fn present() -> void
}

component Display {
  target "x86_64-unknown-none"
  deterministic true
  checkpoint none

  capability display: DisplayDevice(map, present)
}


// BGA registers require atomic 16-bit port accesses. Use the compiler
// inw/outw primitives; bytewise wrappers do not implement this device ABI.

var comp-backbuf: Int = 0

var comp-surf-sizes: Int = 0 // per-window alpha surface allocated sizes (bytes)
var comp-dragging: Int = 0



// VBE framebuffer driver for the Space nanokernel.
// Reads VBE mode info from the Multiboot1 info structure, maps the framebuffer
// memory (identity-mapped in the first 4 GiB by the boot trampoline), and
// provides drawing primitives: pixels, rectangles, lines, and bitmap text.
//
// The framebuffer is a linear pixel array. Each pixel is 32 bits (BGRA or RGBX
// depending on the VBE mode). The pitch (bytes per scanline) may differ from
// width * 4, so all drawing functions use fb_pitch for address calculation.
//
// Multiboot1 info structure offsets (VBE fields):
//   offset 0:  flags (bit 11 = VBE info valid)
//   offset 72: vbe_control_info (u32 pointer)
//   offset 76: vbe_mode_info (u32 pointer)
//   offset 80: vbe_mode (u16)
//
// VBE mode info structure offsets:
//   offset 16: bytes_per_scanline (u16) -- pitch
//   offset 18: x_resolution (u16)
//   offset 20: y_resolution (u16)
//   offset 25: bits_per_pixel (u8)
//   offset 40: phys_base_ptr (u32) -- framebuffer physical address

// --- framebuffer state ------------------------------------------------------
var fb-addr: Int = 0       // framebuffer virtual address (identity-mapped)
var fb-pitch: Int = 0      // bytes per scanline
var fb-width: Int = 0      // pixels
var fb-height: Int = 0     // pixels
var fb-bpp: Int = 0        // bits per pixel
var fb-size: Int = 0       // total framebuffer size in bytes
var fb-ready: Int = 0      // 1 after successful init
var fb-font-scale: Int = 2  // font scale multiplier (2=16x16, 3=24x24)

// --- colors (32-bit RGBX) ---------------------------------------------------
const FB-COLOR-BLACK = 0x00000000
const FB-COLOR-WHITE = 0x00FFFFFF
const FB-COLOR-RED = 0x00FF0000
const FB-COLOR-GREEN = 0x0000FF00
const FB-COLOR-BLUE = 0x000000FF
const FB-COLOR-CYAN = 0x0000FFFF
const FB-COLOR-MAGENTA = 0x00FF00FF
const FB-COLOR-YELLOW = 0x00FFFF00
const FB-COLOR-GRAY = 0x00808080
const FB-COLOR-DARK-GRAY = 0x00404040
const FB-COLOR-LIGHT-GRAY = 0x00C0C0C0
const FB-COLOR-DARK-BLUE = 0x00000080
const FB-COLOR-DARK-GREEN = 0x00008000
const FB-COLOR-DARK-RED = 0x00800000
const FB-COLOR-ORANGE = 0x00FF8000
const FB-COLOR-PURPLE = 0x00800080
const FB-COLOR-TEAL = 0x00808000

// --- Bochs VBE I/O ports (QEMU standard VGA) --------------------------------
const VBE-INDEX = 0x1CE
const VBE-DATA = 0x1CF

// Write a VBE register.
fn vbe-write(idx: Int, val: Int) -> void {
  outw(VBE-INDEX, idx)
  outw(VBE-DATA, val)
  return
}

// Read a VBE register.
fn vbe-read(idx: Int) -> Int {
  outw(VBE-INDEX, idx)
  return inw(VBE-DATA)
}

// --- framebuffer initialization ---------------------------------------------

// Enable PCI vendor/device I/O for VGA device.
fn fb-enable-vga-pci() -> void {
  let dev = 0
  while dev < 32 {
    let vendor = pci-read32(0, dev, 0, 0) & 0xFFFF
    if vendor != 0xFFFF {
      let class-code = (pci-read32(0, dev, 0, 0x08) >> 8) & 0xFFFFFF
      if class-code == 0x030000 {
        let cmd = pci-read32(0, dev, 0, 0x04)
        pci-write32(0, dev, 0, 0x04, cmd | 0x7)
        return
      }
    }
    dev = dev + 1
  }
  return
}

// Initialize the framebuffer using Bochs VBE I/O ports.
// Sets a 1920x1080x32 graphics mode with linear framebuffer.
// Falls back to multiboot VBE info if I/O ports don't respond.
// Returns 0 on success, -1 if VBE is unavailable.
fn fb-init(mb-info: Int) -> Int {
  // Enable PCI VGA I/O (needed for VBE ports to work on some QEMU configs).
  fb-enable-vga-pci()

  // Check for Bochs VBE by reading the ID register.
  let vbe-id = vbe-read(0x00)

  // If VBE I/O fails, try multiboot VBE info.
  if vbe-id == 0 {
    let mb-flags = load32(mb-info + 0)
    let vbe-avail = (mb-flags >> 11) & 1
    if vbe-avail == 0 {
      return -1
    }
    let mode-info = load32(mb-info + 76)
    if mode-info == 0 {
      return -1
    }
    fb-pitch = load16(mode-info + 16)
    fb-width = load16(mode-info + 18)
    fb-height = load16(mode-info + 20)
    fb-bpp = load8(mode-info + 25)
    fb-addr = load32(mode-info + 40)
    if out-commit-mode(fb-width, fb-height, fb-bpp, fb-pitch, 100, 100, OUT-TRANSFORM-NORMAL) == 0 {
      return -1
    }
    fb-font-init()
    desktop-fonts-apply(fb-font-aa16, fb-font-sans-aa16)
    text-init()
    let ttf-raw = space-font-spacesans-init()
    ttf-load(ttf-raw, SPACE-FONT-SPACESANS-SIZE)
    fb-ready = 1
    return 0
  }

  // VBE I/O ports work — configure mode.
  // Disable VBE while configuring.
  vbe-write(0x04, 0x00)

  // Set X resolution, Y resolution, and BPP.
  let target-w = 1920
  let target-h = 1080
  let target-bpp = 32
  vbe-write(0x01, target-w)
  vbe-write(0x02, target-h)
  vbe-write(0x03, target-bpp)

  // Enable VBE with linear framebuffer (bit 6 = LFB, bit 0 = enable).
  // Bit 7 = clear video memory.
  vbe-write(0x04, 0xC1)

  // Read back the actual settings.
  fb-width = vbe-read(0x01)
  fb-height = vbe-read(0x02)
  fb-bpp = vbe-read(0x03)

  // Set pitch (bytes per scanline) = width * (bpp / 8).
  fb-pitch = fb-width * 4
  let virt-w = vbe-read(0x06)
  if virt-w != 0 {
    fb-pitch = virt-w * 4
  }

  if out-commit-mode(fb-width, fb-height, fb-bpp, fb-pitch, 100, 100, OUT-TRANSFORM-NORMAL) == 0 {
    return -1
  }

  // Find the framebuffer address by scanning PCI for a VGA device (class 0x030000).
  fb-addr = 0
  let dev = 0
  while dev < 32 {
    let vendor = pci-read32(0, dev, 0, 0) & 0xFFFF
    if vendor != 0xFFFF {
      let class-code = (pci-read32(0, dev, 0, 0x08) >> 8) & 0xFFFFFF
      if class-code == 0x030000 {
        let bar = pci-bar-mmio(0, dev, 0, 0x10, 0x1000)
        if bar != 0 {
          fb-addr = bar
          // Enable PCI memory space, I/O space, and bus mastering.
          pci-write32(0, dev, 0, 0x04, 0x7)
          break
        }
      }
    }
    dev = dev + 1
  }

  if fb-addr == 0 {
    return -1
  }

  // Initialize the font and text subsystem.
  fb-font-init()
  desktop-fonts-apply(fb-font-aa16, fb-font-sans-aa16)
  text-init()
  let ttf-raw = space-font-spacesans-init()
  ttf-load(ttf-raw, SPACE-FONT-SPACESANS-SIZE)
  fb-ready = 1

  return 0
}

// --- drawing primitives -----------------------------------------------------

// Set a single pixel at (x, y) to color. Clips to screen bounds + active clip.
fn fb-put-pixel(x: Int, y: Int, color: Int) -> void {
  if fb-ready == 0 {
    return
  }
  let rx = x + comp-render-dx
  let ry = y + comp-render-dy
  if rx < 0 || rx >= fb-width || ry < 0 || ry >= fb-height {
    return
  }
  if comp-clip-valid != 0 {
    if rx < comp-clip-x0 || rx >= comp-clip-x1 || ry < comp-clip-y0 || ry >= comp-clip-y1 {
      return
    }
  }
  let off = ry * fb-pitch + rx * 4
  store32(fb-addr + off, color)
  return
}

// Fill a rectangle with a solid color. Clips to screen bounds + active clip.
fn fb-fill-rect(x: Int, y: Int, w: Int, h: Int, color: Int) -> void {
  if fb-ready == 0 {
    return
  }

  let rx = x + comp-render-dx
  let ry = y + comp-render-dy
  let x-start = rx
  if x-start < 0 {
    x-start = 0
  }
  let x-end = rx + w
  if x-end > fb-width {
    x-end = fb-width
  }

  let y-start = ry
  if y-start < 0 {
    y-start = 0
  }
  let y-end = ry + h
  if y-end > fb-height {
    y-end = fb-height
  }

  if comp-clip-valid != 0 {
    if x-start < comp-clip-x0 { x-start = comp-clip-x0 }
    if y-start < comp-clip-y0 { y-start = comp-clip-y0 }
    if x-end > comp-clip-x1 { x-end = comp-clip-x1 }
    if y-end > comp-clip-y1 { y-end = comp-clip-y1 }
  }

  if x-start >= x-end || y-start >= y-end {
    return
  }

  let color32 = color & 0xFFFFFFFF
  let color64 = color32 | (color32 << 32)
  let span = x-end - x-start
  let qwords = span >> 1
  let odd = span & 1
  let odd-off = qwords * 8
  let py = y-start
  while py < y-end {
    let ptr = fb-addr + py * fb-pitch + x-start * 4
    if qwords > 0 {
      cpu-mem-fill64(ptr, color64, qwords)
    }
    if odd != 0 {
      store32(ptr + odd-off, color)
    }
    py = py + 1
  }
  return
}

// Draw a single character at (x, y) in the given color.
fn fb-draw-char(x: Int, y: Int, ch: Int, color: Int) -> void {
  if fb-ready == 0 {
    return
  }
  if ch < 0 || ch >= 128 {
    ch = 63  // '?'
  }
  let rx = x + comp-render-dx
  let ry = y + comp-render-dy

  // Fast path if the whole character (16x16) is within bounds and clip.
  if rx >= 0 && rx + 16 <= fb-width && ry >= 0 && ry + 16 <= fb-height {
    if comp-clip-valid == 0 || (rx >= comp-clip-x0 && rx + 16 <= comp-clip-x1 && ry >= comp-clip-y0 && ry + 16 <= comp-clip-y1) {
      let color32 = color & 0xFFFFFFFF
      let color64 = color32 | (color32 << 32)
      let glyph-base = fb-font + ch * 8
      let row = 0
      let row-addr = fb-addr + ry * fb-pitch + rx * 4
      while row < 8 {
        let bits = load8(glyph-base + row)
        if bits != 0 {
          let col = 0
          let pixel-addr = row-addr
          while col < 8 {
            let bit = (bits >> (7 - col)) & 1
            if bit != 0 {
              store64(pixel-addr, color64)
              store64(pixel-addr + fb-pitch, color64)
            }
            pixel-addr = pixel-addr + 8
            col = col + 1
          }
        }
        row-addr = row-addr + fb-pitch * 2
        row = row + 1
      }
      return
    }
  }

  // Fully off-screen check
  if rx + 16 <= 0 || rx >= fb-width || ry + 16 <= 0 || ry >= fb-height {
    return
  }
  // Fully outside active clip
  if comp-clip-valid != 0 {
    if rx + 16 <= comp-clip-x0 || rx >= comp-clip-x1 || ry + 16 <= comp-clip-y0 || ry >= comp-clip-y1 {
      return
    }
  }

  let glyph-base2 = fb-font + ch * 8
  let row = 0
  let py = y
  while row < 8 {
    let ry2 = py + comp-render-dy
    if ry2 + 1 >= 0 && ry2 < fb-height {
      let bits = load8(glyph-base2 + row)
      let col = 0
      let px = x
      while col < 8 {
        let rx2 = px + comp-render-dx
        let bit = (bits >> (7 - col)) & 1
        if bit != 0 {
          let inside = 1
          if rx2 < 0 || ry2 < 0 || rx2 + 1 >= fb-width || ry2 + 1 >= fb-height {
            inside = 0
          }
          if comp-clip-valid != 0 {
            if rx2 < comp-clip-x0 || rx2 + 1 >= comp-clip-x1 || ry2 < comp-clip-y0 || ry2 + 1 >= comp-clip-y1 {
              inside = 0
            }
          }
          if inside != 0 {
            let row-addr = fb-addr + ry2 * fb-pitch + rx2 * 4
            store32(row-addr, color)
            store32(row-addr + 4, color)
            store32(row-addr + fb-pitch, color)
            store32(row-addr + fb-pitch + 4, color)
          } else {
            fb-put-pixel(px, py, color)
            fb-put-pixel(px + 1, py, color)
            fb-put-pixel(px, py + 1, color)
            fb-put-pixel(px + 1, py + 1, color)
          }
        }
        px = px + 2
        col = col + 1
      }
    }
    py = py + 2
    row = row + 1
  }
  return
}

// Clear the entire screen to a color.
fn fb-clear(color: Int) -> void {
  fb-fill-rect(0, 0, fb-width, fb-height, color)
  return
}

// Print framebuffer info to the serial port.
fn fb-info(port: Int) -> void {
  if fb-ready == 0 {
    serial-write-cstr(port, "  fb: not initialized")
    serial-nl(port)
    return
  }
  serial-write-cstr(port, "  fb: ")
  serial-write-dec-wide(port, fb-width)
  serial-write-cstr(port, "x")
  serial-write-dec-wide(port, fb-height)
  serial-write-cstr(port, "x")
  serial-write-dec-wide(port, fb-bpp)
  serial-write-cstr(port, " pitch=")
  serial-write-dec-wide(port, fb-pitch)
  serial-write-cstr(port, " addr=0x")
  serial-write-hex(port, fb-addr)
  serial-write-cstr(port, " size=")
  serial-write-dec-wide(port, fb-size)
  serial-nl(port)
  return
}

// Draw a small color-bar test pattern so `fb test` exercises the pixel path.
fn fb-test-pattern(port: Int) -> void {
  if fb-ready == 0 {
    serial-write-cstr(port, "  fb: not initialized")
    serial-nl(port)
    return
  }
  let bw = fb-width / 8
  fb-fill-rect(0 * bw, 0, bw, fb-height, FB-COLOR-RED)
  fb-fill-rect(1 * bw, 0, bw, fb-height, FB-COLOR-GREEN)
  fb-fill-rect(2 * bw, 0, bw, fb-height, FB-COLOR-BLUE)
  fb-fill-rect(3 * bw, 0, bw, fb-height, FB-COLOR-CYAN)
  fb-fill-rect(4 * bw, 0, bw, fb-height, FB-COLOR-MAGENTA)
  fb-fill-rect(5 * bw, 0, bw, fb-height, FB-COLOR-YELLOW)
  fb-fill-rect(6 * bw, 0, bw, fb-height, FB-COLOR-GRAY)
  fb-fill-rect(7 * bw, 0, fb-width - 7 * bw, fb-height, FB-COLOR-WHITE)
  serial-write-cstr(port, "  fb: test pattern drawn")
  serial-nl(port)
  return
}

// Wayland-style compositor for the Space nanokernel.
// Manages windows, renders them to the VBE framebuffer, and handles
// mouse/keyboard input. This is a minimal display server that demonstrates
// the Space OS desktop environment.
//
// Window record (64 bytes):
//   [0..4]   id
//   [4..8]   x
//   [8..12]  y
//   [12..16] width
//   [16..20] height
//   [20..24] flags (bit 0 = visible, bit 1 = focused, bit 2 = dirty)
//   [24..32] title string address
//   [32..40] content buffer address (or 0 for auto-rendered)
//   [40..48] role
//   [48]     alpha (0..255; 255 = opaque fast path)
//   [56..64] per-window surface (for alpha compositing)

// --- window constants -------------------------------------------------------
const COMP-MAX-WINDOWS = 16
const COMP-WIN-SIZE = 64
const COMP-TITLE-BAR-H = 28
const COMP-BORDER-W = 1
const COMP-TASKBAR-H = 28
const COMP-COLOR-DESKTOP = 0x000B0909
const COMP-COLOR-PANEL = 0x001B1818
const COMP-COLOR-PANEL-LINE = 0x0027272A
const COMP-COLOR-TITLE = 0x00242429
const COMP-COLOR-TITLE-ACTIVE = 0x0030303A
const COMP-COLOR-WINDOW = 0x00202027
const COMP-COLOR-BORDER = 0x00383840
const COMP-COLOR-ACCENT = 0x00F8BD38
const COMP-COLOR-TEXT = 0x00E8E8ED
const COMP-COLOR-MUTED = 0x00AEB0BE
const COMP-COLOR-SURFACE = 0x00202027
const COMP-COLOR-SURFACE-ALT = 0x002A2A33
const COMP-COLOR-TERM-BG = 0x00151519
const COMP-COLOR-TERM-TEXT = 0x00F5F4F4

const COMP-WIN-VISIBLE = 1
const COMP-WIN-FOCUSED = 2
const COMP-WIN-DIRTY = 4
const COMP-WIN-MINIMIZED = 8
const COMP-CURSOR-W = 16
const COMP-CURSOR-H = 16
const COMP-ROLE-TEXT = 0
const COMP-ROLE-UTILITIES = 2
const COMP-ROLE-TERMINAL = 3
const COMP-MIN-WIN-W = 280
const COMP-MIN-WIN-H = 180
const COMP-MIN-EDITOR-W = 640
const COMP-MIN-SIDE-W = 520

// --- compositor state -------------------------------------------------------
var comp-windows: Int = 0    // array of window records
var comp-count: Int = 0      // number of windows
var comp-focused: Int = 0    // index of focused window
// Track drag mode: 1 = move (title bar), 2 = resize (bottom-right corner)
var comp-drag-mode: Int = 0   // index of window being dragged (-1 = none)
var comp-drag-off-x: Int = 0 // drag offset from window origin to mouse
var comp-drag-off-y: Int = 0
var comp-running: Int = 0    // 1 when compositor loop is active
// --- damage-rect state ------------------------------------------------------
// Pending damage is a single union rect (x0,y0,x1,y1, exclusive x1/y1).
var comp-dmg-x0: Int = 0
var comp-dmg-y0: Int = 0
var comp-dmg-x1: Int = 0
var comp-dmg-y1: Int = 0
var comp-dmg-valid: Int = 0
// Active clip rect applied to all fb-* primitives during recomposition.
var comp-clip-x0: Int = 0
var comp-clip-y0: Int = 0
var comp-clip-x1: Int = 0
var comp-clip-y1: Int = 0
var comp-clip-valid: Int = 0
// Render offset: when rendering a window into its own surface for alpha
// compositing, the window's screen coords are translated by (-wx, -wy).
var comp-render-dx: Int = 0
var comp-render-dy: Int = 0

// Add a rect (x0,y0)-(x1,y1) to the pending damage. Clips to screen.
fn comp-dmg-add(x0: Int, y0: Int, x1: Int, y1: Int) -> void {
  if x0 < 0 { x0 = 0 }
  if y0 < 0 { y0 = 0 }
  if x1 > fb-width { x1 = fb-width }
  if y1 > fb-height { y1 = fb-height }
  if x0 >= x1 || y0 >= y1 {
    return
  }
  if comp-dmg-valid == 0 {
    comp-dmg-x0 = x0
    comp-dmg-y0 = y0
    comp-dmg-x1 = x1
    comp-dmg-y1 = y1
    comp-dmg-valid = 1
  } else {
    if x0 < comp-dmg-x0 { comp-dmg-x0 = x0 }
    if y0 < comp-dmg-y0 { comp-dmg-y0 = y0 }
    if x1 > comp-dmg-x1 { comp-dmg-x1 = x1 }
    if y1 > comp-dmg-y1 { comp-dmg-y1 = y1 }
  }
  return
}

fn comp-dmg-clear() -> void {
  comp-dmg-valid = 0
  return
}

fn comp-dmg-full() -> void {
  comp-dmg-add(0, 0, fb-width, fb-height)
  return
}

// Test whether a point in translated screen coords is inside the clip.
fn comp-clip-test(px: Int, py: Int) -> Int {
  if comp-clip-valid == 0 {
    return 1
  }
  if px >= comp-clip-x0 && px < comp-clip-x1 && py >= comp-clip-y0 && py < comp-clip-y1 {
    return 1
  }
  return 0
}

fn comp-clip-set(x0: Int, y0: Int, x1: Int, y1: Int) -> void {
  comp-clip-x0 = x0
  comp-clip-y0 = y0
  comp-clip-x1 = x1
  comp-clip-y1 = y1
  comp-clip-valid = 1
  return
}

fn comp-clip-clear() -> void {
  comp-clip-valid = 0
  return
}

// Window frame rect (with title bar) intersection test.
fn comp-win-intersects(idx: Int, rx0: Int, ry0: Int, rx1: Int, ry1: Int) -> Int {
  if idx < 0 || idx >= comp-count {
    return 0
  }
  let base = comp-win-base(idx)
  let wx = load32(base + 4)
  let wy = load32(base + 8)
  let ww = load32(base + 12)
  let wh = load32(base + 16)
  let wfy = wy + wh + COMP-TITLE-BAR-H
  if wx < rx1 && wx + ww > rx0 && wy < ry1 && wfy > ry0 {
    return 1
  }
  return 0
}

// Add a window's full frame rect to damage.
fn comp-win-damage(idx: Int) -> void {
  if idx < 0 || idx >= comp-count {
    return
  }
  let base = comp-win-base(idx)
  let wx = load32(base + 4)
  let wy = load32(base + 8)
  let ww = load32(base + 12)
  let wh = load32(base + 16)
  store32(base + 20, load32(base + 20) | COMP-WIN-DIRTY)
  comp-dmg-add(wx, wy, wx + ww, wy + wh + COMP-TITLE-BAR-H)
  return
}

// --- window management ------------------------------------------------------

// Initialize the compositor.
fn comp-init() -> void {
  // ponytail: backbuffer at top of heap avoids alloc/heap_next (optimizer crash).
  if fb-width > 0 && fb-height > 0 {
    let heap-top = 0x0FFE0000
    let sz = fb-width * fb-height * 4
    comp-backbuf = heap-top - ((sz + 4095) & -4096)
  }
  comp-windows = alloc(COMP-MAX-WINDOWS * COMP-WIN-SIZE)
  comp-surf-sizes = alloc(COMP-MAX-WINDOWS * 4)
  let i = 0
  while i < COMP-MAX-WINDOWS {
    comp-win-clear(i)
    store32(comp-surf-sizes + i * 4, 0)
    i = i + 1
  }
  comp-count = 0
  comp-focused = -1
  comp-drag-mode = -1
  comp-dragging = -1
  comp-running = 0
  comp-bar-init()
  comp-launcher-open = 0
  comp-launcher-len = 0
  if comp-launcher-query == 0 {
    comp-launcher-query = alloc(33)
  }
  store8(comp-launcher-query, 0)
  comp-cur-drawn = 0
  comp-cursor-init()
  comp-term-init()
  return
}



// Clear a window slot.
fn comp-win-clear(idx: Int) -> void {
  let base = comp-windows + idx * COMP-WIN-SIZE
  let i = 0
  while i < COMP-WIN-SIZE {
    store8(base + i, 0)
    i = i + 1
  }
  return
}

// Get the base address of a window record.
fn comp-win-base(idx: Int) -> Int {
  return comp-windows + idx * COMP-WIN-SIZE
}

// Create a new window. Returns the window index or -1 if the table is full.
fn comp-win-create(title: Int, x: Int, y: Int, w: Int, h: Int) -> Int {
  if comp-count >= COMP-MAX-WINDOWS {
    return -1
  }
  let idx = comp-count
  let base = comp-win-base(idx)
  store32(base + 0, idx)
  store32(base + 4, x)
  store32(base + 8, y)
  store32(base + 12, w)
  store32(base + 16, h)
  store32(base + 20, COMP-WIN-VISIBLE | COMP-WIN-DIRTY)
  store64(base + 24, title)
  store64(base + 32, 0)
  store64(base + 40, COMP-ROLE-TEXT)
  store8(base + 48, 255)
  store32(base + 52, 0)
  store64(base + 56, 0)
  comp-count = comp-count + 1
  comp-win-focus(idx)
  return idx
}

// Set a window's content buffer (for custom rendering).
fn comp-win-set-content(idx: Int, buf: Int) -> void {
  if idx < 0 || idx >= comp-count {
    return
  }
  let base = comp-win-base(idx)
  store64(base + 32, buf)
  store32(base + 20, load32(base + 20) | COMP-WIN-DIRTY)
  return
}

fn comp-win-set-role(idx: Int, role: Int) -> void {
  if idx < 0 || idx >= comp-count {
    return
  }
  let base = comp-win-base(idx)
  store64(base + 40, role)
  store32(base + 20, load32(base + 20) | COMP-WIN-DIRTY)
  return
}

// Set a window's opacity (0..255). 255 (default) renders opaque directly;
// lower values composite the window surface with alpha over the desktop.
fn comp-win-set-alpha(idx: Int, alpha: Int) -> void {
  if idx < 0 || idx >= comp-count {
    return
  }
  if alpha < 0 {
    alpha = 0
  }
  if alpha > 255 {
    alpha = 255
  }
  store8(comp-win-base(idx) + 48, alpha)
  comp-win-damage(idx)
  return
}

// Check if a point is inside a window's title bar.
fn comp-win-in-titlebar(idx: Int, mx: Int, my: Int) -> Int {
  let base = comp-win-base(idx)
  let x = load32(base + 4)
  let y = load32(base + 8)
  let w = load32(base + 12)
  if mx >= x && mx < x + w && my >= y && my < y + COMP-TITLE-BAR-H {
    return 1
  }
  return 0
}

// Check if a point is inside a window (including title bar).
fn comp-win-contains(idx: Int, mx: Int, my: Int) -> Int {
  let base = comp-win-base(idx)
  let x = load32(base + 4)
  let y = load32(base + 8)
  let w = load32(base + 12)
  let h = load32(base + 16)
  if mx >= x && mx < x + w && my >= y && my < y + h + COMP-TITLE-BAR-H {
    return 1
  }
  return 0
}

// Find the topmost window at a point. Returns index or -1.
fn comp-win-at-point(mx: Int, my: Int) -> Int {
  let i = comp-count - 1
  while i >= 0 {
    let flags = load32(comp-win-base(i) + 20)
    if (flags & COMP-WIN-VISIBLE) != 0 {
      if comp-win-contains(i, mx, my) != 0 {
        return i
      }
    }
    i = i - 1
  }
  return -1
}

// Focus a window (bring to front conceptually — we just update the focused flag).
fn comp-win-close(idx: Int) -> void {
  if idx < 0 || idx >= comp-count {
    return
  }
  // Window indices shift on close; a held pointer must not drag a stale record.
  comp-dragging = -1
  comp-drag-mode = -1
  // Capture the removed window's rect before shifting.
  let rem-x = load32(comp-win-base(idx) + 4)
  let rem-y = load32(comp-win-base(idx) + 8)
  let rem-w = load32(comp-win-base(idx) + 12)
  let rem-h = load32(comp-win-base(idx) + 16)
  let was-focused = 0
  if comp-focused == idx {
    was-focused = 1
  }
  // Shift remaining windows down
  let i = idx
  while i < comp-count - 1 {
    let src = comp-win-base(i + 1)
    let dst = comp-win-base(i)
    let j = 0
    while j < COMP-WIN-SIZE {
      store8(dst + j, load8(src + j))
      j = j + 1
    }
    i = i + 1
  }
  comp-win-clear(comp-count - 1)
  comp-count = comp-count - 1
  comp-dmg-add(0, 0, fb-width, COMP-TASKBAR-H)
  // Shift focus with its window record when an earlier window was removed.
  if comp-focused > idx { comp-focused = comp-focused - 1 }
  if comp-focused >= comp-count {
    comp-focused = comp-count - 1
  }
  // Damage the vacated area; the newly-focused window's title color too.
  comp-dmg-add(rem-x, rem-y, rem-x + rem-w, rem-y + rem-h + COMP-TITLE-BAR-H)
  if was-focused != 0 && comp-focused >= 0 {
    comp-win-damage(comp-focused)
  }
  return
}

// Minimize window — clear VISIBLE flag, set MINIMIZED.
fn comp-win-minimize(idx: Int) -> void {
  if idx < 0 || idx >= comp-count {
    return
  }
  let base = comp-win-base(idx)
  let flags = load32(base + 20)
  store32(base + 20, (flags | COMP-WIN-MINIMIZED | COMP-WIN-DIRTY) & -4)
  comp-dragging = -1
  comp-drag-mode = -1
  comp-win-damage(idx)
  if comp-focused == idx {
    comp-focused = -1
    let i = 0
    while i < comp-count {
      let other = load32(comp-win-base(i) + 20)
      if (other & COMP-WIN-VISIBLE) != 0 && (other & COMP-WIN-MINIMIZED) == 0 {
        comp-win-focus(i)
        return
      }
      i = i + 1
    }
    comp-dmg-add(0, 0, fb-width, COMP-TASKBAR-H)
  }
  return
}

// Restore a minimized window — set VISIBLE, clear MINIMIZED.
fn comp-win-restore(idx: Int) -> void {
  if idx < 0 || idx >= comp-count {
    return
  }
  let base = comp-win-base(idx)
  let flags = load32(base + 20)
  store32(base + 20, (flags & -9) | COMP-WIN-VISIBLE | COMP-WIN-DIRTY)
  comp-win-focus(idx)
  comp-win-damage(idx)
  return
}

// Focus a window (bring to front conceptually — we just update the focused flag).
fn comp-win-focus(idx: Int) -> void {
  let prev = comp-focused
  if prev == idx && (load32(comp-win-base(idx) + 20) & COMP-WIN-FOCUSED) != 0 {
    return
  }
  if prev >= 0 && prev < comp-count && prev != idx {
    comp-win-damage(prev)
  }
  let i = 0
  while i < comp-count {
    let base = comp-win-base(i)
    let flags = load32(base + 20)
    if i == idx {
      store32(base + 20, flags | COMP-WIN-FOCUSED | COMP-WIN-DIRTY)
    } else {
      store32(base + 20, (flags & -3) | COMP-WIN-DIRTY)
    }
    i = i + 1
  }
  comp-focused = idx
  comp-dmg-add(0, 0, fb-width, COMP-TASKBAR-H)
  comp-win-damage(idx)
  return
}

// --- rendering --------------------------------------------------------------

// Draw the desktop background (flat color, no stripes — ponytail: stripes were 20 loops per frame).
fn comp-render-background() -> void {
  fb-clear(COMP-COLOR-DESKTOP)
}

// Helper: draw content area background
fn comp-draw-content-bg(base: Int) -> void {
  let x = load32(base + 4)
  let y = load32(base + 8)
  let w = load32(base + 12)
  let h = load32(base + 16)
  let content-y = y + COMP-TITLE-BAR-H
  fb-fill-rect(x + COMP-BORDER-W, content-y, w - COMP-BORDER-W * 2, h - COMP-BORDER-W, COMP-COLOR-WINDOW)
}

// True 16x16 1x1 physical-pixel grayscale coverage blender using EPX/Scale2x
// subpixel-smoothed glyph tables (fb-font-aa16 / fb-font-sans-aa16).
fn fb-draw-char-table-aa16(aa16-table: Int, x: Int, y: Int, ch: Int, color: Int) -> void {
  if fb-ready == 0 || aa16-table == 0 {
    return
  }
  let rx = x + comp-render-dx
  let ry = y + comp-render-dy
  if rx + 16 <= 0 || rx >= fb-width || ry + 16 <= 0 || ry >= fb-height {
    return
  }
  if comp-clip-valid != 0 {
    if rx + 16 <= comp-clip-x0 || rx >= comp-clip-x1 || ry + 16 <= comp-clip-y0 || ry >= comp-clip-y1 {
      return
    }
  }
  let cr = (color >> 16) & 0xFF
  let cg = (color >> 8) & 0xFF
  let cb = color & 0xFF
  let glyph-base = aa16-table + ch * 256

  // Fast path when the 16x16 glyph cell is completely within screen and clip bounds.
  if rx >= 0 && rx + 16 <= fb-width && ry >= 0 && ry + 16 <= fb-height {
    if comp-clip-valid == 0 || (rx >= comp-clip-x0 && rx + 16 <= comp-clip-x1 && ry >= comp-clip-y0 && ry + 16 <= comp-clip-y1) {
      let row-ptr = fb-addr + ry * fb-pitch + rx * 4
      let r16 = 0
      while r16 < 16 {
        let g-row = glyph-base + r16 * 16
        let w0 = load64(g-row)
        let w1 = load64(g-row + 8)
        if (w0 | w1) != 0 {
          if w0 != 0 {
            let c0 = 0
            while w0 != 0 && c0 < 8 {
              let cov = w0 & 0xFF
              if cov > 0 {
                let p0 = row-ptr + c0 * 4
                if cov >= 255 {
                  store32(p0, color)
                } else {
                  let ia = 255 - cov
                  let d = load32(p0)
                  let dr = (d >> 16) & 0xFF
                  let dg = (d >> 8) & 0xFF
                  let db = d & 0xFF
                  store32(p0, (((cr * cov + dr * ia + 255) >> 8) << 16) | (((cg * cov + dg * ia + 255) >> 8) << 8) | ((cb * cov + db * ia + 255) >> 8))
                }
              }
              w0 = (w0 >> 8) & 0x00FFFFFFFFFFFFFF
              c0 = c0 + 1
            }
          }
          if w1 != 0 {
            let c1 = 0
            let base1 = row-ptr + 32
            while w1 != 0 && c1 < 8 {
              let cov2 = w1 & 0xFF
              if cov2 > 0 {
                let p1 = base1 + c1 * 4
                if cov2 >= 255 {
                  store32(p1, color)
                } else {
                  let ia2 = 255 - cov2
                  let d2 = load32(p1)
                  let dr2 = (d2 >> 16) & 0xFF
                  let dg2 = (d2 >> 8) & 0xFF
                  let db2 = d2 & 0xFF
                  store32(p1, (((cr * cov2 + dr2 * ia2 + 255) >> 8) << 16) | (((cg * cov2 + dg2 * ia2 + 255) >> 8) << 8) | ((cb * cov2 + db2 * ia2 + 255) >> 8))
                }
              }
              w1 = (w1 >> 8) & 0x00FFFFFFFFFFFFFF
              c1 = c1 + 1
            }
          }
        }
        row-ptr = row-ptr + fb-pitch
        r16 = r16 + 1
      }
      return
    }
  }

  let r16 = 0
  while r16 < 16 {
    let py = ry + r16
    if py >= 0 && py < fb-height {
      let row-ok = 1
      if comp-clip-valid != 0 {
        if py < comp-clip-y0 || py >= comp-clip-y1 {
          row-ok = 0
        }
      }
      if row-ok != 0 {
        let g-row2 = glyph-base + r16 * 16
        if (load64(g-row2) | load64(g-row2 + 8)) != 0 {
          let row-off = py * fb-pitch
          let c16 = 0
          while c16 < 16 {
            let cov = load8(g-row2 + c16)
            if cov > 0 {
              let px = rx + c16
              if px >= 0 && px < fb-width {
                let col-ok = 1
                if comp-clip-valid != 0 {
                  if px < comp-clip-x0 || px >= comp-clip-x1 {
                    col-ok = 0
                  }
                }
                if col-ok != 0 {
                  let off = row-off + px * 4
                  if cov >= 255 {
                    store32(fb-addr + off, color)
                  } else {
                    let ia = 255 - cov
                    let d = load32(fb-addr + off)
                    let dr = (d >> 16) & 0xFF
                    let dg = (d >> 8) & 0xFF
                    let db = d & 0xFF
                    store32(fb-addr + off, (((cr * cov + dr * ia + 255) >> 8) << 16) | (((cg * cov + dg * ia + 255) >> 8) << 8) | ((cb * cov + db * ia + 255) >> 8))
                  }
                }
              }
            }
            c16 = c16 + 1
          }
        }
      }
    }
    r16 = r16 + 1
  }
  return
}

// Draw an anti-aliased character at (x, y) using the active UI typeface.
fn fb-draw-char-aa(x: Int, y: Int, ch: Int, color: Int) -> void {
  if fb-ready == 0 {
    return
  }
  let face = text-role-face(TEXT-ROLE-UI-BODY)
  if comp-stress != 0 && desktop-fonts-active == 0 {
    text-draw-char-face(face, x, y, ch, color)
    return
  }
  if fb-font-scale == 3 && text-is-supported-cp(ch) != 0 {
    if face == FONT-FACE-SANS { desktop-font-draw24(desktop-font-sans24, x, y, ch, color); return }
    if face == FONT-FACE-MONO { desktop-font-draw24(desktop-font-mono24, x, y, ch, color); return }
  }
  if fb-font-scale == 2 && text-is-supported-cp(ch) != 0 && face != FONT-FACE-TTF {
    let aa16-table = fb-font-aa16
    if face == FONT-FACE-SANS && fb-font-sans-aa16 != 0 {
      aa16-table = fb-font-sans-aa16
    }
    if aa16-table != 0 {
      fb-draw-char-table-aa16(aa16-table, x, y, ch, color)
      return
    }
  }
  text-draw-char-face-aa(face, x, y, ch, color)
  return
}

// Draw an anti-aliased character at (x, y) using Space Term Mono.
fn fb-draw-char-mono-aa(x: Int, y: Int, ch: Int, color: Int) -> void {
  if fb-ready == 0 {
    return
  }
  if comp-stress != 0 && desktop-fonts-active == 0 {
    text-draw-char-face(FONT-FACE-MONO, x, y, ch, color)
    return
  }
  if fb-font-scale == 3 && text-is-supported-cp(ch) != 0 {
    desktop-font-draw24(desktop-font-mono24, x, y, ch, color)
    return
  }
  if fb-font-scale == 2 && text-is-supported-cp(ch) != 0 && fb-font-aa16 != 0 {
    fb-draw-char-table-aa16(fb-font-aa16, x, y, ch, color)
    return
  }
  text-draw-char-face-aa(FONT-FACE-MONO, x, y, ch, color)
  return
}

// Draw a label using anti-aliased UI glyphs (Space UI Sans proportional chrome path).
fn comp-draw-label-aa(x: Int, y: Int, str: Int, fg: Int, bg: Int) -> void {
  let gh = fb-font-scale * 8 + 2
  let ry = y + comp-render-dy
  if ry + gh <= 0 || ry >= fb-height { return }
  if comp-clip-valid != 0 {
    if ry + gh <= comp-clip-y0 || ry >= comp-clip-y1 { return }
    if x + comp-render-dx >= comp-clip-x1 { return }
  }
  let face = text-role-face(TEXT-ROLE-UI-BODY)
  let cx = x
  let i = 0
  while i < 96 {
    if comp-clip-valid != 0 {
      if cx + comp-render-dx >= comp-clip-x1 { return }
    }
    let b0 = load8(str + i) & 0xFF
    if b0 == 0 {
      return
    }
    if b0 < 0x80 {
      let adv = text-glyph-advance-raw(face, b0, fb-font-scale)
      if comp-clip-valid == 0 || cx + adv + comp-render-dx > comp-clip-x0 {
        if comp-stress == 0 || desktop-fonts-active != 0 {
          fb-fill-rect(cx, y, adv, gh, bg)
          fb-draw-char-aa(cx, y, b0, fg)
        } else {
          text-draw-char-face(face, cx, y, b0, fg)
        }
      }
      cx = cx + adv
      i = i + 1
    } else {
      let cp = text-utf8-decode(str, i)
      let adv = text-glyph-advance(face, cp, fb-font-scale)
      if comp-clip-valid == 0 || cx + adv + comp-render-dx > comp-clip-x0 {
        if comp-stress == 0 || desktop-fonts-active != 0 {
          fb-fill-rect(cx, y, adv, gh, bg)
          fb-draw-char-aa(cx, y, cp, fg)
        } else {
          text-draw-char-face(face, cx, y, cp, fg)
        }
      }
      cx = cx + adv
      i = i + text-utf8-bytes
    }
  }
  return
}

// Draw a UI body label using Space UI Sans smooth anti-aliased strokes.
fn comp-draw-ui-label(x: Int, y: Int, str: Int, fg: Int, bg: Int) -> void {
  if fb-font-scale == 2 || fb-font-scale == 3 {
    comp-draw-label-aa(x, y, str, fg, bg)
    return
  }
  let gh = fb-font-scale * 8 + 2
  let ry = y + comp-render-dy
  if ry + gh <= 0 || ry >= fb-height { return }
  if comp-clip-valid != 0 {
    if ry + gh <= comp-clip-y0 || ry >= comp-clip-y1 { return }
    if x + comp-render-dx >= comp-clip-x1 { return }
  }
  let face = text-role-face(TEXT-ROLE-UI-BODY)
  let cx = x
  let i = 0
  while i < 96 {
    if comp-clip-valid != 0 {
      if cx + comp-render-dx >= comp-clip-x1 { return }
    }
    let b0 = load8(str + i) & 0xFF
    if b0 == 0 {
      return
    }
    if b0 < 0x80 {
      let adv = text-glyph-advance-raw(face, b0, fb-font-scale)
      fb-fill-rect(cx, y, adv, gh, bg)
      text-draw-char-face(face, cx, y, b0, fg)
      cx = cx + adv
      i = i + 1
    } else {
      let cp = text-utf8-decode(str, i)
      let adv = text-glyph-advance(face, cp, fb-font-scale)
      fb-fill-rect(cx, y, adv, gh, bg)
      text-draw-char-face(face, cx, y, cp, fg)
      cx = cx + adv
      i = i + text-utf8-bytes
    }
  }
  return
}

// Draw a terminal/monospace label using Space Term Mono fixed-cell metrics.
fn comp-draw-label(x: Int, y: Int, str: Int, fg: Int, bg: Int) -> void {
  let gh = fb-font-scale * 8 + 2
  let ry = y + comp-render-dy
  if ry + gh <= 0 || ry >= fb-height { return }
  if comp-clip-valid != 0 {
    if ry + gh <= comp-clip-y0 || ry >= comp-clip-y1 { return }
    if x + comp-render-dx >= comp-clip-x1 { return }
  }
  let cw = text-term-cell-w()
  let cx = x
  let i = 0
  while i < 96 {
    if comp-clip-valid != 0 {
      if cx + comp-render-dx >= comp-clip-x1 { return }
    }
    let b0 = load8(str + i) & 0xFF
    if b0 == 0 {
      return
    }
    if b0 < 0x80 {
      if comp-clip-valid == 0 || cx + cw + comp-render-dx > comp-clip-x0 {
        if comp-stress == 0 || desktop-fonts-active != 0 {
          fb-fill-rect(cx, y, cw, gh, bg)
          if fb-font-scale == 2 || fb-font-scale == 3 {
            fb-draw-char-mono-aa(cx + 1, y, b0, fg)
          } else {
            text-draw-char-face(FONT-FACE-MONO, cx, y, b0, fg)
          }
        } else if fb-font-scale == 2 {
          fb-draw-char(cx, y, b0, fg)
        } else {
          text-draw-char-face(FONT-FACE-MONO, cx, y, b0, fg)
        }
      }
      cx = cx + cw
      i = i + 1
    } else {
      let cp = text-utf8-decode(str, i)
      if comp-clip-valid == 0 || cx + cw + comp-render-dx > comp-clip-x0 {
        if comp-stress == 0 || desktop-fonts-active != 0 {
          fb-fill-rect(cx, y, cw, gh, bg)
          if fb-font-scale == 2 || fb-font-scale == 3 {
            fb-draw-char-mono-aa(cx, y, cp, fg)
          } else {
            text-draw-char-face(FONT-FACE-MONO, cx, y, cp, fg)
          }
        } else {
          text-draw-char-face(FONT-FACE-MONO, cx, y, cp, fg)
        }
      }
      cx = cx + cw
      i = i + text-utf8-bytes
    }
  }
  return
}

// Draw a decimal integer using Space UI Sans proportional anti-aliased digits.
fn comp-draw-dec-aa(x: Int, y: Int, value: Int, fg: Int, bg: Int) -> Int {
  let face = text-role-face(TEXT-ROLE-UI-BODY)
  let gh = fb-font-scale * 8 + 2
  let ry = y + comp-render-dy
  let n = value
  let cx = x
  if n == 0 {
    let adv0 = text-glyph-advance-raw(face, 48, fb-font-scale)
    if ry + gh > 0 && ry < fb-height {
      fb-fill-rect(cx, y, adv0, gh, bg)
      fb-draw-char-aa(cx, y, 48, fg)
    }
    return cx + adv0
  }
  let div = 1
  while n / div >= 10 {
    div = div * 10
  }
  while div > 0 {
    let q = n / div
    let digit = q - (q / 10) * 10
    let adv = text-glyph-advance-raw(face, 48 + digit, fb-font-scale)
    if ry + gh > 0 && ry < fb-height {
      fb-fill-rect(cx, y, adv, gh, bg)
      fb-draw-char-aa(cx, y, 48 + digit, fg)
    }
    cx = cx + adv
    div = div / 10
  }
  return cx
}

fn comp-draw-dec(x: Int, y: Int, value: Int, fg: Int, bg: Int) -> Int {
  let cw = text-term-cell-w()
  let gh = fb-font-scale * 8 + 2
  let ry = y + comp-render-dy
  let n = value
  let cx = x
  if n == 0 {
    if ry + gh > 0 && ry < fb-height {
      fb-fill-rect(cx, y, cw, gh, bg)
      if fb-font-scale == 2 {
        fb-draw-char-mono-aa(cx, y, 48, fg)
      } else {
        text-draw-char-face(FONT-FACE-MONO, cx, y, 48, fg)
      }
    }
    return cx + cw
  }
  let div = 1
  while n / div >= 10 {
    div = div * 10
  }
  while div > 0 {
    let q = n / div
    let digit = q - (q / 10) * 10
    if ry + gh > 0 && ry < fb-height {
      fb-fill-rect(cx, y, cw, gh, bg)
      if fb-font-scale == 2 {
        fb-draw-char-mono-aa(cx, y, 48 + digit, fg)
      } else {
        text-draw-char-face(FONT-FACE-MONO, cx, y, 48 + digit, fg)
      }
    }
    cx = cx + cw
    div = div / 10
  }
  return cx
}

// Helper: draw content text (or default placeholder for empty windows)
fn comp-draw-content-text(base: Int) -> void {
  let x = load32(base + 4)
  let y = load32(base + 8)
  let w = load32(base + 12)
  let h = load32(base + 16)
  let content-y = y + COMP-TITLE-BAR-H
  let content = load64(base + 32)
  let title = load64(base + 24)
  let cw = fb-font-scale * 8 + 2
  let lh = cw + 3
  if content == 0 {
    if title != 0 {
      comp-draw-label(x + 16, content-y + lh + 4, title, COMP-COLOR-TEXT, COMP-COLOR-WINDOW)
    }
    comp-draw-label(x + 16, content-y + lh * 2 + 8, "This window has no content", COMP-COLOR-MUTED, COMP-COLOR-WINDOW)
    comp-draw-label(x + 16, content-y + lh * 3 + 12, "Load a file or close this window", COMP-COLOR-MUTED, COMP-COLOR-WINDOW)
    return
  }
  comp-draw-label(x + 12, content-y + 12, content, COMP-COLOR-TEXT, COMP-COLOR-WINDOW)
  return
}

// Draw a window's frame (border + title bar + buttons + content) into the
// current fb-addr surface, honoring the active render offset and clip. Used
// for both the opaque direct path and the per-window alpha surface path.
fn comp-render-window-frame(base: Int) -> void {
  let wx = load32(base + 4)
  let wy = load32(base + 8)
  let ww = load32(base + 12)
  let wh = load32(base + 16)
  let wtitle = load64(base + 24)
  let wflags = load32(base + 20)
  let wfh = wh + COMP-TITLE-BAR-H
  fb-fill-rect(wx, wy, ww, COMP-BORDER-W, COMP-COLOR-BORDER)
  fb-fill-rect(wx, wy + wfh - COMP-BORDER-W, ww, COMP-BORDER-W, COMP-COLOR-BORDER)
  fb-fill-rect(wx, wy + COMP-BORDER-W, COMP-BORDER-W, wfh - COMP-BORDER-W * 2, COMP-COLOR-BORDER)
  fb-fill-rect(wx + ww - COMP-BORDER-W, wy + COMP-BORDER-W, COMP-BORDER-W, wfh - COMP-BORDER-W * 2, COMP-COLOR-BORDER)
  if (wflags & COMP-WIN-FOCUSED) != 0 {
    fb-fill-rect(wx + COMP-BORDER-W, wy + COMP-BORDER-W, ww - COMP-BORDER-W * 2, COMP-TITLE-BAR-H, COMP-COLOR-TITLE-ACTIVE)
    // 2px gold focus indicator bar along top of active titlebar
    fb-fill-rect(wx + COMP-BORDER-W, wy + COMP-BORDER-W, ww - COMP-BORDER-W * 2, 2, COMP-COLOR-ACCENT)
    if wtitle != 0 {
      comp-draw-label-aa(wx + 12, wy + COMP-BORDER-W + (COMP-TITLE-BAR-H - 18) / 2, wtitle, FB-COLOR-WHITE, COMP-COLOR-TITLE-ACTIVE)
    }
  } else {
    fb-fill-rect(wx + COMP-BORDER-W, wy + COMP-BORDER-W, ww - COMP-BORDER-W * 2, COMP-TITLE-BAR-H, COMP-COLOR-TITLE)
    if wtitle != 0 {
      comp-draw-label-aa(wx + 12, wy + COMP-BORDER-W + (COMP-TITLE-BAR-H - 18) / 2, wtitle, COMP-COLOR-MUTED, COMP-COLOR-TITLE)
    }
  }
  let wmin-x = wx + ww - 52
  let wbtn-y = wy + COMP-BORDER-W + 5
  let wbtn-h = COMP-TITLE-BAR-H - 10
  fb-fill-rect(wmin-x, wbtn-y, 22, wbtn-h, COMP-COLOR-BORDER)
  let wmin-bar-y = wbtn-y + wbtn-h / 2
  let wmi = 0
  while wmi < 14 {
    fb-put-pixel(wmin-x + 4 + wmi, wmin-bar-y, FB-COLOR-WHITE)
    wmi = wmi + 1
  }
  let wbtn-x = wx + ww - 28
  fb-fill-rect(wbtn-x, wbtn-y, 22, wbtn-h, 0x006B3039)
  let wcx = wbtn-x + 11
  let wcy = wbtn-y + wbtn-h / 2
  let wxi = -3
  while wxi <= 3 {
    fb-put-pixel(wcx + wxi, wcy + wxi, FB-COLOR-WHITE)
    fb-put-pixel(wcx + wxi, wcy - wxi, FB-COLOR-WHITE)
    wxi = wxi + 1
  }

  let role = load64(base + 40)
  if role == COMP-ROLE-UTILITIES {
    comp-draw-utilities-content(base)
  } else if role == COMP-ROLE-TERMINAL {
    comp-draw-terminal-content(base)
  } else {
    comp-draw-content-bg(base)
    comp-draw-content-text(base)
  }

  let grip-x = wx + ww - COMP-BORDER-W - 6
  let grip-y = wy + wfh - COMP-BORDER-W - 6
  let gi = 0
  while gi < 5 {
    let gj = 0
    while gj < 5 {
      if gi + gj >= 4 {
        fb-put-pixel(grip-x + gi, grip-y + gj, COMP-COLOR-ACCENT)
      }
      gj = gj + 1
    }
    gi = gi + 1
  }
  return
}

// Composite a window's alpha surface over the backbuffer at its position,
// clipped to the active clip rect. dst = (src*a + dst*(255-a)) / 255.
fn comp-composite-alpha(base: Int) -> void {
  let wx = load32(base + 4)
  let wy = load32(base + 8)
  let ww = load32(base + 12)
  let wh = load32(base + 16)
  let alpha = load8(base + 48)
  let surf = load64(base + 56)
  if surf == 0 {
    return
  }
  let fh = wh + COMP-TITLE-BAR-H
  let x0 = wx
  if x0 < 0 { x0 = 0 }
  let y0 = wy
  if y0 < 0 { y0 = 0 }
  let x1 = wx + ww
  if x1 > fb-width { x1 = fb-width }
  let y1 = wy + fh
  if y1 > fb-height { y1 = fb-height }
  if comp-clip-valid != 0 {
    if x0 < comp-clip-x0 { x0 = comp-clip-x0 }
    if y0 < comp-clip-y0 { y0 = comp-clip-y0 }
    if x1 > comp-clip-x1 { x1 = comp-clip-x1 }
    if y1 > comp-clip-y1 { y1 = comp-clip-y1 }
  }
  if x0 >= x1 || y0 >= y1 {
    return
  }
  let surf-pitch = ww * 4
  let ia = 255 - alpha
  let py = y0
  while py < y1 {
    let sy = py - wy
    let row-src = surf + sy * surf-pitch + (x0 - wx) * 4
    let row-dst = fb-addr + py * fb-pitch + x0 * 4
    let px = x0
    let off = 0
    while px < x1 {
      let s = load32(row-src + off)
      let d = load32(row-dst + off)
      let srb = s & 0x00FF00FF
      let sg = s & 0x0000FF00
      let drb = d & 0x00FF00FF
      let dg = d & 0x0000FF00
      let nrb = ((srb * alpha + drb * ia + 0x00FF00FF) >> 8) & 0x00FF00FF
      let ng = ((sg * alpha + dg * ia + 0x0000FF00) >> 8) & 0x0000FF00
      store32(row-dst + off, nrb | ng)
      off = off + 4
      px = px + 1
    }
    py = py + 1
  }
  return
}

// Draw a single window (border + title bar + content). Opaque windows render
// straight into the current surface; translucent windows render into a
// per-window surface when dirty, then blend over the composed background.
fn comp-render-window(idx: Int) -> void {
  let base = comp-win-base(idx)
  let flags = load32(base + 20)
  if (flags & COMP-WIN-VISIBLE) == 0 || (flags & COMP-WIN-MINIMIZED) != 0 {
    return
  }
  let alpha = load8(base + 48)
  if alpha >= 255 {
    comp-render-window-frame(base)
    let flags2 = load32(base + 20)
    store32(base + 20, flags2 & -5)
    return
  }

  let ww = load32(base + 12)
  let wh = load32(base + 16)
  let fh = wh + COMP-TITLE-BAR-H
  let needed = ww * fh * 4
  let surf = load64(base + 56)
  let have = load32(base + 52)
  let need-render = 0
  if (flags & COMP-WIN-DIRTY) != 0 {
    need-render = 1
  }
  if surf == 0 || have < needed {
    surf = alloc(needed)
    store64(base + 56, surf)
    store32(base + 52, needed)
    need-render = 1
  }
  if surf == 0 {
    return
  }
  if need-render != 0 {
    let saved-addr = fb-addr
    let saved-pitch = fb-pitch
    fb-addr = surf
    fb-pitch = ww * 4
    comp-render-dx = 0 - load32(base + 4)
    comp-render-dy = 0 - load32(base + 8)
    comp-clip-set(0, 0, ww, fh)
    comp-render-window-frame(base)
    comp-clip-clear()
    comp-render-dx = 0
    comp-render-dy = 0
    fb-addr = saved-addr
    fb-pitch = saved-pitch
  }

  comp-clip-set(comp-dmg-x0, comp-dmg-y0, comp-dmg-x1, comp-dmg-y1)
  comp-composite-alpha(base)

  // Clear dirty flag
  let flags2 = load32(base + 20)
  store32(base + 20, flags2 & -5)
  return
}

var comp-bg-drawn: Int = 0  // 1 after first background render
var comp-prev-cx: Int = 0   // previous cursor x for restoration
var comp-prev-cy: Int = 0   // previous cursor y
var comp-cur-back: Int = 0  // 24x24 pixel save buffer for cursor restore
var comp-cur-drawn: Int = 0 // 1 if cursor was drawn last frame
var comp-full-redraw: Int = 0 // 1 to force full redraw (window moved)
var comp-bench: Int = 0    // 1 when frame benchmark is active (serial '`' toggles)
var comp-bench-frames: Int = 0 // frames counted while bench active
var comp-bench-last-report: Int = 0 // last reported frame count
var comp-stress: Int = 0   // 1 when auto window-animation stress is active ('~')
var comp-stress-dx: Int = 3 // per-frame window move delta x
var comp-stress-dy: Int = 2 // per-frame window move delta y

// Move the focused window a fixed delta each frame, bouncing within the
// screen. Generates continuous old+new damage so the compositor is exercised
// by a moving-window workload.
fn comp-stress-step() -> void {
  if comp-count <= 0 {
    return
  }
  let idx = 0
  if comp-focused >= 0 && comp-focused < comp-count {
    idx = comp-focused
  }
  let base = comp-win-base(idx)
  let x = load32(base + 4)
  let y = load32(base + 8)
  let w = load32(base + 12)
  let wh = load32(base + 16)
  let dx = comp-stress-dx
  let dy = comp-stress-dy
  let nx = x + dx
  let ny = y + dy
  if nx + w > fb-width || nx < 0 {
    comp-stress-dx = 0 - dx
    nx = x + comp-stress-dx
  }
  let fy = wh + COMP-TITLE-BAR-H
  if ny + fy > fb-height - COMP-TASKBAR-H || ny < COMP-TASKBAR-H {
    comp-stress-dy = 0 - dy
    ny = y + comp-stress-dy
  }
  comp-dmg-add(x, y, x + w, y + fy)
  store32(base + 4, nx)
  store32(base + 8, ny)
  comp-dmg-add(nx, ny, nx + w, ny + fy)
  return
}

// Save pixels behind cursor before drawing.
fn comp-cur-save() -> void {
  if comp-cur-back == 0 {
    comp-cur-back = alloc(24 * 24 * 4)
  }
  let x = mouse-x - 2
  let y = mouse-y - 2
  let j = 0
  while j < 24 {
    let py = y + j
    let i = 0
    while i < 24 {
      let px = x + i
      let pix = COMP-COLOR-DESKTOP
      if px >= 0 && px < fb-width && py >= 0 && py < fb-height {
        pix = load32(fb-addr + py * fb-pitch + px * 4)
      }
      store32(comp-cur-back + j * 24 * 4 + i * 4, pix)
      i = i + 1
    }
    j = j + 1
  }
  comp-prev-cx = x
  comp-prev-cy = y
  return
}

// Restore pixels behind old cursor (erases cursor cleanly).
fn comp-cur-restore() -> void {
  if comp-cur-drawn == 0 || comp-cur-back == 0 {
    return
  }
  let x = comp-prev-cx
  let y = comp-prev-cy
  let j = 0
  while j < 24 {
    let py = y + j
    if py >= 0 && py < fb-height {
      let i = 0
      while i < 24 {
        let px = x + i
        if px >= 0 && px < fb-width {
          let pix = load32(comp-cur-back + j * 24 * 4 + i * 4)
          store32(fb-addr + py * fb-pitch + px * 4, pix)
        }
        i = i + 1
      }
    }
    j = j + 1
  }
  return
}

// Restore pixels behind the old cursor, skipping any area that was just
// recomposed (dx0,dy0)-(dx1,dy1): that region was already overwritten by the
// damage blit with fresh composition, so writing the stale saved pixels back
// would corrupt it.
fn comp-cur-restore-except(dx0: Int, dy0: Int, dx1: Int, dy1: Int) -> void {
  if comp-cur-drawn == 0 || comp-cur-back == 0 {
    return
  }
  let x = comp-prev-cx
  let y = comp-prev-cy
  let j = 0
  while j < 24 {
    let py = y + j
    if py >= 0 && py < fb-height {
      let i = 0
      while i < 24 {
        let px = x + i
        if px >= 0 && px < fb-width {
          if px >= dx0 && px < dx1 && py >= dy0 && py < dy1 {
            i = i + 1
          } else {
            let pix = load32(comp-cur-back + j * 24 * 4 + i * 4)
            store32(fb-addr + py * fb-pitch + px * 4, pix)
            i = i + 1
          }
        } else {
          i = i + 1
        }
      }
    }
    j = j + 1
  }
  return
}

fn comp-rect-intersects(ax0: Int, ay0: Int, ax1: Int, ay1: Int, bx0: Int, by0: Int, bx1: Int, by1: Int) -> Int {
  if ax0 < bx1 && ax1 > bx0 && ay0 < by1 && ay1 > by0 {
    return 1
  }
  return 0
}

// Blit the damage region of the backbuffer to the real framebuffer.
fn comp-blit-region(dst: Int, x0: Int, y0: Int, x1: Int, y1: Int) -> void {
  let src = comp-backbuf
  let n = (x1 - x0) * 4
  let qwords = n >> 3
  let bytes8 = qwords * 8
  let py = y0
  while py < y1 {
    let row-off = py * fb-pitch + x0 * 4
    let sptr = src + row-off
    let dptr = dst + row-off
    if qwords > 0 {
      cpu-mem-copy64(dptr, sptr, qwords)
    }
    let send = sptr + n
    sptr = sptr + bytes8
    dptr = dptr + bytes8
    while sptr < send {
      store8(dptr, load8(sptr))
      sptr = sptr + 1
      dptr = dptr + 1
    }
    py = py + 1
  }
  return
}

// Update the cursor after a damage blit. The cursor lives on the real
// framebuffer only (never the backbuffer), so a recompose+blit may have wiped
// it. Re-save behind the cursor and redraw wherever the old cursor overlapped
// the recomposed region or the pointer moved.
fn comp-cursor-after-damage() -> void {
  let cur-x = mouse-x - 2
  let cur-y = mouse-y - 2
  let moved = cur-x != comp-prev-cx || cur-y != comp-prev-cy
  let wiped = comp-rect-intersects(comp-prev-cx, comp-prev-cy, comp-prev-cx + 24, comp-prev-cy + 24, comp-dmg-x0, comp-dmg-y0, comp-dmg-x1, comp-dmg-y1)
  if comp-cur-drawn != 0 {
    if wiped == 0 {
      // Old cursor still visible on the real fb: erase the untouched parts.
      comp-cur-restore-except(comp-dmg-x0, comp-dmg-y0, comp-dmg-x1, comp-dmg-y1)
    }
  }
  comp-cur-save()
  comp-render-cursor()
  comp-cur-drawn = 1
  return
}

// Fill the desktop background within the pending damage rect, skipping any
// interior region completely covered by the first intersecting opaque window.
fn comp-fill-bg-damage() -> void {
  let dx0 = comp-dmg-x0
  let dy0 = comp-dmg-y0
  let dx1 = comp-dmg-x1
  let dy1 = comp-dmg-y1
  let i = 0
  while i < comp-count {
    let base = comp-win-base(i)
    let flags = load32(base + 20)
    if (flags & COMP-WIN-VISIBLE) != 0 && (flags & COMP-WIN-MINIMIZED) == 0 && load8(base + 48) >= 255 {
      if comp-win-intersects(i, dx0, dy0, dx1, dy1) != 0 {
        let wx0 = load32(base + 4)
        let wy0 = load32(base + 8)
        let wx1 = wx0 + load32(base + 12)
        let wy1 = wy0 + load32(base + 16) + COMP-TITLE-BAR-H
        let ox0 = dx0
        if wx0 > ox0 { ox0 = wx0 }
        let oy0 = dy0
        if wy0 > oy0 { oy0 = wy0 }
        let ox1 = dx1
        if wx1 < ox1 { ox1 = wx1 }
        let oy1 = dy1
        if wy1 < oy1 { oy1 = wy1 }
        if oy0 > dy0 {
          fb-fill-rect(dx0, dy0, dx1 - dx0, oy0 - dy0, COMP-COLOR-DESKTOP)
        }
        if oy1 < dy1 {
          fb-fill-rect(dx0, oy1, dx1 - dx0, dy1 - oy1, COMP-COLOR-DESKTOP)
        }
        if ox0 > dx0 && oy1 > oy0 {
          fb-fill-rect(dx0, oy0, ox0 - dx0, oy1 - oy0, COMP-COLOR-DESKTOP)
        }
        if ox1 < dx1 && oy1 > oy0 {
          fb-fill-rect(ox1, oy0, dx1 - ox1, oy1 - oy0, COMP-COLOR-DESKTOP)
        }
        return
      }
    }
    i = i + 1
  }
  fb-fill-rect(dx0, dy0, dx1 - dx0, dy1 - dy0, COMP-COLOR-DESKTOP)
  return
}

// Render the desktop: recompose only the pending damage rect into the
// backbuffer and blit just that region, then reconcile the cursor on the real
// framebuffer. With no damage, only the cursor is refreshed.
fn comp-render() -> void {
  if comp-full-redraw != 0 || comp-bg-drawn == 0 {
    comp-dmg-full()
    comp-bg-drawn = 1
    comp-full-redraw = 0
  }

  if comp-dmg-valid != 0 {
    let saved-addr = fb-addr
    if comp-backbuf != 0 {
      fb-addr = comp-backbuf
    }
    comp-render-dx = 0
    comp-render-dy = 0
    comp-clip-set(comp-dmg-x0, comp-dmg-y0, comp-dmg-x1, comp-dmg-y1)

    // Background within damage only (skipping opaque window interior).
    comp-fill-bg-damage()

    // Recompose windows intersecting the damage rect, bottom-up.
    let i = 0
    while i < comp-count {
      if comp-win-intersects(i, comp-dmg-x0, comp-dmg-y0, comp-dmg-x1, comp-dmg-y1) != 0 {
        comp-render-window(i)
      }
      i = i + 1
    }

    // Top/task bars when the damage touches them.
    if comp-dmg-y0 < COMP-TASKBAR-H {
      comp-render-topbar()
    }
    if comp-dmg-y1 > fb-height - COMP-TASKBAR-H {
      comp-render-taskbar()
    }

    // The switcher is above client windows and uses the same damage clip.
    if comp-launcher-open != 0 {
      comp-render-launcher()
    }
    comp-clip-clear()

    // Blit only the damaged region.
    if comp-backbuf != 0 {
      comp-blit-region(saved-addr, comp-dmg-x0, comp-dmg-y0, comp-dmg-x1, comp-dmg-y1)
      fb-addr = saved-addr
    }

    comp-cursor-after-damage()
    comp-dmg-clear()
    return
  }

  if comp-cur-drawn != 0 {
    // No changes: just update cursor on real framebuffer
    comp-cur-restore()
    comp-cur-save()
    comp-render-cursor()
  } else {
    comp-cur-save()
    comp-render-cursor()
    comp-cur-drawn = 1
  }
  return
}

// Taskbar geometry follows the scaled glyph width, with room for twelve
// characters. Long titles are bounded to their own button.
fn comp-taskbar-btn-width() -> Int {
  return 12 * (fb-font-scale * 8 + 2) + 8
}

fn comp-taskbar-label(x: Int, y: Int, title: Int, fg: Int) -> void {
  comp-draw-label-aa(x, y, title, fg, COMP-COLOR-PANEL-LINE)
  return
}

// Taskbar window-button geometry: button index -> x offset from the start.
fn comp-taskbar-btn-x(idx: Int) -> Int {
  return fb-width / 2 - 80 + idx * comp-taskbar-btn-width()
}

// Number of window buttons that fit before the right-side activity dot.
fn comp-taskbar-max-btns() -> Int {
  let dot-edge = fb-width - 44
  let avail = dot-edge - (fb-width / 2 - 80)
  if avail <= 0 {
    return 0
  }
  let capacity = avail / comp-taskbar-btn-width()
  if comp-count > capacity && capacity > 0 { return capacity - 1 }
  return capacity
}

// Draw the taskbar at the bottom of the screen, with window buttons that
// clamp to the available width (overflow windows just don't get a button).
fn comp-render-taskbar() -> void {
  let bar-y = fb-height - COMP-TASKBAR-H
  fb-fill-rect(0, bar-y, fb-width, COMP-TASKBAR-H, COMP-COLOR-PANEL)
  let tx2 = 0
  while tx2 < fb-width {
    fb-put-pixel(tx2, bar-y, COMP-COLOR-PANEL-LINE)
    tx2 = tx2 + 1
  }
  let max-btns = comp-taskbar-max-btns()
  let i2 = 0
  while i2 < comp-count && i2 < max-btns {
    let base = comp-win-base(i2)
    let title = load64(base + 24)
    if title != 0 {
      let btn-x = comp-taskbar-btn-x(i2)
      let btn-w = comp-taskbar-btn-width() - 4
      let focused = 0
      if i2 == comp-focused {
        focused = 1
      }
      let btn-bg = COMP-COLOR-PANEL-LINE
      let btn-fg = COMP-COLOR-MUTED
      if focused != 0 {
        btn-bg = 0x00333336
        btn-fg = FB-COLOR-WHITE
      }
      fb-fill-rect(btn-x, bar-y + 2, btn-w, COMP-TASKBAR-H - 4, btn-bg)
      comp-draw-label-aa(btn-x + 10, bar-y + 5, title, btn-fg, btn-bg)
      if focused != 0 {
        fb-fill-rect(btn-x + 6, bar-y + COMP-TASKBAR-H - 4, btn-w - 12, 2, COMP-COLOR-ACCENT)
      }
    }
    i2 = i2 + 1
  }
  if comp-count > max-btns {
    let ox = comp-taskbar-btn-x(max-btns)
    fb-fill-rect(ox, bar-y + 2, comp-taskbar-btn-width() - 4, COMP-TASKBAR-H - 4, COMP-COLOR-PANEL-LINE)
    let oi = 0
    while oi < 3 {
      fb-fill-rect(ox + 8 + oi * 10, bar-y + COMP-TASKBAR-H / 2 - 2, 4, 4, FB-COLOR-WHITE)
      oi = oi + 1
    }
  }
  comp-render-taskbar-dot()
  return
}

fn comp-render-launcher() -> void {
  let x = fb-width / 2 - 360
  let y = COMP-TASKBAR-H + 16
  fb-fill-rect(x, y, 720, 224, COMP-COLOR-BORDER)
  fb-fill-rect(x + 1, y + 1, 718, 222, COMP-COLOR-PANEL)
  // 2px gold top accent bar on command modal
  fb-fill-rect(x + 1, y + 1, 718, 2, COMP-COLOR-ACCENT)
  comp-draw-label-aa(x + 20, y + 14, "SPACE COMMANDS", FB-COLOR-WHITE, COMP-COLOR-PANEL)
  comp-draw-label-aa(x + 540, y + 14, "NIRI / RAYCAST", COMP-COLOR-MUTED, COMP-COLOR-PANEL)
  // Search input outline box
  fb-fill-rect(x + 16, y + 38, 688, 1, COMP-COLOR-PANEL-LINE)
  fb-fill-rect(x + 16, y + 66, 688, 1, COMP-COLOR-PANEL-LINE)
  comp-draw-label-aa(x + 20, y + 44, ">", COMP-COLOR-ACCENT, COMP-COLOR-PANEL)
  if load8(comp-launcher-query) == 0 {
    comp-draw-label-aa(x + 50, y + 44, "TYPE TO FILTER ACTIONS...", COMP-COLOR-MUTED, COMP-COLOR-PANEL)
  } else {
    comp-draw-label-aa(x + 50, y + 44, comp-launcher-query, FB-COLOR-WHITE, COMP-COLOR-PANEL)
  }
  let first = comp-launcher-at(comp-launcher-selected)
  if first < 0 {
    comp-draw-label-aa(x + 20, y + 88, "NO MATCHING RESULTS", COMP-COLOR-MUTED, COMP-COLOR-PANEL)
  } else {
    let row = 0
    while row < 4 {
      let candidate = comp-launcher-at(row)
      if candidate >= 0 {
        let ry = y + 80 + row * 28
        if row == comp-launcher-selected {
          fb-fill-rect(x + 20, ry + 1, 4, 16, COMP-COLOR-ACCENT)
          comp-draw-label-aa(x + 30, ry, comp-bar-title(candidate), COMP-COLOR-ACCENT, COMP-COLOR-PANEL)
          comp-draw-label-aa(x + 632, ry, "ENTER", COMP-COLOR-MUTED, COMP-COLOR-PANEL)
        } else {
          comp-draw-label-aa(x + 30, ry, comp-bar-title(candidate), COMP-COLOR-MUTED, COMP-COLOR-PANEL)
        }
      }
      row = row + 1
    }
  }
  fb-fill-rect(x + 16, y + 193, 688, 1, COMP-COLOR-PANEL-LINE)
  comp-draw-label-aa(x + 20, y + 198, "CTRL-N/P NAVIGATE   ENTER RUN   ESC DISMISS", COMP-COLOR-MUTED, COMP-COLOR-PANEL)
  return
}

fn comp-render-topbar() -> void {
  fb-fill-rect(0, 0, fb-width, COMP-TASKBAR-H, COMP-COLOR-PANEL)
  fb-fill-rect(0, COMP-TASKBAR-H - 1, fb-width, 1, COMP-COLOR-PANEL-LINE)
  let ty = (COMP-TASKBAR-H - fb-font-scale * 8) / 2
  comp-draw-label-aa(12, ty, "SPACE OS", FB-COLOR-WHITE, COMP-COLOR-PANEL)
  fb-fill-rect(220, 3, 340, COMP-TASKBAR-H - 6, COMP-COLOR-TITLE)
  comp-draw-label-aa(232, ty, "TAB  COMMANDS", COMP-COLOR-MUTED, COMP-COLOR-TITLE)
  if comp-focused >= 0 && comp-focused < comp-count {
    let title = load64(comp-win-base(comp-focused) + 24)
    if title != 0 {
      let title-x = fb-width / 2 - 120
      if title-x < 572 { title-x = 572 }
      comp-draw-label-aa(title-x, ty, title, COMP-COLOR-ACCENT, COMP-COLOR-PANEL)
    }
  }
  let count = 0
  let i = 0
  while i < comp-count {
    if load64(comp-win-base(i) + 24) != 0 { count = count + 1 }
    i = i + 1
  }
  comp-draw-label-aa(fb-width - 210, ty, "WINDOWS", COMP-COLOR-MUTED, COMP-COLOR-PANEL)
  comp-draw-dec-aa(fb-width - 96, ty, count, COMP-COLOR-ACCENT, COMP-COLOR-PANEL)
  return
}


// --- compositor main loop ---------------------------------------------------

// Create the default desktop windows (shared by interactive and bench runs).
// Translucency is enabled on the UTILITIES window only for the interactive
// path so the moving-window bench measures the renderer (opaque damage-rect),
// not the alpha blend cost.
fn comp-create-default-windows(translucent-util: Int) -> void {
  let wi = 0
  while wi < COMP-MAX-WINDOWS {
    comp-win-clear(wi)
    store32(comp-surf-sizes + wi * 4, 0)
    wi = wi + 1
  }
  comp-count = 0
  comp-focused = -1
  comp-dragging = -1
  comp-drag-mode = -1
  let top-y = COMP-TASKBAR-H + 20
  let usable-h = fb-height - COMP-TASKBAR-H * 2 - 40 - 8
  let left-w = (fb-width - 64) / 2
  let right-w = fb-width - 64 - left-w
  let right-h = (usable-h - 16) / 2

  let win-term0 = comp-win-create("TERMINAL 1", 32, top-y, left-w, usable-h)
  comp-win-set-role(win-term0, COMP-ROLE-TERMINAL)
  comp-win-set-content(win-term0, 0)

  let win-util = comp-win-create("UTILITIES", 48 + left-w + 16, top-y, right-w, right-h)
  comp-win-set-role(win-util, COMP-ROLE-UTILITIES)
  if translucent-util != 0 {
    comp-win-set-alpha(win-util, 232)
  }

  let win-term1 = comp-win-create("TERMINAL 2", 48 + left-w + 16, top-y + right-h + 16, right-w, right-h)
  comp-win-set-role(win-term1, COMP-ROLE-TERMINAL)
  comp-win-set-content(win-term1, 1)
  comp-win-focus(win-term0)
  return
}

// Run the compositor. This is a blocking loop that renders the desktop and
// handles input until the user presses Escape. The serial console is still
// available for debugging, but the main interaction is via the framebuffer.
fn comp-run(port: Int) -> void {
  if fb-ready == 0 {
    serial-write-cstr(port, "  compositor: framebuffer not ready")
    serial-nl(port)
    return
  }
  serial-write-cstr(port, "space: compositor running (press ESC to exit)")
  serial-nl(port)

  comp-bg-drawn = 0  // force initial background render
  comp-create-default-windows(1)

  comp-running = 1
  let prev-left = 0
  comp-render()
  serial-write-cstr(port, "space: compositor frame ready")
  serial-nl(port)

  // Main compositor loop
  while comp-running != 0 {
    if usb-kbd-ready() != 0 {
      let key = usb-kbd-getchar()
      if key >= 0 {
        if comp-handle-key(port, key) != 0 {
          comp-running = 0
        }
      }
    }
    let pkey = ps2-kbd-getchar()
    if pkey >= 0 {
      if comp-handle-key(port, pkey) != 0 {
        comp-running = 0
      }
    }
    if serial-has-byte(com1()) != 0 {
      let key = inb(com1())
      if key == 96 {
        // '`' toggles the frame benchmark; prints total frames when stopped.
        if comp-bench == 0 {
          comp-bench = 1
          comp-bench-frames = 0
          comp-bench-last-report = 0
          serial-write-cstr(port, "space: frame bench on")
          serial-nl(port)
        } else {
          comp-bench = 0
          serial-write-cstr(port, "space: frame bench total ")
          serial-write-dec-wide(port, comp-bench-frames)
          serial-nl(port)
        }
      } else if key == 126 {
        // '~' toggles the auto window-animation stress (bench should be on).
        if comp-stress == 0 {
          comp-stress = 1
          comp-stress-dx = 3
          comp-stress-dy = 2
          serial-write-cstr(port, "space: stress on")
          serial-nl(port)
        } else {
          comp-stress = 0
          serial-write-cstr(port, "space: stress off")
          serial-nl(port)
        }
      } else if comp-handle-key(port, key) != 0 {
        comp-running = 0
      }
    }

    // Poll mouse
    mouse-poll()

    // Handle dragging
    let cur-left = mouse-left-pressed()
    if cur-left != 0 && prev-left == 0 {
      // Mouse just pressed — check for window click
      comp-handle-click(mouse-x, mouse-y)
    }
    if cur-left != 0 && comp-drag-mode >= 0 {
      // Mouse held and dragging
      comp-handle-drag(mouse-x, mouse-y)
    }
    if cur-left == 0 && prev-left != 0 {
      // Mouse released
      comp-drag-mode = -1
    }
    if cur-left != prev-left {
      // Taskbar activity dot reflects the button state.
      let bar-y2 = fb-height - COMP-TASKBAR-H
      comp-dmg-add(fb-width - 30, bar-y2 + 12, fb-width - 20, bar-y2 + 22)
    }
    prev-left = cur-left

    // Deterministic moving-window stress (bench mode).
    if comp-stress != 0 {
      comp-stress-step()
    }

    // Render the desktop
    comp-render()
    if comp-bench != 0 {
      comp-bench-frames = comp-bench-frames + 1
      if comp-bench-frames - comp-bench-last-report >= 50 {
        serial-write-cstr(port, "space: bench frames ")
        serial-write-dec-wide(port, comp-bench-frames)
        serial-nl(port)
        comp-bench-last-report = comp-bench-frames
      }
    }

    // ponytail: pause briefly to avoid burning CPU. sti+pause yields to QEMU
    // event loop between frames so monitor sendkey commands get processed.
    sti()
    pause()
  }

  serial-write-cstr(port, "space: compositor exited")
  serial-nl(port)
  return
}

var comp-bench-limit: Int = 0 // frames to run for in self-contained bench mode

// Self-contained moving-window benchmark: creates the default windows, enables
// the frame counter and the auto window-animation stress, renders exactly
// comp-bench-limit frames, then returns. The shell command times it via the PIT
// tick counter. Deterministic — no external input required.
fn comp-run-bench(port: Int) -> void {
  if fb-ready == 0 {
    serial-write-cstr(port, "space: bench framebuffer not ready")
    serial-nl(port)
    return
  }
  comp-bg-drawn = 0
  comp-create-default-windows(0)
  comp-bench = 1
  comp-bench-frames = 0
  comp-bench-last-report = 0
  comp-stress = 1
  comp-stress-dx = 3
  comp-stress-dy = 2
  comp-bench-limit = 100
  comp-running = 1
  comp-render()
  while comp-running != 0 {
    comp-stress-step()
    comp-render()
    comp-bench-frames = comp-bench-frames + 1
    if comp-bench-frames >= comp-bench-limit {
      serial-write-cstr(port, "space: bench done ")
      serial-write-dec-wide(port, comp-bench-frames)
      serial-write-cstr(port, " frames")
      serial-nl(port)
      comp-running = 0
    }
    sti()
    pause()
  }
  comp-bench = 0
  comp-stress = 0
  return
}
