package space.kernel

import "file-range-leases.in"

// SparkFS public compatibility API.

fn fs-init() -> void {
  sparkfs-init()
  return
}

fn fs-format() -> Int {
  return sparkfs-format()
}

fn fs-list-volume(path: Int, port: Int) -> void {
  let buf = alloc(3328)
  let n = volume-rpc-list(path, buf, 3328)
  if n < 0 {
    serial-write-cstr(port, "  ls: failed")
    serial-nl(port)
    return
  }
  let i = 0
  while i < n {
    serial-put(port, load8(buf + i))
    i = i + 1
  }
  if n == 0 || load8(buf + n - 1) != 10 {
    serial-nl(port)
  }
  return
}

fn fs-list(port: Int) -> void {
  if volume-ready != 0 {
    fs-list-volume("/", port)
    return
  }
  sparkfs-list("/", port)
  return
}

fn fs-list-path(path: Int, port: Int) -> void {
  if volume-ready != 0 {
    fs-list-volume(path, port)
    return
  }
  sparkfs-list(path, port)
  return
}

fn fs-read-file(name: Int, buf: Int, max: Int) -> Int {
  if volume-ready != 0 {
    return volume-rpc-read-file(name, buf, max)
  }
  return sparkfs-read(name, buf, max)
}

fn fs-write-file(name: Int, buf: Int, size: Int) -> Int {
  if volume-ready != 0 {
    let n = volume-rpc-write-file(name, buf, size)
    if n < 0 {
      return -1
    }
    return 0
  }
  return sparkfs-write(name, buf, size)
}

fn fs-delete(name: Int) -> Int {
  if volume-ready != 0 {
    return volume-rpc-delete(name)
  }
  return sparkfs-delete(name)
}

fn fs-mkdir(path: Int) -> Int {
  if volume-ready != 0 {
    return volume-rpc-mkdir(path)
  }
  return sparkfs-mkdir(path)
}

fn fs-rmdir(path: Int) -> Int {
  if volume-ready != 0 {
    return volume-rpc-rmdir(path)
  }
  return sparkfs-rmdir(path)
}

fn fs-rename(old: Int, new: Int) -> Int {
  if volume-ready != 0 {
    return volume-rpc-rename(old, new)
  }
  return sparkfs-rename(old, new)
}

fn fs-stat(path: Int, buf: Int) -> Int {
  if volume-ready != 0 {
    let result = volume-rpc-stat(path, buf)
    // Volume's older response has no identity fields. Clear these after the
    // response copy so prior shared-buffer contents cannot become identities.
    if result == 0 {
      store64(buf + SF-ST-INODE, 0)
      store64(buf + SF-ST-MOUNT, 0)
    }
    return result
  }
  return sparkfs-stat(path, buf)
}

fn fs-open-path(path: Int) -> Int {
  if volume-ready != 0 {
    return volume-rpc-open(path, 0)
  }
  let ino = sf-lookup-path(path)
  if ino < 0 {
    return -1
  }
  return ino
}


// Native inode permission bits; no foreign mode flags or errno vocabulary.
fn fs-set-mode(path: Int, permissions: Int) -> Int {
  if volume-ready != 0 || sf-disk-ready == 0 || permissions < 0 || permissions > 511 { return -1 }
  let inode = sf-lookup-path(path)
  if inode < 0 { return -1 }
  let record = sf-inode-addr(inode)
  let old = load32(record + SF-IN-MODE)
  store32(record + SF-IN-MODE, permissions)
  if sf-write-inode(inode) != 0 {
    store32(record + SF-IN-MODE, old)
    return -1
  }
  return 0
}

// RAM writes complete synchronously. NVMe requires an actual namespace FLUSH
// after metadata writes; ordinary write completion alone is not this barrier.
fn fs-sync-path(path: Int) -> Int {
  if volume-ready != 0 || sf-disk-ready == 0 { return -1 }
  let inode = sf-lookup-path(path)
  if inode < 0 { return -1 }
  let kind = load32(sf-inode-addr(inode) + SF-IN-TYPE)
  if kind != SF-TYPE-FILE && kind != SF-TYPE-DIR { return -1 }
  if sf-mem-disk != 0 { return 0 }
  if sf-flush-bitmap() != 0 { return -1 }
  if nvme-flush() != 0 { return -1 }
  return 0
}
