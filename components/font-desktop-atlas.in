fn desktop-font-mono24-decode(destination: Int) -> void {
  if destination == 0 { return }
  let pair = 0
  let offset = 0
  while pair < 8117 {
    let word = desktop-font-mono24-data[pair / 4]
    let shift = (pair & 3) * 16
    let count = (word >> shift) & 255
    let coverage = (word >> (shift + 8)) & 255
    if count == 0 || offset > 73728 - count { return }
    let i = 0
    while i < count {
      store8(destination + offset, coverage)
      offset += 1
      i += 1
    }
    pair += 1
  }
  return
}

