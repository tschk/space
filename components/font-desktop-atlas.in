fn desktop-font-sans24-decode(destination: Int) -> void {
  if destination == 0 { return }
  let pair = 0
  let offset = 0
  while pair < 8687 {
    let word = desktop-font-sans24-data[pair / 4]
    let shift = (pair & 3) * 16
    let count = (word >> shift) & 255
    let coverage = (word >> (shift + 8)) & 255
    if count == 0 || offset > 73728 - count { return }
    let i = 0
    while i < count {
      store8(destination + offset, coverage)
      offset += 1
      i += 1
    }
    pair += 1
  }
  return
}

fn desktop-fonts-apply24(mono: Int, sans: Int) -> void {
  desktop-font-mono24-decode(mono)
  desktop-font-sans24-decode(sans)
  return
}

fn desktop-fonts-apply(mono: Int, sans: Int) -> void {
  desktop-fonts-apply16(mono, sans)
  if desktop-font-mono24 == 0 { desktop-font-mono24 = alloc(73728) }
  if desktop-font-sans24 == 0 { desktop-font-sans24 = alloc(73728) }
  desktop-fonts-apply24(desktop-font-mono24, desktop-font-sans24)
  return
}
