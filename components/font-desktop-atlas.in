fn desktop-font-sans16-decode(destination: Int) -> void {
  if destination == 0 { return }
  let pair = 0
  let offset = 0
  while pair < 4924 {
    let word = desktop-font-sans16-data[pair / 4]
    let shift = (pair & 3) * 16
    let count = (word >> shift) & 255
    let coverage = (word >> (shift + 8)) & 255
    if count == 0 || offset > 32768 - count { return }
    let i = 0
    while i < count {
      store8(destination + offset, coverage)
      offset += 1
      i += 1
    }
    pair += 1
  }
  return
}

