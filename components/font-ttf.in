package space.display

// ============================================================================
// Space Freestanding TrueType & OpenType Font Engine
// ============================================================================
//
// Implements complete, bounds-checked SFNT container parsing (.ttf TrueType and
// .otf OpenType CFF), Unicode cmap Format 4 & 0 table resolution, horizontal
// metrics extraction, quadratic Bezier curve subdivision, 4x supersampled
// scanline anti-aliasing (0..255 coverage), and scalable glyph caching.
//
// Complies with Space nanokernel minimal-TCB boundaries:
// - Untrusted font assets are validated with strict bounds checks.
// - 100% integer and fixed-point (16.16) arithmetic: zero floating-point or libc dependency.
// - Supports both raw TrueType (0x00010000 / 'true') and OpenType CFF (0x4F54544F 'OTTO').
// ============================================================================

const TTF-MAGIC-TTF = 0x00010000
const TTF-MAGIC-TRUE = 0x74727565
const TTF-MAGIC-OTTO = 0x4F54544F

const TTF-TAG-CMAP = 0x636D6170
const TTF-TAG-HEAD = 0x68656164
const TTF-TAG-HHEA = 0x68686561
const TTF-TAG-HMTX = 0x686D7478
const TTF-TAG-MAXP = 0x6D617870
const TTF-TAG-LOCA = 0x6C6F6361
const TTF-TAG-GLYF = 0x676C7966
const TTF-TAG-CFF  = 0x43464620

const TTF-MAX-TABLES = 64
const TTF-MAX-CONTOURS = 32
const TTF-MAX-POINTS = 512
const TTF-MAX-SEGMENTS = 1024
const TTF-MAX-CROSSINGS = 64
const TTF-CACHE-SLOTS = 64

var ttf-font-valid: Int = 0
var ttf-font-base: Int = 0
var ttf-font-size: Int = 0
var ttf-is-otto: Int = 0

var ttf-upem: Int = 1000
var ttf-loc-fmt: Int = 1
var ttf-num-glyphs: Int = 0
var ttf-ascent: Int = 800
var ttf-descent: Int = -200
var ttf-line-gap: Int = 200
var ttf-num-hmetrics: Int = 0

var ttf-head-off: Int = 0
var ttf-head-len: Int = 0
var ttf-maxp-off: Int = 0
var ttf-maxp-len: Int = 0
var ttf-hhea-off: Int = 0
var ttf-hhea-len: Int = 0
var ttf-hmtx-off: Int = 0
var ttf-hmtx-len: Int = 0
var ttf-cmap-off: Int = 0
var ttf-cmap-len: Int = 0
var ttf-cmap-suboff: Int = 0
var ttf-cmap-fmt: Int = 0
var ttf-loca-off: Int = 0
var ttf-loca-len: Int = 0
var ttf-glyf-off: Int = 0
var ttf-glyf-len: Int = 0
var ttf-cff-off: Int = 0
var ttf-cff-len: Int = 0

// Scratch buffers for rasterizer
var ttf-pts-x: Int = 0
var ttf-pts-y: Int = 0
var ttf-pts-flags: Int = 0
var ttf-end-pts: Int = 0
var ttf-segs-x0: Int = 0
var ttf-segs-y0: Int = 0
var ttf-segs-x1: Int = 0
var ttf-segs-y1: Int = 0
var ttf-num-segs: Int = 0
var ttf-cross-x: Int = 0
var ttf-cross-w: Int = 0
var ttf-cov-buf: Int = 0

// Scalable dynamic glyph cache:
// cache-keys: ((cp & 0xFFFF) << 16) | (px_size & 0xFFFF)
// cache-records: slot * 40 bytes:
//   +0: width, +8: height, +16: advance, +24: lsb, +32: cov_buf_ptr
var ttf-cache-keys: Int = 0
var ttf-cache-records: Int = 0
var ttf-cache-hits: Int = 0
var ttf-cache-misses: Int = 0

// ----------------------------------------------------------------------------
// Big-Endian Readers
// ----------------------------------------------------------------------------

fn ttf-be-u16(p: Int) -> Int {
  let b0 = load8(p + 0) & 0xFF
  let b1 = load8(p + 1) & 0xFF
  return (b0 << 8) | b1
}

fn ttf-be-i16(p: Int) -> Int {
  let v = ttf-be-u16(p)
  if v >= 0x8000 {
    return v - 0x10000
  }
  return v
}

fn ttf-be-u32(p: Int) -> Int {
  let b0 = load8(p + 0) & 0xFF
  let b1 = load8(p + 1) & 0xFF
  let b2 = load8(p + 2) & 0xFF
  let b3 = load8(p + 3) & 0xFF
  return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

// ----------------------------------------------------------------------------
// Scratch Buffer & Cache Allocation
// ----------------------------------------------------------------------------

fn ttf-init-buffers() -> void {
  if ttf-pts-x == 0 {
    ttf-pts-x = alloc(TTF-MAX-POINTS * 8)
    ttf-pts-y = alloc(TTF-MAX-POINTS * 8)
    ttf-pts-flags = alloc(TTF-MAX-POINTS * 8)
    ttf-end-pts = alloc(TTF-MAX-CONTOURS * 8)
    ttf-segs-x0 = alloc(TTF-MAX-SEGMENTS * 8)
    ttf-segs-y0 = alloc(TTF-MAX-SEGMENTS * 8)
    ttf-segs-x1 = alloc(TTF-MAX-SEGMENTS * 8)
    ttf-segs-y1 = alloc(TTF-MAX-SEGMENTS * 8)
    ttf-cross-x = alloc(TTF-MAX-CROSSINGS * 8)
    ttf-cross-w = alloc(TTF-MAX-CROSSINGS * 8)
    ttf-cov-buf = alloc(64 * 64)
    ttf-cache-keys = alloc(TTF-CACHE-SLOTS * 8)
    ttf-cache-records = alloc(TTF-CACHE-SLOTS * 40)
  }
  ttf-cache-invalidate()
  return
}

fn ttf-cache-invalidate() -> void {
  if ttf-cache-keys == 0 { return }
  let i = 0
  while i < TTF-CACHE-SLOTS {
    store64(ttf-cache-keys + i * 8, -1)
    store64(ttf-cache-records + i * 40 + 0, 0)
    store64(ttf-cache-records + i * 40 + 8, 0)
    store64(ttf-cache-records + i * 40 + 16, 0)
    store64(ttf-cache-records + i * 40 + 24, 0)
    store64(ttf-cache-records + i * 40 + 32, 0)
    i = i + 1
  }
  return
}

// ----------------------------------------------------------------------------
// SFNT Table Directory Lookup & Validation
// ----------------------------------------------------------------------------

fn ttf-find-table(tag: Int) -> Int {
  if ttf-font-base == 0 { return 0 }
  let num-tables = ttf-be-u16(ttf-font-base + 4)
  if num-tables > TTF-MAX-TABLES { num-tables = TTF-MAX-TABLES }
  let i = 0
  while i < num-tables {
    let t = ttf-be-u32(ttf-font-base + 12 + i * 16)
    if t == tag {
      let off = ttf-be-u32(ttf-font-base + 12 + i * 16 + 8)
      return ttf-font-base + off
    }
    i = i + 1
  }
  return 0
}

fn ttf-table-len(tag: Int) -> Int {
  if ttf-font-base == 0 { return 0 }
  let num-tables = ttf-be-u16(ttf-font-base + 4)
  if num-tables > TTF-MAX-TABLES { num-tables = TTF-MAX-TABLES }
  let i = 0
  while i < num-tables {
    let t = ttf-be-u32(ttf-font-base + 12 + i * 16)
    if t == tag {
      return ttf-be-u32(ttf-font-base + 12 + i * 16 + 12)
    }
    i = i + 1
  }
  return 0
}

// ----------------------------------------------------------------------------
// Font Loading & Strict Bounds Validation
// ----------------------------------------------------------------------------

fn ttf-load(buf: Int, len: Int) -> Int {
  ttf-font-valid = 0
  if buf == 0 || len < 12 { return 0 }
  let magic = ttf-be-u32(buf)
  if magic != TTF-MAGIC-TTF && magic != TTF-MAGIC-TRUE && magic != TTF-MAGIC-OTTO {
    return 0
  }
  ttf-is-otto = 0
  if magic == TTF-MAGIC-OTTO {
    ttf-is-otto = 1
  }

  let num-tables = ttf-be-u16(buf + 4)
  if num-tables < 1 || num-tables > TTF-MAX-TABLES { return 0 }
  let dir-size = 12 + num-tables * 16
  if dir-size > len { return 0 }

  ttf-font-base = buf
  ttf-font-size = len

  // Validate all table offsets and bounds
  let i = 0
  while i < num-tables {
    let toff = ttf-be-u32(buf + 12 + i * 16 + 8)
    let tlen = ttf-be-u32(buf + 12 + i * 16 + 12)
    if toff + tlen > len || toff < dir-size {
      return 0
    }
    i = i + 1
  }

  ttf-head-off = ttf-find-table(TTF-TAG-HEAD)
  ttf-head-len = ttf-table-len(TTF-TAG-HEAD)
  ttf-maxp-off = ttf-find-table(TTF-TAG-MAXP)
  ttf-maxp-len = ttf-table-len(TTF-TAG-MAXP)
  ttf-hhea-off = ttf-find-table(TTF-TAG-HHEA)
  ttf-hhea-len = ttf-table-len(TTF-TAG-HHEA)
  ttf-hmtx-off = ttf-find-table(TTF-TAG-HMTX)
  ttf-hmtx-len = ttf-table-len(TTF-TAG-HMTX)
  ttf-cmap-off = ttf-find-table(TTF-TAG-CMAP)
  ttf-cmap-len = ttf-table-len(TTF-TAG-CMAP)

  if ttf-head-off == 0 || ttf-head-len < 54 { return 0 }
  if ttf-maxp-off == 0 || ttf-maxp-len < 6 { return 0 }
  if ttf-hhea-off == 0 || ttf-hhea-len < 36 { return 0 }
  if ttf-hmtx-off == 0 || ttf-cmap-off == 0 { return 0 }

  if ttf-is-otto == 0 {
    ttf-loca-off = ttf-find-table(TTF-TAG-LOCA)
    ttf-loca-len = ttf-table-len(TTF-TAG-LOCA)
    ttf-glyf-off = ttf-find-table(TTF-TAG-GLYF)
    ttf-glyf-len = ttf-table-len(TTF-TAG-GLYF)
    if ttf-loca-off == 0 || ttf-glyf-off == 0 { return 0 }
  } else {
    ttf-cff-off = ttf-find-table(TTF-TAG-CFF)
    ttf-cff-len = ttf-table-len(TTF-TAG-CFF)
    if ttf-cff-off == 0 || ttf-cff-len < 4 { return 0 }
  }

  // Parse 'head'
  ttf-upem = ttf-be-u16(ttf-head-off + 18)
  if ttf-upem < 16 || ttf-upem > 16384 { return 0 }
  ttf-loc-fmt = ttf-be-i16(ttf-head-off + 50)
  if ttf-loc-fmt != 0 && ttf-loc-fmt != 1 { return 0 }

  // Parse 'maxp'
  ttf-num-glyphs = ttf-be-u16(ttf-maxp-off + 4)
  if ttf-num-glyphs < 1 || ttf-num-glyphs > 65535 { return 0 }

  // Parse 'hhea'
  ttf-ascent = ttf-be-i16(ttf-hhea-off + 4)
  ttf-descent = ttf-be-i16(ttf-hhea-off + 6)
  ttf-line-gap = ttf-be-i16(ttf-hhea-off + 8)
  ttf-num-hmetrics = ttf-be-u16(ttf-hhea-off + 34)
  if ttf-num-hmetrics < 1 || ttf-num-hmetrics > ttf-num-glyphs { return 0 }
  if ttf-hmtx-len < ttf-num-hmetrics * 4 { return 0 }

  // Parse 'cmap' to find Format 4 or Format 0
  let num-enc = ttf-be-u16(ttf-cmap-off + 2)
  ttf-cmap-suboff = 0
  ttf-cmap-fmt = 0
  let k = 0
  while k < num-enc {
    let pid = ttf-be-u16(ttf-cmap-off + 4 + k * 8)
    let eid = ttf-be-u16(ttf-cmap-off + 6 + k * 8)
    let soff = ttf-be-u32(ttf-cmap-off + 8 + k * 8)
    if soff + 6 <= ttf-cmap-len {
      let fmt = ttf-be-u16(ttf-cmap-off + soff)
      if pid == 3 && eid == 1 && fmt == 4 {
        ttf-cmap-suboff = ttf-cmap-off + soff
        ttf-cmap-fmt = 4
        k = num-enc // break
      } else if (pid == 0 || pid == 3) && fmt == 4 && ttf-cmap-suboff == 0 {
        ttf-cmap-suboff = ttf-cmap-off + soff
        ttf-cmap-fmt = 4
      } else if fmt == 0 && ttf-cmap-suboff == 0 {
        ttf-cmap-suboff = ttf-cmap-off + soff
        ttf-cmap-fmt = 0
      }
    }
    k = k + 1
  }

  if ttf-cmap-suboff == 0 { return 0 }

  ttf-init-buffers()
  ttf-font-valid = 1
  return 1
}

// ----------------------------------------------------------------------------
// Unicode Codepoint to Glyph ID Mapping (cmap Format 4 / 0)
// ----------------------------------------------------------------------------

fn ttf-map-char(cp: Int) -> Int {
  if ttf-font-valid == 0 || ttf-cmap-suboff == 0 { return 0 }

  if ttf-cmap-fmt == 4 {
    let seg-count-x2 = ttf-be-u16(ttf-cmap-suboff + 6)
    let seg-count = seg-count-x2 / 2
    if seg-count <= 0 || seg-count > 256 { return 0 }

    let end-codes = ttf-cmap-suboff + 14
    let start-codes = ttf-cmap-suboff + 16 + seg-count * 2
    let id-deltas = ttf-cmap-suboff + 16 + seg-count * 4
    let id-range-offsets = ttf-cmap-suboff + 16 + seg-count * 6

    let i = 0
    while i < seg-count {
      let end-code = ttf-be-u16(end-codes + i * 2)
      if cp <= end-code {
        let start-code = ttf-be-u16(start-codes + i * 2)
        if cp >= start-code {
          let range-off = ttf-be-u16(id-range-offsets + i * 2)
          let delta = ttf-be-i16(id-deltas + i * 2)
          if range-off == 0 {
            return (cp + delta) & 0xFFFF
          } else {
            let ptr = id-range-offsets + i * 2 + range-off + (cp - start-code) * 2
            if ptr + 2 <= ttf-font-base + ttf-font-size {
              let g = ttf-be-u16(ptr)
              if g != 0 {
                return (g + delta) & 0xFFFF
              }
            }
          }
        }
        return 0
      }
      i = i + 1
    }
    return 0
  }

  if ttf-cmap-fmt == 0 {
    if cp >= 0 && cp < 256 {
      return load8(ttf-cmap-suboff + 6 + cp) & 0xFF
    }
  }

  return 0
}

// ----------------------------------------------------------------------------
// Horizontal Metrics
// ----------------------------------------------------------------------------

fn ttf-glyph-advance(gid: Int) -> Int {
  if ttf-font-valid == 0 || ttf-hmtx-off == 0 { return 600 }
  if gid < 0 || gid >= ttf-num-glyphs { return 600 }
  if gid < ttf-num-hmetrics {
    return ttf-be-u16(ttf-hmtx-off + gid * 4)
  }
  return ttf-be-u16(ttf-hmtx-off + (ttf-num-hmetrics - 1) * 4)
}

fn ttf-glyph-lsb(gid: Int) -> Int {
  if ttf-font-valid == 0 || ttf-hmtx-off == 0 { return 0 }
  if gid < 0 || gid >= ttf-num-glyphs { return 0 }
  if gid < ttf-num-hmetrics {
    return ttf-be-i16(ttf-hmtx-off + gid * 4 + 2)
  }
  let extra-idx = gid - ttf-num-hmetrics
  return ttf-be-i16(ttf-hmtx-off + ttf-num-hmetrics * 4 + extra-idx * 2)
}

// ----------------------------------------------------------------------------
// TrueType Glyph Outline Decoding (loca + glyf)
// ----------------------------------------------------------------------------

fn ttf-decode-glyph(gid: Int) -> Int {
  if ttf-font-valid == 0 || ttf-is-otto != 0 { return 0 }
  if gid < 0 || gid >= ttf-num-glyphs { return 0 }

  let goff = 0
  let gnext = 0
  if ttf-loc-fmt == 0 {
    goff = ttf-be-u16(ttf-loca-off + gid * 2) * 2
    gnext = ttf-be-u16(ttf-loca-off + (gid + 1) * 2) * 2
  } else {
    goff = ttf-be-u32(ttf-loca-off + gid * 4)
    gnext = ttf-be-u32(ttf-loca-off + (gid + 1) * 4)
  }

  if goff >= gnext || goff + 10 > ttf-glyf-len {
    return 0 // empty glyph (whitespace)
  }

  let p = ttf-glyf-off + goff
  let ncontours = ttf-be-i16(p)
  if ncontours <= 0 || ncontours > TTF-MAX-CONTOURS {
    return 0 // empty or composite
  }

  let i = 0
  while i < ncontours {
    store64(ttf-end-pts + i * 8, ttf-be-u16(p + 10 + i * 2))
    i = i + 1
  }

  let num-points = load64(ttf-end-pts + (ncontours - 1) * 8) + 1
  if num-points <= 0 || num-points > TTF-MAX-POINTS { return 0 }

  let ins-len = ttf-be-u16(p + 10 + ncontours * 2)
  let curr = p + 12 + ncontours * 2 + ins-len

  // Decode flags with repeat byte
  let pt-idx = 0
  while pt-idx < num-points && curr < ttf-font-base + ttf-font-size {
    let flag = load8(curr) & 0xFF
    curr = curr + 1
    store64(ttf-pts-flags + pt-idx * 8, flag)
    pt-idx = pt-idx + 1
    if (flag & 0x08) != 0 {
      let rpt = load8(curr) & 0xFF
      curr = curr + 1
      while rpt > 0 && pt-idx < num-points {
        store64(ttf-pts-flags + pt-idx * 8, flag)
        pt-idx = pt-idx + 1
        rpt = rpt - 1
      }
    }
  }

  // Decode X coordinates
  let x = 0
  pt-idx = 0
  while pt-idx < num-points && curr < ttf-font-base + ttf-font-size {
    let f = load64(ttf-pts-flags + pt-idx * 8)
    if (f & 0x02) != 0 {
      let dx = load8(curr) & 0xFF
      curr = curr + 1
      if (f & 0x10) == 0 {
        dx = -dx
      }
      x = x + dx
    } else {
      if (f & 0x10) == 0 {
        let dx = ttf-be-i16(curr)
        curr = curr + 2
        x = x + dx
      }
    }
    store64(ttf-pts-x + pt-idx * 8, x)
    pt-idx = pt-idx + 1
  }

  // Decode Y coordinates
  let y = 0
  pt-idx = 0
  while pt-idx < num-points && curr < ttf-font-base + ttf-font-size {
    let f = load64(ttf-pts-flags + pt-idx * 8)
    if (f & 0x04) != 0 {
      let dy = load8(curr) & 0xFF
      curr = curr + 1
      if (f & 0x20) == 0 {
        dy = -dy
      }
      y = y + dy
    } else {
      if (f & 0x20) == 0 {
        let dy = ttf-be-i16(curr)
        curr = curr + 2
        y = y + dy
      }
    }
    store64(ttf-pts-y + pt-idx * 8, y)
    pt-idx = pt-idx + 1
  }

  return ncontours
}

// ----------------------------------------------------------------------------
// Quadratic Bezier Curve Subdivision & Segment Construction
// ----------------------------------------------------------------------------

fn ttf-add-segment(x0: Int, y0: Int, x1: Int, y1: Int) -> void {
  if ttf-num-segs >= TTF-MAX-SEGMENTS { return }
  store64(ttf-segs-x0 + ttf-num-segs * 8, x0)
  store64(ttf-segs-y0 + ttf-num-segs * 8, y0)
  store64(ttf-segs-x1 + ttf-num-segs * 8, x1)
  store64(ttf-segs-y1 + ttf-num-segs * 8, y1)
  ttf-num-segs = ttf-num-segs + 1
  return
}

fn ttf-subdivide-quad(x0: Int, y0: Int, x1: Int, y1: Int, x2: Int, y2: Int) -> void {
  // 4 steps in 16.16 fixed-point math:
  // Step 1: t = 0.25 (w0 = 9/16, w1 = 6/16, w2 = 1/16)
  let p1x = (9 * x0 + 6 * x1 + 1 * x2) / 16
  let p1y = (9 * y0 + 6 * y1 + 1 * y2) / 16
  // Step 2: t = 0.50 (w0 = 4/16, w1 = 8/16, w2 = 4/16)
  let p2x = (x0 + 2 * x1 + x2) / 4
  let p2y = (y0 + 2 * y1 + y2) / 4
  // Step 3: t = 0.75 (w0 = 1/16, w1 = 6/16, w2 = 9/16)
  let p3x = (1 * x0 + 6 * x1 + 9 * x2) / 16
  let p3y = (1 * y0 + 6 * y1 + 9 * y2) / 16

  ttf-add-segment(x0, y0, p1x, p1y)
  ttf-add-segment(p1x, p1y, p2x, p2y)
  ttf-add-segment(p2x, p2y, p3x, p3y)
  ttf-add-segment(p3x, p3y, x2, y2)
  return
}

fn ttf-build-segments(ncontours: Int) -> Int {
  ttf-num-segs = 0
  let start-idx = 0
  let c = 0
  while c < ncontours {
    let end-idx = load64(ttf-end-pts + c * 8)
    let count = end-idx - start-idx + 1
    if count >= 2 {
      let i = 0
      while i < count {
        let i0 = start-idx + i
        let i1 = start-idx + ((i + 1) % count)
        let x0 = load64(ttf-pts-x + i0 * 8)
        let y0 = load64(ttf-pts-y + i0 * 8)
        let f0 = (load64(ttf-pts-flags + i0 * 8) & 0x01) != 0

        let x1 = load64(ttf-pts-x + i1 * 8)
        let y1 = load64(ttf-pts-y + i1 * 8)
        let f1 = (load64(ttf-pts-flags + i1 * 8) & 0x01) != 0

        if f0 && f1 {
          ttf-add-segment(x0, y0, x1, y1)
        } else if f0 && (!f1) {
          let i2 = start-idx + ((i + 2) % count)
          let x2 = load64(ttf-pts-x + i2 * 8)
          let y2 = load64(ttf-pts-y + i2 * 8)
          let f2 = (load64(ttf-pts-flags + i2 * 8) & 0x01) != 0
          if f2 {
            ttf-subdivide-quad(x0, y0, x1, y1, x2, y2)
            i = i + 1
          } else {
            let mx = (x1 + x2) / 2
            let my = (y1 + y2) / 2
            ttf-subdivide-quad(x0, y0, x1, y1, mx, my)
          }
        }
        i = i + 1
      }
    }
    start-idx = end-idx + 1
    c = c + 1
  }
  return ttf-num-segs
}

// ----------------------------------------------------------------------------
// Fixed-Point 4x Supersampled Scanline Anti-Aliased Rasterizer
// ----------------------------------------------------------------------------

fn ttf-rasterize(px-size: Int, out-w: Int, out-h: Int, adv-units: Int) -> Int {
  let total-pixels = out-w * out-h
  if total-pixels > 4096 { total-pixels = 4096 }
  let i = 0
  while i < total-pixels {
    store8(ttf-cov-buf + i, 0)
    i = i + 1
  }
  if ttf-num-segs == 0 { return ttf-cov-buf }

  // Scale from font design units to 4x subpixel grid:
  // 1 pixel = 4 subpixel units.
  // scale_4x = (px_size * 4 * 65536) / ttf_upem
  let scale-4x = (px-size * 4 * 65536) / ttf-upem
  let base-y-4x = ((ttf-ascent * px-size) / ttf-upem) * 4

  // Scale and flip segments to subpixel space
  let s = 0
  while s < ttf-num-segs {
    let sx0 = (load64(ttf-segs-x0 + s * 8) * scale-4x) >> 16
    let sy0 = base-y-4x - ((load64(ttf-segs-y0 + s * 8) * scale-4x) >> 16)
    let sx1 = (load64(ttf-segs-x1 + s * 8) * scale-4x) >> 16
    let sy1 = base-y-4x - ((load64(ttf-segs-y1 + s * 8) * scale-4x) >> 16)
    store64(ttf-segs-x0 + s * 8, sx0)
    store64(ttf-segs-y0 + s * 8, sy0)
    store64(ttf-segs-x1 + s * 8, sx1)
    store64(ttf-segs-y1 + s * 8, sy1)
    s = s + 1
  }

  // Rasterize across pixel rows
  let py = 0
  while py < out-h {
    let sub = 0
    while sub < 4 {
      let y-sub = py * 4 + sub
      let num-cross = 0

      // Find all segment crossings
      s = 0
      while s < ttf-num-segs && num-cross < TTF-MAX-CROSSINGS {
        let sy0 = load64(ttf-segs-y0 + s * 8)
        let sy1 = load64(ttf-segs-y1 + s * 8)
        if (sy0 <= y-sub && y-sub < sy1) || (sy1 <= y-sub && y-sub < sy0) {
          let sx0 = load64(ttf-segs-x0 + s * 8)
          let sx1 = load64(ttf-segs-x1 + s * 8)
          let dy = sy1 - sy0
          let x-int = sx0 + ((y-sub - sy0) * (sx1 - sx0)) / dy
          let wind = 1
          if sy1 < sy0 { wind = -1 }

          store64(ttf-cross-x + num-cross * 8, x-int)
          store64(ttf-cross-w + num-cross * 8, wind)
          num-cross = num-cross + 1
        }
        s = s + 1
      }

      // Sort crossings by X using insertion sort
      let a = 1
      while a < num-cross {
        let kx = load64(ttf-cross-x + a * 8)
        let kw = load64(ttf-cross-w + a * 8)
        let b = a - 1
        while b >= 0 && load64(ttf-cross-x + b * 8) > kx {
          store64(ttf-cross-x + (b + 1) * 8, load64(ttf-cross-x + b * 8))
          store64(ttf-cross-w + (b + 1) * 8, load64(ttf-cross-w + b * 8))
          b = b - 1
        }
        store64(ttf-cross-x + (b + 1) * 8, kx)
        store64(ttf-cross-w + (b + 1) * 8, kw)
        a = a + 1
      }

      // Fill spans between crossings using non-zero winding rule
      let w = 0
      let c-idx = 0
      while c-idx + 1 < num-cross {
        w = w + load64(ttf-cross-w + c-idx * 8)
        if w != 0 {
          let x-start = load64(ttf-cross-x + c-idx * 8)
          let x-end = load64(ttf-cross-x + (c-idx + 1) * 8)
          let px = 0
          while px < out-w {
            let px-min = px * 4
            let px-max = px-min + 4
            let o-start = px-min
            if x-start > o-start { o-start = x-start }
            let o-end = px-max
            if x-end < o-end { o-end = x-end }
            if o-end > o-start {
              let overlap = o-end - o-start
              let off = py * out-w + px
              let cur-cov = load8(ttf-cov-buf + off) & 0xFF
              let new-cov = cur-cov + overlap * 16
              if new-cov > 255 { new-cov = 255 }
              store8(ttf-cov-buf + off, new-cov)
            }
            px = px + 1
          }
        }
        c-idx = c-idx + 1
      }
      sub = sub + 1
    }
    py = py + 1
  }

  return ttf-cov-buf
}

// ----------------------------------------------------------------------------
// Scalable Dynamic Glyph Cache
// ----------------------------------------------------------------------------

fn ttf-get-glyph(cp: Int, px-size: Int) -> Int {
  if ttf-font-valid == 0 { return 0 }
  if px-size <= 0 { px-size = 16 }
  if px-size > 64 { px-size = 64 }

  let clamped-cp = cp & 0xFFFF
  let key = (clamped-cp << 16) | (px-size & 0xFFFF)
  let slot = (clamped-cp * 17 + px-size * 31) & (TTF-CACHE-SLOTS - 1)
  let rec = ttf-cache-records + slot * 40

  if load64(ttf-cache-keys + slot * 8) == key {
    ttf-cache-hits = ttf-cache-hits + 1
    return rec
  }

  ttf-cache-misses = ttf-cache-misses + 1
  let gid = ttf-map-char(cp)
  let adv-units = ttf-glyph-advance(gid)
  let adv-px = (adv-units * px-size) / ttf-upem
  if adv-px <= 0 { adv-px = px-size / 2 }

  let gw = adv-px
  if gw < 4 { gw = 4 }
  if gw > 64 { gw = 64 }
  let gh = px-size
  if gh > 64 { gh = 64 }

  let ncontours = ttf-decode-glyph(gid)
  let cov-ptr = 0
  if ncontours > 0 {
    ttf-build-segments(ncontours)
    ttf-rasterize(px-size, gw, gh, adv-units)
    // Allocate persistent cache buffer for this glyph
    cov-ptr = alloc(gw * gh)
    let j = 0
    while j < gw * gh {
      store8(cov-ptr + j, load8(ttf-cov-buf + j))
      j = j + 1
    }
  }

  store64(ttf-cache-keys + slot * 8, key)
  store64(rec + 0, gw)
  store64(rec + 8, gh)
  store64(rec + 16, adv-px)
  store64(rec + 24, ttf-glyph-lsb(gid))
  store64(rec + 32, cov-ptr)
  return rec
}

// ----------------------------------------------------------------------------
// High-Level Typography & Drawing Primitives
// ----------------------------------------------------------------------------

fn ttf-draw-char-aa(x: Int, y: Int, cp: Int, px-size: Int, color: Int) -> Int {
  if fb-ready == 0 { return 8 }
  let rec = ttf-get-glyph(cp, px-size)
  if rec == 0 { return 8 }

  let gw = load64(rec + 0)
  let gh = load64(rec + 8)
  let adv = load64(rec + 16)
  let cov-ptr = load64(rec + 32)

  if cov-ptr == 0 {
    // Missing glyph or whitespace: draw fallback box if not space
    if cp != 32 {
      fb-fill-rect(x, y, adv, px-size, 0x334155)
      fb-fill-rect(x + 1, y + 1, adv - 2, px-size - 2, 0x0F172A)
    }
    return adv
  }

  let rx = x + comp-render-dx
  let ry = y + comp-render-dy
  if rx + gw <= 0 || rx >= fb-width || ry + gh <= 0 || ry >= fb-height {
    return adv
  }

  let cr = (color >> 16) & 0xFF
  let cg = (color >> 8) & 0xFF
  let cb = color & 0xFF

  let row = 0
  while row < gh {
    let yy = ry + row
    if yy >= 0 && yy < fb-height {
      let col = 0
      while col < gw {
        let xx = rx + col
        if xx >= 0 && xx < fb-width && comp-clip-test(xx, yy) != 0 {
          let cov = load8(cov-ptr + row * gw + col) & 0xFF
          if cov > 0 {
            let ia = 255 - cov
            let off = yy * fb-pitch + xx * 4
            let dst = load32(fb-addr + off)
            let dr = (dst >> 16) & 0xFF
            let dg = (dst >> 8) & 0xFF
            let db = dst & 0xFF
            let nr = (cr * cov + dr * ia + 255) >> 8
            let ng = (cg * cov + dg * ia + 255) >> 8
            let nb = (cb * cov + db * ia + 255) >> 8
            store32(fb-addr + off, (nr << 16) | (ng << 8) | nb)
          }
        }
        col = col + 1
      }
    }
    row = row + 1
  }

  return adv
}

fn ttf-measure-string(str: Int, max-len: Int, px-size: Int) -> Int {
  if str == 0 || max-len <= 0 { return 0 }
  let tot-w = 0
  let idx = 0
  while idx < max-len {
    let cp = text-utf8-decode(str, idx)
    if text-utf8-bytes == 0 { return tot-w }
    let rec = ttf-get-glyph(cp, px-size)
    if rec != 0 {
      tot-w = tot-w + load64(rec + 16)
    } else {
      tot-w = tot-w + (px-size / 2)
    }
    idx = idx + text-utf8-bytes
  }
  return tot-w
}

fn ttf-draw-string-aa(x: Int, y: Int, str: Int, max-len: Int, px-size: Int, color: Int) -> Int {
  if str == 0 || max-len <= 0 { return 0 }
  let cur-x = x
  let idx = 0
  while idx < max-len {
    let cp = text-utf8-decode(str, idx)
    if text-utf8-bytes == 0 { return cur-x - x }
    let adv = ttf-draw-char-aa(cur-x, y, cp, px-size, color)
    cur-x = cur-x + adv
    idx = idx + text-utf8-bytes
  }
  return cur-x - x
}
