  fb-font-set(94, 0x18, 0x3C, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00)
  // _ (95)
  fb-font-set(95, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xFF)
