  fb-font-set(126, 0x00, 0x00, 0x60, 0x7E, 0x06, 0x00, 0x00, 0x00)

  fb-font-aa-init()
  fb-font-sans-init()
  return
}

// Initialize Face 1: Space UI Sans (proportional geometric sans-serif).
// Glyphs are left-aligned in their proportional advance box (4..8 base units)
// with clean sans-serif terminals, open counters, and distinct stroke geometry.
fn fb-font-sans-init() -> void {
  fb-font-sans = alloc(128 * 8)
  fb-font-sans-adv = alloc(128)
  let i = 0
  while i < 1024 {
    store8(fb-font-sans + i, 0)
    i = i + 1
  }
  i = 0
  while i < 128 {
    store8(fb-font-sans-adv + i, 7)
    i = i + 1
  }
  // Space (32): proportional 4-unit word space
  fb-font-sans-set(32, 4, 0, 0, 0, 0, 0, 0, 0, 0)
  // ! (33): narrow 4-unit stem
  fb-font-sans-set(33, 4, 0x60, 0x60, 0x60, 0x60, 0x40, 0x00, 0x60, 0x00)
  // " (34)
  fb-font-sans-set(34, 5, 0xA0, 0xA0, 0xA0, 0x00, 0x00, 0x00, 0x00, 0x00)
  // # (35)
  fb-font-sans-set(35, 8, 0x24, 0x7E, 0x24, 0x24, 0x7E, 0x24, 0x00, 0x00)
  // $ (36)
  fb-font-sans-set(36, 7, 0x20, 0x78, 0x80, 0x70, 0x08, 0xF0, 0x20, 0x00)
  // % (37)
  fb-font-sans-set(37, 8, 0xC4, 0xC8, 0x10, 0x20, 0x46, 0x86, 0x00, 0x00)
  // & (38)
  fb-font-sans-set(38, 7, 0x60, 0x90, 0x60, 0xA8, 0x90, 0x68, 0x00, 0x00)
  // ' (39)
  fb-font-sans-set(39, 4, 0x60, 0x60, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00)
  // ( (40)
  fb-font-sans-set(40, 5, 0x30, 0x60, 0x60, 0x60, 0x60, 0x60, 0x30, 0x00)
  // ) (41)
  fb-font-sans-set(41, 5, 0x60, 0x30, 0x30, 0x30, 0x30, 0x30, 0x60, 0x00)
  // * (42)
  fb-font-sans-set(42, 6, 0x00, 0xA8, 0x70, 0xA8, 0x00, 0x00, 0x00, 0x00)
  // + (43)
  fb-font-sans-set(43, 6, 0x00, 0x20, 0x20, 0xF8, 0x20, 0x20, 0x00, 0x00)
  // , (44)
  fb-font-sans-set(44, 4, 0x00, 0x00, 0x00, 0x00, 0x00, 0x60, 0x60, 0x40)
  // - (45)
  fb-font-sans-set(45, 5, 0x00, 0x00, 0x00, 0xF0, 0x00, 0x00, 0x00, 0x00)
  // . (46)
  fb-font-sans-set(46, 4, 0x00, 0x00, 0x00, 0x00, 0x00, 0x60, 0x60, 0x00)
  // / (47)
  fb-font-sans-set(47, 6, 0x08, 0x10, 0x20, 0x20, 0x40, 0x80, 0x80, 0x00)
  // 0-9 (48-57): open geometric sans counters (no slash in 0, no base serif in 1)
  fb-font-sans-set(48, 7, 0x70, 0x88, 0x88, 0x88, 0x88, 0x88, 0x70, 0x00)
  fb-font-sans-set(49, 5, 0x30, 0x70, 0x30, 0x30, 0x30, 0x30, 0x30, 0x00)
  fb-font-sans-set(50, 7, 0x70, 0x88, 0x08, 0x30, 0x40, 0x80, 0xF8, 0x00)
  fb-font-sans-set(51, 7, 0x70, 0x88, 0x08, 0x30, 0x08, 0x88, 0x70, 0x00)
  fb-font-sans-set(52, 7, 0x10, 0x30, 0x50, 0x90, 0xF8, 0x10, 0x10, 0x00)
  fb-font-sans-set(53, 7, 0xF8, 0x80, 0xF0, 0x08, 0x08, 0x88, 0x70, 0x00)
  fb-font-sans-set(54, 7, 0x70, 0x80, 0xF0, 0x88, 0x88, 0x88, 0x70, 0x00)
  fb-font-sans-set(55, 7, 0xF8, 0x08, 0x10, 0x20, 0x40, 0x40, 0x40, 0x00)
  fb-font-sans-set(56, 7, 0x70, 0x88, 0x88, 0x70, 0x88, 0x88, 0x70, 0x00)
  fb-font-sans-set(57, 7, 0x70, 0x88, 0x88, 0x78, 0x08, 0x88, 0x70, 0x00)
  // : ; < = > ? @
  fb-font-sans-set(58, 4, 0x00, 0x60, 0x60, 0x00, 0x00, 0x60, 0x60, 0x00)
  fb-font-sans-set(59, 4, 0x00, 0x60, 0x60, 0x00, 0x00, 0x60, 0x60, 0x40)
  fb-font-sans-set(60, 6, 0x10, 0x20, 0x40, 0x80, 0x40, 0x20, 0x10, 0x00)
  fb-font-sans-set(61, 6, 0x00, 0x00, 0xF0, 0x00, 0xF0, 0x00, 0x00, 0x00)
  fb-font-sans-set(62, 6, 0x80, 0x40, 0x20, 0x10, 0x20, 0x40, 0x80, 0x00)
  fb-font-sans-set(63, 6, 0x70, 0x88, 0x08, 0x30, 0x20, 0x00, 0x20, 0x00)
  fb-font-sans-set(64, 8, 0x7C, 0x82, 0xBA, 0xAA, 0xBA, 0x80, 0x7C, 0x00)
  // A-Z (65-90): clean geometric sans-serif capitals
  fb-font-sans-set(65, 7, 0x70, 0x88, 0x88, 0xF8, 0x88, 0x88, 0x88, 0x00)
  fb-font-sans-set(66, 7, 0xF0, 0x88, 0x88, 0xF0, 0x88, 0x88, 0xF0, 0x00)
  fb-font-sans-set(67, 7, 0x70, 0x88, 0x80, 0x80, 0x80, 0x88, 0x70, 0x00)
  fb-font-sans-set(68, 7, 0xF0, 0x88, 0x88, 0x88, 0x88, 0x88, 0xF0, 0x00)
  fb-font-sans-set(69, 6, 0xF8, 0x80, 0x80, 0xF0, 0x80, 0x80, 0xF8, 0x00)
  fb-font-sans-set(70, 6, 0xF8, 0x80, 0x80, 0xF0, 0x80, 0x80, 0x80, 0x00)
  fb-font-sans-set(71, 7, 0x70, 0x88, 0x80, 0x98, 0x88, 0x88, 0x70, 0x00)
  fb-font-sans-set(72, 7, 0x88, 0x88, 0x88, 0xF8, 0x88, 0x88, 0x88, 0x00)
  // I (73): serverless geometric stem (advance = 4)
  fb-font-sans-set(73, 4, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x00)
  fb-font-sans-set(74, 6, 0x10, 0x10, 0x10, 0x10, 0x10, 0x90, 0x60, 0x00)
  fb-font-sans-set(75, 7, 0x88, 0x90, 0xA0, 0xC0, 0xA0, 0x90, 0x88, 0x00)
  fb-font-sans-set(76, 6, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0xF8, 0x00)
  fb-font-sans-set(77, 8, 0x82, 0xC6, 0xAA, 0x92, 0x82, 0x82, 0x82, 0x00)
  fb-font-sans-set(78, 7, 0x88, 0xC8, 0xA8, 0x98, 0x88, 0x88, 0x88, 0x00)
  fb-font-sans-set(79, 7, 0x70, 0x88, 0x88, 0x88, 0x88, 0x88, 0x70, 0x00)
  fb-font-sans-set(80, 7, 0xF0, 0x88, 0x88, 0xF0, 0x80, 0x80, 0x80, 0x00)
  fb-font-sans-set(81, 7, 0x70, 0x88, 0x88, 0x88, 0xA8, 0x90, 0x68, 0x00)
  fb-font-sans-set(82, 7, 0xF0, 0x88, 0x88, 0xF0, 0xA0, 0x90, 0x88, 0x00)
  fb-font-sans-set(83, 7, 0x78, 0x80, 0x80, 0x70, 0x08, 0x08, 0xF0, 0x00)
  fb-font-sans-set(84, 7, 0xF8, 0x20, 0x20, 0x20, 0x20, 0x20, 0x20, 0x00)
  fb-font-sans-set(85, 7, 0x88, 0x88, 0x88, 0x88, 0x88, 0x88, 0x70, 0x00)
  fb-font-sans-set(86, 7, 0x88, 0x88, 0x88, 0x88, 0x50, 0x50, 0x20, 0x00)
  fb-font-sans-set(87, 8, 0x82, 0x82, 0x82, 0x92, 0xAA, 0xC6, 0x82, 0x00)
  fb-font-sans-set(88, 7, 0x88, 0x50, 0x20, 0x20, 0x20, 0x50, 0x88, 0x00)
  fb-font-sans-set(89, 7, 0x88, 0x88, 0x50, 0x20, 0x20, 0x20, 0x20, 0x00)
  fb-font-sans-set(90, 7, 0xF8, 0x08, 0x10, 0x20, 0x40, 0x80, 0xF8, 0x00)
  // [ \ ] ^ _ `
  fb-font-sans-set(91, 5, 0x70, 0x40, 0x40, 0x40, 0x40, 0x40, 0x70, 0x00)
  fb-font-sans-set(92, 6, 0x80, 0x80, 0x40, 0x20, 0x20, 0x10, 0x08, 0x00)
  fb-font-sans-set(93, 5, 0x70, 0x10, 0x10, 0x10, 0x10, 0x10, 0x70, 0x00)
  fb-font-sans-set(94, 6, 0x20, 0x50, 0x88, 0x00, 0x00, 0x00, 0x00, 0x00)
  fb-font-sans-set(95, 7, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xF8)
  fb-font-sans-set(96, 4, 0x40, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00)
  // a-z (97-122): modern proportional lowercase
  fb-font-sans-set(97, 6, 0x00, 0x00, 0x70, 0x08, 0x78, 0x88, 0x78, 0x00)
  fb-font-sans-set(98, 6, 0x80, 0x80, 0xF0, 0x88, 0x88, 0x88, 0xF0, 0x00)
  fb-font-sans-set(99, 6, 0x00, 0x00, 0x78, 0x80, 0x80, 0x80, 0x78, 0x00)
  fb-font-sans-set(100, 6, 0x08, 0x08, 0x78, 0x88, 0x88, 0x88, 0x78, 0x00)
  fb-font-sans-set(101, 6, 0x00, 0x00, 0x70, 0x88, 0xF8, 0x80, 0x78, 0x00)
  fb-font-sans-set(102, 5, 0x30, 0x40, 0xF0, 0x40, 0x40, 0x40, 0x40, 0x00)
  fb-font-sans-set(103, 6, 0x00, 0x00, 0x78, 0x88, 0x88, 0x78, 0x08, 0x70)
  fb-font-sans-set(104, 6, 0x80, 0x80, 0xF0, 0x88, 0x88, 0x88, 0x88, 0x00)
  // i (105): narrow 4-unit stem without wide base serif
  fb-font-sans-set(105, 4, 0x60, 0x00, 0x60, 0x60, 0x60, 0x60, 0x60, 0x00)
  fb-font-sans-set(106, 5, 0x20, 0x00, 0x20, 0x20, 0x20, 0x20, 0xA0, 0x40)
  fb-font-sans-set(107, 6, 0x80, 0x80, 0x90, 0xA0, 0xC0, 0xA0, 0x90, 0x00)
  // l (108): narrow 4-unit stem
  fb-font-sans-set(108, 4, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x00)
  fb-font-sans-set(109, 8, 0x00, 0x00, 0xEC, 0x92, 0x92, 0x92, 0x92, 0x00)
  fb-font-sans-set(110, 6, 0x00, 0x00, 0xF0, 0x88, 0x88, 0x88, 0x88, 0x00)
  fb-font-sans-set(111, 6, 0x00, 0x00, 0x70, 0x88, 0x88, 0x88, 0x70, 0x00)
  fb-font-sans-set(112, 6, 0x00, 0x00, 0xF0, 0x88, 0x88, 0xF0, 0x80, 0x80)
  fb-font-sans-set(113, 6, 0x00, 0x00, 0x78, 0x88, 0x88, 0x78, 0x08, 0x08)
  fb-font-sans-set(114, 5, 0x00, 0x00, 0xB0, 0xC0, 0x80, 0x80, 0x80, 0x00)
  fb-font-sans-set(115, 6, 0x00, 0x00, 0x78, 0x80, 0x70, 0x08, 0xF0, 0x00)
  fb-font-sans-set(116, 5, 0x40, 0x40, 0xF0, 0x40, 0x40, 0x40, 0x30, 0x00)
  fb-font-sans-set(117, 6, 0x00, 0x00, 0x88, 0x88, 0x88, 0x88, 0x78, 0x00)
  fb-font-sans-set(118, 6, 0x00, 0x00, 0x88, 0x88, 0x88, 0x50, 0x20, 0x00)
  fb-font-sans-set(119, 8, 0x00, 0x00, 0x82, 0x92, 0x92, 0xAA, 0x44, 0x00)
  fb-font-sans-set(120, 6, 0x00, 0x00, 0x88, 0x50, 0x20, 0x50, 0x88, 0x00)
  fb-font-sans-set(121, 6, 0x00, 0x00, 0x88, 0x88, 0x88, 0x78, 0x08, 0x70)
  fb-font-sans-set(122, 6, 0x00, 0x00, 0xF8, 0x10, 0x20, 0x40, 0xF8, 0x00)
  // { | } ~
  fb-font-sans-set(123, 5, 0x30, 0x40, 0x40, 0x80, 0x40, 0x40, 0x30, 0x00)
  fb-font-sans-set(124, 4, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x00)
  fb-font-sans-set(125, 5, 0xC0, 0x20, 0x20, 0x10, 0x20, 0x20, 0xC0, 0x00)
  fb-font-sans-set(126, 7, 0x00, 0x00, 0x60, 0x98, 0x00, 0x00, 0x00, 0x00)

  fb-font-sans-aa = alloc(128 * 64)
  fb-build-aa-table(fb-font-sans, fb-font-sans-aa)
  fb-font-sans-aa16 = alloc(128 * 256)
  fb-build-aa16-table(fb-font-sans, fb-font-sans-aa16)
  return
}

fn fb-glyph-bit(glyph-base: Int, r: Int, c: Int) -> Int {
  if r < 0 || r >= 8 || c < 0 || c >= 8 { return 0 }
  return (load8(glyph-base + r) >> (7 - c)) & 1
}

// Build 16x16 1x1 physical-pixel subpixel-smoothed coverage masks (256 bytes/glyph)
// using EPX/Scale2x diagonal reconstruction, outer convex corner rounding, and
// subtle edge anti-aliasing so 2x text has smooth 1px diagonals and curves.
fn fb-build-aa16-table(bitmap-src: Int, aa16-dst: Int) -> void {
  let i = 0
  while i < 128 * 256 {
    store8(aa16-dst + i, 0)
    i = i + 1
  }
  let ch = 0
  while ch < 128 {
    let glyph-base = bitmap-src + ch * 8
    let r = 0
    while r < 8 {
      let c = 0
      while c < 8 {
        let center = fb-glyph-bit(glyph-base, r, c)
        let sr = 0
        while sr < 2 {
          let vr = r - 1
          let vor = r + 1
          if sr == 1 {
            vr = r + 1
            vor = r - 1
          }
          let v = fb-glyph-bit(glyph-base, vr, c)
          let vo = fb-glyph-bit(glyph-base, vor, c)
          let sc = 0
          while sc < 2 {
            let hc = c - 1
            let hoc = c + 1
            if sc == 1 {
              hc = c + 1
              hoc = c - 1
            }
            let h = fb-glyph-bit(glyph-base, r, hc)
            let ho = fb-glyph-bit(glyph-base, r, hoc)
            let d = fb-glyph-bit(glyph-base, vr, hc)
            let cov = 0
            if center != 0 {
              cov = 255
              if v == 0 && h == 0 && d == 0 && (vo != 0 || ho != 0) {
                cov = 136
              }
            } else {
              if v != 0 && h != 0 {
                if d == 0 {
                  cov = 200
                } else {
                  cov = 128
                }
              } else if v != 0 || h != 0 {
                if d != 0 {
                  cov = 88
                } else {
                  cov = 40
                }
              } else if d != 0 {
                cov = 24
              }
            }
            let r16 = r * 2 + sr
            let c16 = c * 2 + sc
            store8(aa16-dst + ch * 256 + r16 * 16 + c16, cov)
            sc = sc + 1
          }
          sr = sr + 1
        }
        c = c + 1
      }
      r = r + 1
    }
    ch = ch + 1
  }
  return
}

// Build grayscale coverage masks (8x8 per glyph) from a 1-bit 128x8 bitmap table.
// Set cells get full coverage (255); empty cells adjacent to a set cell get
// partial coverage (96), producing soft edges when blended.
fn fb-build-aa-table(bitmap-src: Int, aa-dst: Int) -> void {
  let i = 0
  while i < 128 * 64 {
    store8(aa-dst + i, 0)
    i = i + 1
  }
  let ch = 0
  while ch < 128 {
    let glyph-base = bitmap-src + ch * 8
    let r = 0
    while r < 8 {
      let bits = load8(glyph-base + r)
      let c = 0
      while c < 8 {
        if ((bits >> (7 - c)) & 1) != 0 {
          store8(aa-dst + ch * 64 + r * 8 + c, 255)
        } else {
          let adj = 0
          let dr = -1
          while dr <= 1 && adj == 0 {
            let dc = -1
            while dc <= 1 && adj == 0 {
              let rr = r + dr
              let cc = c + dc
              if rr >= 0 && rr < 8 && cc >= 0 && cc < 8 {
                if ((load8(glyph-base + rr) >> (7 - cc)) & 1) != 0 {
                  adj = 1
                }
              }
              dc = dc + 1
            }
            dr = dr + 1
          }
          if adj != 0 {
            store8(aa-dst + ch * 64 + r * 8 + c, 96)
          }
        }
        c = c + 1
      }
      r = r + 1
    }
    ch = ch + 1
  }
  return
}

fn fb-font-aa-init() -> void {
  fb-font-aa = alloc(128 * 64)
  fb-build-aa-table(fb-font, fb-font-aa)
  fb-font-aa16 = alloc(128 * 256)
  fb-build-aa16-table(fb-font, fb-font-aa16)
  return
}

fn fb-glyph8(ch: Int, row: Int) -> Int {
  if fb-font != 0 && ch >= 0 && ch < 128 && row >= 0 && row < 8 {
    return load8(fb-font + ch * 8 + row)
  }
  return 0
}
