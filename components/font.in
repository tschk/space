package space.display

// ============================================================================
// Space Built-in Typeface Catalog (Freestanding Strike Assets)
// ============================================================================
//
// Face 0: Space Term Mono (FONT-FACE-MONO = 0)
//   Role:      Terminal / Monospace / Symbols (TEXT-ROLE-TERM-MONO, TEXT-ROLE-SYMBOLS)
//   Metrics:   Fixed 8x8 base grid, constant advance = 8 units, baseline = 7,
//              cap-height = 7, x-height = 5.
//   Provenance & License:
//              IBM PC VGA / Public Domain 8x8 fixed-width bitmap strike.
//              Dedicated to the public domain (CC0-1.0 Universal).
//
// Face 1: Space UI Sans (FONT-FACE-SANS = 1)
//   Role:      Interface / Body / Command Bar / Window Titles
//              (TEXT-ROLE-UI-BODY, TEXT-ROLE-COMMAND)
//   Metrics:   Proportional geometric sans-serif on an 8-row strike, per-glyph
//              advance = 4..8 base units (stored in fb-font-sans-adv),
//              baseline = 7, cap-height = 7, x-height = 5.
//   Provenance & License:
//              Space original geometric sans-serif proportional strike derived
//              from public-domain BDF UI proportions. Distributed under MIT /
//              CC0-1.0 permissive license as part of Space OS.
// ============================================================================

const FB-FONT-WIDTH = 8
const FB-FONT-HEIGHT = 8
const FONT-FACE-MONO = 0
const FONT-FACE-SANS = 1

var fb-font: Int = 0
var fb-font-aa: Int = 0
var fb-font-aa16: Int = 0
var fb-font-sans: Int = 0
var fb-font-sans-adv: Int = 0
var fb-font-sans-aa: Int = 0
var fb-font-sans-aa16: Int = 0

fn fb-font-set(ch: Int, r0: Int, r1: Int, r2: Int, r3: Int, r4: Int, r5: Int, r6: Int, r7: Int) -> void {
  let p = fb-font + ch * 8
  store8(p + 0, r0)
  store8(p + 1, r1)
  store8(p + 2, r2)
  store8(p + 3, r3)
  store8(p + 4, r4)
  store8(p + 5, r5)
  store8(p + 6, r6)
  store8(p + 7, r7)
  return
}

fn fb-font-sans-set(ch: Int, adv: Int, r0: Int, r1: Int, r2: Int, r3: Int, r4: Int, r5: Int, r6: Int, r7: Int) -> void {
  store8(fb-font-sans-adv + ch, adv)
  let p = fb-font-sans + ch * 8
  store8(p + 0, r0)
  store8(p + 1, r1)
  store8(p + 2, r2)
  store8(p + 3, r3)
  store8(p + 4, r4)
  store8(p + 5, r5)
  store8(p + 6, r6)
  store8(p + 7, r7)
  return
}

// Initialize both the 8x8 monospace terminal face and the proportional UI sans face.
fn fb-font-init() -> void {
  fb-font = alloc(128 * 8)
  let i = 0
  while i < 1024 {
    store8(fb-font + i, 0)
    i = i + 1
  }
  fb-font-set(32, 0, 0, 0, 0, 0, 0, 0, 0)
  // ! (33)
  fb-font-set(33, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00, 0x18, 0x00)
  // " (34)
  fb-font-set(34, 0x66, 0x66, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00)
  // # (35)
  fb-font-set(35, 0x66, 0x66, 0xFF, 0xFF, 0x66, 0x66, 0xFF, 0xFF)
  // $ (36)
  fb-font-set(36, 0x18, 0x3E, 0x60, 0x3C, 0x06, 0x7C, 0x18, 0x00)
  // % (37)
  fb-font-set(37, 0x62, 0x66, 0x0C, 0x18, 0x30, 0x66, 0x46, 0x00)
  // & (38)
  fb-font-set(38, 0x38, 0x6C, 0x38, 0x76, 0xDC, 0xCC, 0x76, 0x00)
  // ' (39)
  fb-font-set(39, 0x18, 0x18, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00)
  // ( (40)
  fb-font-set(40, 0x0C, 0x18, 0x30, 0x30, 0x30, 0x18, 0x0C, 0x00)
  // ) (41)
  fb-font-set(41, 0x30, 0x18, 0x0C, 0x0C, 0x0C, 0x18, 0x30, 0x00)
  // * (42)
  fb-font-set(42, 0x00, 0x66, 0x3C, 0xFF, 0x3C, 0x66, 0x00, 0x00)
  // + (43)
  fb-font-set(43, 0x00, 0x18, 0x18, 0x7E, 0x18, 0x18, 0x00, 0x00)
  // , (44)
  fb-font-set(44, 0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x30)
  // - (45)
  fb-font-set(45, 0x00, 0x00, 0x00, 0x7E, 0x00, 0x00, 0x00, 0x00)
  // . (46)
  fb-font-set(46, 0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x00)
  // / (47)
  fb-font-set(47, 0x00, 0x03, 0x07, 0x0E, 0x1C, 0x38, 0x70, 0x60)
  // 0-9 (48-57)
  fb-font-set(48, 0x3C, 0x66, 0x6E, 0x76, 0x66, 0x66, 0x3C, 0x00)
  fb-font-set(49, 0x18, 0x38, 0x18, 0x18, 0x18, 0x18, 0x7E, 0x00)
