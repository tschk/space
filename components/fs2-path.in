package space.kernel

// SparkFS path resolution helpers.
// Lookup is synchronous/nonreentrant, like SparkFS's shared block buffer.
// Reuse one owned workspace instead of leaking bump allocations on each read,
// stat and open. Concurrent providers need per-request workspaces throughout
// the filesystem, including the existing inode/block state.
var sf-lookup-workspace: Int = 0
// Parent resolution needs a distinct buffer because it invokes sf-lookup-path.
var sf-parent-workspace: Int = 0

// Native representability predicate. Personalities translate refusal to their
// own error vocabulary. The 1023-byte path bound matches normalization output;
// the on-disk 24-byte limit applies independently to every component.
fn sf-path-name-valid(path:Int) -> Int {
  let i=0;let part=0
  while i<=1023 {
    let c=load8(path+i)
    if c==0 { return 1 }
    if c==47 { part=0 } else { part=part+1;if part>SF-DIR-NAME-MAX{return 0} }
    i=i+1
  }
  return 0
}

// --- path resolution --------------------------------------------------------

// Find the last '/' in path. Returns index or -1.
fn sf-last-slash(path: Int) -> Int {
  let last = -1
  let i = 0
  while true {
    let c = load8(path + i)
    if c == 0 {
      return last
    }
    if c == 47 {
      last = i
    }
    i = i + 1
  }
  return last
}

// Copy a NUL-terminated string from path into dst.
fn sf-copy-name(dst: Int, path: Int) -> void {
  let i = 0
  while i < SF-NAME-MAX {
    let c = load8(path + i)
    store8(dst + i, c)
    if c == 0 {
      i = SF-NAME-MAX
    } else {
      i = i + 1
    }
  }
  store8(dst + SF-NAME-MAX, 0)
  return
}

// Resolve a path to an inode. Returns inode or -1.
fn sf-lookup-path(path: Int) -> Int {
  if sf-path-name-valid(path)==0 { return -1 }
  if load8(path) == 0 {
    return 0
  }
  let ino = load32(sf-super + SF-SB-ROOT-INODE)
  if load8(path) == 47 && load8(path + 1) == 0 {
    return ino
  }
  if sf-lookup-workspace == 0 { sf-lookup-workspace = alloc(SF-NAME-MAX + 17) }
  let name-buf = sf-lookup-workspace
  let tmp = sf-lookup-workspace + SF-NAME-MAX + 1
  store8(name-buf + SF-NAME-MAX, 0)
  let i = 0
  if load8(path) == 47 {
    i = 1
  }
  while true {
    let j = 0
    let seg-len = 0
    while j < SF-NAME-MAX {
      let c = load8(path + i + j)
      if c == 0 || c == 47 {
        store8(name-buf + j, 0)
        j = SF-NAME-MAX
      } else {
        store8(name-buf + j, c)
        seg-len = seg-len + 1
        j = j + 1
      }
    }
    if seg-len == 0 {
      return ino
    }
    // An overlong segment must not resolve through its truncated prefix:
    // reject instead of matching a shorter existing entry.
    let next = load8(path + i + seg-len)
    if next != 0 && next != 47 {
      return -1
    }
    let off = sf-dir-find(ino, name-buf, tmp)
    if off < 0 {
      return -1
    }
    ino = load32(tmp)
    while load8(path + i) != 0 && load8(path + i) != 47 {
      i = i + 1
    }
    if load8(path + i) == 0 {
      return ino
    }
    i = i + 1
  }
  return -1
}

// Join `cwd` and `path`, then resolve `.`/`..` segments into a canonical
// absolute path written to `out` (at least 1024 bytes). Absolute `path`
// ignores `cwd`. Returns `out`.
fn sf-normalize-path(cwd: Int, path: Int, out: Int) -> Int {
  let tmp = alloc(1024)
  let t = 0
  if load8(path) == 47 {
    while load8(path + t) != 0 && t < 1023 {
      store8(tmp + t, load8(path + t))
      t = t + 1
    }
  } else {
    let c = 0
    while load8(cwd + c) != 0 && t < 1023 {
      store8(tmp + t, load8(cwd + c))
      t = t + 1
      c = c + 1
    }
    if t > 1 && load8(tmp + t - 1) != 47 && t < 1023 {
      store8(tmp + t, 47)
      t = t + 1
    }
    if t == 0 {
      store8(tmp + t, 47)
      t = t + 1
    }
    let p = 0
    while load8(path + p) != 0 && t < 1023 {
      store8(tmp + t, load8(path + p))
      t = t + 1
      p = p + 1
    }
  }
  store8(tmp + t, 0)
  let o = 0
  let i = 0
  while load8(tmp + i) != 0 {
    while load8(tmp + i) == 47 {
      i = i + 1
    }
    if load8(tmp + i) != 0 {
      let j = i
      while load8(tmp + j) != 0 && load8(tmp + j) != 47 {
        j = j + 1
      }
      let seg-len = j - i
      let skip = 0
      if seg-len == 1 && load8(tmp + i) == 46 {
        skip = 1
      }
      if seg-len == 2 && load8(tmp + i) == 46 && load8(tmp + i + 1) == 46 {
        skip = 2
      }
      if skip == 2 {
        if o > 0 {
          o = o - 1
          while o > 0 && load8(out + o) != 47 {
            o = o - 1
          }
        }
      }
      if skip == 0 && o + seg-len + 1 < 1023 {
        store8(out + o, 47)
        o = o + 1
        let k = 0
        while k < seg-len {
          store8(out + o, load8(tmp + i + k))
          o = o + 1
          k = k + 1
        }
      }
      i = j
    }
  }
  if o == 0 {
    store8(out, 47)
    o = 1
  }
  store8(out + o, 0)
  return out
}

// Resolve parent directory and final name. Returns parent inode, or -1.
fn sf-lookup-parent(path: Int, name-out: Int) -> Int {
  if sf-path-name-valid(path)==0 { return -1 }
  let slash = sf-last-slash(path)
  if slash < 0 {
    sf-copy-name(name-out, path)
    return 0
  }
  if slash > 1023 {
    return -1
  }
  if sf-parent-workspace == 0 {
    sf-parent-workspace = alloc(1024)
  }
  let parent-path = sf-parent-workspace
  let i = 0
  while i < slash {
    store8(parent-path + i, load8(path + i))
    i = i + 1
  }
  store8(parent-path + i, 0)
  sf-copy-name(name-out, path + slash + 1)
  return sf-lookup-path(parent-path)
}
