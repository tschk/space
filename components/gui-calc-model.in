package space.app.gui

// Bounded integer calculator: one binary +,-,*,/ expression, Enter evaluates.
fn gui-calc-evaluate-at(memory: Int) -> void {
  let length = load64((memory + 128))
  let i = 0
  let first = 0
  let second = 0
  let operator = 0
  let valid = 1
  let digits = 0
  while i < length {
    let ch = load8(memory + i)
    if ch >= 48 && ch <= 57 {
      if operator == 0 { first = first * 10 + ch - 48 } else { second = second * 10 + ch - 48 }
      digits += 1
    } else {
      if operator != 0 || digits == 0 || (ch != 43 && ch != 45 && ch != 42 && ch != 47) { valid = 0 }
      operator = ch
      digits = 0
    }
    i += 1
  }
  let result = first
  if digits == 0 { valid = 0 }
  if operator == 43 { result = first + second }
  if operator == 45 { result = first - second }
  if operator == 42 { result = first * second }
  if operator == 47 { if second == 0 { valid = 0 } else { result = first / second } }
  i = 0
  while i < 8 { store8((memory + 16) + i, 0); i += 1 }
  if valid == 0 || result > 9999999 || result < -999999 {
    store8((memory + 16), 101); store8((memory + 17), 114); store8((memory + 18), 114)
    return
  }
  let start = 0
  if result < 0 { store8((memory + 16), 45); result = 0 - result; start = 1 }
  let count = 0
  while result > 0 || count == 0 {
    store8((memory + 64) + count, 48 + result % 10)
    result = result / 10
    count += 1
  }
  i = 0
  while i < count { store8((memory + 16) + start + i, load8((memory + 64) + count - 1 - i)); i += 1 }
  return
}

fn gui-calc-key-at(memory: Int, code: Int) -> void {
  let length = load64((memory + 128))
  if code == 8 && length > 0 { length -= 1; store8(memory + length, 0) }
  if code >= 32 && code < 127 && length < 8 { store8(memory + length, code); length += 1 }
  store64((memory + 128), length)
  if code == 10 || code == 13 { gui-calc-evaluate-at(memory) }
}

fn gui-calc-evaluate() -> void {
  gui-calc-evaluate-at(0x80000000)
}
fn gui-calc-key(code: Int) -> void {
  gui-calc-key-at(0x80000000, code)
}
