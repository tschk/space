package space.kernel
import "gui-protected-session.in"

// Optional supervisor entry. Bootstrap is explicit and separate; never remint
// launch authority here. All exit paths restore the prior note backend.
fn gui-protected-session-run(port: Int) -> Int {
  return gui-protected-session-run-images(port, boot-image-find(BOOT-IMAGE-GUI-SEAT), boot-image-find(BOOT-IMAGE-GUI-PROTECTED-CALC), boot-image-find(BOOT-IMAGE-GUI-PROTECTED-EDITOR))
}

// Private orchestration boundary: explicit artifacts, same launch authority and
// cleanup ownership as boot-kind selection; never exported to a guest.
fn gui-protected-session-run-images(port: Int, input-image: Int, calc-image: Int, editor-image: Int) -> Int {
  if gui-protected-launch-valid() != 1 || gui-session-input-handle != 0 { return 0 }
  let backend = native-protected-note-backend
  native-protected-note-backend = gui-protected-note-service
  let result = gui-protected-session-owned(port, input-image, calc-image, editor-image)
  let clean = 1
  if gui-protected-records != 0 {
    let slot = 0
    while slot < 2 {
      let record = gui-protected-records + slot * 96
      if load64(record) != 0 && gui-protected-retire(record) != 1 { clean = 0 }
      slot += 1
    }
  }
  let handle = gui-session-input-handle
  if handle != 0 {
    if runtime-instance-retire(handle) != 0 { clean = 0 } else {
      if sci-proof-input.handle == handle {
        sci-proof-input.unit = 0
        sci-proof-input.handle = 0
      }
      if sci-sync-handle == handle { sci-sync-ring-unit = 0; sci-sync-handle = 0 }
      if gui-session-input-page != 0 {
        store64(gui-session-input-page, 0)
        store64(gui-session-input-page + 8, 0)
      }
      if runtime-instance-release(handle) != 0 { clean = 0 } else {
        gui-session-input-handle = 0
        gui-session-input-page = 0
      }
    }
  }
  native-protected-note-backend = backend
  if clean != 1 { return 0 }
  if result == 1 {
    serial-write-cstr(port, "gui: both applications closed; stable session counters; returning to shell")
    serial-nl(port)
  }
  return result
}
