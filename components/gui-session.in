package space.kernel

// Optional full-image native application session. The shell only requests it;
// this service owns launch, retained endpoints, focus and lifetime routing.
var gui-session-message: Int = 0
var gui-session-input-handle: Int = 0
var gui-session-input-page: Int = 0
var gui-session-pending-handle: Int = 0

fn gui-session-run(port: Int) -> Int {
  if domain-get-current() != 0 { return 0 }
  if gui-session-input-handle != 0 || gui-session-pending-handle != 0 { return 0 }
  let result = gui-session-run-owned(port)
  let cleaned = 1
  if gui-records != 0 {
    let slot = 0
    while slot < 2 {
      let record = gui-records + slot * GUI-RECORD-SIZE
      if load64(record + GUI-HANDLE) != 0 && gui-retire(record) != 1 { cleaned = 0 }
      slot += 1
    }
  }
  if gui-session-pending-handle != 0 {
    let handle = gui-session-pending-handle
    // Admission may already have fenced/released a malformed initial reply.
    if runtime-instance-record(handle, 1) != 0 || runtime-instance-record(handle, 2) != 0 {
      if runtime-instance-retire(handle) != 0 || runtime-instance-release(handle) != 0 { cleaned = 0 }
    }
    gui-session-pending-handle = 0
  }
  if gui-session-input-handle != 0 {
    let handle = gui-session-input-handle
    if runtime-instance-retire(handle) != 0 { return 0 }
    // No future input polls can execute this identity. Withdraw the snapshot
    // and discard queued device words before its exact owned page is released.
    sci-proof-input.unit = 0
    sci-proof-input.handle = 0
    sci-sync-ring-unit = 0
    sci-sync-handle = 0
    store64(gui-session-input-page, 0)
    store64(gui-session-input-page + 8, 0)
    if runtime-instance-release(handle) != 0 { return 0 }
    gui-session-input-handle = 0
    gui-session-input-page = 0
  }
  if cleaned != 1 { return 0 }
  if result == 1 {
    serial-write-cstr(port, "gui: both applications closed; stable session counters; returning to shell")
    serial-nl(port)
  }
  return result
}

fn gui-session-run-owned(port: Int) -> Int {
  if domain-get-current() != 0 || fb-ready == 0 { return 0 }
  let input-image = boot-image-find(BOOT-IMAGE-GUI-SEAT)
  let calc-image = boot-image-find(BOOT-IMAGE-GUI-CALC)
  let editor-image = boot-image-find(BOOT-IMAGE-GUI-EDITOR)
  if input-image == 0 || calc-image == 0 || editor-image == 0 {
    serial-write-cstr(port, "gui: native application artifacts unavailable")
    serial-nl(port)
    return 0
  }
  if runtime-instance-canvas-profile(calc-image, SCI-V2-HEADER, load64(calc-image + 24), load64(calc-image + 8), 2) == 1 {
    if runtime-instance-canvas-profile(editor-image, SCI-V2-HEADER, load64(editor-image + 24), load64(editor-image + 8), 2) != 1 { return 0 }
    return gui-window-session-owned(port, input-image, calc-image, editor-image)
  }
  if runtime-instance-can-admit(3) != 1 {
    serial-write-cstr(port, "gui: retained instance capacity exhausted")
    serial-nl(port)
    return 0
  }
  if gui-reopen() != 1 { return 0 }
  if gui-session-message == 0 { gui-session-message = alloc(8) }
  let input-result = sci-load-retained-component(port, input-image, "gui-seat", SCI-INPUT-GRANTS, 0)
  gui-session-input-handle = runtime-instance-last-handle
  gui-session-input-page = sci-sync-page
  if input-result != 0 || gui-session-input-handle == 0 { return 0 }
  if sci-admit-input-sync(sci-sync-domain) != 1 || sci-proof-capture-input() != 1 { return 0 }
  let input-page = sci-sync-page
  let calc-result = sci-load-retained-component(port, calc-image, "gui-calc", cap-memory() | cap-display(), "init")
  gui-session-pending-handle = runtime-instance-last-handle
  if calc-result != 42 { return 0 }
  let calc = gui-admit(0)
  if calc == 0 { return 0 }
  gui-session-pending-handle = 0
  let editor-result = sci-load-retained-component(port, editor-image, "gui-editor", cap-memory() | cap-display() | cap-storage(), "init")
  gui-session-pending-handle = runtime-instance-last-handle
  if editor-result != 42 { return 0 }
  let editor = gui-admit(1)
  if editor == 0 { return 0 }
  gui-session-pending-handle = 0
  let message = gui-session-message
  let domains = domain-count
  let caps = cap-count
  let heap = heap-next
  let free = free-list
  serial-write-cstr(port, "gui: calculator left, text editor right; click or Tab to focus, Escape closes focused app")
  serial-nl(port)
  while gui-record(calc) != 0 || gui-record(editor) != 0 {
    if sci-proof-poll-input() != 0 { return 0 }
    let received = input-page-recv(input-page, message)
    if received < 0 { return 0 }
    while received == 1 {
      let event = load64(message)
      let type = event & 255
      if type == INPUT-EVT-KEY-DOWN {
        let code = (event >> 16) & 65535
        if code == 9 {
          if gui-focused == calc && gui-record(editor) != 0 { gui-focused = editor }
          else if gui-record(calc) != 0 { gui-focused = calc }
          serial-write-cstr(port, "gui: focus ")
          serial-write-dec-wide(port, gui-focused)
          serial-nl(port)
        } else {
          let recipient = gui-focused
          let store-epoch = gui-note-store-epoch
          let lifetime-epoch = gui-lifetime-epoch
          if gui-key(recipient, ticks, code) != 1 { return 0 }
          if gui-lifetime-epoch != lifetime-epoch {
            if code != 27 || gui-lifetime-epoch != lifetime-epoch + 1 { return 0 }
            free = free-list
          }
          if gui-note-store-epoch != store-epoch {
            if code != 19 || recipient != editor || gui-note-store-epoch != store-epoch + 1 { return 0 }
            // Authorized filesystem work may allocate service cache/metadata.
            // Ordinary input still preserves the post-operation baseline.
            heap = heap-next
            free = free-list
          }
          if code == 27 {
            if gui-record(recipient) != 0 || gui-event(recipient, SPDP-SEAT-KEYBOARD-KEY, ticks, 97) != 0 { return 0 }
            if gui-record(calc) != 0 { gui-focused = calc }
            else if gui-record(editor) != 0 { gui-focused = editor }
            serial-write-cstr(port, "gui: focused app closed, retired token refused")
          } else {
            serial-write-cstr(port, "gui: app rendered key ")
            serial-write-dec-wide(port, code)
          }
          serial-nl(port)
        }
      }
      if type == INPUT-EVT-MOUSE-BUTTON && ((event >> 8) & 1) == 1 {
        if gui-pointer(ticks, (event >> 32) & 65535, (event >> 48) & 65535) == 1 {
          serial-write-cstr(port, "gui: pointer focused app ")
          serial-write-dec-wide(port, gui-focused)
          serial-nl(port)
        }
      }
      received = input-page-recv(input-page, message)
      if received < 0 { return 0 }
    }
    if domain-get-current() != 0 || domain-count != domains || cap-count != caps || heap-next != heap || free-list != free { return 0 }
    pause()
  }
  return 1
}
