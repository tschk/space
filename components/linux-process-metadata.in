package space.kernel

// Linux structure/error translation around native filesystem identities and
// leases. The native provider owns persistence and overlap/owner semantics.
fn linux-process-file-bind-identity(guest: Int, host: Int) -> Int {
  if fs-stat(load64(vfs-fd-table + host * 32),linux-process-file-buffer) < 0 { return -5 }
  let inode = load64(linux-process-file-buffer + SF-ST-INODE)
  let mount = load64(linux-process-file-buffer + SF-ST-MOUNT)
  if inode <= 0 || mount <= 0 { return -5 }
  store64(linux-process-file-identities + guest * 16,inode)
  store64(linux-process-file-identities + guest * 16 + 8,mount)
  return 0
}

fn linux-process-file-unlock-close(fd: Int) -> void {
  let row = linux-process-file-identities + fd * 16
  let inode = load64(row)
  let mount = load64(row + 8)
  if inode > 0 && mount > 0 { fs-range-release-owner-file(linux-process-state-id(),mount,inode) }
  store64(row,0); store64(row + 8,0)
  return
}

fn linux-process-file-copy-stat(buffer: Int) -> Int {
  let kind = load32(linux-process-file-buffer + SF-ST-TYPE)
  let bits = 0x8000
  if kind == SF-TYPE-DIR { bits = 0x4000 }
  else if kind != SF-TYPE-FILE { return -38 }
  let size = load64(linux-process-file-buffer + SF-ST-SIZE)
  let mode = load32(linux-process-file-buffer + SF-ST-MODE) & 0x1FF
  let links = load32(linux-process-file-buffer + SF-ST-NLINK)
  let inode = load64(linux-process-file-buffer + SF-ST-INODE)
  let mount = load64(linux-process-file-buffer + SF-ST-MOUNT)
  if inode <= 0 || mount <= 0 { return -5 }
  let i = 0
  while i < 144 { linux-process-store8(buffer + i,0); i = i + 1 }
  linux-process-store64(buffer,mount)
  linux-process-store64(buffer + 8,inode)
  linux-process-store64(buffer + 16,links)
  linux-process-store64(buffer + 24,bits | mode)
  linux-process-store64(buffer + 48,size)
  linux-process-store64(buffer + 56,4096)
  linux-process-store64(buffer + 64,(size + 511) / 512)
  return 0
}

fn linux-process-file-stat-at(directory: Int, path: Int, buffer: Int, flags: Int) -> Int {
  if cap-check(linux-process-authority,cap-memory()) == 0 { return -13 }
  if (flags & 0x1100) != flags { return -22 }
  if linux-process-range(buffer,144,1) == 0 || linux-process-range(path,1,0) == 0 { return -14 }
  if linux-process-read8(path) == 0 && (flags & 0x1000) != 0 {
    if (directory & 0xFFFFFFFF) != 0xFFFFFF9C { return linux-process-fstat(directory,buffer) }
  }
  let ready = linux-process-files-ready()
  if ready < 0 { return ready }
  let dest = linux-process-file-buffer + 256
  let copied = 0
  if linux-process-read8(path) == 0 && (flags & 0x1000) != 0 {
    store8(dest,47);store8(dest + 1,0);copied = 1
  } else {
    copied = linux-process-file-copy-path(path,dest)
    if copied < 0 { return copied }
    // Absolute paths ignore dirfd; the declared relative base is cwd=/.
    if load8(dest) != 47 && (directory & 0xFFFFFFFF) != 0xFFFFFF9C {
      let host = linux-process-file-host(directory)
      if host < 3 { return -9 }
      if (load64(vfs-fd-table + host * 32 + 16) & 0x10000) == 0 { return -20 }
      return -38
    }
  }
  if fs-stat(dest,linux-process-file-buffer) < 0 { return -2 }
  if copied > 1 && load8(dest + copied - 1) == 47 && load32(linux-process-file-buffer + SF-ST-TYPE) != SF-TYPE-DIR { return -20 }
  return linux-process-file-copy-stat(buffer)
}

fn linux-process-file-sync(fd: Int) -> Int {
  let host = linux-process-file-host(fd)
  if host < 3 { return -9 }
  if vfs-discard-valid(host) != 0 { return -22 }
  let ready = linux-process-files-ready()
  if ready < 0 { return ready }
  // RAM is synchronous; direct NVMe requires a matched successful namespace
  // FLUSH after metadata writes. Asynchronous Volume remains refused.
  if fs-sync-path(load64(vfs-fd-table + host * 32)) < 0 { return -5 }
  return 0
}

fn linux-process-file-load64(address: Int) -> Int {
  return linux-process-read32(address) | (linux-process-read32(address + 4) << 32)
}

fn linux-process-file-lock(fd: Int, command: Int, record: Int) -> Int {
  let host = linux-process-file-host(fd)
  if host < 3 { return -9 }
  if cap-check(linux-process-authority,cap-memory()) == 0 { return -13 }
  if vfs-discard-valid(host) != 0 { return -38 }
  if command != 6 { return -38 }
  if linux-process-range(record,32,0) == 0 { return -14 }
  let kind = linux-process-read8(record) | (linux-process-read8(record + 1) << 8)
  let whence = linux-process-read8(record + 2) | (linux-process-read8(record + 3) << 8)
  let start = linux-process-file-load64(record + 8)
  let length = linux-process-file-load64(record + 16)
  if kind > 2 || whence != 0 || start < 0 || length < 0 { return -22 }
  let access = load64(vfs-fd-table + host * 32 + 16) & 3
  if (kind == 0 && access == VFS-O-WRONLY) || (kind == 1 && access == VFS-O-RDONLY) { return -9 }
  let ready = linux-process-files-ready()
  if ready < 0 { return ready }
  let row = linux-process-file-identities + fd * 16
  let result = fs-range-lease(linux-process-state-id(),load64(row + 8),load64(row),start,length,kind)
  if result == -2 { return -11 }
  if result == -3 { return -37 }
  if result < 0 { return -22 }
  return 0
}
