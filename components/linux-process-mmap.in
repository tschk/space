package space.kernel

const LINUX-PROCESS-MMAP-BASE = 0x30000000
const LINUX-PROCESS-MMAP-LIMIT = 0x31000000

// Private anonymous data mappings only: no executable, fixed, file-backed or
// shared mappings. Backing frames use the same execution ledger and teardown
// as ELF, stack and brk, and are zeroed by the native frame allocator.
fn linux-process-mmap(address: Int, length: Int, protection: Int, flags: Int, fd: Int, offset: Int) -> Int {
  if cap-check(linux-process-authority,cap-memory()) == 0 { return -13 }
  if address != 0 || length <= 0 || length > LINUX-PROCESS-MMAP-LIMIT - LINUX-PROCESS-MMAP-BASE { return -22 }
  if protection != 1 && protection != 3 { return -13 }
  if flags != 0x22 || (fd & 0xFFFFFFFF) != 0xFFFFFFFF || offset != 0 { return -22 }
  let pages = (length + 4095) / 4096
  if pages > LINUX-PROCESS-MAX-PAGES - linux-process-pages { return -12 }
  let page = LINUX-PROCESS-MMAP-BASE
  let start = page
  let count = 0
  while page < LINUX-PROCESS-MMAP-LIMIT {
    if linux-process-page-index(page) >= 0 { count = 0; start = page + 4096 }
    else { count = count + 1 }
    if count == pages {
      let prot = 6
      if protection == 1 { prot = 4 }
      let current = start
      while current <= page {
        if linux-process-map-page(current,prot) <= 0 { return -12 }
        current = current + 4096
      }
      return start
    }
    page = page + 4096
  }
  return -12
}

fn linux-process-munmap(address: Int, length: Int) -> Int {
  if cap-check(linux-process-authority,cap-memory()) == 0 { return -13 }
  if (address & 4095) != 0 || length <= 0 { return -22 }
  if address < LINUX-PROCESS-MMAP-BASE || address >= LINUX-PROCESS-MMAP-LIMIT { return -22 }
  if length > LINUX-PROCESS-MMAP-LIMIT - address { return -22 }
  let end = (address + length + 4095) & -4096
  let page = address
  while page < end {
    // Linux permits holes in a munmap range. Only owned anonymous-region
    // pages can be revoked; ELF code, stack, brk and other domains are outside.
    if linux-process-page-index(page) >= 0 {
      if linux-process-remove-page(page) != 0 { return -5 }
    }
    page = page + 4096
  }
  return 0
}
