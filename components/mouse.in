package space.kernel

// PS/2 mouse driver for the Space nanokernel.
// Uses polling (no IRQ) to read 3-byte mouse packets from the PS/2 controller.
// The PS/2 controller is accessed via ports 0x60 (data) and 0x64 (status/control).
//
// Mouse packet format (3 bytes):
//   byte 0: [Y overflow][X overflow][Y sign bit][X sign bit][Always 1][Middle][Right][Left]
//   byte 1: X movement (relative, 8-bit signed)
//   byte 2: Y movement (relative, 8-bit signed, inverted)
//
// The mouse is initialized by:
//   1. Disable both PS/2 ports
//   2. Read controller configuration byte
//   3. Enable mouse IRQ and second port
//   4. Enable mouse port
//   5. Send "enable data reporting" to mouse

// --- PS/2 controller ports --------------------------------------------------
const PS2-DATA = 0x60
const PS2-STATUS = 0x64
const PS2-CMD = 0x64

// --- mouse state ------------------------------------------------------------
var mouse-x: Int = 0
var mouse-y: Int = 0
var mouse-buttons: Int = 0     // bit 0=left, 1=right, 2=middle
var mouse-ready: Int = 0
var mouse-cycle: Int = 0       // packet byte index (0-2)
var mouse-buf0: Int = 0
var mouse-buf1: Int = 0
var mouse-buf2: Int = 0

// Wait for the PS/2 controller output buffer to be full (data available).
fn mouse-wait-output() -> void {
  while (inb(PS2-STATUS) & 0x01) == 0 {
  }
  return
}

// Wait for the PS/2 controller input buffer to be empty (ready for writing).
fn mouse-wait-input() -> void {
  while (inb(PS2-STATUS) & 0x02) != 0 {
  }
  return
}

// Send a command to the PS/2 controller (port 0x64).
fn ps2-cmd(cmd: Int) -> void {
  mouse-wait-input()
  outb(PS2-CMD, cmd)
  return
}

// Send a byte to the PS/2 mouse (via 0xD4 command prefix).
fn mouse-cmd(cmd: Int) -> void {
  mouse-wait-input()
  outb(PS2-CMD, 0xD4)
  mouse-wait-input()
  outb(PS2-DATA, cmd)
  return
}

// Read a byte from the PS/2 data port, waiting for output.
fn ps2-read() -> Int {
  mouse-wait-output()
  return inb(PS2-DATA)
}

// Initialize the PS/2 mouse. Returns 0 on success.
fn mouse-init() -> Int {
  // Disable both PS/2 ports
  ps2-cmd(0xAD)  // disable first port
  ps2-cmd(0xA7)  // disable second port (mouse)

  // Flush output buffer
  while (inb(PS2-STATUS) & 0x01) != 0 {
    inb(PS2-DATA)
  }

  // Read controller configuration byte
  ps2-cmd(0x20)
  let config = ps2-read()

  // Enable mouse IRQ (bit 1) and second port (bit 5), clear disable bits
  let new-config = (config | 0x02 | 0x20) & -0x21
  ps2-cmd(0x60)
  mouse-wait-input()
  outb(PS2-DATA, new-config)

  // Enable mouse port
  ps2-cmd(0xA8)

  // Reset the mouse
  mouse-cmd(0xFF)
  let ack = ps2-read()  // 0xFA = ACK
  if ack != 0xFA {
    return -1
  }

  // Set defaults
  mouse-cmd(0xF6)
  ps2-read()  // ACK

  // Enable data reporting
  mouse-cmd(0xF4)
  ps2-read()  // ACK

  // Enable first PS/2 port
  ps2-cmd(0xAE)

  // Center the mouse cursor
  mouse-x = fb-width / 2
  mouse-y = fb-height / 2
  mouse-buttons = 0
  mouse-cycle = 0
  mouse-ready = 1
  return 0
}

// Check if mouse data is available (output buffer full and mouse data).
fn mouse-has-data() -> Int {
  let st = inb(PS2-STATUS)
  if (st & 0x01) != 0 && (st & 0x20) != 0 {
    return 1
  }
  return 0
}

// Process one byte of mouse data. Returns 1 when a complete packet is received.
fn mouse-process-byte(b: Int) -> Int {
  if mouse-cycle == 0 {
    // Byte 0: flags. Bit 3 must be set for a valid packet.
    if (b & 0x08) == 0 {
      return 0  // out of sync, discard
    }
    mouse-buf0 = b
    mouse-cycle = 1
    return 0
  }
  if mouse-cycle == 1 {
    mouse-buf1 = b
    mouse-cycle = 2
    return 0
  }
  // Byte 2: complete packet
  mouse-buf2 = b
  mouse-cycle = 0

  // Extract button states
  mouse-buttons = mouse-buf0 & 0x07

  // Extract X movement (sign-extend 8-bit)
  let dx = mouse-buf1
  if (mouse-buf0 & 0x10) != 0 {
    dx = mouse-buf1 - 256
  }

  // Extract Y movement (sign-extend, inverted)
  let dy = mouse-buf2
  if (mouse-buf0 & 0x20) != 0 {
    dy = mouse-buf2 - 256
  }
  dy = -dy  // invert Y (screen coordinates)

  // Update position with clipping
  mouse-x = mouse-x + dx
  if mouse-x < 0 {
    mouse-x = 0
  }
  if mouse-x >= fb-width {
    mouse-x = fb-width - 1
  }
  mouse-y = mouse-y + dy
  if mouse-y < 0 {
    mouse-y = 0
  }
  if mouse-y >= fb-height {
    mouse-y = fb-height - 1
  }
  return 1
}

// Poll the mouse: read all available bytes and process complete packets.
// Returns the number of complete packets processed.
fn mouse-poll() -> Int {
  if mouse-ready == 0 {
    return 0
  }
  let count = 0
  while mouse-has-data() != 0 {
    let b = inb(PS2-DATA)
    if mouse-process-byte(b) != 0 {
      count = count + 1
    }
  }
  return count
}

// Check if left mouse button is currently pressed.
fn mouse-left-pressed() -> Int {
  return mouse-buttons & 0x01
}

// Check if right mouse button is currently pressed.
fn mouse-right-pressed() -> Int {
  return mouse-buttons & 0x02
}

fn ps2-kbd-init() -> Int {
  ps2-cmd(0xAE)
  mouse-wait-input()
  outb(PS2-DATA, 0xF4)
  return 0
}

fn ps2-kbd-has-data() -> Int {
  let st = inb(PS2-STATUS)
  if (st & 0x01) != 0 && (st & 0x20) == 0 {
    return 1
  }
  return 0
}

fn ps2-scancode-ascii(sc: Int) -> Int {
  if sc == 0x01 { return 27 }
  if sc == 0x0E { return 8 }
  if sc == 0x1C { return 10 }
  if sc == 0x39 { return 32 }
  if sc == 0x02 { return 49 }
  if sc == 0x03 { return 50 }
  if sc == 0x04 { return 51 }
  if sc == 0x05 { return 52 }
  if sc == 0x06 { return 53 }
  if sc == 0x07 { return 54 }
  if sc == 0x08 { return 55 }
  if sc == 0x09 { return 56 }
  if sc == 0x0A { return 57 }
  if sc == 0x0B { return 48 }
  if sc == 0x10 { return 113 }
  if sc == 0x11 { return 119 }
  if sc == 0x12 { return 101 }
  if sc == 0x13 { return 114 }
  if sc == 0x14 { return 116 }
  if sc == 0x15 { return 121 }
  if sc == 0x16 { return 117 }
  if sc == 0x17 { return 105 }
  if sc == 0x18 { return 111 }
  if sc == 0x19 { return 112 }
  if sc == 0x1E { return 97 }
  if sc == 0x1F { return 115 }
  if sc == 0x20 { return 100 }
  if sc == 0x21 { return 102 }
  if sc == 0x22 { return 103 }
  if sc == 0x23 { return 104 }
  if sc == 0x24 { return 106 }
  if sc == 0x25 { return 107 }
  if sc == 0x26 { return 108 }
  if sc == 0x2C { return 122 }
  if sc == 0x2D { return 120 }
  if sc == 0x2E { return 99 }
  if sc == 0x2F { return 118 }
  if sc == 0x30 { return 98 }
  if sc == 0x31 { return 110 }
  if sc == 0x32 { return 109 }
  if sc == 0x0C { return 45 }
  if sc == 0x0D { return 61 }
  if sc == 0x1A { return 91 }
  if sc == 0x1B { return 93 }
  if sc == 0x27 { return 59 }
  if sc == 0x28 { return 39 }
  if sc == 0x29 { return 96 }
  if sc == 0x2B { return 92 }
  if sc == 0x33 { return 44 }
  if sc == 0x34 { return 46 }
  if sc == 0x35 { return 47 }
  return -1
}

fn ps2-kbd-getchar() -> Int {
  if ps2-kbd-has-data() == 0 {
    return -1
  }
  let sc = inb(PS2-DATA)
  if sc == 0x2A || sc == 0x36 || sc == 0xAA || sc == 0xB6 {
    return -1
  }
  if (sc & 0x80) != 0 {
    return -1
  }
  let ch = ps2-scancode-ascii(sc)
  return ch
}
