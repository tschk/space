package space.kernel
import "../protocol/native-protected.in"

// Translation uses only the caller's immutable physical backing ledgers. No
// guest pointer becomes a kernel pointer and no user allocator metadata is trusted.
fn native-protected-pointer(state: Int, address: Int, write: Int) -> Int {
  if state == 0 || load64(state + 120) != NATIVE-PROTECTED-KIND || address < 0 { return 0 }
  let pages = 0
  let offset = 0
  if address >= NATIVE-PROTECTED-HEAP && address - NATIVE-PROTECTED-HEAP < NATIVE-PROTECTED-HEAP-BYTES {
    pages = load64(state + 24); offset = address - NATIVE-PROTECTED-HEAP
  } else {
    if address >= NATIVE-PROTECTED-ALLOC && address - NATIVE-PROTECTED-ALLOC < NATIVE-PROTECTED-ALLOC-BYTES {
      pages = load64(load64(state + 112) + 984); offset = address - NATIVE-PROTECTED-ALLOC
    } else {
    if write != 0 { return 0 }
    if address >= NATIVE-PROTECTED-IMAGE && address - NATIVE-PROTECTED-IMAGE < load64(state + 104) {
      pages = load64(state + 88); offset = address - NATIVE-PROTECTED-IMAGE
    } else {
      let extra = load64(state + 112)
      if extra == 0 { return 0 }
      if address >= NATIVE-PROTECTED-STACK && address - NATIVE-PROTECTED-STACK < NATIVE-PROTECTED-STACK-PAGES * 4096 {
        pages = extra + 848; offset = address - NATIVE-PROTECTED-STACK
      } else {
        if address >= NATIVE-PROTECTED-INFO && address - NATIVE-PROTECTED-INFO < 4096 { return load64(state + 32) + address - NATIVE-PROTECTED-INFO }
        return 0
      }
    }
    }
  }
  if pages == 0 { return 0 }
  let frame = load64(pages + (offset / 4096) * 8)
  if frame == 0 { return 0 }
  return frame + (offset & 4095)
}

fn native-protected-heap-metadata(state: Int) -> Int {
  let extra = load64(state + 112)
  if extra == 0 { return 0 }
  return load64(extra + 776)
}

// 128 supervisor-only records: [offset,length,state(0unused/1free/2live),0].
fn native-protected-malloc(state: Int, bytes: Int) -> Int {
  if bytes < 0 || bytes > NATIVE-PROTECTED-HEAP-BYTES { return 0 }
  let amount = (bytes + 15) & -16
  if amount == 0 { amount = 16 }
  let metadata = native-protected-heap-metadata(state)
  if metadata == 0 { return 0 }
  let i = 0
  while i < 128 {
    let node = metadata + i * 32
    let length = load64(node + 8)
    if load64(node + 16) == 1 && length >= amount {
      if length > amount {
        let empty = 0
        let j = 0
        while j < 128 && empty == 0 {
          if load64(metadata + j * 32 + 16) == 0 { empty = metadata + j * 32 }
          j = j + 1
        }
        if empty == 0 { return 0 }
        store64(empty,load64(node) + amount)
        store64(empty + 8,length - amount)
        store64(empty + 16,1)
      }
      store64(node + 8,amount)
      store64(node + 16,2)
      return NATIVE-PROTECTED-ALLOC + load64(node)
    }
    i = i + 1
  }
  return 0
}

fn native-protected-allocation(state: Int, pointer: Int) -> Int {
  if pointer < NATIVE-PROTECTED-ALLOC || pointer - NATIVE-PROTECTED-ALLOC >= NATIVE-PROTECTED-ALLOC-BYTES { return 0 }
  let metadata = native-protected-heap-metadata(state)
  let i = 0
  while i < 128 {
    let node = metadata + i * 32
    if load64(node + 16) == 2 && load64(node) == pointer - NATIVE-PROTECTED-ALLOC { return node }
    i = i + 1
  }
  return 0
}

fn native-protected-free(state: Int, pointer: Int) -> Int {
  if pointer == 0 { return 0 }
  let node = native-protected-allocation(state,pointer)
  if node == 0 { return -1 }
  store64(node + 16,1)
  let metadata = native-protected-heap-metadata(state)
  let j = 0
  while j < 128 {
    let other = metadata + j * 32
    let merged = 0
    if other != node && load64(other + 16) == 1 {
      if load64(node) + load64(node + 8) == load64(other) {
        store64(node + 8,load64(node + 8) + load64(other + 8)); merged = 1
      } else {
        if load64(other) + load64(other + 8) == load64(node) {
          store64(node,load64(other)); store64(node + 8,load64(node + 8) + load64(other + 8)); merged = 1
        }
      }
      if merged != 0 { store64(other,0); store64(other + 8,0); store64(other + 16,0) }
    }
    if merged != 0 { j = 0 } else { j = j + 1 }
  }
  return 0
}

fn native-protected-zero(state: Int, pointer: Int, bytes: Int) -> Int {
  if bytes < 0 || bytes > NATIVE-PROTECTED-HEAP-BYTES { return -1 }
  let i = 0
  while i < bytes {
    let physical = native-protected-pointer(state,pointer + i,1)
    if physical == 0 { return -1 }
    store8(physical,0); i = i + 1
  }
  return 0
}

fn native-protected-calloc(state: Int, count: Int, size: Int) -> Int {
  if count < 0 || size < 0 || count > NATIVE-PROTECTED-HEAP-BYTES || size > NATIVE-PROTECTED-HEAP-BYTES { return 0 }
  if size != 0 && count > NATIVE-PROTECTED-HEAP-BYTES / size { return 0 }
  let bytes = count * size
  let pointer = native-protected-malloc(state,bytes)
  if pointer == 0 { return 0 }
  if native-protected-zero(state,pointer,bytes) != 0 { native-protected-free(state,pointer); return 0 }
  return pointer
}

fn native-protected-realloc(state: Int, pointer: Int, bytes: Int) -> Int {
  if pointer == 0 { return native-protected-malloc(state,bytes) }
  if bytes < 0 || bytes > NATIVE-PROTECTED-HEAP-BYTES { return 0 }
  let node = native-protected-allocation(state,pointer)
  if node == 0 { return 0 }
  if bytes == 0 { native-protected-free(state,pointer); return 0 }
  let length = load64(node + 8)
  if bytes <= length { return pointer }
  let next = native-protected-malloc(state,bytes)
  if next == 0 { return 0 }
  let i = 0
  while i < length {
    store8(native-protected-pointer(state,next + i,1),load8(native-protected-pointer(state,pointer + i,0)))
    i = i + 1
  }
  native-protected-free(state,pointer)
  return next
}
