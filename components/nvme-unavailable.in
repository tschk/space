package space.kernel

// Minimal image transport binding: no device or Storage component is present.
// The shared filesystem chooses its real RAM SparkFS backend while ready is 0.
// These error-only operations are never advertised as a working NVMe service.
var nvme-ready: Int = 0
var storage-data-page: Int = 0

