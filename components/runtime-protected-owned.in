package space.kernel
import "../protocol/native-protected.in"

// Protected state retains the shared object/cap/image/heap/catalog fields.
// state+120=2 selects an owned user tree. state+112 is an extra frame:
// 0..767 user context; 768 trap frame; 776 allocator metadata frame;
// 784 stack page count; 792 entry RSP; 800 profile; 808 last stop kind;
// 816 abort marker; 824 service calls; 832 reserved; 840 extra magic;
// 848..975 sixteen stack backing frame addresses. state+32 owns capinfo.
// 976 args byte count; 984 allocator-backing ledger; 992 its live page count.
fn runtime-instance-protected-valid(state: Int) -> Int {
  let extra = load64(state + 112)
  if extra == 0 { return 1 }
  if extra < 0x100000 || extra >= heap-end || (extra & 4095) != 0 || load64(extra + 840) != NATIVE-PROTECTED-EXTRA-MAGIC { return 0 }
  let count = load64(extra + 784)
  if count < 0 || count > NATIVE-PROTECTED-STACK-PAGES { return 0 }
  let allocated = load64(extra + 992)
  let backing = load64(extra + 984)
  if allocated < 0 || allocated > 512 || (allocated != 0 && backing == 0) { return 0 }
  if backing != 0 && (backing < 0x100000 || backing >= heap-end || (backing & 4095) != 0) { return 0 }
  let page = 0
  while page < allocated {
    let frame = load64(backing + page * 8)
    if frame < 0x100000 || frame >= heap-end || (frame & 4095) != 0 { return 0 }
    page = page + 1
  }
  let i = 0
  while i < count {
    let frame = load64(extra + 848 + i * 8)
    if frame < 0x100000 || frame >= heap-end || (frame & 4095) != 0 { return 0 }
    i = i + 1
  }
  i = 768
  while i <= 776 {
    let frame = load64(extra + i)
    if frame != 0 && (frame < 0x100000 || frame >= heap-end || (frame & 4095) != 0) { return 0 }
    i = i + 8
  }
  return 1
}

// User mappings have already been withdrawn. Never touch guest allocator
// payloads as kernel chan-heap headers; their physical backing is in state+24.
fn runtime-instance-protected-dispose(state: Int) -> Int {
  if load64(state + 120) != NATIVE-PROTECTED-KIND || runtime-instance-protected-valid(state) == 0 { return -1 }
  let extra = load64(state + 112)
  if extra == 0 { return 0 }
  let i = 0
  while i < load64(extra + 784) { frame-free(load64(extra + 848 + i * 8)); i = i + 1 }
  if load64(extra + 768) != 0 { frame-free(load64(extra + 768)) }
  if load64(extra + 776) != 0 { frame-free(load64(extra + 776)) }
  let backing = load64(extra + 984)
  i = 0
  while i < load64(extra + 992) { frame-free(load64(backing + i * 8)); i = i + 1 }
  if backing != 0 { frame-free(backing) }
  frame-free(extra)
  store64(state + 112,0)
  return 0
}
