package space.kernel

var volume-ready: Int = 0
var volume-domain: Int = 0
var volume-entry-addr: Int = 0
var volume-cap-info: Int = 0
var volume-heap-frames: Int = 0
var volume-shared: Int = 0
var volume-via-marker: Int = 0

const SCI-MAGIC = 0x5343490000000001
// SCI v2: 64-byte manifest with export/import symbol tables (dynamic linking).
const SCI-MAGIC-V2 = 0x5343490000000002
const SCI-V2-HEADER = 64
const SCI-V2-EXPORT-COUNT = 32
const SCI-V2-EXPORT-TABLE = 40
const SCI-V2-IMPORT-COUNT = 48
const SCI-V2-IMPORT-TABLE = 56
const SCI-GUEST-GRANTS = 1
const SCI-DISPLAY-GRANTS = 1
const SCI-INPUT-GRANTS = 3
const SCI-VOLUME-GRANTS = 0
const SCI-LIB-GRANTS = 1
const SCI-DYN-GRANTS = 1
// App grants. SCI manifests encode required capabilities as ordinal bits
// (bit N set = the Nth capability declared in the component block): a
// serial-only app requires 0x1, an app that also declares storage requires
// 0x3. Kernel-internal cap-type masks (cap-serial etc.) are a separate
// vocabulary and never appear in SCI manifests.
const SCI-APP-GRANTS = 1
const SCI-APP-FS-GRANTS = 3
const VOLUME-NVME-LBA = 65536

// Dynamic-linking registry: exported symbols from the kernel boot image
// (kind 0 provider), registered shared-library SCIs, and successfully loaded
// modules. Each entry has a provider record so bind can map provider text
// into the importing domain. Kernel entries carry zero provider fields.
const DYN-MAX-EXPORTS = 1024
const LIB-VIRT-BASE = 0x3F000000
const KERNEL-CODE-BASE = 0x101100
const KERNEL-HEADER = 0x101000

var lib-registered: Int = 0
var lib-phys: Int = 0
var lib-entry: Int = 0
var lib-size: Int = 0
var dyn-name-tab: Int = 0
var dyn-fn-tab: Int = 0
var dyn-prov-phys: Int = 0
var dyn-prov-base: Int = 0
var dyn-prov-size: Int = 0
var dyn-count: Int = 0

const COMP-GNOME-DESKTOP = 0x001E1E2E
const COMP-GNOME-PANEL = 0x00181825
const COMP-GNOME-PANEL-LINE = 0x00333040
const COMP-GNOME-TITLE = 0x002A2A3A
const COMP-GNOME-TITLE-ACTIVE = 0x003584E4
const COMP-GNOME-BORDER = 0x003D3846
const COMP-GNOME-ACCENT = 0x003584E4
const COMP-GNOME-TERM-BG = 0x00121015
const COMP-GNOME-TERM-TEXT = 0x00C8D4E0
const COMP-GNOME-BTN-CLOSE = 0x00C01C28

// Runtime-loaded components get an isolated heap and a cross-domain shared
// page mapped at the same virtual address in both domains.
const COMP-HEAP-VIRT = 0x80000000
const COMP-HEAP-SIZE = 0x200000
const COMP-SHARED-VIRT = 0x70000000

var comp-entry-arg: Int = 0
var comp-cap-info-arg: Int = 0
var comp-domain-arg: Int = 0

fn boot-image-find(kind: Int) -> Int {
  let table = load64(0x40D0)
  if table == 0 || load64(table) != BOOT-IMAGE-TABLE-MAGIC {
    return 0
  }
  let count = load64(table + 8)
  if count < 0 || count > 64 {
    return 0
  }
  let i = 0
  while i < count {
    let entry = table + 16 + i * 32
    if load64(entry) == kind {
      let phys = load64(entry + 8)
      let size = load64(entry + 16)
      if phys >= 0x100000 && phys < 0x300000 && size >= 32 && size <= 0x200000 && phys + size >= phys && phys + size <= 0x300000 {
        return phys
      }
      return 0
    }
    i = i + 1
  }
  return 0
}

fn comp-thread-wrapper() -> Int {
  domain-switch(comp-domain-arg)
  return invoke1(comp-entry-arg, comp-cap-info-arg)
}

// --- dynamic linking ---------------------------------------------------------

// Byte-compare two NUL-terminated strings. Returns 1 when equal.
fn dyn-str-eq(a: Int, b: Int) -> Int {
  let i = 0
  let ca = load8(a + i)
  let cb = load8(b + i)
  while ca != 0 && cb != 0 {
    if ca != cb {
      return 0
    }
    i = i + 1
    ca = load8(a + i)
    cb = load8(b + i)
  }
  if ca == cb {
    return 1
  }
  return 0
}

// Resolve a symbol name against the dynamic-link registry.
// Returns the registry index, or -1 when unresolved.
fn dyn-resolve-idx(name: Int) -> Int {
  let i = 0
  while i < dyn-count {
    if dyn-str-eq(load64(dyn-name-tab + i * 8), name) != 0 {
      return i
    }
    i = i + 1
  }
  return -1
}

fn dyn-ensure-tables() -> void {
  if dyn-name-tab == 0 {
    dyn-name-tab = alloc(DYN-MAX-EXPORTS * 8)
    dyn-fn-tab = alloc(DYN-MAX-EXPORTS * 8)
    dyn-prov-phys = alloc(DYN-MAX-EXPORTS * 8)
    dyn-prov-base = alloc(DYN-MAX-EXPORTS * 8)
    dyn-prov-size = alloc(DYN-MAX-EXPORTS * 8)
  }
  return
}

// Add one registry entry. Kernel-provider entries pass provider 0/0/0.
fn dyn-add(name: Int, fn-addr: Int, prov-phys: Int, prov-base: Int, prov-size: Int) -> void {
  if dyn-count >= DYN-MAX-EXPORTS {
    return
  }
  store64(dyn-name-tab + dyn-count * 8, name)
  store64(dyn-fn-tab + dyn-count * 8, fn-addr)
  store64(dyn-prov-phys + dyn-count * 8, prov-phys)
  store64(dyn-prov-base + dyn-count * 8, prov-base)
  store64(dyn-prov-size + dyn-count * 8, prov-size)
  dyn-count = dyn-count + 1
  return
}

// Register the nanokernel's own export table (boot-image header field
// [40..48] holds the table's absolute virtual address). Kernel symbols need
// no provider mapping: kernel text is mapped in every kernel-clone domain.
fn dyn-register-kernel-exports(port: Int) -> Int {
  let table = load64(KERNEL-HEADER + 40)
  if table == 0 {
    serial-write-cstr(port, "  SCI: kernel exports: none")
    serial-nl(port)
    return -1
  }
  dyn-ensure-tables()
  let count = load64(table + 0)
  let i = 0
  while i < count && dyn-count < DYN-MAX-EXPORTS {
    let rec = table + 8 + i * 16
    dyn-add(table + load64(rec + 0), KERNEL-CODE-BASE + load64(rec + 8), 0, 0, 0)
    i = i + 1
  }
  serial-write-cstr(port, "  SCI: kernel exports registered: ")
  serial-write-dec-wide(port, count)
  serial-nl(port)
  return 0
}

// Register the export table of a loaded SCI v2 image as a provider record so
// later modules can import from it (chained dynamic modules).
fn dyn-register-image-exports(port: Int, load-addr: Int, entry: Int, image-size: Int) -> Int {
  if load64(load-addr) != SCI-MAGIC-V2 {
    return -1
  }
  let export-count = load64(load-addr + SCI-V2-EXPORT-COUNT)
  if export-count == 0 {
    return 0
  }
  dyn-ensure-tables()
  let export-table = load-addr + load64(load-addr + SCI-V2-EXPORT-TABLE)
  let i = 0
  while i < export-count && dyn-count < DYN-MAX-EXPORTS {
    let rec = export-table + i * 16
    dyn-add(load-addr + load64(rec + 0), entry + load64(rec + 8), load-addr, entry - SCI-V2-HEADER, image-size)
    i = i + 1
  }
  return 0
}

// Register a shared-library SCI (boot-image kind 7 = libspace, kind 14 =
// appapi): validate its manifest, record its physical image, and copy its
// export table into the registry. Each library keeps its own provider base,
// so any number of libraries can coexist; importing components map each
// provider's text at the base that library was linked at. Library text is
// later mapped into importing components at its linked virtual base.
fn sci-register-library(port: Int, load-addr: Int) -> Int {
  if load-addr == 0 {
    return -1
  }
  let magic = load64(load-addr + 0)
  if magic != SCI-MAGIC-V2 {
    serial-write-cstr(port, "  SCI: library manifest is not SCI v2")
    serial-nl(port)
    return -1
  }
  let required = load64(load-addr + 8)
  let missing = required & (-1 ^ SCI-LIB-GRANTS)
  if missing != 0 {
    serial-write-cstr(port, "  SCI: DENIED library cap 0x")
    serial-write-hex(port, missing)
    serial-nl(port)
    return -1
  }
  let img-entry = load64(load-addr + 16)
  let img-size = load64(load-addr + 24)
  dyn-ensure-tables()
  let export-count = load64(load-addr + SCI-V2-EXPORT-COUNT)
  let export-table = load-addr + load64(load-addr + SCI-V2-EXPORT-TABLE)
  let i = 0
  while i < export-count && dyn-count < DYN-MAX-EXPORTS {
    let rec = export-table + i * 16
    dyn-add(load-addr + load64(rec + 0), img-entry + load64(rec + 8), load-addr, img-entry - SCI-V2-HEADER, img-size)
    i = i + 1
  }
  lib-phys = load-addr
  lib-entry = img-entry
  lib-size = img-size
  lib-registered = 1
  serial-write-cstr(port, "  SCI: library registered at 0x")
  serial-write-hex(port, img-entry)
  serial-write-cstr(port, ", ")
  serial-write-dec-wide(port, export-count)
  serial-write-cstr(port, " exports")
  serial-nl(port)
  return 0
}

// Map a registry entry's provider image (if any) into the importing domain
// as shared RX text. Kernel providers (provider phys 0) need no mapping.
fn dyn-map-provider(domain: Int, idx: Int) -> void {
  let phys = load64(dyn-prov-phys + idx * 8)
  if phys == 0 {
    return
  }
  let base = load64(dyn-prov-base + idx * 8)
  let size = load64(dyn-prov-size + idx * 8)
  let pages = (size + 4095) / 4096
  let p = 0
  while p < pages {
    domain-map-user-code(domain, base + p * 4096, phys + p * 4096)
    p = p + 1
  }
  return
}

// Bind a component's imports: resolve each name against the registry, map
// the provider's image into the component's domain as shared RX text, and
// patch the `call rel32` displacement. Returns -1 (deny load) when any
// import has no registered provider.
fn sci-bind-imports(port: Int, load-addr: Int, domain: Int, entry: Int) -> Int {
  // Only SCI v2 images carry an import table; v1 (32-byte manifest) images
  // have no symbol tables — offset 48 is component code there.
  if load64(load-addr) != SCI-MAGIC-V2 {
    return 0
  }
  let count = load64(load-addr + SCI-V2-IMPORT-COUNT)
  if count == 0 {
    return 0
  }
  if dyn-count == 0 {
    serial-write-cstr(port, "  SCI: DENIED no provider registered")
    serial-nl(port)
    return -1
  }
  let import-table = load-addr + load64(load-addr + SCI-V2-IMPORT-TABLE)
  let i = 0
  while i < count {
    let rec = import-table + i * 16
    let name = load-addr + load64(rec + 0)
    let site = load64(rec + 8)
    let idx = dyn-resolve-idx(name)
    if idx < 0 {
      serial-write-cstr(port, "  SCI: DENIED unresolved import ")
      serial-write-cstr(port, name)
      serial-nl(port)
      return -1
    }
    dyn-map-provider(domain, idx)
    // rel32 displacement relative to the next instruction (site + 5).
    // Site offsets are manifest-relative (the 64-byte SCI v2 header precedes
    // the code), and `entry` is the linked code start (base + 64), so
    // entry + site is the call's virtual address — the same byte the store
    // below patches through the kernel's identity map of `load-addr`.
    let site-virt = entry + site
    store32(load-addr + SCI-V2-HEADER + site + 1, load64(dyn-fn-tab + idx * 8) - site-virt - 5)
    i = i + 1
  }
  serial-write-cstr(port, "  SCI: bound ")
  serial-write-dec-wide(port, count)
  serial-write-cstr(port, " imports")
  serial-nl(port)
  return 0
}

fn sci-load-runtime-component(port: Int, load-addr: Int, name: Int, grants: Int, sync: Int, args: Int) -> Int {
  serial-write-cstr(port, "  SCI: loading ")
  serial-write-cstr(port, name)
  serial-nl(port)
  if load-addr == 0 {
    serial-write-cstr(port, "  SCI: null load address")
    serial-nl(port)
    return -1
  }
  let magic = load64(load-addr + 0)
  if magic != SCI-MAGIC && magic != SCI-MAGIC-V2 {
    serial-write-cstr(port, "  SCI: no valid component manifest at 0x")
    serial-write-hex(port, load-addr)
    serial-nl(port)
    return -1
  }
  let header = 32
  if magic == SCI-MAGIC-V2 {
    header = SCI-V2-HEADER
  }
  let required = load64(load-addr + 8)
  let entry = load64(load-addr + 16)
  let image-size = load64(load-addr + 24)
  serial-write-cstr(port, "  SCI: manifest ok entry 0x")
  serial-write-hex(port, entry)
  serial-nl(port)

  let missing = required & (-1 ^ grants)
  if missing != 0 {
    serial-write-cstr(port, "  SCI: DENIED undeclared cap 0x")
    serial-write-hex(port, missing)
    serial-nl(port)
    return -1
  }
  let domain = domain-create()
  if domain <= 0 {
    serial-write-cstr(port, "  SCI: domain_create failed")
    serial-nl(port)
    return -1
  }
  serial-write-cstr(port, "  SCI: domain created")
  serial-nl(port)

  let component = component-register(name, entry, required)
  let virt-load = entry - header
  let image-pages = (image-size + 4096 - 1) / 4096
  let i = 0
  while i < image-pages {
    domain-map-user-code(domain, virt-load + i * 4096, load-addr + i * 4096)
    i = i + 1
  }
  serial-write-cstr(port, "  SCI: image mapped")
  serial-nl(port)

  // Bind imports before the component ever runs (SCI v2 dynamic linking).
  if sci-bind-imports(port, load-addr, domain, entry) != 0 {
    return -1
  }
  // Chained dynamic modules: this component's exports become importable.
  dyn-register-image-exports(port, load-addr, entry, image-size)

  // Allocate and map a 2 MiB heap for the component.
  let heap-pages = COMP-HEAP-SIZE / 4096
  let j = 0
  while j < heap-pages {
    let p = frame-alloc()
    domain-map-user-data(domain, COMP-HEAP-VIRT + j * 4096, p)
    j = j + 1
  }
  serial-write-cstr(port, "  SCI: heap mapped")
  serial-nl(port)

  // Create a cross-domain shared page and initialize it as a ring channel.
  let shared = domain-create-shared-page(0, domain, COMP-SHARED-VIRT, COMP-SHARED-VIRT)
  store64(shared + 0, 0)   // head
  store64(shared + 8, 0)   // tail
  store64(shared + 16, 508)  // capacity
  store64(shared + 24, 8)      // msg_size
  let k = 0
  while k < 504 {
    store64(shared + 32 + k * 8, 0)
    k = k + 1
  }
  serial-write-cstr(port, "  SCI: shared page mapped")
  serial-nl(port)

  store64(component + 40, domain)
  obj-link(root-realm, component)

  // cap-info is the app ABI page (APP-API v1): grants@0, heap@16/24,
  // shared page@32, domain@40, console size@48/56, args string@64. The
  // args pointer targets memory owned by the caller (empty string when
  // the launcher passes none).
  let cap-info = alloc(96)
  store64(cap-info + 0, grants)
  store64(cap-info + 8, 0)
  store64(cap-info + 16, COMP-HEAP-VIRT)
  store64(cap-info + 24, COMP-HEAP-SIZE)
  store64(cap-info + 32, COMP-SHARED-VIRT)
  store64(cap-info + 40, domain)
  store64(cap-info + 48, 800)
  store64(cap-info + 56, 600)
  store64(cap-info + 64, args)

  serial-write-cstr(port, "  SCI: starting ")
  serial-write-cstr(port, name)
  serial-nl(port)
  if sync != 0 {
    // Synchronous mode (runapp): run the component entry inside its own
    // domain and return its status. No preempt thread is registered, so
    // apps work after preempt-stop, when the shell owns the CPU.
    let prev = domain-get-current()
    domain-switch(domain)
    let rc = invoke1(entry, cap-info)
    domain-switch(prev)
    serial-write-cstr(port, "  SCI: ")
    serial-write-cstr(port, name)
    serial-write-cstr(port, " exited 0x")
    serial-write-hex(port, rc)
    serial-nl(port)
    return rc
  }
  comp-entry-arg = entry
  comp-cap-info-arg = cap-info
  comp-domain-arg = domain
  let tid = thr-create(comp-thread-wrapper)
  store64(component + 48, tid)
  let stack = alloc(65536)
  preempt-register-component(port, entry, cap-info, domain, stack + 65536)
  serial-write-cstr(port, "  SCI: ")
  serial-write-cstr(port, name)
  serial-write-cstr(port, " thread 0x")
  serial-write-hex(port, tid)
  serial-nl(port)
  return 0
}

fn sci-volume-nvme-load(heap-frames: Int) -> Int {
  let i = 0
  while i < 256 {
    if nvme-read(VOLUME-NVME-LBA + i * 8, 8, storage-data-page) != 0 {
      return -1
    }
    let dst = load64(heap-frames + (i + 2) * 8)
    let k = 0
    while k < 4096 {
      store8(dst + k, load8(storage-data-page + k))
      k = k + 1
    }
    i = i + 1
  }
  return 0
}

fn sci-volume-nvme-flush(heap-frames: Int) -> Int {
  let i = 0
  while i < 256 {
    let src = load64(heap-frames + (i + 2) * 8)
    let k = 0
    while k < 4096 {
      store8(storage-data-page + k, load8(src + k))
      k = k + 1
    }
    if nvme-write(VOLUME-NVME-LBA + i * 8, 8, storage-data-page) != 0 {
      return -1
    }
    i = i + 1
  }
  return 0
}

fn sci-volume-rpc(port: Int, load-addr: Int) -> Int {
  let required = load64(load-addr + 8)
  let entry = load64(load-addr + 16)
  let image-size = load64(load-addr + 24)
  let magic = load64(load-addr)
  let header = 32
  if magic == SCI-MAGIC-V2 {
    header = SCI-V2-HEADER
  }
  if magic != SCI-MAGIC && magic != SCI-MAGIC-V2 {
    return -1
  }
  if (required & (-1 ^ SCI-VOLUME-GRANTS)) != 0 {
    return -1
  }
  let domain = domain-create()
  if domain <= 0 { return -1 }
  let pages = (image-size + 4095) / 4096
  let i = 0
  while i < pages {
    domain-map-user-code(domain, entry - header + i * 4096, load-addr + i * 4096)
    i = i + 1
  }
  if sci-bind-imports(port, load-addr, domain, entry) != 0 {
    return -1
  }
  let heap = COMP-HEAP-VIRT
  let heap-frames = alloc(COMP-HEAP-SIZE / 4096 * 8)
  let j = 0
  while j < COMP-HEAP-SIZE / 4096 {
    let frame = frame-alloc()
    store64(heap-frames + j * 8, frame)
    domain-map-user-data(domain, heap + j * 4096, frame)
    j = j + 1
  }
  let shared = domain-create-shared-page(0, domain, COMP-SHARED-VIRT, COMP-SHARED-VIRT)
  if shared == 0 { return -1 }
  let cap-info = alloc(64)
  store64(cap-info + 16, heap)
  store64(cap-info + 24, COMP-HEAP-SIZE)
  store64(cap-info + 32, COMP-SHARED-VIRT)
  let mounted = 0
  if nvme-ready != 0 {
    serial-write-cstr(port, "volume: loading NVMe backing")
    serial-nl(port)
    if sci-volume-nvme-load(heap-frames) == 0 {
      if load32(load64(heap-frames + 16)) == 0x53504146 {
        mounted = 1
      }
    }
    serial-write-cstr(port, "volume: NVMe backing loaded")
    serial-nl(port)
    // A missing backing filesystem must not become an implicit disk format.
    // Leave Volume unavailable so the caller can continue without writing it.
    if mounted == 0 {
      return -1
    }
  }
  store64(cap-info + 40, mounted)

  store64(COMP-SHARED-VIRT + 0, 1)
  store64(COMP-SHARED-VIRT + 8, 0)
  store64(COMP-SHARED-VIRT + 16, 1)
  domain-switch(domain)
  let init-rc = invoke1(entry, cap-info)
  domain-switch(0)
  if init-rc != 0 || load64(COMP-SHARED-VIRT + 24) != 0 { return -1 }
  if mounted != 0 {
    serial-write-cstr(port, "volume: persistent mount passed")
    serial-nl(port)
  }

  store8(COMP-SHARED-VIRT + 256, 47)
  store8(COMP-SHARED-VIRT + 257, 118)
  store8(COMP-SHARED-VIRT + 258, 111)
  store8(COMP-SHARED-VIRT + 259, 108)
  store8(COMP-SHARED-VIRT + 260, 117)
  store8(COMP-SHARED-VIRT + 261, 109)
  store8(COMP-SHARED-VIRT + 262, 101)
  store8(COMP-SHARED-VIRT + 263, 0)
  store64(COMP-SHARED-VIRT + 32, 64)
  store64(COMP-SHARED-VIRT + 0, 1)
  store64(COMP-SHARED-VIRT + 8, 0)
  store64(COMP-SHARED-VIRT + 16, 2)
  domain-switch(domain)
  let open-rc = invoke1(entry, cap-info)
  domain-switch(0)
  if open-rc != 0 || load64(COMP-SHARED-VIRT + 24) != 0 || load64(COMP-SHARED-VIRT + 56) < 0 { return -1 }

  store8(COMP-SHARED-VIRT + 768, 118)
  store8(COMP-SHARED-VIRT + 769, 111)
  store8(COMP-SHARED-VIRT + 770, 108)
  store8(COMP-SHARED-VIRT + 771, 117)
  store8(COMP-SHARED-VIRT + 772, 109)
  store8(COMP-SHARED-VIRT + 773, 101)
  store64(COMP-SHARED-VIRT + 32, 0)
  store64(COMP-SHARED-VIRT + 40, 6)
  store64(COMP-SHARED-VIRT + 0, 1)
  store64(COMP-SHARED-VIRT + 8, 0)
  store64(COMP-SHARED-VIRT + 16, 5)
  domain-switch(domain)
  let write-rc = invoke1(entry, cap-info)
  domain-switch(0)
  if write-rc != 0 || load64(COMP-SHARED-VIRT + 56) != 6 { return -1 }
  if nvme-ready != 0 {
    if sci-volume-nvme-flush(heap-frames) != 0 { return -1 }
    serial-write-cstr(port, "volume: NVMe backing flushed")
    serial-nl(port)
  }

  store8(COMP-SHARED-VIRT + 768, 0)
  store64(COMP-SHARED-VIRT + 40, 6)
  store64(COMP-SHARED-VIRT + 0, 1)
  store64(COMP-SHARED-VIRT + 8, 0)
  store64(COMP-SHARED-VIRT + 16, 4)
  domain-switch(domain)
  let read-rc = invoke1(entry, cap-info)
  domain-switch(0)
  if read-rc != 0 || load64(COMP-SHARED-VIRT + 56) != 6 || load8(COMP-SHARED-VIRT + 768) != 118 || load8(COMP-SHARED-VIRT + 773) != 101 { return -1 }
  serial-write-cstr(port, "volume: component init/write/read passed")
  serial-nl(port)

  volume-ready = 1
  volume-domain = domain
  volume-entry-addr = entry
  volume-cap-info = cap-info
  volume-heap-frames = heap-frames
  // Physical page: display/input later remap COMP-SHARED-VIRT in domain 0.
  volume-shared = shared
  serial-write-cstr(port, "volume: client bound")
  serial-nl(port)
  return 0
}

fn volume-copy-path(dst: Int, src: Int) -> void {
  let i = 0
  while i < 255 && load8(src + i) != 0 {
    store8(dst + i, load8(src + i))
    i = i + 1
  }
  store8(dst + i, 0)
  return
}

fn volume-rpc-call(op: Int, flush: Int) -> Int {
  if volume-ready == 0 {
    return -1
  }
  store64(volume-shared + 0, 1)
  store64(volume-shared + 8, 0)
  store64(volume-shared + 16, op)
  store64(volume-shared + 24, 0)
  store64(volume-shared + 56, 0)
  let prev = domain-get-current()
  domain-switch(volume-domain)
  let rc = invoke1(volume-entry-addr, volume-cap-info)
  domain-switch(prev)
  if rc != 0 {
    return -1
  }
  if flush != 0 && nvme-ready != 0 && volume-heap-frames != 0 {
    if sci-volume-nvme-flush(volume-heap-frames) != 0 {
      return -1
    }
  }
  if volume-via-marker == 0 {
    volume-via-marker = 1
    serial-write-cstr(com1(), "volume: filesystem op via Volume RPC")
    serial-nl(com1())
  }
  let status = load64(volume-shared + 24)
  let result = load64(volume-shared + 56)
  if status != 0 {
    if result < 0 {
      return result
    }
    return -1
  }
  return result
}

fn volume-rpc-open(path: Int, flags: Int) -> Int {
  volume-copy-path(volume-shared + 256, path)
  store64(volume-shared + 32, flags)
  let r = volume-rpc-call(2, 0)
  if r < 0 {
    return -1
  }
  return r
}

fn volume-rpc-pread(path: Int, buf: Int, count: Int, offset: Int) -> Int {
  let total = 0
  let remaining = count
  let off = offset
  while remaining > 0 {
    volume-copy-path(volume-shared + 256, path)
    store64(volume-shared + 32, off)
    let n = remaining
    if n > 3328 {
      n = 3328
    }
    store64(volume-shared + 40, n)
    store64(volume-shared + 48, 0)
    let got = volume-rpc-call(4, 0)
    if got < 0 {
      if total > 0 {
        return total
      }
      return got
    }
    if got == 0 {
      return total
    }
    if got > n {
      got = n
    }
    let i = 0
    while i < got {
      store8(buf + total + i, load8(volume-shared + 768 + i))
      i = i + 1
    }
    total = total + got
    off = off + got
    remaining = remaining - got
    if got < n {
      return total
    }
  }
  return total
}

fn volume-rpc-pwrite(path: Int, buf: Int, count: Int, offset: Int) -> Int {
  let total = 0
  let remaining = count
  let off = offset
  while remaining > 0 {
    volume-copy-path(volume-shared + 256, path)
    store64(volume-shared + 32, off)
    let n = remaining
    if n > 3328 {
      n = 3328
    }
    store64(volume-shared + 40, n)
    store64(volume-shared + 48, 0)
    let i = 0
    while i < n {
      store8(volume-shared + 768 + i, load8(buf + total + i))
      i = i + 1
    }
    let wrote = volume-rpc-call(5, 1)
    if wrote < 0 {
      if total > 0 {
        return total
      }
      return wrote
    }
    if wrote == 0 {
      return total
    }
    if wrote > n {
      wrote = n
    }
    total = total + wrote
    off = off + wrote
    remaining = remaining - wrote
  }
  return total
}

fn volume-rpc-stat(path: Int, stat-buf: Int) -> Int {
  volume-copy-path(volume-shared + 256, path)
  let rc = volume-rpc-call(7, 0)
  if rc < 0 {
    return -1
  }
  let i = 0
  while i < 64 {
    store8(stat-buf + i, load8(volume-shared + 768 + i))
    i = i + 1
  }
  return rc
}

fn volume-rpc-delete(path: Int) -> Int {
  volume-copy-path(volume-shared + 256, path)
  return volume-rpc-call(9, 1)
}

fn volume-rpc-mkdir(path: Int) -> Int {
  volume-copy-path(volume-shared + 256, path)
  return volume-rpc-call(10, 1)
}

fn volume-rpc-rmdir(path: Int) -> Int {
  volume-copy-path(volume-shared + 256, path)
  return volume-rpc-call(11, 1)
}

fn volume-rpc-rename(old-path: Int, new-path: Int) -> Int {
  volume-copy-path(volume-shared + 256, old-path)
  volume-copy-path(volume-shared + 512, new-path)
  return volume-rpc-call(12, 1)
}

// List directory entries via Volume RPC into caller buffer. Returns byte count.
fn volume-rpc-list(path: Int, buf: Int, max: Int) -> Int {
  volume-copy-path(volume-shared + 256, path)
  let n = volume-rpc-call(8, 0)
  if n < 0 {
    return n
  }
  let copy = n
  if copy > max - 1 {
    copy = max - 1
  }
  let i = 0
  while i < copy {
    store8(buf + i, load8(volume-shared + 768 + i))
    i = i + 1
  }
  store8(buf + copy, 0)
  return copy
}

fn volume-rpc-read-file(path: Int, buf: Int, max: Int) -> Int {
  return volume-rpc-pread(path, buf, max, 0)
}

fn volume-rpc-write-file(path: Int, buf: Int, size: Int) -> Int {
  let open-rc = volume-rpc-open(path, 64)
  if open-rc < 0 {
    return -1
  }
  let wrote = volume-rpc-pwrite(path, buf, size, 0)
  if wrote < size {
    return -1
  }
  return wrote
}

fn sci-load(port: Int, load-addr: Int) -> Int {
  // Heap buffers (execve / load-arena) sit above the fixed boot SCI slots.
  if load-addr == 0 {
    serial-write-cstr(port, "  SCI: null load address")
    serial-nl(port)
    return -1
  }
  let magic = load64(load-addr + 0)
  if magic != SCI-MAGIC && magic != SCI-MAGIC-V2 {
    serial-write-cstr(port, "  SCI: no valid component manifest at 0x")
    serial-write-hex(port, load-addr)
    serial-nl(port)
    return -1
  }
  let header = 32
  if magic == SCI-MAGIC-V2 {
    header = SCI-V2-HEADER
  }
  let required = load64(load-addr + 8)
  let entry = load64(load-addr + 16)
  let image-size = load64(load-addr + 24)
  serial-write-cstr(port, "  SCI: manifest ok, caps 0x")
  serial-write-hex(port, required)
  serial-write-cstr(port, " entry 0x")
  serial-write-hex(port, entry)
  serial-nl(port)
  let missing = required & (-1 ^ SCI-GUEST-GRANTS)
  if missing != 0 {
    serial-write-cstr(port, "  SCI: DENIED undeclared cap 0x")
    serial-write-hex(port, missing)
    serial-nl(port)
    return -1
  }
  let domain = domain-create-user()
  if domain <= 0 {
    serial-write-cstr(port, "  SCI: domain_create failed")
    serial-nl(port)
    return -1
  }
  let component = component-register("sci-guest", entry, required)
  let virt-load = entry - header
  let image-pages = (image-size + 4095) / 4096
  let i = 0
  while i < image-pages {
    domain-map-user-code(domain, virt-load + i * 4096, load-addr + i * 4096)
    i = i + 1
  }
  // Keep the rest of the 2 MiB guest window executable after any 4 KiB split.
  serial-write-cstr(port, "  SCI: domain 0x")
  serial-write-hex(port, domain)
  serial-write-cstr(port, ", mapped 0x")
  serial-write-hex(port, image-pages)
  serial-write-cstr(port, " pages, cap check passed")
  serial-nl(port)
  // Bind imports before the component ever runs (SCI v2 dynamic linking).
  if sci-bind-imports(port, load-addr, domain, entry) != 0 {
    return -1
  }
  dyn-register-image-exports(port, load-addr, entry, image-size)
  store64(component + 40, domain)
  obj-link(root-realm, component)
  serial-write-cstr(port, "  SCI: registered component object id 0x")
  serial-write-hex(port, obj-id(component))
  serial-nl(port)
  let cap-info = alloc(16)
  store64(cap-info + 0, required)
  store64(cap-info + 8, 0)
  let status = domain-enter-user(entry, cap-info, domain)
  store64(component + 48, status)
  serial-write-cstr(port, "  SCI: component returned status 0x")
  serial-write-hex(port, status)
  serial-nl(port)
  return status
}
