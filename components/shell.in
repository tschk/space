package space.kernel

// Full desktop/personality shell profile and bounded integration proofs.
import "shell-common.in"

fn shell(port: Int) -> void {
  line = alloc(256)
  shell-cwd = alloc(1024)
  shell-hist = alloc(SHELL-HIST-N * SHELL-HIST-LEN)
  shell-draft = alloc(SHELL-HIST-LEN)
  shell-hist-len = 0
  shell-hist-head = 0
  shell-hist-view = 0
  shell-pushback = 0
  store8(shell-cwd, 47)
  store8(shell-cwd + 1, 0)
  serial-nl(port)
  serial-write-cstr(port, "space interactive shell -- type 'help'")
  serial-nl(port)
  while true {
    serial-write-cstr(port, "space> ")
    let n = read-line(port)
    shell-strip-bg(port)
    if shell-try-pipe(port) != 0 {
    } else if shell-try-redir(port) != 0 {
    } else if line-eq("help") != 0 {
      serial-write-cstr(port, "help verbose quiet selftest status mem ticks ps kill test det domain chan cap pci net netstat nvme udpsend tcp dhcp dns snapshot spawn restore map sci hello uecho apps runapp exec load_sci run fault divzero echo echo>file echo|cat peek poke proc format ls cd pwd mkdir rmdir rm cat write read mv stat edit libc vfs usb linux linuxelf linuxsyscall linuxfileio darwin darwinmacho darwinsyscall darwinfileio windows windowspe windowsfileio fetch syscall uptime time fb fb test font desktop gui apps bench display dsp test comp halt up/down=hist")
      serial-nl(port)
    } else if line-eq("verbose") != 0 {
      boot-quiet = 0
      serial-write-cstr(port, "  verbose mode enabled")
      serial-nl(port)
    } else if line-eq("quiet") != 0 {
      boot-quiet = 1
      serial-write-cstr(port, "  quiet mode enabled")
      serial-nl(port)
    } else if line-eq("selftest") != 0 {
      serial-write-cstr(port, "  running boot diagnostics...")
      serial-nl(port)
      run-boot-selftest(port)
      serial-write-cstr(port, "  diagnostics complete")
      serial-nl(port)

    } else if line-eq("snapshot") != 0 {
      checkpoint-save()
      serial-write-cstr(port, "  object-graph checkpoint captured at objects 0x")
      serial-write-hex(port, obj-counter)
      serial-nl(port)
    } else if line-eq("spawn") != 0 {
      let o = obj-alloc(3)
      serial-write-cstr(port, "  spawned object id 0x")
      serial-write-hex(port, obj-id(o))
      serial-write-cstr(port, " (objects now 0x")
      serial-write-hex(port, obj-counter)
      serial-write-cstr(port, ")")
      serial-nl(port)
    } else if line-eq("restore") != 0 {
      checkpoint-restore()
      serial-write-cstr(port, "  restored to checkpoint; objects now 0x")
      serial-write-hex(port, obj-counter)
      serial-nl(port)
    } else if line-eq("pci") != 0 {
      pci-scan(port)
    } else if line-eq("net") != 0 {
      run-net(port)
    } else if line-eq("netstat") != 0 {
      sock-netstat(port)
    } else if line-eq("udpsend") != 0 {
      let sfd = sock-socket(2, 2, 17)
      if sfd < 0 {
        serial-write-cstr(port, "  udpsend: socket failed")
        serial-nl(port)
      } else {
        sock-bind(sfd, 0x0A00020F, 9999)
        let n = sock-sendto(sfd, "hello from spaceOS", 18, 0x0A000202, 9999)
        serial-write-cstr(port, "  udpsend: sent ")
        serial-write-dec-wide(port, n)
        serial-nl(port)
        sock-close(sfd)
      }
    } else if line-eq("tcp") != 0 {
      let sfd = sock-socket(2, 1, 6)
      if sfd < 0 {
        serial-write-cstr(port, "  tcp: socket failed")
        serial-nl(port)
      } else {
        // Prefer 8080: check-tcp host listener; 80/443 often closed on SLIRP host.
        let rc = sock-connect(sfd, 0x0A000202, 8080)
        if rc != 0 {
          serial-write-cstr(port, "  tcp: connect 10.0.2.2:8080 failed, try 80")
          serial-nl(port)
          rc = sock-connect(sfd, 0x0A000202, 80)
        }
        if rc != 0 {
          serial-write-cstr(port, "  tcp: connect 80 failed, try 443")
          serial-nl(port)
          rc = sock-connect(sfd, 0x0A000202, 443)
        }
        if rc == 0 {
          serial-write-cstr(port, "  tcp: connect ok fd=")
          serial-write-dec-wide(port, sfd)
          serial-nl(port)
          // Best-effort data path: HTTP GET may get RST on QEMU user net.
          let req = "GET / HTTP/1.0\r\n\r\n"
          let sn = sock-send(sfd, req, 18)
          serial-write-cstr(port, "  tcp: sent ")
          serial-write-dec-wide(port, sn)
          serial-nl(port)
          let rbuf = frame-alloc()
          let rn = sock-recv(sfd, rbuf, 512)
          serial-write-cstr(port, "  tcp: recv ")
          serial-write-dec-wide(port, rn)
          serial-nl(port)
        } else {
          serial-write-cstr(port, "  tcp: connect failed")
          serial-nl(port)
        }
        sock-netstat(port)
        sock-close(sfd)
      }
    } else if line-eq("dhcp") != 0 {
      dhcp-discover(port)
    } else if line-prefix("dns ") >= 0 {
      let dpr = line-prefix("dns ")
      dns-query(port, line + dpr)
    } else if line-eq("dns") != 0 {
      dns-query(port, 0)
    } else if line-eq("det") != 0 {
      run-determinism(port)
    } else if line-eq("domain") != 0 {
      let d = domain-create()
      serial-write-cstr(port, "  created domain 0x")
      serial-write-hex(port, d)
      serial-write-cstr(port, " (total 0x")
      serial-write-hex(port, domain-count)
      serial-write-cstr(port, ")")
      serial-nl(port)
    } else if line-eq("chan") != 0 {
      let d1 = domain-create()
      let d2 = domain-create()
      if d1 > 0 && d2 > 0 {
        let phys = domain-create-shared-page(d1, d2, 0xFFFF8000, 0xFFFF9000)
        if phys != 0 {
          let ch = chan-cross-bind(phys, d1, 16)
          store64(phys + 32, 0xCAFE)
          store64(phys + 0, 1)
          let msg = load64(phys + 32)
          store64(phys + 8, 1)
          serial-write-cstr(port, "  chan: domain 0x")
          serial-write-hex(port, d1)
          serial-write-cstr(port, " <-> domain 0x")
          serial-write-hex(port, d2)
          serial-write-cstr(port, " shared phys 0x")
          serial-write-hex(port, phys)
          serial-write-cstr(port, " msg 0x")
          serial-write-hex(port, msg)
          serial-write-cstr(port, " OK")
          serial-nl(port)
        } else {
          serial-write-cstr(port, "  chan: shared page allocation failed")
          serial-nl(port)
        }
      } else {
        serial-write-cstr(port, "  chan: domain creation failed")
        serial-nl(port)
      }
    } else if line-eq("cap") != 0 {
      let o = obj-alloc(4)
      let idx = cap-mint(o, 7)
      let ok1 = cap-check(idx, 3)
      let ok2 = cap-check(idx, 8)
      let rev = cap-revoke(idx)
      let ok3 = cap-check(idx, 1)
      if ok1 == 1 && ok2 == 0 && rev == 0 && ok3 == 0 {
        serial-write-cstr(port, "  cap OK")
      } else {
        serial-write-cstr(port, "  cap FAIL")
      }
      serial-nl(port)
    } else if line-eq("sci") != 0 {
      sci-load(port, boot-image-find(BOOT-IMAGE-GUEST))
    } else if line-eq("hello") != 0 {
      sci-load(port, boot-image-find(BOOT-IMAGE-USER-HELLO))
    } else if line-eq("uecho") != 0 {
      sci-load(port, boot-image-find(BOOT-IMAGE-USER-ECHO))
    } else if line-eq("apps") != 0 {
      shell-list-apps(port)
    } else if line-prefix("runapp ") >= 0 {
      shell-run-app(port, line + line-prefix("runapp "))
    } else if line-prefix("exec ") >= 0 {
      let arg = line-prefix("exec ")
      let rc = posix-sys-execve(line + arg, 0, 0)
      serial-write-cstr(port, "  exec: returned ")
      serial-write-dec-wide(port, rc)
      serial-nl(port)
    } else if line-eq("map") != 0 {
      let frame = frame-alloc()
      map-page(0x40000000, frame, 3)
      store64(0x40000000, 0xCAFEBABE)
      serial-write-cstr(port, "  mapped virt 0x40000000 -> phys 0x")
      serial-write-hex(port, frame)
      serial-write-cstr(port, " readback 0x")
      serial-write-hex(port, load64(0x40000000))
      serial-nl(port)
    } else if line-eq("fault") != 0 {
      serial-write-cstr(port, "  triggering a page fault at 0x50000000...")
      serial-nl(port)
      store64(0x50000000, 1)
    } else if line-eq("divzero") != 0 {
      serial-write-cstr(port, "  triggering divide-by-zero...")
      serial-nl(port)
      let z = ticks - ticks
      let q = 100 / z
      serial-write-hex(port, q)
      serial-nl(port)
    } else if line-eq("status") != 0 {
      serial-write-cstr(port, "  realm object id 0x")
      serial-write-hex(port, obj-id(root-realm))
      serial-write-cstr(port, " objects 0x")
      serial-write-hex(port, obj-counter)
      serial-write-cstr(port, " caps 0x")
      serial-write-hex(port, cap-count)
      serial-nl(port)
    } else if line-eq("mem") != 0 {
      let used = heap-next - 0x200000
      let total = heap-end - 0x200000
      let free = total - used
      let pct = 0
      if total > 0 { pct = (used * 100) / total }
      serial-write-cstr(port, "  total RAM: ")
      serial-write-dec-wide(port, total-ram / 1048576)
      serial-write-cstr(port, " MiB")
      serial-nl(port)
      serial-write-cstr(port, "  heap total: ")
      serial-write-dec-wide(port, total / 1048576)
      serial-write-cstr(port, " MiB (0x")
      serial-write-hex(port, total)
      serial-write-cstr(port, ")")
      serial-nl(port)
      serial-write-cstr(port, "  heap used:  ")
      serial-write-dec-wide(port, used / 1048576)
      serial-write-cstr(port, " MiB (")
      serial-write-dec-wide(port, pct)
      serial-write-cstr(port, "%)")
      serial-nl(port)
      serial-write-cstr(port, "  kernel heap unallocated: ")
      serial-write-dec-wide(port, mem-heap-free())
      serial-nl(port)
      serial-write-cstr(port, "  heap free:  ")
      serial-write-dec-wide(port, free / 1048576)
      serial-write-cstr(port, " MiB")
      serial-nl(port)
    } else if line-eq("ticks") != 0 {
      serial-write-cstr(port, "  timer ticks 0x")
      serial-write-hex(port, ticks-now())
      serial-nl(port)
    } else if line-eq("ps") != 0 {
      proc-list(port)
    } else if line-prefix("kill ") >= 0 {
      let arg = line-prefix("kill ")
      let pid = atoi(line + arg)
      let sig = SIGTERM
      let sp = next-arg(arg)
      if sp > 0 {
        let a0 = atoi(line + arg)
        let a1 = atoi(line + sp)
        // Support both `kill <pid> [sig]` and `kill -<sig> <pid>`.
        if load8(line + arg) == 45 {
          sig = 0 - a0
          pid = a1
        } else {
          pid = a0
          if a1 != 0 {
            sig = a1
          }
        }
      }
      if proc-signal(pid, sig) != 0 {
        serial-write-cstr(port, "  kill: no such process or signal")
      } else {
        serial-write-cstr(port, "  kill: sent ")
        serial-write-dec-wide(port, sig)
        serial-write-cstr(port, " to pid ")
        serial-write-dec-wide(port, pid)
      }
      serial-nl(port)
    } else if line-eq("test") != 0 {
      serial-write-cstr(port, "  array selftest sum 0x")
      serial-write-hex(port, array-selftest())
      serial-write-cstr(port, " (expect 0x8C)")
      serial-nl(port)
    } else if line-eq("halt") != 0 {
      serial-write-cstr(port, "  halting on request")
      serial-nl(port)
      outb(0xf4, 0)      // QEMU isa-debug-exit (harmless if absent)
      outw(0x604, 0x2000) // QEMU ACPI power-off
      cli()
      while true { hlt() }
    } else if line-eq("uptime") != 0 {
      let secs = ticks / 100
      let umins = secs / 60
      let uhrs = umins / 60
      serial-write-cstr(port, "  ")
      serial-write-dec-wide(port, uhrs)
      serial-write-cstr(port, "h ")
      serial-write-dec-wide(port, umins % 60)
      serial-write-cstr(port, "m ")
      serial-write-dec-wide(port, secs % 60)
      serial-write-cstr(port, "s (")
      serial-write-dec-wide(port, ticks)
      serial-write-cstr(port, " ticks)")
      serial-nl(port)
    } else if line-eq("time") != 0 {
      time-print(port)
    } else if line-eq("syscall") != 0 {
      run-syscall-demo(port)
    } else if line-eq("nvme") != 0 {
      nvme-shell(port)
    } else if line-eq("format") != 0 {
      if fs-format() == 0 {
        store8(shell-cwd, 47)
        store8(shell-cwd + 1, 0)
        serial-write-cstr(port, "  disk formatted")
      } else {
        serial-write-cstr(port, "  format: no disk or write error")
      }
      serial-nl(port)
    } else if line-eq("pwd") != 0 {
      serial-write-cstr(port, "  ")
      serial-write-cstr(port, shell-cwd)
      serial-nl(port)
    } else if line-eq("cd") != 0 {
      store8(shell-cwd, 47)
      store8(shell-cwd + 1, 0)
      serial-write-cstr(port, "  /")
      serial-nl(port)
    } else if line-prefix("cd ") >= 0 {
      let arg = line-prefix("cd ")
      let p = shell-path(line + arg)
      let stat-buf = alloc(64)
      if fs-stat(p, stat-buf) == 0 && load32(stat-buf + SF-ST-TYPE) == SF-TYPE-DIR {
        let i = 0
        while load8(p + i) != 0 && i < 1023 {
          store8(shell-cwd + i, load8(p + i))
          i = i + 1
        }
        store8(shell-cwd + i, 0)
        serial-write-cstr(port, "  ")
        serial-write-cstr(port, shell-cwd)
      } else {
        serial-write-cstr(port, "  cd: not a directory or not found")
      }
      serial-nl(port)
    } else if line-prefix("ls ") >= 0 {
      let ls-arg = line-prefix("ls ")
      fs-list-path(shell-path(line + ls-arg), port)
    } else if line-eq("ls") != 0 {
      fs-list-path(shell-cwd, port)
    } else if line-prefix("mkdir ") >= 0 {
      let arg = line-prefix("mkdir ")
      if fs-mkdir(shell-path(line + arg)) >= 0 {
        serial-write-cstr(port, "  created")
      } else {
        serial-write-cstr(port, "  mkdir: no such parent or already exists")
      }
      serial-nl(port)
    } else if line-prefix("rmdir ") >= 0 {
      let arg = line-prefix("rmdir ")
      if fs-rmdir(shell-path(line + arg)) == 0 {
        serial-write-cstr(port, "  removed")
      } else {
        serial-write-cstr(port, "  rmdir: not found or not empty")
      }
      serial-nl(port)
    } else if line-prefix("rm ") >= 0 {
      let arg = line-prefix("rm ")
      if fs-delete(shell-path(line + arg)) == 0 {
        serial-write-cstr(port, "  deleted")
      } else {
        serial-write-cstr(port, "  rm: not found or is directory")
      }
      serial-nl(port)
    } else if line-prefix("read ") >= 0 {
      let arg = line-prefix("read ")
      let buf = alloc(4096)
      let n = fs-read-file(shell-path(line + arg), buf, 4096)
      if n < 0 {
        serial-write-cstr(port, "  read: file not found")
      } else {
        let i = 0
        while i < n {
          serial-put(port, load8(buf + i))
          i = i + 1
        }
      }
      serial-nl(port)
    } else if line-prefix("cat ") >= 0 {
      let arg = line-prefix("cat ")
      let buf = alloc(4096)
      let n = fs-read-file(shell-path(line + arg), buf, 4096)
      if n < 0 {
        serial-write-cstr(port, "  cat: file not found")
      } else {
        let i = 0
        while i < n {
          serial-put(port, load8(buf + i))
          i = i + 1
        }
      }
      serial-nl(port)
    } else if line-prefix("write ") >= 0 {
      let arg1 = line-prefix("write ")
      let arg2 = next-arg(arg1)
      if arg2 != 0 {
        store8(line + arg2 - 1, 0)
        let len = strlen(line + arg2)
        if fs-write-file(shell-path(line + arg1), line + arg2, len) == 0 {
          serial-write-cstr(port, "  written")
        } else {
          serial-write-cstr(port, "  write: disk full or read-only")
        }
      } else {
        serial-write-cstr(port, "  usage: write <path> <data>")
      }
      serial-nl(port)
    } else if line-prefix("mv ") >= 0 {
      let arg1 = line-prefix("mv ")
      let arg2 = next-arg(arg1)
      if arg2 != 0 {
        store8(line + arg2 - 1, 0)
        if fs-rename(shell-path(line + arg1), shell-path(line + arg2)) == 0 {
          serial-write-cstr(port, "  renamed")
        } else {
          serial-write-cstr(port, "  mv: not found or destination exists")
        }
      } else {
        serial-write-cstr(port, "  usage: mv <old> <new>")
      }
      serial-nl(port)
    } else if line-prefix("stat ") >= 0 {
      let arg = line-prefix("stat ")
      let stat-buf = alloc(64)
      if fs-stat(shell-path(line + arg), stat-buf) == 0 {
        print-stat(port, stat-buf)
      } else {
        serial-write-cstr(port, "  stat: not found")
        serial-nl(port)
      }
    } else if line-prefix("edit ") >= 0 {
      editor-run(port, shell-path(line + line-prefix("edit ")))
    } else if line-eq("libc") != 0 {
      let rc = libc-selftest()
      if rc == 0 {
        serial-write-cstr(port, "  libc self-test passed")
      } else {
        serial-write-cstr(port, "  libc self-test FAILED")
      }
      serial-nl(port)
    } else if line-eq("vfs") != 0 {
      let rc = vfs-selftest()
      if rc != 0 {
        serial-write-cstr(port, "  vfs self-test passed")
      } else {
        serial-write-cstr(port, "  vfs self-test FAILED")
      }
      serial-nl(port)
    } else if line-eq("usb") != 0 {
      usb-kbd-cmd(port)
    } else if line-eq("linux") != 0 {
      linux-demo(port)
    } else if line-eq("linuxsyscall") != 0 {
      linux-syscall-demo(port)
    } else if line-eq("localstream") != 0 {
      foreign-stream-demo(port)
    } else if line-eq("linuxfileio") != 0 {
      foreign-fileio-demo(port, 1)
    } else if line-eq("darwinfileio") != 0 {
      foreign-fileio-demo(port, 2)
    } else if line-eq("windowsfileio") != 0 {
      foreign-fileio-demo(port, 3)
    } else if line-eq("windowspe") != 0 {
      win-pe-demo(port)
    } else if line-eq("linuxelf") != 0 {
      linux-elf-probe(port)
    } else if line-eq("darwinsyscall") != 0 {
      darwin-syscall-demo(port)
    } else if line-eq("darwinmacho") != 0 {
      darwin-macho-demo(port)
    } else if line-eq("darwin") != 0 {
      darwin-demo(port)
    } else if line-eq("windows") != 0 {
      win-demo(port)
    } else if line-eq("fetch") != 0 {
      diagnostics-fetch(port)
    } else if line-eq("desktop") != 0 {
      comp-run(port)
    } else if line-eq("display") != 0 {
      let ch = chan-new(32)
      dsp-init()
      dsp-run(ch, port)
    } else if line-eq("fb test") != 0 {
      fb-test-pattern(port)
    } else if line-eq("bench") != 0 {
      // Self-contained moving-window compositor benchmark. Times 100 stress
      // frames against the PIT tick counter (100 Hz) and reports fps.
      let t0 = ticks
      comp-run-bench(port)
      let t1 = ticks
      let elapsed = t1 - t0
      if elapsed > 0 {
        let fps = (100 * 100) / elapsed
        serial-write-cstr(port, "space: bench elapsed ticks ")
        serial-write-dec-wide(port, elapsed)
        serial-write-cstr(port, " fps ")
        serial-write-dec-wide(port, fps)
        serial-nl(port)
      }
    } else if line-eq("hardening") != 0 {
      // Regression assertions for the kernel-audit fixes (check-audit-fixes.sh).
      let ok = 1
      let c0 = chan-new(0)
      if c0 != 0 {
        ok = 0
        serial-write-cstr(port, "  chan cap=0 not rejected")
        serial-nl(port)
      }
      let c4 = chan-new(4)
      if c4 == 0 {
        ok = 0
        serial-write-cstr(port, "  chan-new(4) failed")
        serial-nl(port)
      }
      if sys-cap-mint(root-realm, -1) != -1 || sys-cap-revoke(0) != -1 {
        ok = 0
        serial-write-cstr(port, "  userspace capability mutation not rejected")
        serial-nl(port)
      }
      let reused-frame = frame-alloc()
      frame-free(reused-frame)
      let reused-frame-next = frame-alloc()
      if reused-frame-next != reused-frame || load64(reused-frame-next) != 0 {
        ok = 0
        serial-write-cstr(port, "  freed frame not reused and cleared")
        serial-nl(port)
      }
      let permission-domain = domain-create-user()
      let permission-code = frame-alloc()
      let permission-data = frame-alloc()
      domain-map-user-code(permission-domain, 0x40000000, permission-code)
      domain-map-user-data(permission-domain, 0x40003000, permission-data)
      let code-flags = domain-page-flags(permission-domain, 0x40000000)
      let data-flags = domain-page-flags(permission-domain, 0x40003000)
      if (code-flags & 4) == 0 || (code-flags & 2) != 0 || (code-flags & PAGE-NX) != 0 {
        ok = 0
        serial-write-cstr(port, "  component code mapping is not user RX")
        serial-nl(port)
      }
      if (data-flags & 7) != 7 || data-flags >= 0 {
        ok = 0
        serial-write-cstr(port, "  component data mapping is not user RW NX")
        serial-nl(port)
      }
      let kernel-flags = domain-page-flags(permission-domain, 0x200000)
      if kernel-flags != 0 {
        ok = 0
        serial-write-cstr(port, "  kernel globals are mapped in the guest tree")
        serial-nl(port)
      }
      let clone-flags = domain-page-flags(permission-domain, 0x80000000)
      if clone-flags != 0 {
        ok = 0
        serial-write-cstr(port, "  guest map still clones the 2-4 GiB identity window")
        serial-nl(port)
      }
      let boot-stack-flags = domain-page-flags(permission-domain, 0x80000)
      if boot-stack-flags != 0 {
        ok = 0
        serial-write-cstr(port, "  guest map still includes the boot kernel stack")
        serial-nl(port)
      }
      let stub-page-flags = domain-page-flags(permission-domain, 0x4000)
      if stub-page-flags != 0 {
        ok = 0
        serial-write-cstr(port, "  guest map still includes published ISR pointers")
        serial-nl(port)
      }
      let cpl3-code = frame-alloc()
      store8(cpl3-code + 0, 0x48)
      store8(cpl3-code + 1, 0xC7)
      store8(cpl3-code + 2, 0xC0)
      store8(cpl3-code + 3, 0x42)
      store8(cpl3-code + 4, 0x00)
      store8(cpl3-code + 5, 0x00)
      store8(cpl3-code + 6, 0x00)
      store8(cpl3-code + 7, 0xC3)
      domain-map-user-code(permission-domain, 0x40004000, cpl3-code)
      let cpl3 = domain-enter-user(0x40004000, 0, permission-domain)
      if cpl3 != 0x42 {
        ok = 0
        serial-write-cstr(port, "  CPL3 enter/exit failed 0x")
        serial-write-hex(port, cpl3)
        serial-nl(port)
      }
      let tramp-flags = domain-page-flags(permission-domain, 0x100000)
      if (tramp-flags & 1) == 0 || (tramp-flags & 4) != 0 {
        ok = 0
        serial-write-cstr(port, "  trampoline is missing or user-accessible")
        serial-nl(port)
      }
      let w = sys-write(1, 0, 10)
      if w != -1 {
        ok = 0
        serial-write-cstr(port, "  sys-write buf=0 not rejected")
        serial-nl(port)
      }
      if load64(0x4058) != 0 || load64(0x4060) != 0 {
        ok = 0
        serial-write-cstr(port, "  cr3 stubs still published")
        serial-nl(port)
      }
      let saved-cap = current-cap
      let weak = cap-mint(root-realm, cap-timer())
      current-cap = weak
      let probe = "x"
      if sys-write(1, probe, 1) != -1 {
        ok = 0
        serial-write-cstr(port, "  sys-write without serial cap not rejected")
        serial-nl(port)
      }
      if sys-chan-create(4) != 0 {
        ok = 0
        serial-write-cstr(port, "  sys-chan-create without graph cap not rejected")
        serial-nl(port)
      }
      current-cap = saved-cap
      let guest-comp = component-register("hard-guest", 0, cap-serial())
      let guest-cap = cap-mint(guest-comp, cap-serial())
      if guest-cap >= 0 {
        let guest-dom = domain-create()
        if guest-dom > 0 {
          domain-set-cap(guest-dom, guest-cap)
          domain-switch(guest-dom)
          let kg = sys-write(1, 0x200000, 16)
          domain-switch(0)
          if kg != -1 {
            ok = 0
            serial-write-cstr(port, "  guest sys-write of kernel globals not rejected")
            serial-nl(port)
          }
        } else {
          cap-revoke(guest-cap)
          component-unregister(guest-comp)
          ok = 0
          serial-write-cstr(port, "  guest domain allocation failed")
          serial-nl(port)
        }
      } else {
        component-unregister(guest-comp)
        ok = 0
        serial-write-cstr(port, "  guest cap mint failed")
        serial-nl(port)
      }
      // DNS parser must reject a truncated message (huge ancount, short len).
      let dbuf = alloc(64)
      let di = 0
      while di < 64 {
        store8(dbuf + di, 0)
        di = di + 1
      }
      store8(dbuf + 0, 0x12)
      store8(dbuf + 6, 0xFF)
      store8(dbuf + 7, 0xFF)
      let dip = dns-parse-a(dbuf, 0, 12)
      if dip != 0 {
        ok = 0
        serial-write-cstr(port, "  dns truncated parse returned a result")
        serial-nl(port)
      }
      if ok != 0 {
        serial-write-cstr(port, "  hardening PASS")
        serial-nl(port)
      } else {
        serial-write-cstr(port, "  hardening FAIL")
        serial-nl(port)
      }
    } else if line-eq("gui apps") != 0 {
      if gui-desktop-run(port) == 0 { serial-write-cstr(port, "  gui: native session unavailable or failed"); serial-nl(port) }
    } else if line-eq("input app") != 0 {
      if input-app-proof(port) == 0 { serial-write-cstr(port, "  seat: SCI proof failed"); serial-nl(port) }
    } else if line-eq("input sci") != 0 {
      if input-sci-proof(port) == 0 { serial-write-cstr(port, "  input: SCI proof failed"); serial-nl(port) }
    } else if line-eq("dsp") != 0 {
      serial-write-cstr(port, "  usage: dsp test | dsp demo | dsp sci left/right/destroy")
      serial-nl(port)
    } else if line-eq("dsp test") != 0 {
      let rc = dsp-selftest(port)
      serial-nl(port)
    } else if line-eq("dsp sci left") != 0 {
      if dsp-sci-demo(port, 0) == 0 { serial-write-cstr(port, "  dsp: SCI frame proof failed"); serial-nl(port) }
    } else if line-eq("dsp sci destroy") != 0 {
      if dsp-sci-demo(port, 2) == 0 { serial-write-cstr(port, "  dsp: SCI frame proof failed"); serial-nl(port) }
    } else if line-eq("dsp sci right") != 0 {
      if dsp-sci-demo(port, 1) == 0 { serial-write-cstr(port, "  dsp: SCI frame proof failed"); serial-nl(port) }
    } else if line-eq("dsp demo") != 0 {
      let rc = dsp-demo(port)
      if rc == 0 {
        serial-write-cstr(port, "  dsp: demo failed")
        serial-nl(port)
      }
      serial-nl(port)
    } else if line-eq("fb") != 0 {
      fb-info(port)
    } else if line-prefix("fb mode ") >= 0 {
      let arg1 = line-prefix("fb mode ")
      let arg2 = next-arg(arg1)
      let mw = atoi(line + arg1)
      let mh = 0
      if arg2 > 0 { mh = atoi(line + arg2) }
      out-set-bga-mode(port, mw, mh, out-scale-num, out-scale-den)
    } else if line-prefix("fb scale ") >= 0 {
      let arg1 = line-prefix("fb scale ")
      let sc = atoi(line + arg1)
      if text-set-scale(sc) != 0 {
        serial-write-cstr(port, "space: text scale ")
        serial-write-dec-wide(port, sc)
        serial-nl(port)
      } else {
        serial-write-cstr(port, "space: text scale refused ")
        serial-write-dec-wide(port, sc)
        serial-nl(port)
      }
    } else if line-eq("font") != 0 {
      serial-write-cstr(port, "space typography: active face=")
      if text-ui-face == FONT-FACE-TTF {
        serial-write-cstr(port, "Space TrueType Sans (Scalable Vector)")
      } else if text-ui-face == FONT-FACE-SANS {
        serial-write-cstr(port, "Space UI Sans (Proportional)")
      } else {
        serial-write-cstr(port, "Space Term Mono (Fixed)")
      }
      serial-nl(port)
      serial-write-cstr(port, "  scale=")
      serial-write-dec-wide(port, fb-font-scale)
      serial-write-cstr(port, " (")
      serial-write-dec-wide(port, out-scale-num)
      serial-write-cstr(port, "%)")
      serial-nl(port)
      serial-write-cstr(port, "  ttf engine: ")
      if ttf-font-valid != 0 {
        serial-write-cstr(port, "active, upem=")
        serial-write-dec-wide(port, ttf-upem)
        serial-write-cstr(port, ", glyphs=")
        serial-write-dec-wide(port, ttf-num-glyphs)
        serial-write-cstr(port, ", format=")
        if ttf-is-otto != 0 {
          serial-write-cstr(port, "OpenType CFF (.otf)")
        } else {
          serial-write-cstr(port, "TrueType (.ttf)")
        }
      } else {
        serial-write-cstr(port, "not loaded")
      }
      serial-nl(port)
    } else if line-prefix("font face ") >= 0 {
      let farg = line-prefix("font face ")
      if str-eq(line + farg, "ttf") != 0 {
        text-set-ui-face(FONT-FACE-TTF)
        serial-write-cstr(port, "space: active face set to TrueType Vector")
      } else if str-eq(line + farg, "sans") != 0 {
        text-set-ui-face(FONT-FACE-SANS)
        serial-write-cstr(port, "space: active face set to Space UI Sans")
      } else if str-eq(line + farg, "mono") != 0 {
        text-set-ui-face(FONT-FACE-MONO)
        serial-write-cstr(port, "space: active face set to Space Term Mono")
      } else {
        serial-write-cstr(port, "space: unknown face (expected mono, sans, or ttf)")
      }
      serial-nl(port)
      comp-full-redraw = 1
      comp-dmg-full()
    } else if line-prefix("font test") >= 0 {
      let sz = 16
      let targ = line-prefix("font test ")
      if targ >= 0 {
        sz = atoi(line + targ)
        if sz < 8 || sz > 48 { sz = 16 }
      }
      serial-write-cstr(port, "space: rendering TTF banner at ")
      serial-write-dec-wide(port, sz)
      serial-write-cstr(port, "px...")
      serial-nl(port)
      let test-buf = alloc(64)
      shell-copy-cstr(test-buf, "Space OS Scalable Typography", 64)
      ttf-draw-string-aa(40, 200, test-buf, 28, sz, 0x38BDF8)
      comp-full-redraw = 1
      comp-dmg-full()
      serial-write-cstr(port, "space: TTF test render complete")
      serial-nl(port)
    } else if line-eq("comp") != 0 {
      comp-init()
      let w1 = comp-win-create("Terminal", 40, 40, 320, 200)
      comp-win-set-content(w1, "Space OS Terminal\n\n> help\n> status\n> ls\n> linux\n\nWelcome to Space OS!")
      let w2 = comp-win-create("File Browser", 400, 60, 280, 160)
      comp-win-set-content(w2, "Files on disk:\n\n(no files yet)")
      let w3 = comp-win-create("System Info", 120, 280, 360, 120)
      comp-win-set-content(w3, "Space OS v0.0.1\nNanokernel + Linux personality\nFramebuffer: active")
      comp-render()
      serial-write-cstr(port, "  comp: rendered OK")
      serial-nl(port)
    } else {
      let rest = line-prefix("desktop ")
      if rest >= 0 {
        comp-run(port)
      } else {
        let rest = line-prefix("echo ")
        if rest >= 0 {
          serial-write-cstr(port, line + rest)
          serial-nl(port)
        } else {
          let rest = line-prefix("peek ")
          if rest >= 0 {
            let addr = str-to-hex(line + rest)
            serial-write-cstr(port, "  [0x")
            serial-write-hex(port, addr)
            serial-write-cstr(port, "] = 0x")
            serial-write-hex(port, load64(addr))
            serial-nl(port)
          } else {
            let rest = line-prefix("poke ")
            if rest >= 0 {
              let space-pos = 0
              while load8(line + rest + space-pos) > 32 {
                space-pos = space-pos + 1
              }
              let addr = str-to-hex(line + rest)
              let val = str-to-hex(line + rest + space-pos + 1)
              store64(addr, val)
              serial-write-cstr(port, "  [0x")
              serial-write-hex(port, addr)
              serial-write-cstr(port, "] := 0x")
              serial-write-hex(port, load64(addr))
              serial-nl(port)
            } else {
              let rest = line-prefix("load_sci ")
              if rest >= 0 {
                proc-spawn-sci(port, line + rest)
              } else {
                let rest = line-prefix("run ")
                if rest >= 0 {
                  proc-spawn-sci(port, line + rest)
                } else {
                let rest = line-prefix("proc ")
                if rest >= 0 {
                  let pid = proc-create(line + rest, proc-dummy-entry, cap-serial())
                  if pid < 0 {
                    serial-write-cstr(port, "  proc: process table full")
                    serial-nl(port)
                  } else {
                    serial-write-cstr(port, "  proc: created process ")
                    serial-write-dec-wide(port, pid)
                    serial-write-cstr(port, " (")
                    serial-write-cstr(port, line + rest)
                    serial-write-cstr(port, "), running...")
                    serial-nl(port)
                    thr-run()
                    serial-write-cstr(port, "  proc: process ")
                    serial-write-dec-wide(port, pid)
                    serial-write-cstr(port, " exited with code ")
                    serial-write-dec-wide(port, proc-wait(pid))
                    serial-nl(port)
                  }
                } else {
                  let rest = line-prefix("write ")

                if rest >= 0 {
                  let sp = 0
                  while load8(line + rest + sp) > 32 {
                    sp = sp + 1
                  }
                  store8(line + rest + sp, 0)
                  let name-addr = line + rest
                  let text-addr = line + rest + sp + 1
                  let tlen = 0
                  while load8(text-addr + tlen) != 0 {
                    tlen = tlen + 1
                  }
                  let rc = fs-write-file(name-addr, text-addr, tlen)
                  if rc != 0 {
                    serial-write-cstr(port, "  write: failed")
                  } else {
                    serial-write-cstr(port, "  write: ok")
                  }
                  serial-nl(port)
                } else {
                  let rest = line-prefix("read ")
                  if rest >= 0 {
                    let rbuf = alloc(4096)
                    let rsize = fs-read-file(line + rest, rbuf, 4096)
                    if rsize < 0 {
                      serial-write-cstr(port, "  read: file not found")
                    } else {
                      serial-write-cstr(port, "  ")
                      let ri = 0
                      while ri < rsize {
                        serial-put(port, load8(rbuf + ri))
                        ri = ri + 1
                      }
                    }
                    serial-nl(port)
                  } else {
                    let rest = line-prefix("rm ")
                    if rest >= 0 {
                      let rc = fs-delete(line + rest)
                      if rc != 0 {
                        serial-write-cstr(port, "  rm: file not found")
                      } else {
                        serial-write-cstr(port, "  rm: deleted")
                      }
                      serial-nl(port)
                    } else {
                      let rest = line-prefix("nvme read ")
                      if rest >= 0 {
                        let lba = str-to-hex(line + rest)
                        nvme-shell-read(port, lba)
                      } else if n != 0 {
                        serial-write-cstr(port, "  unknown command (try 'help')")
                        serial-nl(port)
                      }
                    }
                  }
                }
                }
              }
            }
          }
        }
      }
    }
  }
  }
  return
}

// Bounded synchronous proof: one loader-granted pixel page, not a general window.
fn dsp-adopt-sync-pixels(domain: Int, pool: Int) -> Int {
  let physical = sci-sync-pixels(domain, pool)
  if physical == 0 { return 0 }
  store64(dsp-pools + pool * 8, physical)
  store64(dsp-pool-sizes + pool * 8, 4096)
  return 1
}
var dsp-proof-domain: Int = 0
var dsp-proof-pixel: Int = 0
var dsp-proof-page: Int = 0
var dsp-proof-domain-count: Int = 0
var dsp-proof-cap-count: Int = 0
var dsp-proof-heap-next: Int = 0
var dsp-proof-free-list: Int = 0

fn dsp-sci-demo(port: Int, phase: Int) -> Int {
  if fb-ready == 0 { return 0 }
  let image = 0x2f0000
  if load64(image) != SCI-MAGIC-V2 { return 0 }
  if phase != 0 {
    if dsp-surfaces == 0 || dsp-surface-count == 0 || dsp-proof-domain == 0 { return 0 }
  } else { dsp-init() }
  let args = "left"
  if phase == 1 { args = "right" }
  if phase == 2 { args = "destroy" }
  if phase == 0 {
    if sci-load-retained-component(port, image, "spdp-proof", cap-memory() | cap-display(), args) != 42 { return 0 }
    dsp-proof-domain = sci-sync-domain
    dsp-proof-pixel = sci-sync-pixel-phys
    dsp-proof-page = sci-sync-page
    dsp-proof-domain-count = domain-count
    dsp-proof-cap-count = cap-count
    dsp-proof-heap-next = heap-next
    dsp-proof-free-list = free-list
  } else {
    if sci-sync-domain != dsp-proof-domain || sci-sync-pixel-phys != dsp-proof-pixel || sci-sync-page != dsp-proof-page { return 0 }
    if sci-resume-sync(dsp-proof-domain, args) != 42 { return 0 }
    if sci-sync-domain != dsp-proof-domain || sci-sync-pixel-phys != dsp-proof-pixel || sci-sync-page != dsp-proof-page { return 0 }
    if domain-count != dsp-proof-domain-count || cap-count != dsp-proof-cap-count || heap-next != dsp-proof-heap-next || free-list != dsp-proof-free-list { return 0 }
    serial-write-cstr(port, "  dsp: same SCI instance, allocation counters unchanged")
    serial-nl(port)
  }
  if phase == 2 {
    if dsp-drain-page(sci-sync-page, port) != 2 { return 0 }
    if dsp-surface-valid(0) != 0 || load64(dsp-pools) != 0 || load64(dsp-pool-sizes) != 0 { return 0 }
    dsp-composite()
    serial-write-cstr(port, "  dsp: SCI teardown PASS")
    serial-nl(port)
    return 1
  }
  if dsp-adopt-sync-pixels(sci-sync-domain, 0) == 0 { return 0 }
  let frames = 3
  if phase == 0 { frames = 4 }
  if dsp-drain-page(sci-sync-page, port) != frames { return 0 }
  let pool = load64(dsp-pools)
  let size = load64(dsp-pool-sizes)
  if pool == 0 || size != 4096 || dsp-surface-count != 1 { return 0 }
  dsp-composite()
  serial-write-cstr(port, "  dsp: SCI frame proof ")
  serial-write-dec-wide(port, phase)
  serial-write-cstr(port, " PASS (SCI client pixels)")
  serial-nl(port)
  return 1
}

// Dedicated single-service proof. No app endpoint or seat-event delivery.
fn input-sci-proof(port: Int) -> Int {
  let image = 0x2f0000
  if load64(image) != SCI-MAGIC-V2 { return 0 }
  if sci-load-retained-component(port, image, "input-poll-proof", SCI-INPUT-GRANTS, 0) != 0 { return 0 }
  let domain = sci-sync-domain
  let page = sci-sync-page
  if sci-admit-input-sync(domain) == 0 { return 0 }
  // Ordinary SPDP entry must never accept the input role, even when drained.
  if sci-resume-sync(domain, 0) != -1 { return 0 }
  let message = alloc(8)
  let domains = domain-count
  let caps = cap-count
  let heap = heap-next
  let free = free-list
  serial-write-cstr(port, "  input: retained SCI ready")
  serial-nl(port)
  while true {
    if sci-resume-input-sync(domain) != 0 { return 0 }
    if sci-sync-page != page || sci-sync-domain != domain || domain-count != domains || cap-count != caps || heap-next != heap || free-list != free { return 0 }
    let received = input-page-recv(page, message)
    if received < 0 { return 0 }
    while received == 1 {
      let event = load64(message)
      if (event & 255) == INPUT-EVT-MOUSE-MOVE {
        serial-write-cstr(port, "  input: mouse move ")
        serial-write-dec-wide(port, (event >> 32) & 65535)
        serial-write-cstr(port, ",")
        serial-write-dec-wide(port, (event >> 48) & 65535)
        serial-nl(port)
      }
      if (event & 255) == INPUT-EVT-KEY-DOWN {
        let code = (event >> 16) & 65535
        serial-write-cstr(port, "  input: key ")
        serial-write-dec-wide(port, code)
        serial-nl(port)
        if code == 27 {
          if input-page-recv(page, message) != 0 { return 0 }
          serial-write-cstr(port, "  input: exactly-once, same domain/page, allocation counters unchanged PASS")
          serial-nl(port)
          return 1
        }
      }
      received = input-page-recv(page, message)
      if received < 0 { return 0 }
    }
    pause()
  }
  return 0
}

// Two fixed proof endpoints, synchronous ownership handoff; no seat/focus manager.
fn input-app-proof(port: Int) -> Int {
  if fb-ready == 0 || domain-get-current() != 0 { return 0 }
  if load64(0x2d0000) != SCI-MAGIC-V2 || load64(0x2e0000) != SCI-MAGIC-V2 { return 0 }
  sci-proof-input.unit = 0
  sci-proof-app.unit = 0
  dsp-init()
  let original-domains = domain-count
  if sci-load-retained-component(port, 0x2d0000, "seat-input", SCI-INPUT-GRANTS, 0) != 0 { return 0 }
  if sci-admit-input-sync(sci-sync-domain) == 0 || sci-proof-capture-input() == 0 { return 0 }
  let input-domain = sci-sync-domain
  let input-page = sci-sync-page
  if sci-load-retained-component(port, 0x2e0000, "seat-client", cap-memory() | cap-display(), "init") != 42 { return 0 }
  let app-domain = sci-sync-domain
  let app-page = sci-sync-page
  let pixel = sci-sync-pixel-phys
  if app-domain == input-domain || app-page == input-page || domain-count != original-domains + 2 { return 0 }
  if dsp-adopt-sync-pixels(app-domain, 0) == 0 || dsp-drain-page(app-page, port) != 4 { return 0 }
  if sci-proof-capture-app() == 0 { return 0 }
  dsp-composite()
  let message = alloc(8)
  let domains = domain-count
  let caps = cap-count
  let heap = heap-next
  let free = free-list
  let delivered = 0
  serial-write-cstr(port, "  seat: two SCI endpoints ready")
  serial-nl(port)
  while true {
    if sci-proof-poll-input() != 0 { return 0 }
    let received = input-page-recv(input-page, message)
    if received < 0 { return 0 }
    while received == 1 {
      let event = load64(message)
      if (event & 255) == INPUT-EVT-KEY-DOWN {
        let key = (event >> 16) & 65535
        if key == 27 {
          if delivered != 2 || input-page-recv(input-page, message) != 0 { return 0 }
          if sci-proof-deliver-key(ticks, key) != 42 { return 0 }
          if dsp-drain-page(app-page, port) != 2 { return 0 }
          if dsp-surface-valid(0) != 0 || load64(dsp-pools) != 0 || load64(dsp-pool-sizes) != 0 { return 0 }
          dsp-composite()
          // Logical close only: retire authority for this proof, never free pages.
          if domain-get-current() != 0 { return 0 }
          sci-proof-app.unit = 0
          sci-sync-ring-unit = 0
          let head = load64(app-page)
          let tail = load64(app-page + 8)
          if head != tail || sci-proof-deliver-key(ticks, 27) != -1 || sci-proof-deliver-key(ticks, 97) != -1 { return 0 }
          if load64(app-page) != head || load64(app-page + 8) != tail { return 0 }
          if domain-get-current() != 0 || domain-count != domains || cap-count != caps || heap-next != heap || free-list != free { return 0 }
          if sci-proof-input.domain != input-domain || sci-proof-input.page != input-page || sci-proof-input.unit != 1 || sci-proof-app.domain != app-domain || sci-proof-app.page != app-page || sci-proof-app.pixel_phys != pixel || sci-proof-app.unit != 0 { return 0 }
          serial-write-cstr(port, "  seat: Escape close blue, app retired, no replay PASS")
          serial-nl(port)
          serial-write-cstr(port, "  seat: two renders and one close, stable endpoints/counters PASS")
          serial-nl(port)
          return 1
        }
        if key == 97 || key == 98 {
          if sci-proof-deliver-key(ticks, key) != 42 { return 0 }
          if dsp-drain-page(app-page, port) != 3 { return 0 }
          dsp-composite()
          delivered += 1
          serial-write-cstr(port, "  seat: client pixels updated for key ")
          serial-write-dec-wide(port, key)
          serial-nl(port)
        }
      }
      received = input-page-recv(input-page, message)
      if received < 0 { return 0 }
    }
    if domain-get-current() != 0 || domain-count != domains || cap-count != caps || heap-next != heap || free-list != free { return 0 }
    if sci-proof-input.domain != input-domain || sci-proof-input.page != input-page || sci-proof-app.domain != app-domain || sci-proof-app.page != app-page || sci-proof-app.pixel_phys != pixel { return 0 }
    pause()
  }
  return 0
}
