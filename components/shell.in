package space.kernel

// Interactive serial shell for the Space nanokernel.
// Provides commands for inspecting and controlling the kernel state:
// memory, processes, devices, filesystem, compositor, and debug features.
// Imported by kernel-root.in; available via the `shell(port)` function.

var line: Int = 0
var shell-cwd: Int = 0
var shell-pushback: Int = 0
var shell-hist: Int = 0
var shell-draft: Int = 0
var shell-hist-len: Int = 0
var shell-hist-head: Int = 0
var shell-hist-view: Int = 0

const SHELL-HIST-N = 16
const SHELL-HIST-LEN = 256
const SHELL-KEY-UP = 1002
const SHELL-KEY-DOWN = 1003

// --- serial I/O helpers -----------------------------------------------------
fn serial-has-byte(port: Int) -> Int {
  return inb(port + 5) & 1
}

fn serial-read(port: Int) -> Int {
  while serial-has-byte(port) == 0 {
  }
  return inb(port + 0)
}

fn shell-read-byte(port: Int) -> Int {
  if shell-pushback != 0 {
    let c = shell-pushback
    shell-pushback = 0
    return c
  }
  return serial-read(port)
}

// ESC [ A/B (ANSI) or mouse.in codes 128/131 (PS/2 arrows).
fn shell-read-key(port: Int) -> Int {
  let c = shell-read-byte(port)
  if c == 128 { return SHELL-KEY-UP }
  if c == 131 { return SHELL-KEY-DOWN }
  if c != 27 { return c }
  let n = shell-read-byte(port)
  if n != 91 {
    shell-pushback = n
    return 27
  }
  let f = shell-read-byte(port)
  if f == 65 { return SHELL-KEY-UP }
  if f == 66 { return SHELL-KEY-DOWN }
  return 0
}

fn shell-clear-input(port: Int, len: Int) -> void {
  let i = 0
  while i < len {
    serial-put(port, 8)
    serial-put(port, 32)
    serial-put(port, 8)
    i = i + 1
  }
  return
}

fn shell-copy-cstr(dst: Int, src: Int, max: Int) -> Int {
  let i = 0
  while i < max - 1 && load8(src + i) != 0 {
    store8(dst + i, load8(src + i))
    i = i + 1
  }
  store8(dst + i, 0)
  return i
}

fn shell-hist-slot(idx: Int) -> Int {
  return shell-hist + idx * SHELL-HIST-LEN
}

fn shell-hist-entry(view: Int) -> Int {
  let idx = (shell-hist-head + SHELL-HIST-N - view) % SHELL-HIST-N
  return shell-hist-slot(idx)
}

fn shell-hist-push() -> void {
  if load8(line) == 0 { return }
  if shell-hist-len > 0 {
    let last = (shell-hist-head + SHELL-HIST-N - 1) % SHELL-HIST-N
    let same = 1
    let i = 0
    while i < SHELL-HIST-LEN {
      let a = load8(line + i)
      let b = load8(shell-hist-slot(last) + i)
      if a != b { same = 0 }
      if a == 0 { i = SHELL-HIST-LEN } else { i = i + 1 }
    }
    if same != 0 { return }
  }
  shell-copy-cstr(shell-hist-slot(shell-hist-head), line, SHELL-HIST-LEN)
  shell-hist-head = (shell-hist-head + 1) % SHELL-HIST-N
  if shell-hist-len < SHELL-HIST-N {
    shell-hist-len = shell-hist-len + 1
  }
  return
}

// Read one line into the `line` buffer, echoing input. Returns its length.
fn read-line(port: Int) -> Int {
  let len = 0
  shell-hist-view = 0
  while true {
    let c = shell-read-key(port)
    if c == 0 { continue }
    if (c == 13) || (c == 10) {
      serial-nl(port)
      store8(line + len, 0)
      shell-hist-push()
      shell-hist-view = 0
      return len
    }
    if c == SHELL-KEY-UP {
      if shell-hist-view < shell-hist-len {
        if shell-hist-view == 0 {
          store8(line + len, 0)
          shell-copy-cstr(shell-draft, line, SHELL-HIST-LEN)
        }
        shell-hist-view = shell-hist-view + 1
        shell-clear-input(port, len)
        len = shell-copy-cstr(line, shell-hist-entry(shell-hist-view), SHELL-HIST-LEN)
        serial-write-cstr(port, line)
      }
    } else if c == SHELL-KEY-DOWN {
      if shell-hist-view > 0 {
        shell-hist-view = shell-hist-view - 1
        shell-clear-input(port, len)
        if shell-hist-view == 0 {
          len = shell-copy-cstr(line, shell-draft, SHELL-HIST-LEN)
        } else {
          len = shell-copy-cstr(line, shell-hist-entry(shell-hist-view), SHELL-HIST-LEN)
        }
        serial-write-cstr(port, line)
      }
    } else if (c == 8) || (c == 127) {
      if len > 0 {
        len = len - 1
        serial-put(port, 8)
        serial-put(port, 32)
        serial-put(port, 8)
      }
    } else {
      if c >= 32 && c < 127 && len < 254 {
        serial-put(port, c)
        store8(line + len, c)
        len = len + 1
      }
    }
  }
  return len
}

// Resolve `p` against the shell cwd into a fresh canonical absolute path.
fn shell-path(p: Int) -> Int {
  let out = alloc(1024)
  return sf-normalize-path(shell-cwd, p, out)
}

// Parse a hex string at addr into an integer.
fn str-to-hex(addr: Int) -> Int {
  let result = 0
  let i = 0
  if load8(addr) == 48 && (load8(addr + 1) == 120 || load8(addr + 1) == 88) {
    i = 2
  }
  while i < 16 {
    let c = load8(addr + i)
    if (c >= 48) && (c <= 57) {
      result = result * 16 + c - 48
    } else if (c >= 65) && (c <= 70) {
      result = result * 16 + c - 55
    } else if (c >= 97) && (c <= 102) {
      result = result * 16 + c - 87
    } else {
      return result
    }
    i = i + 1
  }
  return result
}

// Compare the line buffer against a NUL-terminated command string.
fn line-eq(cmd: Int) -> Int {
  let i = 0
  while true {
    let a = load8(line + i)
    let b = load8(cmd + i)
    if a != b {
      return 0
    }
    if a == 0 {
      return 1
    }
    i = i + 1
  }
  return 0
}

// If the line begins with `prefix`, return the index just past it, else -1.
fn line-prefix(prefix: Int) -> Int {
  let i = 0
  while load8(prefix + i) != 0 {
    if load8(line + i) != load8(prefix + i) {
      return -1
    }
    i = i + 1
  }
  return i
}

// Return the index of the next argument after `start`, or 0 if none.
fn next-arg(start: Int) -> Int {
  let i = start
  while load8(line + i) != 0 && load8(line + i) != 32 {
    i = i + 1
  }
  if load8(line + i) == 32 {
    return i + 1
  }
  return 0
}

// Print the value of a stat buffer returned by fs_stat.
fn print-stat(port: Int, stat-buf: Int) -> void {
  serial-write-cstr(port, "  type=")
  let ty = load32(stat-buf + SF-ST-TYPE)
  if ty == SF-TYPE-DIR {
    serial-write-cstr(port, "dir")
  } else if ty == SF-TYPE-FILE {
    serial-write-cstr(port, "file")
  } else {
    serial-write-cstr(port, "?")
  }
  serial-write-cstr(port, "  mode=0x")
  serial-write-hex(port, load32(stat-buf + SF-ST-MODE))
  serial-write-cstr(port, "  size=")
  serial-write-dec-wide(port, load64(stat-buf + SF-ST-SIZE))
  serial-write-cstr(port, "  nlink=")
  serial-write-dec-wide(port, load32(stat-buf + SF-ST-NLINK))
  serial-write-cstr(port, "  mtime=0x")
  serial-write-hex(port, load64(stat-buf + SF-ST-MTIME))
  serial-nl(port)
  return
}

// A self-test of array indexing: sum of squares 0..7 == 140 (0x8C).
fn array-selftest() -> Int {
  let a = alloc(64)
  for i in 0..8 {
    a[i] = i * i
  }
  let sum = 0
  for j in 0..8 {
    sum = sum + a[j]
  }
  return sum
}


fn shell-bg-noop() -> void {
  return
}

fn shell-strip-bg(port: Int) -> void {
  let n = strlen(line)
  while n > 0 && load8(line + n - 1) == 32 {
    n = n - 1
    store8(line + n, 0)
  }
  if n >= 2 && load8(line + n - 1) == 38 && load8(line + n - 2) == 32 {
    store8(line + n - 2, 0)
    let tid = thr-create(shell-bg-noop)
    serial-write-cstr(port, "  bg: thr ")
    serial-write-dec-wide(port, tid)
    serial-nl(port)
  }
  return
}

fn shell-try-pipe(port: Int) -> Int {
  let i = 0
  while load8(line + i) != 0 {
    if load8(line + i) == 124 {
      store8(line + i, 0)
      let right = i + 1
      while load8(line + right) == 32 {
        right = right + 1
      }
      let le = i
      while le > 0 && load8(line + le - 1) == 32 {
        le = le - 1
        store8(line + le, 0)
      }
      let r0 = load8(line + right)
      let r1 = load8(line + right + 1)
      let r2 = load8(line + right + 2)
      let r3 = load8(line + right + 3)
      let is-cat = 0
      if r0 == 99 && r1 == 97 && r2 == 116 && (r3 == 0 || r3 == 32) {
        is-cat = 1
      }
      if is-cat == 0 {
        serial-write-cstr(port, "  pipe: right must be cat")
        serial-nl(port)
        return 1
      }
      redir-buf = alloc(16384)
      redir-pos = 0
      redir-max = 16383
      if line-eq("ls") != 0 {
        fs-list-path(shell-cwd, port)
      } else if line-prefix("ls ") >= 0 {
        fs-list-path(shell-path(line + line-prefix("ls ")), port)
      } else if line-prefix("cat ") >= 0 {
        let abuf = alloc(4096)
        let n = fs-read-file(shell-path(line + line-prefix("cat ")), abuf)
        if n >= 0 {
          let j = 0
          while j < n { serial-put(port, load8(abuf + j)); j = j + 1 }
        }
      } else if line-prefix("read ") >= 0 {
        let abuf = alloc(4096)
        let n = fs-read-file(shell-path(line + line-prefix("read ")), abuf)
        if n >= 0 {
          let j = 0
          while j < n { serial-put(port, load8(abuf + j)); j = j + 1 }
        }
      } else if line-prefix("stat ") >= 0 {
        let sb = alloc(64)
        if fs-stat(shell-path(line + line-prefix("stat ")), sb) == 0 { print-stat(port, sb) }
      } else if line-eq("status") != 0 {
        serial-write-cstr(port, "  realm object id 0x")
        serial-write-hex(port, obj-id(root-realm))
        serial-write-cstr(port, " objects 0x")
        serial-write-hex(port, obj-counter)
        serial-write-cstr(port, " caps 0x")
        serial-write-hex(port, cap-count)
        serial-nl(port)
      } else if line-eq("mem") != 0 {
        let used = heap-next - 0x200000
        let total = heap-end - 0x200000
        let free = total - used
        let pct = 0
        if total > 0 { pct = (used * 100) / total }
        serial-write-cstr(port, "  total RAM: ")
        serial-write-dec-wide(port, total-ram / 1048576)
        serial-write-cstr(port, " MiB")
        serial-nl(port)
        serial-write-cstr(port, "  heap used:  ")
        serial-write-dec-wide(port, used / 1048576)
        serial-write-cstr(port, " MiB / ")
        serial-write-dec-wide(port, total / 1048576)
        serial-write-cstr(port, " MiB (")
        serial-write-dec-wide(port, pct)
        serial-write-cstr(port, "%)")
        serial-nl(port)
        serial-write-cstr(port, "  heap free:  ")
        serial-write-dec-wide(port, free / 1048576)
        serial-write-cstr(port, " MiB")
        serial-nl(port)
      } else if line-prefix("echo ") >= 0 {
        serial-write-cstr(port, line + line-prefix("echo "))
        serial-nl(port)
      }
      store8(redir-buf + redir-pos, 0)
      let pipe-pos = redir-pos
      let pipe-buf = redir-buf
      redir-buf = 0
      redir-pos = 0
      redir-max = 0
      let out-path = 0
      let after-cat = line + right + 3
      if load8(after-cat) == 32 {
        let fp = after-cat + 1
        while load8(fp) == 32 { fp = fp + 1 }
        if load8(fp) != 0 { out-path = fp }
      }
      if out-path != 0 && load8(out-path) != 0 {
        fs-write-file(shell-path(out-path), pipe-buf, pipe-pos)
        serial-write-cstr(port, "  piped to ")
        serial-write-cstr(port, out-path)
        serial-nl(port)
      } else {
        let k = 0
        while k < pipe-pos {
          serial-put-real(port, load8(pipe-buf + k))
          k = k + 1
        }
      }
      return 1
    }
    i = i + 1
  }
  return 0
}

fn shell-run-with-redir(port: Int) -> void {
  if line-eq("ls") != 0 {
    fs-list-path(shell-cwd, port)
  } else if line-prefix("ls ") >= 0 {
    fs-list-path(shell-path(line + line-prefix("ls ")), port)
  } else if line-prefix("cat ") >= 0 {
    let abuf = alloc(4096)
    let n = fs-read-file(shell-path(line + line-prefix("cat ")), abuf)
    if n >= 0 {
      let j = 0
      while j < n { serial-put(port, load8(abuf + j)); j = j + 1 }
    }
  } else if line-prefix("read ") >= 0 {
    let abuf = alloc(4096)
    let n = fs-read-file(shell-path(line + line-prefix("read ")), abuf)
    if n >= 0 {
      let j = 0
      while j < n { serial-put(port, load8(abuf + j)); j = j + 1 }
    }
  } else if line-prefix("stat ") >= 0 {
    let sb = alloc(64)
    if fs-stat(shell-path(line + line-prefix("stat ")), sb) == 0 { print-stat(port, sb) }
  } else if line-eq("status") != 0 {
    serial-write-cstr(port, "  realm object id 0x")
    serial-write-hex(port, obj-id(root-realm))
    serial-write-cstr(port, " objects 0x")
    serial-write-hex(port, obj-counter)
    serial-write-cstr(port, " caps 0x")
    serial-write-hex(port, cap-count)
    serial-nl(port)
  } else if line-eq("mem") != 0 {
    let used = heap-next - 0x200000
    let total = heap-end - 0x200000
    let free = total - used
    let pct = 0
    if total > 0 { pct = (used * 100) / total }
    serial-write-cstr(port, "  total RAM: ")
    serial-write-dec-wide(port, total-ram / 1048576)
    serial-write-cstr(port, " MiB")
    serial-nl(port)
    serial-write-cstr(port, "  heap total: ")
    serial-write-dec-wide(port, total / 1048576)
    serial-write-cstr(port, " MiB")
    serial-nl(port)
    serial-write-cstr(port, "  heap used:  ")
    serial-write-dec-wide(port, used / 1048576)
    serial-write-cstr(port, " MiB (")
    serial-write-dec-wide(port, pct)
    serial-write-cstr(port, "%)")
    serial-nl(port)
    serial-write-cstr(port, "  heap free:  ")
    serial-write-dec-wide(port, free / 1048576)
    serial-write-cstr(port, " MiB")
    serial-nl(port)
  } else if line-eq("ticks") != 0 {
    serial-write-cstr(port, "  timer ticks 0x")
    serial-write-hex(port, ticks)
    serial-nl(port)
  } else if line-eq("ps") != 0 {
    proc-list(port)
  } else if line-eq("uptime") != 0 {
    serial-write-cstr(port, "  ")
    serial-write-dec-wide(port, ticks)
    serial-write-cstr(port, " ticks since boot")
    serial-nl(port)
  } else if line-eq("time") != 0 {
    time-print(port)
  } else if line-prefix("echo ") >= 0 {
    serial-write-cstr(port, line + line-prefix("echo "))
    serial-nl(port)
  } else {
    serial-write-cstr(port, "  unknown command for redir")
    serial-nl(port)
  }
  return
}

fn shell-try-redir(port: Int) -> Int {
  let i = 0
  while load8(line + i) != 0 {
    if load8(line + i) == 62 && load8(line + i + 1) != 62 {
      store8(line + i, 0)
      let path = i + 1
      while load8(line + path) == 32 {
        path = path + 1
      }
      let le = i
      while le > 0 && load8(line + le - 1) == 32 {
        le = le - 1
        store8(line + le, 0)
      }
      if load8(line + path) == 0 {
        serial-write-cstr(port, "  usage: cmd > <path>")
        serial-nl(port)
        return 1
      }
      redir-buf = alloc(16384)
      redir-pos = 0
      redir-max = 16383
      shell-run-with-redir(port)
      store8(redir-buf + redir-pos, 0)
      let rc = fs-write-file(shell-path(line + path), redir-buf, redir-pos)
      redir-buf = 0
      redir-pos = 0
      redir-max = 0
      if rc == 0 {
        serial-write-cstr(port, "  redirected to ")
        serial-write-cstr(port, line + path)
      } else {
        serial-write-cstr(port, "  redirect failed")
      }
      serial-nl(port)
      return 1
    }
    i = i + 1
  }
  return 0
}

// --- interactive serial shell ------------------------------------------------
fn shell(port: Int) -> void {
  line = alloc(256)
  shell-cwd = alloc(1024)
  shell-hist = alloc(SHELL-HIST-N * SHELL-HIST-LEN)
  shell-draft = alloc(SHELL-HIST-LEN)
  shell-hist-len = 0
  shell-hist-head = 0
  shell-hist-view = 0
  shell-pushback = 0
  store8(shell-cwd, 47)
  store8(shell-cwd + 1, 0)
  serial-nl(port)
  serial-write-cstr(port, "space interactive shell -- type 'help'")
  serial-nl(port)
  while true {
    serial-write-cstr(port, "space> ")
    let n = read-line(port)
    shell-strip-bg(port)
    if shell-try-pipe(port) != 0 {
    } else if shell-try-redir(port) != 0 {
    } else if line-eq("help") != 0 {
      serial-write-cstr(port, "help verbose quiet selftest status mem ticks ps kill test det domain chan cap pci net netstat nvme udpsend tcp dhcp dns snapshot spawn restore map sci hello uecho exec load_sci run fault divzero echo echo>file echo|cat peek poke proc format ls cd pwd mkdir rmdir rm cat write read mv stat edit libc vfs usb linux linuxelf darwin windows fetch syscall uptime time fb fb test desktop display dsp test comp halt up/down=hist")
      serial-nl(port)
    } else if line-eq("verbose") != 0 {
      boot-quiet = 0
      serial-write-cstr(port, "  verbose mode enabled")
      serial-nl(port)
    } else if line-eq("quiet") != 0 {
      boot-quiet = 1
      serial-write-cstr(port, "  quiet mode enabled")
      serial-nl(port)
    } else if line-eq("selftest") != 0 {
      serial-write-cstr(port, "  running boot diagnostics...")
      serial-nl(port)
      run-boot-selftest(port)
      serial-write-cstr(port, "  diagnostics complete")
      serial-nl(port)

    } else if line-eq("snapshot") != 0 {
      checkpoint-save()
      serial-write-cstr(port, "  object-graph checkpoint captured at objects 0x")
      serial-write-hex(port, obj-counter)
      serial-nl(port)
    } else if line-eq("spawn") != 0 {
      let o = obj-alloc(3)
      serial-write-cstr(port, "  spawned object id 0x")
      serial-write-hex(port, obj-id(o))
      serial-write-cstr(port, " (objects now 0x")
      serial-write-hex(port, obj-counter)
      serial-write-cstr(port, ")")
      serial-nl(port)
    } else if line-eq("restore") != 0 {
      checkpoint-restore()
      serial-write-cstr(port, "  restored to checkpoint; objects now 0x")
      serial-write-hex(port, obj-counter)
      serial-nl(port)
    } else if line-eq("pci") != 0 {
      pci-scan(port)
    } else if line-eq("net") != 0 {
      run-net(port)
    } else if line-eq("netstat") != 0 {
      sock-netstat(port)
    } else if line-eq("udpsend") != 0 {
      let sfd = sock-socket(2, 2, 17)
      if sfd < 0 {
        serial-write-cstr(port, "  udpsend: socket failed")
        serial-nl(port)
      } else {
        sock-bind(sfd, 0x0A00020F, 9999)
        let n = sock-sendto(sfd, "hello from spaceOS", 18, 0x0A000202, 9999)
        serial-write-cstr(port, "  udpsend: sent ")
        serial-write-dec-wide(port, n)
        serial-nl(port)
        sock-close(sfd)
      }
    } else if line-eq("tcp") != 0 {
      let sfd = sock-socket(2, 1, 6)
      if sfd < 0 {
        serial-write-cstr(port, "  tcp: socket failed")
        serial-nl(port)
      } else {
        let rc = sock-connect(sfd, 0x0A000202, 80)
        if rc != 0 {
          serial-write-cstr(port, "  tcp: connect 10.0.2.2:80 failed, try 8080")
          serial-nl(port)
          rc = sock-connect(sfd, 0x0A000202, 8080)
        }
        if rc != 0 {
          serial-write-cstr(port, "  tcp: connect 8080 failed, try 443")
          serial-nl(port)
          rc = sock-connect(sfd, 0x0A000202, 443)
        }
        if rc == 0 {
          serial-write-cstr(port, "  tcp: connect ok fd=")
          serial-write-dec-wide(port, sfd)
          serial-nl(port)
          // Best-effort data path: HTTP GET may get RST on QEMU user net.
          let req = "GET / HTTP/1.0\r\n\r\n"
          let sn = sock-send(sfd, req, 18)
          serial-write-cstr(port, "  tcp: sent ")
          serial-write-dec-wide(port, sn)
          serial-nl(port)
          let rbuf = frame-alloc()
          let rn = sock-recv(sfd, rbuf, 512)
          serial-write-cstr(port, "  tcp: recv ")
          serial-write-dec-wide(port, rn)
          serial-nl(port)
        } else {
          serial-write-cstr(port, "  tcp: connect failed")
          serial-nl(port)
        }
        sock-netstat(port)
        sock-close(sfd)
      }
    } else if line-eq("dhcp") != 0 {
      dhcp-discover(port)
    } else if line-prefix("dns ") >= 0 {
      let dpr = line-prefix("dns ")
      dns-query(port, line + dpr)
    } else if line-eq("dns") != 0 {
      dns-query(port, 0)
    } else if line-eq("det") != 0 {
      run-determinism(port)
    } else if line-eq("domain") != 0 {
      let d = domain-create()
      serial-write-cstr(port, "  created domain 0x")
      serial-write-hex(port, d)
      serial-write-cstr(port, " (total 0x")
      serial-write-hex(port, domain-count)
      serial-write-cstr(port, ")")
      serial-nl(port)
    } else if line-eq("chan") != 0 {
      let d1 = domain-create()
      let d2 = domain-create()
      if d1 > 0 && d2 > 0 {
        let phys = domain-create-shared-page(d1, d2, 0xFFFF8000, 0xFFFF9000)
        if phys != 0 {
          let ch = chan-cross-bind(phys, d1, 16)
          store64(phys + 32, 0xCAFE)
          store64(phys + 0, 1)
          let msg = load64(phys + 32)
          store64(phys + 8, 1)
          serial-write-cstr(port, "  chan: domain 0x")
          serial-write-hex(port, d1)
          serial-write-cstr(port, " <-> domain 0x")
          serial-write-hex(port, d2)
          serial-write-cstr(port, " shared phys 0x")
          serial-write-hex(port, phys)
          serial-write-cstr(port, " msg 0x")
          serial-write-hex(port, msg)
          serial-write-cstr(port, " OK")
          serial-nl(port)
        } else {
          serial-write-cstr(port, "  chan: shared page allocation failed")
          serial-nl(port)
        }
      } else {
        serial-write-cstr(port, "  chan: domain creation failed")
        serial-nl(port)
      }
    } else if line-eq("cap") != 0 {
      let o = obj-alloc(4)
      let idx = sys-cap-mint(o, 7)
      let ok1 = sys-cap-check(idx, 3)
      let ok2 = sys-cap-check(idx, 8)
      let rev = sys-cap-revoke(idx)
      let ok3 = sys-cap-check(idx, 1)
      if ok1 == 1 && ok2 == 0 && rev == 0 && ok3 == 0 {
        serial-write-cstr(port, "  cap OK")
      } else {
        serial-write-cstr(port, "  cap FAIL")
      }
      serial-nl(port)
    } else if line-eq("sci") != 0 {
      sci-load(port, 0x180000)
    } else if line-eq("hello") != 0 {
      sci-load(port, 0x190000)
    } else if line-eq("uecho") != 0 {
      sci-load(port, 0x1b0000)
    } else if line-prefix("exec ") >= 0 {
      let arg = line-prefix("exec ")
      let rc = posix-sys-execve(line + arg, 0, 0)
      serial-write-cstr(port, "  exec: returned ")
      serial-write-dec-wide(port, rc)
      serial-nl(port)
    } else if line-eq("map") != 0 {
      let frame = frame-alloc()
      map-page(0x40000000, frame, 3)
      store64(0x40000000, 0xCAFEBABE)
      serial-write-cstr(port, "  mapped virt 0x40000000 -> phys 0x")
      serial-write-hex(port, frame)
      serial-write-cstr(port, " readback 0x")
      serial-write-hex(port, load64(0x40000000))
      serial-nl(port)
    } else if line-eq("fault") != 0 {
      serial-write-cstr(port, "  triggering a page fault at 0x50000000...")
      serial-nl(port)
      store64(0x50000000, 1)
    } else if line-eq("divzero") != 0 {
      serial-write-cstr(port, "  triggering divide-by-zero...")
      serial-nl(port)
      let z = ticks - ticks
      let q = 100 / z
      serial-write-hex(port, q)
      serial-nl(port)
    } else if line-eq("status") != 0 {
      serial-write-cstr(port, "  realm object id 0x")
      serial-write-hex(port, obj-id(root-realm))
      serial-write-cstr(port, " objects 0x")
      serial-write-hex(port, obj-counter)
      serial-write-cstr(port, " caps 0x")
      serial-write-hex(port, cap-count)
      serial-nl(port)
    } else if line-eq("mem") != 0 {
      let used = heap-next - 0x200000
      let total = heap-end - 0x200000
      let free = total - used
      let pct = 0
      if total > 0 { pct = (used * 100) / total }
      serial-write-cstr(port, "  total RAM: ")
      serial-write-dec-wide(port, total-ram / 1048576)
      serial-write-cstr(port, " MiB")
      serial-nl(port)
      serial-write-cstr(port, "  heap total: ")
      serial-write-dec-wide(port, total / 1048576)
      serial-write-cstr(port, " MiB (0x")
      serial-write-hex(port, total)
      serial-write-cstr(port, ")")
      serial-nl(port)
      serial-write-cstr(port, "  heap used:  ")
      serial-write-dec-wide(port, used / 1048576)
      serial-write-cstr(port, " MiB (")
      serial-write-dec-wide(port, pct)
      serial-write-cstr(port, "%)")
      serial-nl(port)
      serial-write-cstr(port, "  heap free:  ")
      serial-write-dec-wide(port, free / 1048576)
      serial-write-cstr(port, " MiB")
      serial-nl(port)
    } else if line-eq("ticks") != 0 {
      serial-write-cstr(port, "  timer ticks 0x")
      serial-write-hex(port, ticks)
      serial-nl(port)
    } else if line-eq("ps") != 0 {
      proc-list(port)
    } else if line-prefix("kill ") >= 0 {
      let arg = line-prefix("kill ")
      let pid = atoi(line + arg)
      let sig = SIGTERM
      let sp = next-arg(arg)
      if sp > 0 {
        let a0 = atoi(line + arg)
        let a1 = atoi(line + sp)
        // Support both `kill <pid> [sig]` and `kill -<sig> <pid>`.
        if load8(line + arg) == 45 {
          sig = 0 - a0
          pid = a1
        } else {
          pid = a0
          if a1 != 0 {
            sig = a1
          }
        }
      }
      if proc-signal(pid, sig) != 0 {
        serial-write-cstr(port, "  kill: no such process or signal")
      } else {
        serial-write-cstr(port, "  kill: sent ")
        serial-write-dec-wide(port, sig)
        serial-write-cstr(port, " to pid ")
        serial-write-dec-wide(port, pid)
      }
      serial-nl(port)
    } else if line-eq("test") != 0 {
      serial-write-cstr(port, "  array selftest sum 0x")
      serial-write-hex(port, array-selftest())
      serial-write-cstr(port, " (expect 0x8C)")
      serial-nl(port)
    } else if line-eq("halt") != 0 {
      serial-write-cstr(port, "  halting on request")
      serial-nl(port)
      outb(0xf4, 0)      // QEMU isa-debug-exit (harmless if absent)
      outw(0x604, 0x2000) // QEMU ACPI power-off
      cli()
      while true { hlt() }
    } else if line-eq("uptime") != 0 {
      let secs = ticks / 100
      let umins = secs / 60
      let uhrs = umins / 60
      serial-write-cstr(port, "  ")
      serial-write-dec-wide(port, uhrs)
      serial-write-cstr(port, "h ")
      serial-write-dec-wide(port, umins % 60)
      serial-write-cstr(port, "m ")
      serial-write-dec-wide(port, secs % 60)
      serial-write-cstr(port, "s (")
      serial-write-dec-wide(port, ticks)
      serial-write-cstr(port, " ticks)")
      serial-nl(port)
    } else if line-eq("time") != 0 {
      time-print(port)
    } else if line-eq("syscall") != 0 {
      run-syscall-demo(port)
    } else if line-eq("nvme") != 0 {
      nvme-shell(port)
    } else if line-eq("format") != 0 {
      if fs-format() == 0 {
        store8(shell-cwd, 47)
        store8(shell-cwd + 1, 0)
        serial-write-cstr(port, "  disk formatted")
      } else {
        serial-write-cstr(port, "  format: no disk or write error")
      }
      serial-nl(port)
    } else if line-eq("pwd") != 0 {
      serial-write-cstr(port, "  ")
      serial-write-cstr(port, shell-cwd)
      serial-nl(port)
    } else if line-eq("cd") != 0 {
      store8(shell-cwd, 47)
      store8(shell-cwd + 1, 0)
      serial-write-cstr(port, "  /")
      serial-nl(port)
    } else if line-prefix("cd ") >= 0 {
      let arg = line-prefix("cd ")
      let p = shell-path(line + arg)
      let stat-buf = alloc(64)
      if fs-stat(p, stat-buf) == 0 && load32(stat-buf + SF-ST-TYPE) == SF-TYPE-DIR {
        let i = 0
        while load8(p + i) != 0 && i < 1023 {
          store8(shell-cwd + i, load8(p + i))
          i = i + 1
        }
        store8(shell-cwd + i, 0)
        serial-write-cstr(port, "  ")
        serial-write-cstr(port, shell-cwd)
      } else {
        serial-write-cstr(port, "  cd: not a directory or not found")
      }
      serial-nl(port)
    } else if line-prefix("ls ") >= 0 {
      let ls-arg = line-prefix("ls ")
      fs-list-path(shell-path(line + ls-arg), port)
    } else if line-eq("ls") != 0 {
      fs-list-path(shell-cwd, port)
    } else if line-prefix("mkdir ") >= 0 {
      let arg = line-prefix("mkdir ")
      if fs-mkdir(shell-path(line + arg)) >= 0 {
        serial-write-cstr(port, "  created")
      } else {
        serial-write-cstr(port, "  mkdir: no such parent or already exists")
      }
      serial-nl(port)
    } else if line-prefix("rmdir ") >= 0 {
      let arg = line-prefix("rmdir ")
      if fs-rmdir(shell-path(line + arg)) == 0 {
        serial-write-cstr(port, "  removed")
      } else {
        serial-write-cstr(port, "  rmdir: not found or not empty")
      }
      serial-nl(port)
    } else if line-prefix("rm ") >= 0 {
      let arg = line-prefix("rm ")
      if fs-delete(shell-path(line + arg)) == 0 {
        serial-write-cstr(port, "  deleted")
      } else {
        serial-write-cstr(port, "  rm: not found or is directory")
      }
      serial-nl(port)
    } else if line-prefix("read ") >= 0 {
      let arg = line-prefix("read ")
      let buf = alloc(4096)
      let n = fs-read-file(shell-path(line + arg), buf)
      if n < 0 {
        serial-write-cstr(port, "  read: file not found")
      } else {
        let i = 0
        while i < n {
          serial-put(port, load8(buf + i))
          i = i + 1
        }
      }
      serial-nl(port)
    } else if line-prefix("cat ") >= 0 {
      let arg = line-prefix("cat ")
      let buf = alloc(4096)
      let n = fs-read-file(shell-path(line + arg), buf)
      if n < 0 {
        serial-write-cstr(port, "  cat: file not found")
      } else {
        let i = 0
        while i < n {
          serial-put(port, load8(buf + i))
          i = i + 1
        }
      }
      serial-nl(port)
    } else if line-prefix("write ") >= 0 {
      let arg1 = line-prefix("write ")
      let arg2 = next-arg(arg1)
      if arg2 != 0 {
        store8(line + arg2 - 1, 0)
        let len = strlen(line + arg2)
        if fs-write-file(shell-path(line + arg1), line + arg2, len) == 0 {
          serial-write-cstr(port, "  written")
        } else {
          serial-write-cstr(port, "  write: disk full or read-only")
        }
      } else {
        serial-write-cstr(port, "  usage: write <path> <data>")
      }
      serial-nl(port)
    } else if line-prefix("mv ") >= 0 {
      let arg1 = line-prefix("mv ")
      let arg2 = next-arg(arg1)
      if arg2 != 0 {
        store8(line + arg2 - 1, 0)
        if fs-rename(shell-path(line + arg1), shell-path(line + arg2)) == 0 {
          serial-write-cstr(port, "  renamed")
        } else {
          serial-write-cstr(port, "  mv: not found or destination exists")
        }
      } else {
        serial-write-cstr(port, "  usage: mv <old> <new>")
      }
      serial-nl(port)
    } else if line-prefix("stat ") >= 0 {
      let arg = line-prefix("stat ")
      let stat-buf = alloc(64)
      if fs-stat(shell-path(line + arg), stat-buf) == 0 {
        print-stat(port, stat-buf)
      } else {
        serial-write-cstr(port, "  stat: not found")
        serial-nl(port)
      }
    } else if line-prefix("edit ") >= 0 {
      editor-run(port, shell-path(line + line-prefix("edit ")))
    } else if line-eq("libc") != 0 {
      let rc = libc-selftest()
      if rc == 0 {
        serial-write-cstr(port, "  libc self-test passed")
      } else {
        serial-write-cstr(port, "  libc self-test FAILED")
      }
      serial-nl(port)
    } else if line-eq("vfs") != 0 {
      let rc = vfs-selftest()
      if rc != 0 {
        serial-write-cstr(port, "  vfs self-test passed")
      } else {
        serial-write-cstr(port, "  vfs self-test FAILED")
      }
      serial-nl(port)
    } else if line-eq("usb") != 0 {
      usb-kbd-cmd(port)
    } else if line-eq("linux") != 0 {
      linux-demo(port)
    } else if line-eq("linuxelf") != 0 {
      linux-elf-probe(port)
    } else if line-eq("darwin") != 0 {
      darwin-demo(port)
    } else if line-eq("windows") != 0 {
      win-demo(port)
    } else if line-eq("fetch") != 0 {
      diagnostics-fetch(port)
    } else if line-eq("desktop") != 0 {
      comp-run(port)
    } else if line-eq("display") != 0 {
      let ch = chan-new(32)
      dsp-init()
      dsp-run(ch, port)
    } else if line-eq("fb test") != 0 {
      fb-test-pattern(port)
    } else if line-eq("dsp") != 0 {
      serial-write-cstr(port, "  usage: dsp test | display")
      serial-nl(port)
    } else if line-eq("dsp test") != 0 {
      let rc = dsp-selftest(port)
      serial-nl(port)
    } else if line-eq("fb") != 0 {
      fb-info(port)
    } else if line-eq("comp") != 0 {
      comp-init()
      let w1 = comp-win-create("Terminal", 40, 40, 320, 200)
      comp-win-set-content(w1, "Space OS Terminal\n\n> help\n> status\n> ls\n> linux\n\nWelcome to Space OS!")
      let w2 = comp-win-create("File Browser", 400, 60, 280, 160)
      comp-win-set-content(w2, "Files on disk:\n\n(no files yet)")
      let w3 = comp-win-create("System Info", 120, 280, 360, 120)
      comp-win-set-content(w3, "Space OS v0.0.1\nNanokernel + Linux personality\nFramebuffer: active")
      comp-render()
      serial-write-cstr(port, "  comp: rendered OK")
      serial-nl(port)
    } else {
      let rest = line-prefix("desktop ")
      if rest >= 0 {
        comp-run(port)
      } else {
        let rest = line-prefix("echo ")
        if rest >= 0 {
          serial-write-cstr(port, line + rest)
          serial-nl(port)
        } else {
          let rest = line-prefix("peek ")
          if rest >= 0 {
            let addr = str-to-hex(line + rest)
            serial-write-cstr(port, "  [0x")
            serial-write-hex(port, addr)
            serial-write-cstr(port, "] = 0x")
            serial-write-hex(port, load64(addr))
            serial-nl(port)
          } else {
            let rest = line-prefix("poke ")
            if rest >= 0 {
              let space-pos = 0
              while load8(line + rest + space-pos) > 32 {
                space-pos = space-pos + 1
              }
              let addr = str-to-hex(line + rest)
              let val = str-to-hex(line + rest + space-pos + 1)
              store64(addr, val)
              serial-write-cstr(port, "  [0x")
              serial-write-hex(port, addr)
              serial-write-cstr(port, "] := 0x")
              serial-write-hex(port, load64(addr))
              serial-nl(port)
            } else {
              let rest = line-prefix("load_sci ")
              if rest >= 0 {
                proc-spawn-sci(port, line + rest)
              } else {
                let rest = line-prefix("run ")
                if rest >= 0 {
                  proc-spawn-sci(port, line + rest)
                } else {
                let rest = line-prefix("proc ")
                if rest >= 0 {
                  let pid = proc-create(line + rest, proc-dummy-entry, cap-serial())
                  if pid < 0 {
                    serial-write-cstr(port, "  proc: process table full")
                    serial-nl(port)
                  } else {
                    serial-write-cstr(port, "  proc: created process ")
                    serial-write-dec-wide(port, pid)
                    serial-write-cstr(port, " (")
                    serial-write-cstr(port, line + rest)
                    serial-write-cstr(port, "), running...")
                    serial-nl(port)
                    thr-run()
                    serial-write-cstr(port, "  proc: process ")
                    serial-write-dec-wide(port, pid)
                    serial-write-cstr(port, " exited with code ")
                    serial-write-dec-wide(port, proc-wait(pid))
                    serial-nl(port)
                  }
                } else {
                  let rest = line-prefix("write ")

                if rest >= 0 {
                  let sp = 0
                  while load8(line + rest + sp) > 32 {
                    sp = sp + 1
                  }
                  store8(line + rest + sp, 0)
                  let name-addr = line + rest
                  let text-addr = line + rest + sp + 1
                  let tlen = 0
                  while load8(text-addr + tlen) != 0 {
                    tlen = tlen + 1
                  }
                  let rc = fs-write-file(name-addr, text-addr, tlen)
                  if rc != 0 {
                    serial-write-cstr(port, "  write: failed")
                  } else {
                    serial-write-cstr(port, "  write: ok")
                  }
                  serial-nl(port)
                } else {
                  let rest = line-prefix("read ")
                  if rest >= 0 {
                    let rbuf = alloc(4096)
                    let rsize = fs-read-file(line + rest, rbuf)
                    if rsize < 0 {
                      serial-write-cstr(port, "  read: file not found")
                    } else {
                      serial-write-cstr(port, "  ")
                      let ri = 0
                      while ri < rsize {
                        serial-put(port, load8(rbuf + ri))
                        ri = ri + 1
                      }
                    }
                    serial-nl(port)
                  } else {
                    let rest = line-prefix("rm ")
                    if rest >= 0 {
                      let rc = fs-delete(line + rest)
                      if rc != 0 {
                        serial-write-cstr(port, "  rm: file not found")
                      } else {
                        serial-write-cstr(port, "  rm: deleted")
                      }
                      serial-nl(port)
                    } else {
                      let rest = line-prefix("nvme read ")
                      if rest >= 0 {
                        let lba = str-to-hex(line + rest)
                        nvme-shell-read(port, lba)
                      } else if n != 0 {
                        serial-write-cstr(port, "  unknown command (try 'help')")
                        serial-nl(port)
                      }
                    }
                  }
                }
                }
              }
            }
          }
        }
      }
    }
  }
  }
  return
}
