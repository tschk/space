package space.terminal
import "terminal-vt-table.in"

// Pure client-owned ASCII screen. Caller owns 32 KiB, no device/heap authority.
// Fixed 80x24 initial profile. Transition data is upstream VTE; this screen
// policy is Space code. Unsupported strings have no external side effects.
const TERMINAL-SCREEN-BYTES=32768
const TERMINAL-SCREEN-MAGIC=0x545343523031
fn terminal-screen-base(memory:Int)->Int{
  return memory+512+load64(memory+48)*15360;
}
fn terminal-screen-blank(memory:Int)->Int{
  return 32 | (load64(memory+104)<<8) | (load64(memory+112)<<16) | (load64(memory+120)<<24);
}
fn terminal-screen-cell(memory:Int,x:Int,y:Int)->Int{
  if load64(memory)!=TERMINAL-SCREEN-MAGIC || x<0 || x>=80 || y<0 || y>=24{return -1;}
  return load64(terminal-screen-base(memory)+(y*80+x)*8);
}
fn terminal-screen-fill(memory:Int,start:Int,end:Int)->void{
  let base=terminal-screen-base(memory);let blank=terminal-screen-blank(memory);
  let i=start;while i<end{store64(base+i*8,blank);i+=1;}
  store64(memory+160,load64(memory+160)+1);
}
fn terminal-screen-init(memory:Int)->void{
  let i=0;while i<TERMINAL-SCREEN-BYTES{store64(memory+i,0);i+=8;}
  store64(memory,TERMINAL-SCREEN-MAGIC);store64(memory+8,12);
  store64(memory+104,7);store64(memory+136,23);store64(memory+184,1);
  terminal-screen-fill(memory,0,1920);store64(memory+48,1);
  terminal-screen-fill(memory,0,1920);store64(memory+48,0);
}
fn terminal-screen-move(memory:Int,x:Int,y:Int)->void{
  let nx=x;let ny=y;
  if nx<0{nx=0;}if nx>79{nx=79;}if ny<0{ny=0;}if ny>23{ny=23;}
  store64(memory+16,nx);store64(memory+24,ny);store64(memory+96,0);
  store64(memory+160,load64(memory+160)+1);
}
fn terminal-screen-linefeed(memory:Int)->void{
  let y=load64(memory+24);let bottom=load64(memory+136);
  if y==bottom{
    let top=load64(memory+128);let base=terminal-screen-base(memory);
    let i=top*80;while i<bottom*80{store64(base+i*8,load64(base+(i+80)*8));i+=1;}
    terminal-screen-fill(memory,bottom*80,(bottom+1)*80);
  }else if y<23{store64(memory+24,y+1);}
  store64(memory+96,0);store64(memory+160,load64(memory+160)+1);
}
fn terminal-screen-print(memory:Int,byte:Int)->void{
  if load64(memory+96)!=0{store64(memory+16,0);terminal-screen-linefeed(memory);}
  let x=load64(memory+16);let y=load64(memory+24);
  store64(terminal-screen-base(memory)+(y*80+x)*8,(terminal-screen-blank(memory)&-256)|byte);
  if x==79{store64(memory+96,1);}else{store64(memory+16,x+1);}
  store64(memory+160,load64(memory+160)+1);
}
fn terminal-screen-execute(memory:Int,byte:Int)->void{
  let x=load64(memory+16);let y=load64(memory+24);
  if byte==8{terminal-screen-move(memory,x - 1,y);}
  if byte==9{terminal-screen-move(memory,((x/8)+1)*8,y);}
  if byte==10 || byte==11 || byte==12{terminal-screen-linefeed(memory);}
  if byte==13{terminal-screen-move(memory,0,y);}
}
fn terminal-screen-clear-parser(memory:Int)->void{
  store64(memory+56,0);store64(memory+64,0);store64(memory+72,0);
  store64(memory+80,0);store64(memory+88,0);
}
fn terminal-screen-param-push(memory:Int)->void{
  let count=load64(memory+56);
  if count>=32{store64(memory+88,1);return;}
  store64(memory+256+count*8,load64(memory+64));
  store64(memory+56,count+1);store64(memory+64,0);
}
fn terminal-screen-param(memory:Int,index:Int,fallback:Int)->Int{
  if index>=load64(memory+56){return fallback;}
  let value=load64(memory+256+index*8);
  if value==0{return fallback;}return value;
}
fn terminal-screen-csi(memory:Int,byte:Int)->void{
  terminal-screen-param-push(memory);
  if load64(memory+88)!=0{return;}
  let x=load64(memory+16);let y=load64(memory+24);
  let n=terminal-screen-param(memory,0,1);
  let private=load64(memory+80);
  if private==63 && load64(memory+72)==1{
    if (byte==104 || byte==108) && load64(memory+56)==1{
      let value=load64(memory+256);
      if value==25{if byte==104{store64(memory+184,1);}else{store64(memory+184,0);}}
      if value==1049{
        if byte==104 && load64(memory+48)==0{
          store64(memory+144,x);store64(memory+152,y);store64(memory+48,1);
          terminal-screen-fill(memory,0,1920);terminal-screen-move(memory,0,0);
        }
        if byte==108 && load64(memory+48)==1{
          store64(memory+48,0);terminal-screen-move(memory,load64(memory+144),load64(memory+152));
        }
      }
    }
    return;
  }
  if load64(memory+72)!=0{return;}
  if byte==65{terminal-screen-move(memory,x,y - n);}
  else if byte==66{terminal-screen-move(memory,x,y+n);}
  else if byte==67{terminal-screen-move(memory,x+n,y);}
  else if byte==68{terminal-screen-move(memory,x - n,y);}
  else if byte==69{terminal-screen-move(memory,0,y+n);}
  else if byte==70{terminal-screen-move(memory,0,y - n);}
  else if byte==71{terminal-screen-move(memory,n - 1,y);}
  else if byte==100{terminal-screen-move(memory,x,n - 1);}
  else if byte==72 || byte==102{terminal-screen-move(memory,terminal-screen-param(memory,1,1) - 1,n - 1);}
  else if byte==74 || byte==75{
    let mode=terminal-screen-param(memory,0,0);let start=y*80;let end=(y+1)*80;
    if byte==74{start=0;end=1920;}
    if mode==0{start=y*80+x;}
    else if mode==1{end=y*80+x+1;}
    else if mode!=2{return;}
    terminal-screen-fill(memory,start,end);
  }
  else if byte==114{
    let top=n - 1;let bottom=terminal-screen-param(memory,1,24) - 1;
    if top>=0 && top<bottom && bottom<24{
      store64(memory+128,top);store64(memory+136,bottom);terminal-screen-move(memory,0,0);
    }
  }
  else if byte==109{
    let i=0;while i<load64(memory+56){
      let value=load64(memory+256+i*8);
      if value==0{store64(memory+104,7);store64(memory+112,0);store64(memory+120,0);}
      else if value==1{store64(memory+120,load64(memory+120)|1);}
      else if value==7{store64(memory+120,load64(memory+120)|2);}
      else if value==22{store64(memory+120,load64(memory+120)&-2);}
      else if value==27{store64(memory+120,load64(memory+120)&-3);}
      else if value>=30 && value<=37{store64(memory+104,value - 30);}
      else if value>=40 && value<=47{store64(memory+112,value - 40);}
      else if value>=90 && value<=97{store64(memory+104,value - 90+8);}
      else if value>=100 && value<=107{store64(memory+112,value - 100+8);}
      else if value==39{store64(memory+104,7);}
      else if value==49{store64(memory+112,0);}
      else{return;}
      i+=1;
    }
  }
}
fn terminal-screen-action(memory:Int,action:Int,byte:Int)->void{
  if action==1{terminal-screen-clear-parser(memory);}
  else if action==2{
    let n=load64(memory+72);
    if n>=2{store64(memory+88,1);}else{store64(memory+80,load64(memory+80)|(byte<<(n*8)));store64(memory+72,n+1);}
  }
  else if action==3{terminal-screen-csi(memory,byte);}
  else if action==4 && load64(memory+72)==0{
    if byte==55{store64(memory+32,load64(memory+16));store64(memory+40,load64(memory+24));}
    if byte==56{terminal-screen-move(memory,load64(memory+32),load64(memory+40));}
    if byte==68{terminal-screen-linefeed(memory);}
    if byte==69{terminal-screen-move(memory,0,load64(memory+24));terminal-screen-linefeed(memory);}
  }
  else if action==5{terminal-screen-execute(memory,byte);}
  else if action==11{
    if byte==59{terminal-screen-param-push(memory);}
    else if byte==58{store64(memory+88,1);}
    else{
      let n=load64(memory+64)*10+byte - 48;if n>65535{n=65535;}store64(memory+64,n);
    }
  }
  else if action==12{terminal-screen-print(memory,byte);}
}
fn terminal-screen-feed(memory:Int,byte:Int)->Int{
  if load64(memory)!=TERMINAL-SCREEN-MAGIC || byte<0 || byte>255{return -1;}
  // Explicit ASCII profile, including no C1-control or UTF-8 claim.
  if byte>=128{return -95;}
  let state=load64(memory+8);
  if state<0 || state>=15{return -1;}
  let change=terminal-vt-transition(0,byte);
  if change==0{change=terminal-vt-transition(state,byte);}
  let next=change&15;let action=change>>4;
  terminal-screen-action(memory,action,byte);
  if next!=0{
    if next==1 || next==5 || next==10{terminal-screen-clear-parser(memory);}
    store64(memory+8,next);
  }
  return 0;
}
