package space.kernel

// USB xHCI and HID keyboard driver stub (kernel-linked).
// Full xHCI + HID logic lives in components/input.in for the SCI input
// component. Kernel keeps these symbols so boot and compositor compile;
// desktop keyboard path uses PS/2 (components/mouse.in) until USB is wired.

fn xhci-init() -> Int {
  return -1
}

fn usb-kbd-init() -> Int {
  return -1
}

fn usb-kbd-ready() -> Int {
  return 0
}

fn usb-kbd-getchar() -> Int {
  return -1
}

fn usb-kbd-wait-key() -> Int {
  return -1
}

fn usb-kbd-cmd(port: Int) -> void {
  serial-write-cstr(port, "  no keyboard")
  serial-nl(port)
  return
}

fn xhci-kbd-poll() -> Int {
  return 0
}

fn hid-to-ascii(usage: Int) -> Int {
  return 0
}
