package space.user

// Dynamically linked user component: prints through libspace, a shared-library
// SCI whose symbols the kernel binds at load time (SCI v2 import table).
// The lib-* functions are declared here with empty bodies — the compiler
// records them as imports, and the loader patches the call sites to the
// library's exported addresses before this component ever runs.

component HelloUser {
  target "x86_64-unknown-none"
  deterministic true
  checkpoint none

  capability serial: DebugConsole(write)

  export entry: HelloEntry
}

interface HelloEntry {
  fn hello-entry(cap-info: Int) -> Int
}

interface DebugConsole {
  fn write(msg: String) -> void
}

const COM1 = 0x3F8

// Import stubs for libspace symbols. Marked `interrupt fn` so the compiler
// emits no caller-saved register spills around the (load-time bound) call,
// matching the library's own prologue/epilogue frames.
fn lib-write(port: Int, addr: Int) -> void {
}

fn lib-nl(port: Int) -> void {
}

fn hello-entry(cap-info: Int) -> Int {
  let port = COM1
  lib-write(port, "hello from user SCI\n")
  lib-nl(port)
  return 0x4849
}
