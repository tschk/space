package space.kernel

const VFS-O-RDONLY = 0
const VFS-O-WRONLY = 1
const VFS-O-RDWR = 2
const VFS-O-CREAT = 64

const VFS-MAX-FDS = 16
var vfs-fd-table: Int = 0

fn vfs-init() -> void {
  vfs-fd-table-alloc()
  store64(vfs-fd-table + 0 * 32 + 0, 0)
  store64(vfs-fd-table + 0 * 32 + 8, 0)
  store64(vfs-fd-table + 0 * 32 + 16, VFS-O-RDONLY)
  store64(vfs-fd-table + 1 * 32 + 0, 0)
  store64(vfs-fd-table + 1 * 32 + 8, 0)
  store64(vfs-fd-table + 1 * 32 + 16, VFS-O-WRONLY)
  store64(vfs-fd-table + 2 * 32 + 0, 0)
  store64(vfs-fd-table + 2 * 32 + 8, 0)
  store64(vfs-fd-table + 2 * 32 + 16, VFS-O-WRONLY)
  return
}

fn vfs-fd-table-alloc() -> void {
  // Preserve the public 32-byte descriptor rows, followed by fd->open-file
  // mappings and a bounded pool of {offset, reference count} records.
  vfs-fd-table = alloc(VFS-MAX-FDS * 56)
  let word = VFS-MAX-FDS * 32
  while word < VFS-MAX-FDS * 56 {
    store64(vfs-fd-table + word, 0)
    word = word + 8
  }
  let i = 0
  while i < VFS-MAX-FDS {
    vfs-fd-clear(i)
    i = i + 1
  }
  return
}

fn vfs-fd-clear(fd: Int) -> void {
  if vfs-stream-valid(fd) != 0 { vfs-stream-release(fd) }
  let mapping = vfs-fd-table + VFS-MAX-FDS * 32 + fd * 8
  let record = load64(mapping)
  if record != 0 {
    store64(record + 8, load64(record + 8) - 1)
    store64(mapping, 0)
  }
  let base = vfs-fd-table + fd * 32
  store64(base + 0, -1)
  store64(base + 8, 0)
  store64(base + 16, 0)
  store64(base + 24, 0)
  return
}

// Ensure one shared offset record per open, never per pathname. Lazy setup
// also supports existing callers that construct a descriptor row directly.
fn vfs-fd-open-file(fd: Int) -> Int {
  let mapping = vfs-fd-table + VFS-MAX-FDS * 32 + fd * 8
  let record = load64(mapping)
  if record != 0 { return record }
  let i = 0
  while i < VFS-MAX-FDS {
    let candidate = vfs-fd-table + VFS-MAX-FDS * 40 + i * 16
    if load64(candidate + 8) == 0 {
      store64(candidate, load64(vfs-fd-table + fd * 32 + 8))
      store64(candidate + 8, 1)
      store64(mapping, candidate)
      return candidate
    }
    i = i + 1
  }
  return 0
}

fn vfs-fd-offset(fd: Int) -> Int {
  let record = load64(vfs-fd-table + VFS-MAX-FDS * 32 + fd * 8)
  if record != 0 { return load64(record) }
  return load64(vfs-fd-table + fd * 32 + 8)
}

fn vfs-fd-set-offset(fd: Int, value: Int) -> void {
  let record = load64(vfs-fd-table + VFS-MAX-FDS * 32 + fd * 8)
  if record == 0 {
    store64(vfs-fd-table + fd * 32 + 8, value)
    return
  }
  store64(record, value)
  // Keep the legacy descriptor offset word truthful for existing observers.
  let i = 0
  while i < VFS-MAX-FDS {
    if load64(vfs-fd-table + VFS-MAX-FDS * 32 + i * 8) == record {
      store64(vfs-fd-table + i * 32 + 8, value)
    }
    i = i + 1
  }
  return
}

fn vfs-fd-alloc() -> Int {
  let i = 3
  while i < VFS-MAX-FDS {
    if load64(vfs-fd-table + i * 32 + 0) == -1 {
      return i
    }
    i = i + 1
  }
  return -1
}

fn vfs-fd-valid(fd: Int) -> Int {
  if fd < 0 {
    return 0
  }
  if fd >= VFS-MAX-FDS {
    return 0
  }
  if fd < 3 {
    return 1
  }
  if load64(vfs-fd-table + fd * 32 + 0) == -1 {
    return 0
  }
  return 1
}

fn vfs-sparkfs-file-size(path: Int) -> Int {
  if volume-ready != 0 {
    let st = alloc(64)
    if volume-rpc-stat(path, st) != 0 {
      return -1
    }
    return load64(st + SF-ST-SIZE)
  }
  let ino = sf-lookup-path(path)
  if ino < 0 {
    return -1
  }
  let addr = sf-inode-addr(ino)
  if load32(addr + SF-IN-TYPE) != SF-TYPE-FILE {
    return -1
  }
  return load64(addr + SF-IN-SIZE)
}

fn vfs-open(pathname: Int, flags: Int) -> Int {
  if volume-ready != 0 {
    let vrc = volume-rpc-open(pathname, flags)
    if vrc < 0 {
      if (flags & VFS-O-CREAT) != 0 {
        return -28
      }
      return -2
    }
    let fd = vfs-fd-alloc()
    if fd < 0 {
      return -16
    }
    let path-copy = strdup(pathname)
    let base = vfs-fd-table + fd * 32
    store64(base + 0, path-copy)
    store64(base + 8, 0)
    store64(base + 16, flags)
    store64(base + 24, 0)
    if vfs-fd-open-file(fd) == 0 { vfs-fd-clear(fd); return -16 }
    return fd
  }
  if sf-disk-ready == 0 {
    return -5
  }
  let ino = sf-lookup-path(pathname)
  if ino < 0 {
    if (flags & VFS-O-CREAT) != 0 {
      let rc = fs-write-file(pathname, pathname, 0)
      if rc != 0 {
        return -28
      }
      ino = sf-lookup-path(pathname)
      if ino < 0 {
        return -5
      }
    } else {
      return -2
    }
  }
  let fd = vfs-fd-alloc()
  if fd < 0 {
    return -16
  }
  let path-copy = strdup(pathname)
  let base = vfs-fd-table + fd * 32
  store64(base + 0, path-copy)
  store64(base + 8, 0)
  store64(base + 16, flags)
  store64(base + 24, 0)
  if vfs-fd-open-file(fd) == 0 { vfs-fd-clear(fd); return -16 }
  return fd
}

// Duplicate a regular-file descriptor while retaining its shared open-file offset.
// Pipe endpoint lifetime belongs to its personality and must not use this helper.
fn vfs-dup-file(fd: Int) -> Int {
  if fd < 3 || vfs-fd-valid(fd) == 0 { return -9 }
  let base = vfs-fd-table + fd * 32
  if load64(base + 24) != 0 { return -9 }
  let copy = vfs-fd-alloc()
  if copy < 0 { return -16 }
  let record = vfs-fd-open-file(fd)
  if record == 0 { return -16 }
  store64(record + 8, load64(record + 8) + 1)
  let target = vfs-fd-table + copy * 32
  store64(target, load64(base))
  store64(target + 8, vfs-fd-offset(fd))
  store64(target + 16, load64(base + 16))
  store64(target + 24, 0)
  store64(vfs-fd-table + VFS-MAX-FDS * 32 + copy * 8, record)
  return copy
}

fn vfs-close(fd: Int) -> Int {
  if vfs-fd-valid(fd) == 0 {
    return -9
  }
  if fd < 3 {
    return 0
  }
  vfs-fd-clear(fd)
  return 0
}

fn vfs-read(fd: Int, buf: Int, count: Int) -> Int {
  if vfs-stream-valid(fd) != 0 { return vfs-stream-read(fd, buf, count) }
  if vfs-fd-valid(fd) == 0 {
    return -9
  }
  if fd == 0 {
    let port = com1()
    let i = 0
    while i < count {
      let c = serial-read(port)
      store8(buf + i, c)
      i = i + 1
      if c == 10 || c == 13 {
        return i
      }
    }
    return count
  }
  if fd < 3 {
    return -9
  }
  let base = vfs-fd-table + fd * 32
  if (load64(base + 16) & 3) == VFS-O-WRONLY { return -9 }
  let path = load64(base + 0)
  let offset = vfs-fd-offset(fd)
  let n = 0
  if volume-ready != 0 {
    n = volume-rpc-pread(path, buf, count, offset)
  } else {
    n = sparkfs-pread(path, buf, count, offset)
  }
  if n < 0 {
    return -5
  }
  vfs-fd-set-offset(fd, offset + n)
  return n
}

fn vfs-write(fd: Int, buf: Int, count: Int) -> Int {
  if vfs-stream-valid(fd) != 0 { return vfs-stream-write(fd, buf, count) }
  if vfs-fd-valid(fd) == 0 {
    return -9
  }
  if fd == 1 || fd == 2 {
    let port = com1()
    let i = 0
    while i < count {
      serial-put(port, load8(buf + i))
      i = i + 1
    }
    return count
  }
  if fd == 0 {
    return -9
  }
  let base = vfs-fd-table + fd * 32
  if (load64(base + 16) & 3) == VFS-O-RDONLY { return -9 }
  let path = load64(base + 0)
  let offset = vfs-fd-offset(fd)
  let n = 0
  if volume-ready != 0 {
    n = volume-rpc-pwrite(path, buf, count, offset)
  } else {
    n = sparkfs-pwrite(path, buf, count, offset)
  }
  if n < 0 {
    return -5
  }
  vfs-fd-set-offset(fd, offset + n)
  return n
}

fn vfs-lseek(fd: Int, offset: Int, whence: Int) -> Int {
  if vfs-stream-valid(fd) != 0 { return -29 }
  if vfs-fd-valid(fd) == 0 {
    return -9
  }
  if fd < 3 {
    return -29
  }
  let base = vfs-fd-table + fd * 32
  let path = load64(base + 0)
  let file-size = vfs-sparkfs-file-size(path)
  if file-size < 0 {
    return -5
  }
  let cur-offset = vfs-fd-offset(fd)
  let new-offset = 0
  if whence == 0 {
    new-offset = offset
  } else if whence == 1 {
    new-offset = cur-offset + offset
  } else if whence == 2 {
    new-offset = file-size + offset
  } else {
    return -22
  }
  if new-offset < 0 {
    return -22
  }
  vfs-fd-set-offset(fd, new-offset)
  return new-offset
}

// shortcut: live empty/full streams return EAGAIN; add readiness waits with scheduler support.
// Tag3 descriptor pair handles are private one-based indices, never addresses.
const VFS-FD-STREAM = 3
const VFS-STREAM-MAX = 4
const VFS-STREAM-CAP = 4096
struct VfsStreamPair {
  Int refs0
  Int refs1
  Int head0
  Int count0
  Int head1
  Int count1
  Int ringbase
}
var vfs-stream-pairs:[VfsStreamPair]=[VfsStreamPair{refs0:0,refs1:0,head0:0,count0:0,head1:0,count1:0,ringbase:0},VfsStreamPair{refs0:0,refs1:0,head0:0,count0:0,head1:0,count1:0,ringbase:0},VfsStreamPair{refs0:0,refs1:0,head0:0,count0:0,head1:0,count1:0,ringbase:0},VfsStreamPair{refs0:0,refs1:0,head0:0,count0:0,head1:0,count1:0,ringbase:0}]
var vfs-stream-buffers:Int=0

fn vfs-stream-pair-valid(pair: Int) -> Int {
  if pair < 1 || pair > VFS-STREAM-MAX { return 0 }
  return 1
}

fn vfs-stream-valid(fd: Int) -> Int {
  if vfs-fd-table == 0 || fd < 3 || fd >= VFS-MAX-FDS { return 0 }
  let row = vfs-fd-table + fd * 32
  if load64(row + 24) != VFS-FD-STREAM { return 0 }
  let pair = load64(row)
  let side = load64(row + 8)
  if vfs-stream-pair-valid(pair) == 0 || side < 0 || side > 1 { return 0 }
  if side == 0 { if vfs-stream-pairs[pair - 1].refs0 > 0 { return 1 } }
  else { if vfs-stream-pairs[pair - 1].refs1 > 0 { return 1 } }
  return 0
}

fn vfs-stream-init() -> Void {
  if vfs-stream-buffers != 0 { return }
  vfs-stream-buffers=alloc(VFS-STREAM-MAX*2*VFS-STREAM-CAP)
  let cleared=0
  while cleared<VFS-STREAM-MAX*2*VFS-STREAM-CAP {
    store64(vfs-stream-buffers+cleared,0)
    cleared=cleared+8
  }
  let i=0
  while i<VFS-STREAM-MAX {
    vfs-stream-pairs[i].ringbase=vfs-stream-buffers+i*2*VFS-STREAM-CAP
    i=i+1
  }
}

fn vfs-stream-publish(fd: Int, pair: Int, side: Int) -> Void {
  let row = vfs-fd-table + fd * 32
  store64(row, pair)
  store64(row + 8, side)
  store64(row + 16, VFS-O-RDWR)
  store64(row + 24, VFS-FD-STREAM)
}

fn vfs-stream-pair(domain: Int, stype: Int, protocol: Int, result: Int) -> Int {
  if vfs-fd-table == 0 { return -9 }
  if domain != 1 { return -97 }
  if stype != 1 || protocol != 0 { return -22 }
  if result <= 0 { return -14 }
  let first = -1
  let second = -1
  let fd = 3
  while fd < VFS-MAX-FDS {
    if load64(vfs-fd-table + fd * 32) == -1 {
      if first < 0 { first = fd } else { if second < 0 { second = fd } }
    }
    fd = fd + 1
  }
  if second < 0 { return -24 }
  vfs-stream-init()
  let pair = 0
  let i = 0
  while i < VFS-STREAM-MAX {
    if pair == 0 && vfs-stream-pairs[i].refs0 == 0 && vfs-stream-pairs[i].refs1 == 0 { pair = i+1 }
    i = i + 1
  }
  if pair == 0 { return -23 }
  // No descriptor/output publication before all capacity checks succeed.
  vfs-stream-pairs[pair - 1].head0=0;vfs-stream-pairs[pair - 1].count0=0
  vfs-stream-pairs[pair - 1].head1=0;vfs-stream-pairs[pair - 1].count1=0
  vfs-stream-pairs[pair - 1].refs0=1;vfs-stream-pairs[pair - 1].refs1=1
  vfs-stream-publish(first, pair, 0)
  vfs-stream-publish(second, pair, 1)
  store32(result, first); store32(result + 4, second)
  return 0
}

fn vfs-stream-retain(fd: Int) -> Int {
  if vfs-stream-valid(fd) == 0 { return -9 }
  let row = vfs-fd-table + fd * 32
  let pair=load64(row)-1
  if load64(row+8)==0 { vfs-stream-pairs[pair].refs0=vfs-stream-pairs[pair].refs0+1 }
  else { vfs-stream-pairs[pair].refs1=vfs-stream-pairs[pair].refs1+1 }
  return 0
}

fn vfs-stream-release(fd: Int) -> Void {
  let row = vfs-fd-table + fd * 32
  let pair=load64(row)-1
  if load64(row+8)==0 { vfs-stream-pairs[pair].refs0=vfs-stream-pairs[pair].refs0 - 1 }
  else { vfs-stream-pairs[pair].refs1=vfs-stream-pairs[pair].refs1 - 1 }
}

fn vfs-stream-dup(fd: Int) -> Int {
  if vfs-stream-valid(fd) == 0 { return -9 }
  let copy = vfs-fd-alloc()
  if copy < 0 { return -24 }
  vfs-stream-retain(fd)
  let row = vfs-fd-table + fd * 32
  vfs-stream-publish(copy, load64(row), load64(row + 8))
  return copy
}

fn vfs-stream-read(fd: Int, buf: Int, count: Int) -> Int {
  if vfs-stream-valid(fd) == 0 { return -9 }
  if count < 0 { return -22 }
  if count == 0 { return 0 }
  if buf <= 0 { return -14 }
  let row = vfs-fd-table + fd * 32
  let pair = load64(row)
  let side = load64(row + 8)
  let n=vfs-stream-pairs[pair - 1].count0
  if side==1 { n=vfs-stream-pairs[pair - 1].count1 }
  if n == 0 {
    if side==0 && vfs-stream-pairs[pair - 1].refs1==0 { return 0 }
    if side==1 && vfs-stream-pairs[pair - 1].refs0==0 { return 0 }
    return -11
  }
  let take = count
  if take > n { take = n }
  let head=vfs-stream-pairs[pair - 1].head0
  if side==1 { head=vfs-stream-pairs[pair - 1].head1 }
  let ring=vfs-stream-pairs[pair - 1].ringbase+side*VFS-STREAM-CAP
  let i = 0
  while i < take {
    store8(buf + i, load8(ring + (head + i) % VFS-STREAM-CAP))
    i = i + 1
  }
  if side==0 { vfs-stream-pairs[pair - 1].head0=(head+take)%VFS-STREAM-CAP;vfs-stream-pairs[pair - 1].count0=n - take }
  else { vfs-stream-pairs[pair - 1].head1=(head+take)%VFS-STREAM-CAP;vfs-stream-pairs[pair - 1].count1=n - take }
  return take
}

fn vfs-stream-write(fd: Int, buf: Int, count: Int) -> Int {
  if vfs-stream-valid(fd) == 0 { return -9 }
  if count < 0 { return -22 }
  if count == 0 { return 0 }
  if buf <= 0 { return -14 }
  let row = vfs-fd-table + fd * 32
  let pair = load64(row)
  let peer = 1 - load64(row + 8)
  if peer==0 && vfs-stream-pairs[pair - 1].refs0==0 { return -32 }
  if peer==1 && vfs-stream-pairs[pair - 1].refs1==0 { return -32 }
  let n=vfs-stream-pairs[pair - 1].count0
  if peer==1 { n=vfs-stream-pairs[pair - 1].count1 }
  if n == VFS-STREAM-CAP { return -11 }
  let put = count
  if put > VFS-STREAM-CAP - n { put = VFS-STREAM-CAP - n }
  let head=vfs-stream-pairs[pair - 1].head0
  if peer==1 { head=vfs-stream-pairs[pair - 1].head1 }
  let ring=vfs-stream-pairs[pair - 1].ringbase+peer*VFS-STREAM-CAP
  let i = 0
  while i < put {
    store8(ring + (head + n + i) % VFS-STREAM-CAP, load8(buf + i))
    i = i + 1
  }
  if peer==0 { vfs-stream-pairs[pair - 1].count0=n+put }
  else { vfs-stream-pairs[pair - 1].count1=n+put }
  return put
}
