package space.kernel

import "windows-pe-view.in"

// Separate protected application profile; the original strict fixture admission
// stays unchanged. Preferred-base execution has no ASLR/relocation claim.
fn windows-application-section-flags(image: Int, rva: Int, bytes: Int) -> Int {
  let i = 0
  while i < windows-application-sections(image) {
    let p = windows-application-section(image, i)
    let va = load32(p + 12)
    let raw = load32(p + 16)
    if rva >= va && rva - va <= raw && bytes <= raw - (rva - va) { return load32(p + 36) }
    i = i + 1
  }
  return 0
}

fn windows-application-import-id(image: Int, size: Int, rva: Int) -> Int {
  let hint = windows-protected-rva(image, size, rva, 2)
  if hint < 0 { return -1 }
  let i = 0
  while i < 10 {
    if windows-protected-name(image, size, rva + 2, windows-protected-import-name(i)) != 0 { return i }
    i = i + 1
  }
  return -1
}

fn windows-application-kernel32(image: Int, size: Int, rva: Int) -> Int {
  let off = windows-protected-rva(image, size, rva, 13)
  if off < 0 { return 0 }
  let i = 0
  while i < 13 {
    let a = load8(image + off + i)
    let b = load8("KERNEL32.dll" + i)
    if a >= 97 && a <= 122 { a = a - 32 }
    if b >= 97 && b <= 122 { b = b - 32 }
    if a != b { return 0 }
    i = i + 1
  }
  return 1
}

fn windows-application-pages(image: Int) -> Int {
  let count = 7
  let i = 0
  while i < windows-application-sections(image) {
    let p = windows-application-section(image, i)
    let extent = load32(p + 8)
    if load32(p + 16) > extent { extent = load32(p + 16) }
    count = count + (extent + 4095) / 4096
    i = i + 1
  }
  return count
}

fn windows-application-structure-entry(image: Int, size: Int) -> Int {
  if image <= 0 || size < 1024 || size > 0x1000000 || (size & 511) != 0 || image > 0x100000000 - size { return -8 }
  if posix-load16(image) != 0x5A4D { return -8 }
  let pe = load32(image + 60)
  if pe < 64 || pe > 4096 - 264 || pe > size - 264 || (pe & 3) != 0 { return -8 }
  if load32(image + pe) != 0x4550 || posix-load16(image + pe + 4) != 0x8664 { return -8 }
  let coff = windows-application-coff(image)
  let count = windows-application-sections(image)
  let chars = posix-load16(coff + 18)
  if count < 1 || count > 16 || posix-load16(coff + 16) != 240 || (chars & 0x2002) != 2 || (chars & (0xFFFF ^ 0x22F)) != 0 { return -8 }
  if load64(coff + 8) != 0 { return -8 }
  let opt = windows-application-opt(image)
  let headers = load32(opt + 60)
  if posix-load16(opt) != 0x20B || load32(opt + 32) != 4096 || load32(opt + 36) != 512 { return -8 }
  if headers < pe + 264 + count * 40 || headers > 4096 || headers > size || (headers & 511) != 0 { return -8 }
  let base = load64(opt + 24)
  let extent = load32(opt + 56)
  if base < 0x50000000 || (base & 65535) != 0 || extent <= 4096 || extent > 0x2000000 || (extent & 4095) != 0 { return -8 }
  if base >= 0x800000000000 || extent > 0x800000000000 - base { return -8 }
  let dll = posix-load16(opt + 70)
  if posix-load16(opt + 68) != 3 || (dll & 256) == 0 || (dll & (0xFFFF ^ 0x8160)) != 0 || load32(opt + 108) != 16 { return -8 }
  let previous = 4096
  let file-end = headers
  let entry = load32(opt + 16)
  let found = 0
  let i = 0
  while i < count {
    let p = windows-application-section(image, i)
    let vm = load32(p + 8)
    let va = load32(p + 12)
    let raw = load32(p + 16)
    let off = load32(p + 20)
    let flags = load32(p + 36)
    if flags != 0x60000020 && flags != 0x40000040 && flags != 0xC0000040 && flags != 0xC0000080 && flags != 0x42000040 { return -8 }
    if vm <= 0 || vm > 0x400000 || raw > 0x400000 || va < previous || (va & 4095) != 0 { return -8 }
    let memory = vm
    if raw > memory { memory = raw }
    let rounded = (memory + 4095) & -4096
    if va > extent - rounded || load64(p + 24) != 0 || load32(p + 32) != 0 { return -8 }
    if raw == 0 {
      if off != 0 || flags != 0xC0000080 { return -8 }
    } else {
      if off < file-end || (off & 511) != 0 || (raw & 511) != 0 || off > size - raw { return -8 }
      file-end = off + raw
    }
    if flags == 0x60000020 && entry >= va && entry - va < raw { found = 1 }
    previous = va + rounded
    i = i + 1
  }
  if previous != extent || file-end != size || found == 0 || windows-application-pages(image) > 1024 { return -8 }
  return base + entry
}

fn windows-application-entry-mode(image: Int, size: Int, startup: Int) -> Int {
  let validated = windows-application-structure-entry(image, size)
  if validated < 0 { return validated }
  let opt = windows-application-opt(image)
  let base = load64(opt + 24)
  let entry = validated - base
  let i = 0
  while i < 16 {
    if i != 1 && i != 12 && (i != 9 || startup == 0) && load64(opt + 112 + i * 8) != 0 { return -8 }
    i = i + 1
  }
  let imp = load32(opt + 120)
  let bytes = load32(opt + 124)
  let iat-dir = load32(opt + 208)
  let iat-bytes = load32(opt + 212)
  if imp == 0 && bytes == 0 {
    if iat-dir != 0 || iat-bytes != 0 { return -8 }
    return base + entry
  }
  if imp == 0 || bytes != 40 { return -8 }
  let descriptor = windows-protected-rva(image, size, imp, 40)
  if descriptor < 0 { return -8 }
  let p = image + descriptor
  if load64(p + 4) != 0 || load64(p + 20) != 0 || load64(p + 28) != 0 || load32(p + 36) != 0 { return -8 }
  if windows-application-kernel32(image, size, load32(p + 12)) == 0 { return -8 }
  let iat = load32(p + 16)
  let lookup = load32(p)
  if lookup == 0 { lookup = iat }
  if (iat & 7) != 0 { return -8 }
  i = 0
  let done = 0
  while i <= 32 && done == 0 {
    let lo = windows-protected-rva(image, size, lookup + i * 8, 8)
    let io = windows-protected-rva(image, size, iat + i * 8, 8)
    if lo < 0 || io < 0 || (windows-application-section-flags(image, iat + i * 8, 8) & 0x20000000) != 0 { return -8 }
    let name = load64(image + lo)
    if load64(image + io) != name { return -8 }
    if name == 0 { done = 1 }
    else {
      let id = windows-application-import-id(image, size, name)
      if startup >= 2 { id = windows-parameters-import-id(image, size, name) }
      if startup == 3 { id = windows-parameters-time-import(image, size, name) }
      if startup == 4 { id = windows-parameters-env-import(image, size, name) }
      if startup == 5 { id = windows-parameters-counter-import(image, size, name) }
      if startup == 6 { id = windows-parameters-heap-import(image, size, name) }
      if startup == 7 { id = windows-parameters-local-import(image, size, name) }
      if startup == 8 { id = windows-parameters-critical-import(image, size, name) }
      if startup == 9 { id = windows-parameters-composed-import(image, size, name) }
      if startup == 10 { id = windows-parameters-unicode-import(image, size, name) }
      if startup == 11 { id = windows-parameters-path-import(image,size,name) }
      if startup == 12 { id = windows-find-import(image,size,name) }
      if i == 32 || id < 0 { return -8 }
      i = i + 1
    }
  }
  if done == 0 || i == 0 { return -8 }
  if lookup != iat && lookup < iat + (i + 1) * 8 && iat < lookup + (i + 1) * 8 { return -8 }
  if iat-dir != 0 || iat-bytes != 0 {
    if iat-dir != iat || iat-bytes != (i + 1) * 8 { return -8 }
  }
  return base + entry
}

fn windows-application-entry(image: Int, size: Int) -> Int {
  return windows-application-entry-mode(image, size, 0)
}
