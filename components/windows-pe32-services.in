package space.kernel
import "windows-pe32-files.in"
import "counter.in"
import "time.in"

fn pe32-clock(state:Int,id:Int,args:Int)->Int{
 if cap-check(load64(state+56),cap-timer())==0{store64(state+96,126);store64(state+144,1);return 0;}
 if id==8{
  let frequency=counter-frequency-authorized(load64(state+56));let value=counter-read-authorized(load64(state+56));
  if frequency<=0 || value<0{store64(state+96,125);store64(state+144,1);return 0;}
  return ((value/frequency)*1000+((value%frequency)*1000)/frequency)&0xffffffff;
 }
 let pointer=load32(args);
 if id==7{
  if pe32-span(state,pointer,16,1)==0{store64(state+96,142);store64(state+144,1);return 0;}
  let seconds=time-component-wallclock();if seconds<0{store64(state+96,125);store64(state+144,1);return 0;}
  let buffer=state+20480;
  store16(buffer,time-component-y);store16(buffer+2,time-component-mo);store16(buffer+4,((seconds/86400)+4)%7);
  store16(buffer+6,time-component-d);store16(buffer+8,time-component-h);store16(buffer+10,time-component-mi);store16(buffer+12,time-component-s);store16(buffer+14,0);
  if pe32-out(state,pointer,buffer,16)!=0{store64(state+96,142);store64(state+144,1);}return 0;
 }
 let output=load32(args+4);
 if pe32-span(state,output,8,1)==0 || pe32-in(state,pointer,state+20480,16)!=0{return pe32-error(state,998,0);}
 let buffer=state+20480;let y=load16(buffer);let month=load16(buffer+2);let day=load16(buffer+6);let hour=load16(buffer+8);let minute=load16(buffer+10);let second=load16(buffer+12);let millis=load16(buffer+14);
 if y<1601 || y>9999 || month<1 || month>12 || day<1 || day>time-component-month-days(y,month) || hour>23 || minute>59 || second>59 || millis>999{return pe32-error(state,87,0);}
 let prior=y - 1;let epoch=1600;let days=prior*365+prior/4 - prior/100+prior/400 - (epoch*365+epoch/4 - epoch/100+epoch/400);
 days+=time-component-days-before-month(month,time-component-is-leap-year(y))+day - 1;
 let value=(days*86400+hour*3600+minute*60+second)*10000000+millis*10000;store64(buffer,value);
 if pe32-out(state,output,buffer,8)!=0{return pe32-error(state,998,0);}return 1;
}

// Capsules expose runtime-private operation ids, not Windows NT syscalls.
// Every operation is serviced while its CPU activation is stopped.
fn pe32-service(state:Int)->Int{
 let context=state+256;let id=load64(context+112) - 0x320000;
 if id<1 || id>19{store64(state+96,134);return 0;}
 let count=pe32-import-args(id);let args=state+24576;
 cpu-mem-fill64(args,0,8);
 if count!=0 && pe32-in(state,load64(context+144)+4,args,count*4)!=0{store64(state+96,142);return 0;}
 store64(state+176,load64(state+176)|(1<<id));
 let result=0;
 if id==3{store64(state+96,load32(args));return 0;}
 if id==1{result=pe32-file-close(state,load32(args));}
 else if id==2{result=pe32-file-open(state,args);}
 else if id==4{result=PE32-ARGUMENTS;}
 else if id==5{
  // The launch profile has an explicit empty environment; never inherit host
  // or kernel variables. Validate the requested name even when absent.
  let address=load32(args);let done=0;let i=0;
  while i<256 && done==0{if pe32-in(state,address+i,state+20480,1)!=0{store64(state+96,142);return 0;}if load8(state+20480)==0{done=1;}i+=1;}
  if done==0 || i==1{result=pe32-error(state,87,0);}else{result=pe32-error(state,203,0);}
 }
 else if id==6{
  let which=load32(args);if which==0xfffffff5 && (load64(state+136)&2)!=0{result=1;}
  else if which==0xfffffff4 && (load64(state+136)&4)!=0{result=2;}
  else{result=pe32-error(state,6,0xffffffff);}
 }
 else if id==7 || id==8 || id==17{result=pe32-clock(state,id,args);if load64(state+144)!=0{return 0;}}
 else if id>=9 && id<=14{result=pe32-heap-service(state,id,args);}
 else if id==15{result=pe32-file-io(state,args,0);}
 else if id==16{result=pe32-file-seek(state,args);}
 else if id==18{result=pe32-file-io(state,args,1);}
 else if id==19{result=load64(state+88);}
 store64(context+112,result&0xffffffff);return 1;
}
