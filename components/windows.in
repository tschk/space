package space.kernel

// Windows personality — translator microservice (Win32/NT-shaped surface only).
// Not a kernel ABI and not full Win32/NT. Pattern matches linux.in → posix.in:
// map a small call surface onto Space VFS / process / serial.
//
// Space-local call numbers (not real NT syscall numbers):
//   1  WIN-NtWriteFile / WriteFile
//   2  WIN-GetCurrentProcessId
//   3  WIN-ExitProcess
//   4  WIN-CreateFileA   (path, access: 0=read 1=write/create)
//   5  WIN-ReadFile      (0 bytes at EOF → STATUS_END_OF_FILE / ERROR_HANDLE_EOF)
//   6  WIN-CloseHandle
//   7  WIN-GetFileSize
//   8  WIN-Sleep         → short pause loop (no thr-yield from shell)
//   9  WIN-GetCurrentThreadId → current-task
//  10  WIN-DeleteFileA   → fs-delete / volume
//  11  WIN-SetFilePointer → vfs-lseek(vfd, off, whence); a0=handle a1=offset a2=whence(0=SET)
//  12  WIN-GetStdHandle  → a0 nStdHandle: -10=stdin→0, -11=stdout→1, -12=stderr→2
//  13  WIN-MoveFileA     → fs-rename; return 1/0
//  14  WIN-FlushFileBuffers → 1 no-op success for open handle
//  15  WIN-CreateDirectoryA → fs-mkdir; return 1/0
//  16  WIN-RemoveDirectoryA → fs-rmdir; return 1/0
//  17  WIN-GetLastError → win-last-error
//  18  WIN-SetLastError → a0 err
//  19  WIN-VirtualAlloc → posix-sys-mmap / alloc; return ptr
//  20  WIN-VirtualFree → posix-sys-munmap stand-in; return 1/0
//  21  WIN-CreateProcessA → proc-spawn-sci; return table handle (type process) or 0
//  22  WIN-WaitForSingleObject → proc-wait if type process
//  23  WIN-GetCommandLineA → static "space-windows" cstr ptr
//  24  WIN-WriteConsoleA → WriteFile on stdout/stderr
//  25  WIN-GetModuleFileNameA → copy "space.exe" into buf; return len
//  26  WIN-HeapAlloc → alloc(size) zeroed; a0/a1 heap+flags ignored except size=a2
//  27  WIN-HeapFree → return 1 (bump heap: no real free)
//  28  WIN-CopyFileA → fs-read-file src + fs-write-file dst; return 1/0
//  29  WIN-GetEnvironmentVariableA → PATH→"/", else empty; return len
//  30  WIN-OutputDebugStringA → serial-write-cstr
//  34  WIN-RtlGetLastNtStatus → win-last-status
//  35  WIN-RtlNtStatusToDosError → a0 NTSTATUS → Win32 error
//  36  WIN-RtlGetLastWin32Error → win-last-error (alias of GetLastError)
//
// Honest: not full Win32, not PE loader, not CSRSS, not real NT objects.

const WIN-CALL-WRITEFILE = 1
const WIN-CALL-GETCURRENTPROCESSID = 2
const WIN-CALL-EXITPROCESS = 3
const WIN-CALL-CREATEFILEA = 4
const WIN-CALL-READFILE = 5
const WIN-CALL-CLOSEHANDLE = 6
const WIN-CALL-GETFILESIZE = 7
const WIN-CALL-SLEEP = 8
const WIN-CALL-GETCURRENTTHREADID = 9
const WIN-CALL-DELETEFILEA = 10
const WIN-CALL-SETFILEPOINTER = 11
const WIN-CALL-GETSTDHANDLE = 12
const WIN-CALL-MOVEFILEA = 13
const WIN-CALL-FLUSHFILEBUFFERS = 14
const WIN-CALL-CREATEDIRECTORYA = 15
const WIN-CALL-REMOVEDIRECTORYA = 16
const WIN-CALL-GETLASTERROR = 17
const WIN-CALL-SETLASTERROR = 18
const WIN-CALL-VIRTUALALLOC = 19
const WIN-CALL-VIRTUALFREE = 20
const WIN-CALL-CREATEPROCESSA = 21
const WIN-CALL-WAITFORSINGLEOBJECT = 22
const WIN-CALL-GETCOMMANDLINEA = 23
const WIN-CALL-WRITECONSOLEA = 24
const WIN-CALL-GETMODULEFILENAMEA = 25
const WIN-CALL-HEAPALLOC = 26
const WIN-CALL-HEAPFREE = 27
const WIN-CALL-COPYFILEA = 28
const WIN-CALL-GETENVIRONMENTVARIABLEA = 29
const WIN-CALL-OUTPUTDEBUGSTRINGA = 30
const WIN-CALL-DUPLICATEHANDLE = 31
const WIN-CALL-GETFILETYPE = 32
const WIN-CALL-SETENDOFFILE = 33
const WIN-CALL-RTLGETLASTNTSTATUS = 34
const WIN-CALL-RTLNTSTATUSTODOSERROR = 35
const WIN-CALL-RTLGETLASTWIN32ERROR = 36

const WIN-MAX-HANDLES = 16
const WIN-HANDLE-STRIDE = 16
const WIN-INVALID-HANDLE = 0
const WIN-ACCESS-READ = 0
const WIN-ACCESS-WRITE = 1
// Win32 error codes (winerror.h subset).
const WIN-ERROR-SUCCESS = 0
const WIN-ERROR-FILE-NOT-FOUND = 2
const WIN-ERROR-PATH-NOT-FOUND = 3
const WIN-ERROR-TOO-MANY-OPEN-FILES = 4
const WIN-ERROR-ACCESS-DENIED = 5
const WIN-ERROR-INVALID-HANDLE = 6
const WIN-ERROR-NOT-ENOUGH-MEMORY = 8
const WIN-ERROR-GEN-FAILURE = 31
const WIN-ERROR-HANDLE-EOF = 38
const WIN-ERROR-NOT-SUPPORTED = 50
const WIN-ERROR-FILE-EXISTS = 80
const WIN-ERROR-INVALID-PARAMETER = 87
const WIN-ERROR-INSUFFICIENT-BUFFER = 122
const WIN-ERROR-DISK-FULL = 112
const WIN-ERROR-DIR-NOT-EMPTY = 145
const WIN-ERROR-ALREADY-EXISTS = 183
const WIN-HANDLE-TYPE-FREE = 0
const WIN-HANDLE-TYPE-CONSOLE = 1
const WIN-HANDLE-TYPE-FILE = 2
const WIN-HANDLE-TYPE-PROCESS = 3

// GetFileType return values.
const WIN-FILE-TYPE-DISK = 1
const WIN-FILE-TYPE-CHAR = 2
const WIN-FILE-TYPE-UNKNOWN = 0

// NTSTATUS mapping.
const WIN-STATUS-SUCCESS = 0
const WIN-STATUS-END-OF-FILE = -1073741805
const WIN-STATUS-FILE-IS-A-DIRECTORY = -1073741810
const WIN-STATUS-NO-MEDIA = -1073741768
const WIN-STATUS-INVALID-HANDLE = -1073741816
const WIN-STATUS-OBJECT-NAME-NOT-FOUND = -1073741772
const WIN-STATUS-UNSUCCESSFUL = -1073741823
const WIN-STATUS-NOT-IMPLEMENTED = -1073741822
const WIN-STATUS-INVALID-PARAMETER = -1073741811
const WIN-STATUS-ACCESS-DENIED = -1073741790
const WIN-STATUS-NO-MEMORY = -1073741801
const WIN-STATUS-OBJECT-NAME-COLLISION = -1073741771
const WIN-STATUS-OBJECT-PATH-NOT-FOUND = -1073741766
const WIN-STATUS-DISK-FULL = -1073741697
const WIN-STATUS-INSUFFICIENT-RESOURCES = -1073741670
const WIN-STATUS-DIRECTORY-NOT-EMPTY = -1073741567
const WIN-STATUS-TOO-MANY-OPENED-FILES = -1073741537
const WIN-STATUS-BUFFER-TOO-SMALL = -1073741789
const WIN-STATUS-IO-DEVICE-ERROR = -1073741435

// Typed handle table: 16-byte records, slots 0..15.
// offset 0: type (0=free, 1=console, 2=file, 3=process)
// offset 8: value (console 1/2, file vfd, process pid)
// Slots 1/2 reserved console; 3..15 file or process.
var win-ready: Int = 0
var win-handles: Int = 0
var win-last-error: Int = 0
var win-last-status: Int = 0
var win-cmdline: Int = 0

fn win-handle-base(handle: Int) -> Int {
  return win-handles + handle * WIN-HANDLE-STRIDE
}

fn win-handle-set(h: Int, typ: Int, value: Int) -> void {
  if h < 0 {
    return
  }
  if h >= WIN-MAX-HANDLES {
    return
  }
  let base = win-handle-base(h)
  store64(base + 0, typ)
  store64(base + 8, value)
  return
}

fn win-handle-type(h: Int) -> Int {
  if h < 0 {
    return WIN-HANDLE-TYPE-FREE
  }
  if h >= WIN-MAX-HANDLES {
    return WIN-HANDLE-TYPE-FREE
  }
  return load64(win-handle-base(h) + 0)
}

fn win-handle-value(h: Int) -> Int {
  if h < 0 {
    return 0
  }
  if h >= WIN-MAX-HANDLES {
    return 0
  }
  return load64(win-handle-base(h) + 8)
}

// Map VFS/errno-shaped return codes to NTSTATUS values.
fn win-ntstatus(vfs-rc: Int) -> Int {
  if vfs-rc >= 0 {
    return WIN-STATUS-SUCCESS
  }
  if vfs-rc == -2 {
    return WIN-STATUS-OBJECT-NAME-NOT-FOUND
  }
  if vfs-rc == -5 {
    return WIN-STATUS-IO-DEVICE-ERROR
  }
  if vfs-rc == -6 {
    return WIN-STATUS-NO-MEDIA
  }
  if vfs-rc == -9 {
    return WIN-STATUS-INVALID-HANDLE
  }
  if vfs-rc == -12 {
    return WIN-STATUS-NO-MEMORY
  }
  if vfs-rc == -13 {
    return WIN-STATUS-ACCESS-DENIED
  }
  if vfs-rc == -16 {
    return WIN-STATUS-TOO-MANY-OPENED-FILES
  }
  if vfs-rc == -17 {
    return WIN-STATUS-OBJECT-NAME-COLLISION
  }
  if vfs-rc == -21 {
    return WIN-STATUS-FILE-IS-A-DIRECTORY
  }
  if vfs-rc == -22 {
    return WIN-STATUS-INVALID-PARAMETER
  }
  if vfs-rc == -28 {
    return WIN-STATUS-DISK-FULL
  }
  if vfs-rc == -38 {
    return WIN-STATUS-NOT-IMPLEMENTED
  }
  if vfs-rc == -39 {
    return WIN-STATUS-DIRECTORY-NOT-EMPTY
  }
  return WIN-STATUS-UNSUCCESSFUL
}

// RtlNtStatusToDosError subset: NTSTATUS → Win32 error code.
fn win-dos-error(status: Int) -> Int {
  if status == WIN-STATUS-SUCCESS {
    return WIN-ERROR-SUCCESS
  }
  if status == WIN-STATUS-OBJECT-NAME-NOT-FOUND {
    return WIN-ERROR-FILE-NOT-FOUND
  }
  if status == WIN-STATUS-OBJECT-PATH-NOT-FOUND {
    return WIN-ERROR-PATH-NOT-FOUND
  }
  if status == WIN-STATUS-OBJECT-NAME-COLLISION {
    return WIN-ERROR-ALREADY-EXISTS
  }
  if status == WIN-STATUS-INVALID-HANDLE {
    return WIN-ERROR-INVALID-HANDLE
  }
  if status == WIN-STATUS-ACCESS-DENIED {
    return WIN-ERROR-ACCESS-DENIED
  }
  if status == WIN-STATUS-NO-MEMORY {
    return WIN-ERROR-NOT-ENOUGH-MEMORY
  }
  if status == WIN-STATUS-INSUFFICIENT-RESOURCES {
    return WIN-ERROR-NOT-ENOUGH-MEMORY
  }
  if status == WIN-STATUS-TOO-MANY-OPENED-FILES {
    return WIN-ERROR-TOO-MANY-OPEN-FILES
  }
  if status == WIN-STATUS-DISK-FULL {
    return WIN-ERROR-DISK-FULL
  }
  if status == WIN-STATUS-DIRECTORY-NOT-EMPTY {
    return WIN-ERROR-DIR-NOT-EMPTY
  }
  if status == WIN-STATUS-END-OF-FILE {
    return WIN-ERROR-HANDLE-EOF
  }
  if status == WIN-STATUS-FILE-IS-A-DIRECTORY {
    return WIN-ERROR-ACCESS-DENIED
  }
  if status == WIN-STATUS-INVALID-PARAMETER {
    return WIN-ERROR-INVALID-PARAMETER
  }
  if status == WIN-STATUS-BUFFER-TOO-SMALL {
    return WIN-ERROR-INSUFFICIENT-BUFFER
  }
  if status == WIN-STATUS-NOT-IMPLEMENTED {
    return WIN-ERROR-NOT-SUPPORTED
  }
  if status == WIN-STATUS-NO-MEDIA {
    return WIN-ERROR-GEN-FAILURE
  }
  if status == WIN-STATUS-IO-DEVICE-ERROR {
    return WIN-ERROR-GEN-FAILURE
  }
  return WIN-ERROR-GEN-FAILURE
}

// Inverse of win-dos-error for the SetLastError path, so GetLastError and
// RtlGetLastNtStatus never disagree.
fn win-status-from-error(err: Int) -> Int {
  if err == WIN-ERROR-SUCCESS {
    return WIN-STATUS-SUCCESS
  }
  if err == WIN-ERROR-FILE-NOT-FOUND {
    return WIN-STATUS-OBJECT-NAME-NOT-FOUND
  }
  if err == WIN-ERROR-PATH-NOT-FOUND {
    return WIN-STATUS-OBJECT-PATH-NOT-FOUND
  }
  if err == WIN-ERROR-ALREADY-EXISTS {
    return WIN-STATUS-OBJECT-NAME-COLLISION
  }
  if err == WIN-ERROR-FILE-EXISTS {
    return WIN-STATUS-OBJECT-NAME-COLLISION
  }
  if err == WIN-ERROR-INVALID-HANDLE {
    return WIN-STATUS-INVALID-HANDLE
  }
  if err == WIN-ERROR-ACCESS-DENIED {
    return WIN-STATUS-ACCESS-DENIED
  }
  if err == WIN-ERROR-NOT-ENOUGH-MEMORY {
    return WIN-STATUS-NO-MEMORY
  }
  if err == WIN-ERROR-TOO-MANY-OPEN-FILES {
    return WIN-STATUS-TOO-MANY-OPENED-FILES
  }
  if err == WIN-ERROR-DISK-FULL {
    return WIN-STATUS-DISK-FULL
  }
  if err == WIN-ERROR-DIR-NOT-EMPTY {
    return WIN-STATUS-DIRECTORY-NOT-EMPTY
  }
  if err == WIN-ERROR-HANDLE-EOF {
    return WIN-STATUS-END-OF-FILE
  }
  if err == WIN-ERROR-INVALID-PARAMETER {
    return WIN-STATUS-INVALID-PARAMETER
  }
  if err == WIN-ERROR-INSUFFICIENT-BUFFER {
    return WIN-STATUS-BUFFER-TOO-SMALL
  }
  if err == WIN-ERROR-NOT-SUPPORTED {
    return WIN-STATUS-NOT-IMPLEMENTED
  }
  return WIN-STATUS-UNSUCCESSFUL
}

// Single writer for both last-error slots: keeps LastError and NTSTATUS paired.
fn win-set-error(err: Int) -> void {
  win-last-error = err
  win-last-status = win-status-from-error(err)
  return
}

fn win-set-status(status: Int) -> void {
  win-last-status = status
  win-last-error = win-dos-error(status)
  return
}

// Record a VFS/errno-shaped failure code as both NTSTATUS and Win32 error.
fn win-set-error-rc(rc: Int) -> void {
  win-set-status(win-ntstatus(rc))
  return
}

fn win-clear-error() -> void {
  win-last-error = WIN-ERROR-SUCCESS
  win-last-status = WIN-STATUS-SUCCESS
  return
}

// Existence probe used to refine 0/-1 filesystem failures into real codes.
fn win-path-exists(path: Int) -> Int {
  if path == 0 {
    return 0
  }
  let sbuf = alloc(256)
  if fs-stat(path, sbuf) == 0 {
    return 1
  }
  return 0
}

// mkdir failed: collision if the name is taken, otherwise a bad parent path.
fn win-set-error-mkdir(path: Int) -> void {
  if win-path-exists(path) != 0 {
    win-set-status(WIN-STATUS-OBJECT-NAME-COLLISION)
    return
  }
  win-set-status(WIN-STATUS-OBJECT-PATH-NOT-FOUND)
  return
}

// unlink/rmdir failed: missing name vs a directory that still has entries.
fn win-set-error-unlink(path: Int) -> void {
  if win-path-exists(path) == 0 {
    win-set-status(WIN-STATUS-OBJECT-NAME-NOT-FOUND)
    return
  }
  win-set-status(WIN-STATUS-DIRECTORY-NOT-EMPTY)
  return
}

// rename failed: missing source vs occupied destination.
fn win-set-error-rename(oldp: Int, newp: Int) -> void {
  if win-path-exists(oldp) == 0 {
    win-set-status(WIN-STATUS-OBJECT-NAME-NOT-FOUND)
    return
  }
  if win-path-exists(newp) != 0 {
    win-set-status(WIN-STATUS-OBJECT-NAME-COLLISION)
    return
  }
  win-set-status(WIN-STATUS-OBJECT-PATH-NOT-FOUND)
  return
}

fn win-init() -> void {
  if win-ready != 0 {
    return
  }
  win-handles = alloc(WIN-MAX-HANDLES * WIN-HANDLE-STRIDE)
  let i = 0
  while i < WIN-MAX-HANDLES {
    win-handle-set(i, WIN-HANDLE-TYPE-FREE, 0)
    i = i + 1
  }
  // Reserved console handles (no VFS fd backing).
  win-handle-set(1, WIN-HANDLE-TYPE-CONSOLE, 1)
  win-handle-set(2, WIN-HANDLE-TYPE-CONSOLE, 2)
  // Static command line for GetCommandLineA (not real argv).
  win-cmdline = alloc(16)
  store8(win-cmdline + 0, 115)
  store8(win-cmdline + 1, 112)
  store8(win-cmdline + 2, 97)
  store8(win-cmdline + 3, 99)
  store8(win-cmdline + 4, 101)
  store8(win-cmdline + 5, 45)
  store8(win-cmdline + 6, 119)
  store8(win-cmdline + 7, 105)
  store8(win-cmdline + 8, 110)
  store8(win-cmdline + 9, 100)
  store8(win-cmdline + 10, 111)
  store8(win-cmdline + 11, 119)
  store8(win-cmdline + 12, 115)
  store8(win-cmdline + 13, 0)
  win-clear-error()
  win-ready = 1
  return
}

fn win-handle-alloc(vfd: Int) -> Int {
  let i = 3
  while i < WIN-MAX-HANDLES {
    if win-handle-type(i) == WIN-HANDLE-TYPE-FREE {
      win-handle-set(i, WIN-HANDLE-TYPE-FILE, vfd)
      return i
    }
    i = i + 1
  }
  return WIN-INVALID-HANDLE
}

fn win-handle-alloc-process(pid: Int) -> Int {
  let i = 3
  while i < WIN-MAX-HANDLES {
    if win-handle-type(i) == WIN-HANDLE-TYPE-FREE {
      win-handle-set(i, WIN-HANDLE-TYPE-PROCESS, pid)
      return i
    }
    i = i + 1
  }
  return WIN-INVALID-HANDLE
}

fn win-handle-vfd(handle: Int) -> Int {
  if win-handle-type(handle) != WIN-HANDLE-TYPE-FILE {
    return -1
  }
  return win-handle-value(handle)
}

fn win-handle-free(handle: Int) -> Int {
  if handle < 3 {
    return 0
  }
  if handle >= WIN-MAX-HANDLES {
    return -1
  }
  if win-handle-type(handle) == WIN-HANDLE-TYPE-FREE {
    return -1
  }
  win-handle-set(handle, WIN-HANDLE-TYPE-FREE, 0)
  return 0
}

fn win-dispatch(port: Int, num: Int, a0: Int, a1: Int, a2: Int, a3: Int) -> Int {
  if win-ready == 0 {
    win-init()
  }
  if num == WIN-CALL-WRITEFILE {
    let handle = a0
    let buf = a1
    let len = a2
    let htype = win-handle-type(handle)
    if htype == WIN-HANDLE-TYPE-CONSOLE || handle == 1 || handle == 2 {
      let i = 0
      while i < len {
        serial-put(port, load8(buf + i))
        i = i + 1
      }
      win-clear-error()
      return len
    }
    if htype != WIN-HANDLE-TYPE-FILE {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    let vfd = win-handle-value(handle)
    let n = vfs-write(vfd, buf, len)
    if n < 0 {
      win-set-error-rc(n)
      return 0
    }
    win-clear-error()
    return n
  }
  if num == WIN-CALL-GETCURRENTPROCESSID {
    return current-task
  }
  if num == WIN-CALL-EXITPROCESS {
    // Demo only: do not halt the kernel.
    return a0
  }
  if num == WIN-CALL-CREATEFILEA {
    let path = a0
    let access = a1
    let flags = VFS-O-RDONLY
    if access == WIN-ACCESS-WRITE {
      flags = VFS-O-RDWR | VFS-O-CREAT
    }
    let vfd = vfs-open(path, flags)
    if vfd < 0 {
      win-set-error-rc(vfd)
      return WIN-INVALID-HANDLE
    }
    let h = win-handle-alloc(vfd)
    if h == WIN-INVALID-HANDLE {
      vfs-close(vfd)
      win-set-error(WIN-ERROR-TOO-MANY-OPEN-FILES)
      return WIN-INVALID-HANDLE
    }
    win-clear-error()
    return h
  }
  if num == WIN-CALL-READFILE {
    let handle = a0
    let buf = a1
    let len = a2
    if win-handle-type(handle) != WIN-HANDLE-TYPE-FILE {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    let vfd = win-handle-value(handle)
    let n = vfs-read(vfd, buf, len)
    if n < 0 {
      win-set-error-rc(n)
      return 0
    }
    if n == 0 && len > 0 {
      win-set-status(WIN-STATUS-END-OF-FILE)
      return 0
    }
    win-clear-error()
    return n
  }
  if num == WIN-CALL-CLOSEHANDLE {
    let handle = a0
    let htype = win-handle-type(handle)
    if htype == WIN-HANDLE-TYPE-CONSOLE || handle == 1 || handle == 2 {
      win-clear-error()
      return 1
    }
    if htype == WIN-HANDLE-TYPE-PROCESS {
      win-handle-free(handle)
      win-clear-error()
      return 1
    }
    if htype != WIN-HANDLE-TYPE-FILE {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    let vfd = win-handle-value(handle)
    vfs-close(vfd)
    win-handle-free(handle)
    win-clear-error()
    return 1
  }
  if num == WIN-CALL-GETFILESIZE {
    let handle = a0
    if win-handle-type(handle) != WIN-HANDLE-TYPE-FILE {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    let vfd = win-handle-value(handle)
    if vfs-fd-valid(vfd) == 0 {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    let base = vfs-fd-table + vfd * 32
    let path = load64(base + 0)
    let sz = vfs-sparkfs-file-size(path)
    if sz < 0 {
      win-set-error(WIN-ERROR-FILE-NOT-FOUND)
      return 0
    }
    win-clear-error()
    return sz
  }
  if num == WIN-CALL-SLEEP {
    // Shell/demo path is not thr- worker stack: thr-yield ctxsw faults.
    // Small busy pause only (honest Sleep stand-in).
    let n = a0
    if n < 1 {
      n = 1
    }
    if n > 64 {
      n = 64
    }
    let i = 0
    while i < n * 256 {
      i = i + 1
    }
    return 0
  }
  if num == WIN-CALL-GETCURRENTTHREADID {
    return current-task
  }
  if num == WIN-CALL-DELETEFILEA {
    let path = a0
    let rc = fs-delete(path)
    if rc != 0 {
      win-set-error-unlink(path)
      return 0
    }
    win-clear-error()
    return 1
  }
  if num == WIN-CALL-SETFILEPOINTER {
    let handle = a0
    let offset = a1
    let whence = a2
    if win-handle-type(handle) != WIN-HANDLE-TYPE-FILE {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return -1
    }
    let vfd = win-handle-value(handle)
    win-clear-error()
    return vfs-lseek(vfd, offset, whence)
  }
  if num == WIN-CALL-GETSTDHANDLE {
    // Space-local: -10 stdin→0, -11 stdout→1, -12 stderr→2
    if a0 == -10 {
      win-clear-error()
      return 0
    }
    if a0 == -11 {
      win-clear-error()
      return 1
    }
    if a0 == -12 {
      win-clear-error()
      return 2
    }
    win-set-error(WIN-ERROR-INVALID-HANDLE)
    return WIN-INVALID-HANDLE
  }
  if num == WIN-CALL-MOVEFILEA {
    let oldp = a0
    let newp = a1
    let rc = fs-rename(oldp, newp)
    if rc != 0 {
      win-set-error-rename(oldp, newp)
      return 0
    }
    win-clear-error()
    return 1
  }
  if num == WIN-CALL-FLUSHFILEBUFFERS {
    let handle = a0
    let htype = win-handle-type(handle)
    if htype == WIN-HANDLE-TYPE-CONSOLE || handle == 1 || handle == 2 {
      win-clear-error()
      return 1
    }
    if htype != WIN-HANDLE-TYPE-FILE {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    // No-op success: VFS writes are already durable enough for this subset.
    win-clear-error()
    return 1
  }
  if num == WIN-CALL-CREATEDIRECTORYA {
    let path = a0
    let rc = fs-mkdir(path)
    if rc != 0 {
      win-set-error-mkdir(path)
      return 0
    }
    win-clear-error()
    return 1
  }
  if num == WIN-CALL-REMOVEDIRECTORYA {
    let path = a0
    let rc = fs-rmdir(path)
    if rc != 0 {
      win-set-error-unlink(path)
      return 0
    }
    win-clear-error()
    return 1
  }
  if num == WIN-CALL-GETLASTERROR {
    return win-last-error
  }
  if num == WIN-CALL-RTLGETLASTWIN32ERROR {
    return win-last-error
  }
  if num == WIN-CALL-RTLGETLASTNTSTATUS {
    return win-last-status
  }
  if num == WIN-CALL-RTLNTSTATUSTODOSERROR {
    return win-dos-error(a0)
  }
  if num == WIN-CALL-SETLASTERROR {
    win-set-error(a0)
    return 0
  }
  if num == WIN-CALL-VIRTUALALLOC {
    // a0 preferred addr ignored; a1 size. Not real VirtualAlloc/MEM_*.
    let size = a1
    if size < 1 {
      win-set-error(WIN-ERROR-INVALID-PARAMETER)
      return 0
    }
    let p = posix-sys-mmap(0, size, 0, 0, -1, 0)
    if p == 0 {
      win-set-error(WIN-ERROR-NOT-ENOUGH-MEMORY)
      return 0
    }
    win-clear-error()
    return p
  }
  if num == WIN-CALL-VIRTUALFREE {
    // a0 addr a1 size. Best-effort munmap stand-in; not real MEM_RELEASE.
    let addr = a0
    let size = a1
    if addr == 0 {
      win-set-error(WIN-ERROR-INVALID-PARAMETER)
      return 0
    }
    if size < 1 {
      size = 4096
    }
    posix-sys-munmap(addr, size)
    win-clear-error()
    return 1
  }
  if num == WIN-CALL-CREATEPROCESSA {
    // a0 app path only. Not real CreateProcessA / PE spawn.
    let path = a0
    if path == 0 {
      win-set-error(WIN-ERROR-FILE-NOT-FOUND)
      return 0
    }
    if load8(path) == 0 {
      win-set-error(WIN-ERROR-FILE-NOT-FOUND)
      return 0
    }
    let status = proc-spawn-sci(port, path)
    if status < 0 {
      win-set-error(WIN-ERROR-FILE-NOT-FOUND)
      return 0
    }
    let pid = proc-count - 1
    if pid < 0 {
      pid = 0
    }
    let h = win-handle-alloc-process(pid)
    if h == WIN-INVALID-HANDLE {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    win-clear-error()
    return h
  }
  if num == WIN-CALL-WAITFORSINGLEOBJECT {
    // Demo: process handles only. Not real wait objects / timeouts.
    let handle = a0
    if win-handle-type(handle) != WIN-HANDLE-TYPE-PROCESS {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    let pid = win-handle-value(handle)
    let code = proc-wait(pid)
    if code < 0 {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    win-clear-error()
    return 0
  }
  if num == WIN-CALL-GETCOMMANDLINEA {
    if win-cmdline == 0 {
      win-init()
    }
    win-clear-error()
    return win-cmdline
  }
  if num == WIN-CALL-WRITECONSOLEA {
    // Alias WriteFile on console handles only.
    let handle = a0
    let buf = a1
    let len = a2
    if win-handle-type(handle) != WIN-HANDLE-TYPE-CONSOLE && handle != 1 && handle != 2 {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    return win-dispatch(port, WIN-CALL-WRITEFILE, handle, buf, len, 0)
  }
  if num == WIN-CALL-GETMODULEFILENAMEA {
    // a0 hModule ignored; a1 buf a2 size. Static module name only.
    let buf = a1
    let size = a2
    if buf == 0 || size < 2 {
      win-set-error(WIN-ERROR-INVALID-PARAMETER)
      return 0
    }
    let name = "space.exe"
    let nlen = 0
    while load8(name + nlen) != 0 {
      nlen = nlen + 1
    }
    if size <= nlen {
      win-set-error(WIN-ERROR-INSUFFICIENT-BUFFER)
      return 0
    }
    let i = 0
    while i < nlen {
      store8(buf + i, load8(name + i))
      i = i + 1
    }
    store8(buf + nlen, 0)
    win-clear-error()
    return nlen
  }
  if num == WIN-CALL-HEAPALLOC {
    // a0 heap ignored; a1 flags ignored; a2 size. Bump alloc + zero.
    let size = a2
    if size < 1 {
      win-set-error(WIN-ERROR-INVALID-PARAMETER)
      return 0
    }
    let p = alloc(size)
    if p == 0 {
      win-set-error(WIN-ERROR-NOT-ENOUGH-MEMORY)
      return 0
    }
    let i = 0
    while i < size {
      store8(p + i, 0)
      i = i + 1
    }
    win-clear-error()
    return p
  }
  if num == WIN-CALL-HEAPFREE {
    // a0 heap a1 flags a2 ptr. Bump heap has no free — success only.
    if a2 == 0 {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    win-clear-error()
    return 1
  }
  if num == WIN-CALL-COPYFILEA {
    // a0 src a1 dst. Whole-file copy via VFS helpers.
    let src = a0
    let dst = a1
    if src == 0 || dst == 0 {
      win-set-error(WIN-ERROR-FILE-NOT-FOUND)
      return 0
    }
    let cbuf = alloc(4096)
    let n = fs-read-file(src, cbuf)
    if n < 0 {
      win-set-error-unlink(src)
      return 0
    }
    let wrc = fs-write-file(dst, cbuf, n)
    if wrc != 0 {
      win-set-status(WIN-STATUS-DISK-FULL)
      return 0
    }
    win-clear-error()
    return 1
  }
  if num == WIN-CALL-GETENVIRONMENTVARIABLEA {
    // a0 name a1 buf a2 size. PATH → "/"; else empty.
    let name = a0
    let buf = a1
    let size = a2
    if buf == 0 || size < 1 {
      win-set-error(WIN-ERROR-INVALID-PARAMETER)
      return 0
    }
    let is-path = 0
    if name != 0 {
      if load8(name + 0) == 80 {
        if load8(name + 1) == 65 {
          if load8(name + 2) == 84 {
            if load8(name + 3) == 72 {
              if load8(name + 4) == 0 {
                is-path = 1
              }
            }
          }
        }
      }
    }
    if is-path != 0 {
      if size < 2 {
        win-set-error(WIN-ERROR-INSUFFICIENT-BUFFER)
        return 0
      }
      store8(buf + 0, 47)
      store8(buf + 1, 0)
      win-clear-error()
      return 1
    }
    store8(buf + 0, 0)
    win-clear-error()
    return 0
  }
  if num == WIN-CALL-OUTPUTDEBUGSTRINGA {
    let s = a0
    if s == 0 {
      win-clear-error()
      return 0
    }
    serial-write-cstr(port, s)
    win-clear-error()
    return 0
  }
  if num == WIN-CALL-DUPLICATEHANDLE {
    // a0 = source handle. Return new handle with same type+value.
    let src = a0
    let stype = win-handle-type(src)
    if stype == WIN-HANDLE-TYPE-FREE {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return WIN-INVALID-HANDLE
    }
    let sval = win-handle-value(src)
    let nh = -1
    if stype == WIN-HANDLE-TYPE-PROCESS {
      nh = win-handle-alloc-process(sval)
    } else {
      // Console + file: use generic file alloc for files, or manual for console.
      if stype == WIN-HANDLE-TYPE-CONSOLE {
        // Allocate a free slot and set console type manually.
        let i = 3
        while i < WIN-MAX-HANDLES {
          if win-handle-type(i) == WIN-HANDLE-TYPE-FREE {
            win-handle-set(i, WIN-HANDLE-TYPE-CONSOLE, sval)
            nh = i
            break
          }
          i = i + 1
        }
      } else {
        nh = win-handle-alloc(sval)
      }
    }
    if nh < 0 || nh >= WIN-MAX-HANDLES {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return WIN-INVALID-HANDLE
    }
    win-clear-error()
    return nh
  }
  if num == WIN-CALL-GETFILETYPE {
    let handle = a0
    let htype = win-handle-type(handle)
    if htype == WIN-HANDLE-TYPE-CONSOLE {
      win-clear-error()
      return WIN-FILE-TYPE-CHAR
    }
    if htype == WIN-HANDLE-TYPE-FILE {
      win-clear-error()
      return WIN-FILE-TYPE-DISK
    }
    if handle == 1 || handle == 2 {
      win-clear-error()
      return WIN-FILE-TYPE-CHAR
    }
    win-set-error(WIN-ERROR-INVALID-HANDLE)
    return WIN-FILE-TYPE-UNKNOWN
  }
  if num == WIN-CALL-SETENDOFFILE {
    // a0 = file handle. Truncate at current VFS position.
    let handle = a0
    if win-handle-type(handle) != WIN-HANDLE-TYPE-FILE {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    let vfd = win-handle-value(handle)
    if vfs-fd-valid(vfd) == 0 {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    // Get current position from VFS fd table (offset 8 = pos).
    let pos = load64(vfs-fd-table + vfd * 32 + 8)
    let fpath = load64(vfs-fd-table + vfd * 32 + 0)
    if fpath == -1 || fpath == 0 {
      win-set-error(WIN-ERROR-INVALID-HANDLE)
      return 0
    }
    // Read existing file content, truncate to pos, write back.
    let fullsz = vfs-sparkfs-file-size(fpath)
    if fullsz < 0 {
      win-set-error(WIN-ERROR-FILE-NOT-FOUND)
      return 0
    }
    if pos >= fullsz {
      // Nothing to truncate.
      win-clear-error()
      return 1
    }
    let truncbuf = alloc(pos)
    if pos > 0 {
      // Reopen to read from start.
      let rfd = vfs-open(fpath, VFS-O-RDONLY)
      if rfd >= 0 {
        vfs-read(rfd, truncbuf, pos)
        vfs-close(rfd)
      }
    }
    fs-write-file(fpath, truncbuf, pos)
    win-clear-error()
    return 1
  }
  return 0
}

// Print "<label> = <err> / <status>" for the current last-error pair.
fn win-report-error(port: Int, label: Int) -> void {
  serial-write-cstr(port, label)
  serial-write-cstr(port, " GetLastError = ")
  serial-write-dec-wide(port, win-last-error)
  serial-write-cstr(port, " NTSTATUS = ")
  serial-write-dec-wide(port, win-last-status)
  serial-nl(port)
  return
}

// Invariant: GetLastError() == RtlNtStatusToDosError(RtlGetLastNtStatus()).
fn win-error-pair-consistent(port: Int) -> Int {
  let err = win-dispatch(port, WIN-CALL-GETLASTERROR, 0, 0, 0, 0)
  let status = win-dispatch(port, WIN-CALL-RTLGETLASTNTSTATUS, 0, 0, 0, 0)
  let mapped = win-dispatch(port, WIN-CALL-RTLNTSTATUSTODOSERROR, status, 0, 0, 0)
  if mapped == err {
    return 1
  }
  return 0
}

fn win-status-demo(port: Int) -> void {
  let checks = 0
  let ok = 0

  // Missing file: STATUS_OBJECT_NAME_NOT_FOUND / ERROR_FILE_NOT_FOUND.
  win-dispatch(port, WIN-CALL-DELETEFILEA, "win-err-nosuch.txt", 0, 0, 0)
  win-report-error(port, "windows: DeleteFileA(missing)")
  checks = checks + 1
  if win-last-error == WIN-ERROR-FILE-NOT-FOUND && win-last-status == WIN-STATUS-OBJECT-NAME-NOT-FOUND {
    ok = ok + 1
  }

  // Bad handle: STATUS_INVALID_HANDLE / ERROR_INVALID_HANDLE.
  let rbuf = alloc(16)
  win-dispatch(port, WIN-CALL-READFILE, WIN-MAX-HANDLES - 1, rbuf, 8, 0)
  win-report-error(port, "windows: ReadFile(unopened handle)")
  checks = checks + 1
  if win-last-error == WIN-ERROR-INVALID-HANDLE && win-last-status == WIN-STATUS-INVALID-HANDLE {
    ok = ok + 1
  }

  // Existing name: STATUS_OBJECT_NAME_COLLISION / ERROR_ALREADY_EXISTS.
  let edir = "win-err-dir"
  win-dispatch(port, WIN-CALL-CREATEDIRECTORYA, edir, 0, 0, 0)
  let again = win-dispatch(port, WIN-CALL-CREATEDIRECTORYA, edir, 0, 0, 0)
  serial-write-cstr(port, "windows: CreateDirectoryA(existing) = ")
  serial-write-dec-wide(port, again)
  serial-nl(port)
  win-report-error(port, "windows: CreateDirectoryA(existing)")
  checks = checks + 1
  if win-last-error == WIN-ERROR-ALREADY-EXISTS && win-last-status == WIN-STATUS-OBJECT-NAME-COLLISION {
    ok = ok + 1
  }
  win-dispatch(port, WIN-CALL-REMOVEDIRECTORYA, edir, 0, 0, 0)

  // SetLastError feeds the NTSTATUS slot too.
  win-dispatch(port, WIN-CALL-SETLASTERROR, WIN-ERROR-DISK-FULL, 0, 0, 0)
  win-report-error(port, "windows: SetLastError(ERROR_DISK_FULL)")
  checks = checks + 1
  if win-last-status == WIN-STATUS-DISK-FULL {
    ok = ok + 1
  }

  // Success path clears both slots.
  win-dispatch(port, WIN-CALL-GETSTDHANDLE, -11, 0, 0, 0)
  win-report-error(port, "windows: GetStdHandle(stdout)")
  checks = checks + 1
  if win-last-error == WIN-ERROR-SUCCESS && win-last-status == WIN-STATUS-SUCCESS {
    ok = ok + 1
  }

  serial-write-cstr(port, "windows: LastError/NTSTATUS scenarios ")
  serial-write-dec-wide(port, ok)
  serial-write-cstr(port, "/")
  serial-write-dec-wide(port, checks)
  serial-nl(port)

  // Every VFS/errno-shaped code must round-trip status → dos error.
  let rcs = alloc(8 * 10)
  store64(rcs + 0, -2)
  store64(rcs + 8, -5)
  store64(rcs + 16, -9)
  store64(rcs + 24, -12)
  store64(rcs + 32, -13)
  store64(rcs + 40, -16)
  store64(rcs + 48, -17)
  store64(rcs + 56, -22)
  store64(rcs + 64, -28)
  store64(rcs + 72, -39)
  let i = 0
  let pairs = 0
  while i < 10 {
    let rc = load64(rcs + i * 8)
    win-set-error-rc(rc)
    serial-write-cstr(port, "windows: rc ")
    serial-write-dec-wide(port, rc)
    serial-write-cstr(port, " -> NTSTATUS ")
    serial-write-dec-wide(port, win-last-status)
    serial-write-cstr(port, " -> Win32 ")
    serial-write-dec-wide(port, win-last-error)
    serial-nl(port)
    if win-error-pair-consistent(port) != 0 {
      pairs = pairs + 1
    }
    i = i + 1
  }
  serial-write-cstr(port, "windows: errno/NTSTATUS pairs consistent ")
  serial-write-dec-wide(port, pairs)
  serial-write-cstr(port, "/10")
  serial-nl(port)
  if pairs == 10 && ok == checks {
    serial-write-cstr(port, "windows: LastError/NTSTATUS consistency OK")
  } else {
    serial-write-cstr(port, "windows: LastError/NTSTATUS consistency FAILED")
  }
  serial-nl(port)
  win-clear-error()
  return
}

fn win-demo(port: Int) -> void {
  if win-ready == 0 {
    win-init()
  }
  serial-write-cstr(port, "windows: Win32 subset personality registered (translator)")
  serial-nl(port)
  serial-write-cstr(port, "windows: typed handles active")
  serial-nl(port)

  let msg = "  hello from windows personality (WriteFile stdout)\n"
  let mlen = 0
  while load8(msg + mlen) != 0 {
    mlen = mlen + 1
  }
  let wrc = win-dispatch(port, WIN-CALL-WRITEFILE, 1, msg, mlen, 0)
  serial-write-cstr(port, "windows: WriteFile(stdout, msg, ")
  serial-write-dec-wide(port, mlen)
  serial-write-cstr(port, ") = ")
  serial-write-dec-wide(port, wrc)
  serial-nl(port)

  let fname = "win-hello.txt"
  let wh = win-dispatch(port, WIN-CALL-CREATEFILEA, fname, WIN-ACCESS-WRITE, 0, 0)
  serial-write-cstr(port, "windows: CreateFileA(win-hello.txt, write) = ")
  serial-write-dec-wide(port, wh)
  serial-nl(port)

  if wh != WIN-INVALID-HANDLE {
    let content = "windows file content"
    let clen = 0
    while load8(content + clen) != 0 {
      clen = clen + 1
    }
    let fwrc = win-dispatch(port, WIN-CALL-WRITEFILE, wh, content, clen, 0)
    serial-write-cstr(port, "windows: WriteFile(handle, content, ")
    serial-write-dec-wide(port, clen)
    serial-write-cstr(port, ") = ")
    serial-write-dec-wide(port, fwrc)
    serial-nl(port)

    let fsz = win-dispatch(port, WIN-CALL-GETFILESIZE, wh, 0, 0, 0)
    serial-write-cstr(port, "windows: GetFileSize(handle) = ")
    serial-write-dec-wide(port, fsz)
    serial-nl(port)

    let crc = win-dispatch(port, WIN-CALL-CLOSEHANDLE, wh, 0, 0, 0)
    serial-write-cstr(port, "windows: CloseHandle(write) = ")
    serial-write-dec-wide(port, crc)
    serial-nl(port)
  }

  let rh = win-dispatch(port, WIN-CALL-CREATEFILEA, fname, WIN-ACCESS-READ, 0, 0)
  serial-write-cstr(port, "windows: CreateFileA(win-hello.txt, read) = ")
  serial-write-dec-wide(port, rh)
  serial-nl(port)

  if rh != WIN-INVALID-HANDLE {
    let rtype = win-handle-type(rh)
    serial-write-cstr(port, "windows: handle type(file) = ")
    serial-write-dec-wide(port, rtype)
    serial-nl(port)
    let rbuf = alloc(256)
    let rlen = win-dispatch(port, WIN-CALL-READFILE, rh, rbuf, 255, 0)
    serial-write-cstr(port, "windows: ReadFile(handle, buf, 255) = ")
    serial-write-dec-wide(port, rlen)
    serial-write-cstr(port, " -> '")
    let ri = 0
    while ri < rlen {
      serial-put(port, load8(rbuf + ri))
      ri = ri + 1
    }
    serial-write-cstr(port, "'")
    serial-nl(port)
    win-dispatch(port, WIN-CALL-CLOSEHANDLE, rh, 0, 0, 0)
  }

  // Patch mid-file, rename, std handle write, flush (subset only).
  let ph = win-dispatch(port, WIN-CALL-CREATEFILEA, fname, WIN-ACCESS-WRITE, 0, 0)
  serial-write-cstr(port, "windows: CreateFileA(win-hello.txt, write reopen) = ")
  serial-write-dec-wide(port, ph)
  serial-nl(port)
  if ph != WIN-INVALID-HANDLE {
    let spos = win-dispatch(port, WIN-CALL-SETFILEPOINTER, ph, 8, 0, 0)
    serial-write-cstr(port, "windows: SetFilePointer(handle, 8, SET) = ")
    serial-write-dec-wide(port, spos)
    serial-nl(port)
    let patch = "PATCH"
    let plen = 5
    let pwrc = win-dispatch(port, WIN-CALL-WRITEFILE, ph, patch, plen, 0)
    serial-write-cstr(port, "windows: WriteFile(handle, PATCH, 5) = ")
    serial-write-dec-wide(port, pwrc)
    serial-nl(port)
    let frc = win-dispatch(port, WIN-CALL-FLUSHFILEBUFFERS, ph, 0, 0, 0)
    serial-write-cstr(port, "windows: FlushFileBuffers(handle) = ")
    serial-write-dec-wide(port, frc)
    serial-nl(port)
    win-dispatch(port, WIN-CALL-CLOSEHANDLE, ph, 0, 0, 0)
  }

  let fname2 = "win-hello2.txt"
  let mrc = win-dispatch(port, WIN-CALL-MOVEFILEA, fname, fname2, 0, 0)
  serial-write-cstr(port, "windows: MoveFileA(win-hello.txt, win-hello2.txt) = ")
  serial-write-dec-wide(port, mrc)
  serial-nl(port)

  let stdout-h = win-dispatch(port, WIN-CALL-GETSTDHANDLE, -11, 0, 0, 0)
  serial-write-cstr(port, "windows: GetStdHandle(STD_OUTPUT_HANDLE) = ")
  serial-write-dec-wide(port, stdout-h)
  serial-nl(port)
  let smsg = "  hello via GetStdHandle+WriteFile\n"
  let slen = 0
  while load8(smsg + slen) != 0 {
    slen = slen + 1
  }
  let swrc = win-dispatch(port, WIN-CALL-WRITEFILE, stdout-h, smsg, slen, 0)
  serial-write-cstr(port, "windows: WriteFile(GetStdHandle, msg, ")
  serial-write-dec-wide(port, slen)
  serial-write-cstr(port, ") = ")
  serial-write-dec-wide(port, swrc)
  serial-nl(port)

  let pid = win-dispatch(port, WIN-CALL-GETCURRENTPROCESSID, 0, 0, 0, 0)
  serial-write-cstr(port, "windows: GetCurrentProcessId() = ")
  serial-write-dec-wide(port, pid)
  serial-nl(port)

  let tid = win-dispatch(port, WIN-CALL-GETCURRENTTHREADID, 0, 0, 0, 0)
  serial-write-cstr(port, "windows: GetCurrentThreadId() = ")
  serial-write-dec-wide(port, tid)
  serial-nl(port)

  win-dispatch(port, WIN-CALL-SLEEP, 1, 0, 0, 0)
  serial-write-cstr(port, "windows: Sleep(1) mapped (pause loop)")
  serial-nl(port)

  let drc = win-dispatch(port, WIN-CALL-DELETEFILEA, fname2, 0, 0, 0)
  serial-write-cstr(port, "windows: DeleteFileA(win-hello2.txt) = ")
  serial-write-dec-wide(port, drc)
  serial-nl(port)
  // Cleanup either name if rename failed mid-demo.
  win-dispatch(port, WIN-CALL-DELETEFILEA, fname, 0, 0, 0)

  // Directory + nested file (subset only).
  let dname = "win-dir"
  let mdrc = win-dispatch(port, WIN-CALL-CREATEDIRECTORYA, dname, 0, 0, 0)
  serial-write-cstr(port, "windows: CreateDirectoryA(win-dir) = ")
  serial-write-dec-wide(port, mdrc)
  serial-nl(port)
  let nested = "win-dir/nested.txt"
  let nh = win-dispatch(port, WIN-CALL-CREATEFILEA, nested, WIN-ACCESS-WRITE, 0, 0)
  serial-write-cstr(port, "windows: CreateFileA(win-dir/nested.txt, write) = ")
  serial-write-dec-wide(port, nh)
  serial-nl(port)
  if nh != WIN-INVALID-HANDLE {
    let nmsg = "nested"
    win-dispatch(port, WIN-CALL-WRITEFILE, nh, nmsg, 6, 0)
    win-dispatch(port, WIN-CALL-CLOSEHANDLE, nh, 0, 0, 0)
  }
  win-dispatch(port, WIN-CALL-DELETEFILEA, nested, 0, 0, 0)
  let rdrc = win-dispatch(port, WIN-CALL-REMOVEDIRECTORYA, dname, 0, 0, 0)
  serial-write-cstr(port, "windows: RemoveDirectoryA(win-dir) = ")
  serial-write-dec-wide(port, rdrc)
  serial-nl(port)

  // GetLastError after missing CreateFileA.
  let bad = "win-missing-no-such.txt"
  let bh = win-dispatch(port, WIN-CALL-CREATEFILEA, bad, WIN-ACCESS-READ, 0, 0)
  serial-write-cstr(port, "windows: CreateFileA(missing) = ")
  serial-write-dec-wide(port, bh)
  serial-nl(port)
  let glerr = win-dispatch(port, WIN-CALL-GETLASTERROR, 0, 0, 0, 0)
  serial-write-cstr(port, "windows: GetLastError() after missing CreateFileA = ")
  serial-write-dec-wide(port, glerr)
  serial-nl(port)

  // GetCommandLineA → static "space-windows".
  let cl = win-dispatch(port, WIN-CALL-GETCOMMANDLINEA, 0, 0, 0, 0)
  serial-write-cstr(port, "windows: GetCommandLineA() = '")
  if cl != 0 {
    serial-write-cstr(port, cl)
  }
  serial-write-cstr(port, "'")
  serial-nl(port)

  // VirtualAlloc / VirtualFree stand-ins.
  let va = win-dispatch(port, WIN-CALL-VIRTUALALLOC, 0, 64, 0, 0)
  serial-write-cstr(port, "windows: VirtualAlloc(0, 64) = ")
  serial-write-hex(port, va)
  serial-nl(port)
  if va != 0 {
    store8(va + 0, 65)
    let vfrc = win-dispatch(port, WIN-CALL-VIRTUALFREE, va, 64, 0, 0)
    serial-write-cstr(port, "windows: VirtualFree(ptr, 64) = ")
    serial-write-dec-wide(port, vfrc)
    serial-nl(port)
  }

  // WriteConsoleA → WriteFile on stdout.
  let cmsg = "  hello via WriteConsoleA\n"
  let clen = 0
  while load8(cmsg + clen) != 0 {
    clen = clen + 1
  }
  let cwrc = win-dispatch(port, WIN-CALL-WRITECONSOLEA, 1, cmsg, clen, 0)
  serial-write-cstr(port, "windows: WriteConsoleA(stdout, msg, ")
  serial-write-dec-wide(port, clen)
  serial-write-cstr(port, ") = ")
  serial-write-dec-wide(port, cwrc)
  serial-nl(port)

  // CreateProcessA on missing path → fail + GetLastError.
  let missapp = "no-such-space-app.sci"
  let cprc = win-dispatch(port, WIN-CALL-CREATEPROCESSA, missapp, 0, 0, 0)
  serial-write-cstr(port, "windows: CreateProcessA(missing) = ")
  serial-write-dec-wide(port, cprc)
  serial-nl(port)
  let perr = win-dispatch(port, WIN-CALL-GETLASTERROR, 0, 0, 0, 0)
  serial-write-cstr(port, "windows: GetLastError() after CreateProcessA = ")
  serial-write-dec-wide(port, perr)
  serial-nl(port)
  // Optional: if test.sci present, spawn + typed process handle.
  let testapp = "test.sci"
  let okh = win-dispatch(port, WIN-CALL-CREATEPROCESSA, testapp, 0, 0, 0)
  if okh != WIN-INVALID-HANDLE {
    serial-write-cstr(port, "windows: CreateProcessA(test.sci) handle = ")
    serial-write-dec-wide(port, okh)
    serial-nl(port)
    serial-write-cstr(port, "windows: handle type(process) = ")
    serial-write-dec-wide(port, win-handle-type(okh))
    serial-nl(port)
    win-dispatch(port, WIN-CALL-WAITFORSINGLEOBJECT, okh, 0, 0, 0)
    win-dispatch(port, WIN-CALL-CLOSEHANDLE, okh, 0, 0, 0)
  }

  // HeapAlloc / HeapFree.
  let hp = win-dispatch(port, WIN-CALL-HEAPALLOC, 0, 0, 32, 0)
  serial-write-cstr(port, "windows: HeapAlloc(0, 0, 32) = ")
  serial-write-hex(port, hp)
  serial-nl(port)
  if hp != 0 {
    store8(hp + 0, 90)
    let hfrc = win-dispatch(port, WIN-CALL-HEAPFREE, 0, 0, hp, 0)
    serial-write-cstr(port, "windows: HeapFree(ptr) = ")
    serial-write-dec-wide(port, hfrc)
    serial-nl(port)
  }

  // GetModuleFileNameA → "space.exe".
  let mbuf = alloc(64)
  let mlen = win-dispatch(port, WIN-CALL-GETMODULEFILENAMEA, 0, mbuf, 64, 0)
  serial-write-cstr(port, "windows: GetModuleFileNameA() = ")
  serial-write-dec-wide(port, mlen)
  serial-write-cstr(port, " '" )
  if mlen > 0 {
    serial-write-cstr(port, mbuf)
  }
  serial-write-cstr(port, "'")
  serial-nl(port)

  // Rebuild win-hello2 for CopyFileA, then copy + delete both.
  let src2 = "win-hello2.txt"
  let dst2 = "win-copy.txt"
  let sh = win-dispatch(port, WIN-CALL-CREATEFILEA, src2, WIN-ACCESS-WRITE, 0, 0)
  if sh != WIN-INVALID-HANDLE {
    let sc = "copy-src"
    win-dispatch(port, WIN-CALL-WRITEFILE, sh, sc, 8, 0)
    win-dispatch(port, WIN-CALL-CLOSEHANDLE, sh, 0, 0, 0)
  }
  let cprc2 = win-dispatch(port, WIN-CALL-COPYFILEA, src2, dst2, 0, 0)
  serial-write-cstr(port, "windows: CopyFileA(win-hello2.txt, win-copy.txt) = ")
  serial-write-dec-wide(port, cprc2)
  serial-nl(port)
  win-dispatch(port, WIN-CALL-DELETEFILEA, src2, 0, 0, 0)
  win-dispatch(port, WIN-CALL-DELETEFILEA, dst2, 0, 0, 0)

  // OutputDebugStringA.
  let dmsg = "windows: OutputDebugStringA ok\n"
  win-dispatch(port, WIN-CALL-OUTPUTDEBUGSTRINGA, dmsg, 0, 0, 0)

  // GetEnvironmentVariableA PATH → "/".
  let ebuf = alloc(16)
  let elen = win-dispatch(port, WIN-CALL-GETENVIRONMENTVARIABLEA, "PATH", ebuf, 16, 0)
  serial-write-cstr(port, "windows: GetEnvironmentVariableA(PATH) = ")
  serial-write-dec-wide(port, elen)
  serial-write-cstr(port, " '" )
  if elen > 0 {
    serial-write-cstr(port, ebuf)
  }
  serial-write-cstr(port, "'")
  serial-nl(port)

  // DuplicateHandle: clone a file handle.
  let dups = "win-dup.txt"
  let dh = win-dispatch(port, WIN-CALL-CREATEFILEA, dups, WIN-ACCESS-WRITE, 0, 0)
  if dh != WIN-INVALID-HANDLE {
    let dmsg = "dup-handle-test"
    let dlen = 0
    while load8(dmsg + dlen) != 0 {
      dlen = dlen + 1
    }
    win-dispatch(port, WIN-CALL-WRITEFILE, dh, dmsg, dlen, 0)
    win-dispatch(port, WIN-CALL-CLOSEHANDLE, dh, 0, 0, 0)
  }
  // Reopen read-only and duplicate.
  let dh2 = win-dispatch(port, WIN-CALL-CREATEFILEA, dups, WIN-ACCESS-READ, 0, 0)
  if dh2 != WIN-INVALID-HANDLE {
    let ddh = win-dispatch(port, WIN-CALL-DUPLICATEHANDLE, dh2, 0, 0, 0)
    serial-write-cstr(port, "windows: DuplicateHandle(file) = ")
    serial-write-dec-wide(port, ddh)
    serial-nl(port)
    if ddh != WIN-INVALID-HANDLE {
      let dtyp = win-handle-type(ddh)
      serial-write-cstr(port, "windows: dup handle type = ")
      serial-write-dec-wide(port, dtyp)
      serial-nl(port)
      win-dispatch(port, WIN-CALL-CLOSEHANDLE, ddh, 0, 0, 0)
    }
    win-dispatch(port, WIN-CALL-CLOSEHANDLE, dh2, 0, 0, 0)
  }
  win-dispatch(port, WIN-CALL-DELETEFILEA, dups, 0, 0, 0)

  // GetFileType: console = CHAR, file = DISK.
  let gt1 = win-dispatch(port, WIN-CALL-GETFILETYPE, 1, 0, 0, 0)
  serial-write-cstr(port, "windows: GetFileType(stdout) = ")
  serial-write-dec-wide(port, gt1)
  if gt1 == WIN-FILE-TYPE-CHAR {
    serial-write-cstr(port, " (FILE_TYPE_CHAR)")
  }
  serial-nl(port)
  let gtfd = win-dispatch(port, WIN-CALL-CREATEFILEA, "win-gt.txt", WIN-ACCESS-WRITE, 0, 0)
  if gtfd != WIN-INVALID-HANDLE {
    let gt2 = win-dispatch(port, WIN-CALL-GETFILETYPE, gtfd, 0, 0, 0)
    serial-write-cstr(port, "windows: GetFileType(file) = ")
    serial-write-dec-wide(port, gt2)
    if gt2 == WIN-FILE-TYPE-DISK {
      serial-write-cstr(port, " (FILE_TYPE_DISK)")
    }
    serial-nl(port)
    win-dispatch(port, WIN-CALL-CLOSEHANDLE, gtfd, 0, 0, 0)
  }
  win-dispatch(port, WIN-CALL-DELETEFILEA, "win-gt.txt", 0, 0, 0)

  // SetEndOfFile: write 20 bytes, seek to 10, truncate, verify size.
  let truncf = "win-trunc.txt"
  let trh = win-dispatch(port, WIN-CALL-CREATEFILEA, truncf, WIN-ACCESS-WRITE, 0, 0)
  if trh != WIN-INVALID-HANDLE {
    let tdata = "0123456789ABCDEFGHIJ"
    win-dispatch(port, WIN-CALL-WRITEFILE, trh, tdata, 20, 0)
    let tsz1 = win-dispatch(port, WIN-CALL-GETFILESIZE, trh, 0, 0, 0)
    serial-write-cstr(port, "windows: GetFileSize(before truncate) = ")
    serial-write-dec-wide(port, tsz1)
    serial-nl(port)
    win-dispatch(port, WIN-CALL-SETFILEPOINTER, trh, 10, 0, 0)
    let serrc = win-dispatch(port, WIN-CALL-SETENDOFFILE, trh, 0, 0, 0)
    serial-write-cstr(port, "windows: SetEndOfFile(at pos 10) = ")
    serial-write-dec-wide(port, serrc)
    serial-nl(port)
    win-dispatch(port, WIN-CALL-CLOSEHANDLE, trh, 0, 0, 0)
    // Reopen to check size.
    let trh2 = win-dispatch(port, WIN-CALL-CREATEFILEA, truncf, WIN-ACCESS-READ, 0, 0)
    if trh2 != WIN-INVALID-HANDLE {
      let tsz2 = win-dispatch(port, WIN-CALL-GETFILESIZE, trh2, 0, 0, 0)
      serial-write-cstr(port, "windows: GetFileSize(after truncate) = ")
      serial-write-dec-wide(port, tsz2)
      serial-nl(port)
      win-dispatch(port, WIN-CALL-CLOSEHANDLE, trh2, 0, 0, 0)
    }
  }
  win-dispatch(port, WIN-CALL-DELETEFILEA, truncf, 0, 0, 0)

  // NTSTATUS mapping demo: missing file → error code.
  let ntpath = "win-ntstatus-nosuch.txt"
  let nth = win-dispatch(port, WIN-CALL-CREATEFILEA, ntpath, WIN-ACCESS-READ, 0, 0)
  serial-write-cstr(port, "windows: CreateFileA(missing) for NTSTATUS = ")
  serial-write-dec-wide(port, nth)
  serial-nl(port)
  let nst = win-dispatch(port, WIN-CALL-RTLGETLASTNTSTATUS, 0, 0, 0, 0)
  serial-write-cstr(port, "windows: RtlGetLastNtStatus() = ")
  serial-write-dec-wide(port, nst)
  if nst == WIN-STATUS-OBJECT-NAME-NOT-FOUND {
    serial-write-cstr(port, " (STATUS_OBJECT_NAME_NOT_FOUND)")
  }
  serial-nl(port)

  win-status-demo(port)

  let erc = win-dispatch(port, WIN-CALL-EXITPROCESS, 0, 0, 0, 0)
  serial-write-cstr(port, "windows: ExitProcess(0) mapped (demo status ")
  serial-write-dec-wide(port, erc)
  serial-write-cstr(port, ", no halt)")
  serial-nl(port)

  serial-write-cstr(port, "windows: personality demo complete")
  serial-nl(port)
  return
}
