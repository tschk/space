cpu-mem-copy64(copy,0x10000000,28209);store64(copy+220760,1);if linux-process-elf-entry(copy,225672)!=-8{panic("ET_DYN malformed needed-library");}
cpu-mem-copy64(copy,0x10000000,28209);store64(copy+320,16);store64(copy+328,16);store64(copy+220760,7);if linux-process-elf-entry(copy,225672)!=-8{panic("ET_DYN malformed unterminated-dynamic");}
cpu-mem-copy64(copy,0x10000000,28209);store64(copy+296,225672);if linux-process-elf-entry(copy,225672)!=-8{panic("ET_DYN malformed dynamic-file-bounds");}
