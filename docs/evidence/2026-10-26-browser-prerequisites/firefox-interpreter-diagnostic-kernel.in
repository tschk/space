}

fn browser-runtime-probe(port:Int)->void{
 let authority=cap-mint(root-realm,cap-memory()|cap-serial()|cap-storage()|cap-timer());
 serial-write-cstr(port,"firefox-original: filesystem install status ");serial-write-dec-wide(port,fs-write-file("/firefox",0x12000000,659992));serial-nl(port);
 linux-process-trace=1;
 let status=linux-process-run-counted-input(0x10000000,225672,"/ld.so","--verify","/firefox",authority,-1,3);
 serial-write-cstr(port,"firefox-original: interpreter verify status ");serial-write-dec-wide(port,status);serial-nl(port);
}
