cpu-mem-copy64(copy,0x10000000,28209);store8(copy+344,2);store8(copy+345,0);store8(copy+346,0);store8(copy+347,0);store8(copy+348,6);store8(copy+349,0);store8(copy+350,0);store8(copy+351,0);store8(copy+352,88);store8(copy+353,94);store8(copy+354,3);store8(copy+355,0);store8(copy+356,0);store8(copy+357,0);store8(copy+358,0);store8(copy+359,0);store8(copy+360,88);store8(copy+361,94);store8(copy+362,3);store8(copy+363,0);store8(copy+364,0);store8(copy+365,0);store8(copy+366,0);store8(copy+367,0);store8(copy+368,88);store8(copy+369,94);store8(copy+370,3);store8(copy+371,0);store8(copy+372,0);store8(copy+373,0);store8(copy+374,0);store8(copy+375,0);store8(copy+376,128);store8(copy+377,1);store8(copy+378,0);store8(copy+379,0);store8(copy+380,0);store8(copy+381,0);store8(copy+382,0);store8(copy+383,0);store8(copy+384,128);store8(copy+385,1);store8(copy+386,0);store8(copy+387,0);store8(copy+388,0);store8(copy+389,0);store8(copy+390,0);store8(copy+391,0);store8(copy+392,8);store8(copy+393,0);store8(copy+394,0);store8(copy+395,0);store8(copy+396,0);store8(copy+397,0);store8(copy+398,0);store8(copy+399,0);if linux-process-elf-entry(copy,225672)!=-8{panic("ET_DYN malformed duplicate-dynamic");}
cpu-mem-copy64(copy,0x10000000,28209);store64(copy+320,17);store64(copy+328,17);if linux-process-elf-entry(copy,225672)!=-8{panic("ET_DYN malformed dynamic-stride");}
