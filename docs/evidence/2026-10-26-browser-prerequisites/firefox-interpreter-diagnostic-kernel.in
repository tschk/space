import "/workspace/browser-entry-frozen-standard/source/components/linux-process.in"
import "/workspace/browser-entry-frozen-standard/source/components/counter.in"
package space.kernel

// =============================================================================
// CENTRAL NANOKERNEL HUB ("Space Central Station")
// =============================================================================
// Core hardware enforcement, execution & IPC fabric:
import "/workspace/browser-entry-frozen-standard/source/components/native-call.in"
import "/workspace/browser-entry-frozen-standard/source/components/cpu.in"
import "/workspace/browser-entry-frozen-standard/source/components/pci.in"
import "/workspace/browser-entry-frozen-standard/source/components/channel.in"
import "/workspace/browser-entry-frozen-standard/source/components/domain.in"
import "/workspace/browser-entry-frozen-standard/source/components/libc.in"
import "/workspace/browser-entry-frozen-standard/source/components/serial.in"
import "/workspace/browser-entry-frozen-standard/source/components/memory.in"
import "/workspace/browser-entry-frozen-standard/source/components/object.in"
import "/workspace/browser-entry-frozen-standard/source/components/interrupts.in"
import "/workspace/browser-entry-frozen-standard/source/components/syscall.in"
import "/workspace/browser-entry-frozen-standard/source/components/sched.in"

// Spoke Subsystem Hubs ("Metro Lines" radiating from the Central Nanokernel Hub):
// 1. Network Metro Line (e1000, netstack, DHCP, DNS)
import "/workspace/browser-entry-frozen-standard/source/components/net-hub.in"
// 2. Storage & VFS Metro Line (NVMe, SparkFS fs2-*, filesystem, VFS, time)
import "/workspace/browser-entry-frozen-standard/source/components/storage-hub.in"
// 3. Runtime & SCI Metro Line (supervisor, preempt, sci-loader, boot-image, process)
import "/workspace/browser-entry-frozen-standard/source/components/runtime-hub.in"
// 4. Personalities Metro Line (Linux/POSIX, Darwin/Mach-O, Windows/PE32+, foreign-exec)
import "/workspace/browser-entry-frozen-standard/source/components/personality-hub.in"
// 5. Desktop & Display Metro Line (USB xHCI/HID, display stations, PS/2 mouse)
import "/workspace/browser-entry-frozen-standard/source/components/desktop-hub.in"
// 6. Diagnostics, Shell & Verification Metro Line (shell, editor, diagnostics, selftests)
import "/workspace/browser-entry-frozen-standard/source/components/diagnostics-hub.in"


// The nanokernel root component.
component KernelRoot {
  target "x86_64-unknown-none"
  deterministic true
  checkpoint none

  export boot: BootEntry

  capability serial: DebugConsole(write)
  capability memory: PhysicalMemory(discover, map)
  capability tables: PageTables(create, activate)
  capability traps: TrapTable(install)
  capability caps: CapabilityTable(create-root, mint-kernel)
  capability storage: BlockStorage(read, write)
  capability input: InputDevice(publish)
  capability network: NetworkDevice(tx, rx, configure)
  capability display: DisplayDevice(map, present)
  capability volume: Volume(read, write)
}

struct KernelState {
  Int root-table-id
  Int realm-id
  Bool cpu-ready
}

interface BootEntry {
  fn start(mb-info: Int) -> Int
}

interface DebugConsole {
  fn write(msg: String) -> void
}

interface BlockStorage {
  fn read(lba: Int, count: Int, buf: Int) -> Int
  fn write(lba: Int, count: Int, buf: Int) -> Int
}

interface InputDevice {
  fn publish(evt: Int) -> void
}

interface NetworkDevice {
  fn tx(len: Int) -> void
  fn rx() -> Int
  fn configure() -> Int
}

interface DisplayDevice {
  fn map(phys: Int, size: Int) -> void
  fn present() -> void
}

interface Volume {
  fn read(fd: Int, buf: Int, count: Int) -> Int
  fn write(fd: Int, buf: Int, count: Int) -> Int
}

// --- nanokernel state -------------------------------------------------------
var heap-next: Int = 0
var heap-end: Int = 0
var total-ram: Int = 0
var region-count: Int = 0
var obj-counter: Int = 0
var cap-table-base: Int = 0
var cap-count: Int = 0
var root-realm: Int = 0
var ticks: Int = 0
var idt-base: Int = 0
var realm-grants: Int = 0
var boot-quiet: Int = 1
var redir-buf: Int = 0
var redir-pos: Int = 0
var redir-max: Int = 0

// --- kernel accessors (published via the kernel export table) ---------------
// Dynamic apps bind these to read live kernel state; the underlying values
// are kernel-owned globals that data imports cannot reach.

fn ticks-now() -> Int {
  return ticks
}

fn mem-heap-free() -> Int {
  return heap-end - heap-next
}

// --- kernel entry -----------------------------------------------------------
fn kernel-entry(mb-info: Int) -> Int {
  let port = com1()
  serial-init(port)
  serial-write-cstr(port, "space: kernel root entered (Space 0.1.0)")
  serial-nl(port)

  // Writable globals, including their initial values, are loaded in the boot image.
  boot-quiet = 1

  discover-memory(mb-info)
  counter-init(mb-info)
  if boot-quiet == 0 {
    serial-write-cstr(port, "space: available RAM bytes 0x")
    serial-write-hex(port, total-ram)
    serial-write-cstr(port, " across regions 0x")
    serial-write-hex(port, region-count)
    serial-nl(port)
    serial-write-cstr(port, "space: heap window 0x")
    serial-write-hex(port, heap-next)
    serial-write-cstr(port, " .. 0x")
    serial-write-hex(port, heap-end)
    serial-nl(port)
  }

  obj-arena-init(65536)
  cap-table-init(64)
  let cap-table-obj = obj-alloc(2)
  root-realm = obj-alloc(1)
  store64(root-realm + 16, cap-table-obj)
  let kernel-cap = cap-mint(root-realm, 0xF)

  if boot-quiet == 0 {
    serial-write-cstr(port, "space: bootstrap realm object id 0x")
    serial-write-hex(port, obj-id(root-realm))
    serial-nl(port)
    serial-write-cstr(port, "space: root cap table at 0x")
    serial-write-hex(port, cap-table-base)
    serial-write-cstr(port, " caps 0x")
    serial-write-hex(port, cap-count)
    serial-nl(port)
    serial-write-cstr(port, "space: objects allocated 0x")
    serial-write-hex(port, obj-counter)
    serial-nl(port)
  }

  domain-init()
  store64(domain-table + 16, kernel-cap)
  current-cap = kernel-cap
  if boot-quiet == 0 {
    serial-write-cstr(port, "space: domain subsystem init, ")
    serial-write-dec-wide(port, domain-count)
    serial-write-cstr(port, " domains (kernel + ")
    let available-domains = 63
    serial-write-dec-wide(port, available-domains)
    serial-write-cstr(port, " available)")
    serial-nl(port)
  }

  interrupts-init()
  if boot-quiet == 0 {
    serial-write-cstr(port, "space: interrupts enabled (PIC remapped, PIT 100Hz)")
    serial-nl(port)
  }

  let shown = 0
  while shown < 1 {
    hlt()
    if ticks >= (shown + 1) * 2 {
      if boot-quiet == 0 {
        serial-write-cstr(port, "space: timer ticks 0x")
        serial-write-hex(port, ticks)
        serial-nl(port)
      }
      shown = shown + 1
    }
  }

  // Activate Spoke Hubs ("Metro Lines") from the Central Nanokernel Hub:
  runtime-hub-early-init(port)
  net-hub-init(port)
  storage-hub-nvme-init(port)
  let usb-rc = desktop-hub-usb-init(port)
  runtime-hub-arena-init(port)
  storage-hub-fs-init(port)
  diagnostics-hub-sci-selftest(port)
  personality-hub-init(port)
  desktop-hub-init(port, mb-info, usb-rc)

  // Optional runtime-loaded Display / Input components (probed at fixed
  // physical addresses). If present, they are started in isolated domains.
  preempt-start(port)
  runtime-hub-load-components(port)

  // Let preemptive display/input print boot markers, then stop the timer
  // scheduler so the serial shell owns the CPU (input/display hlt forever).
  if preempt-count > 0 {
    let grace = ticks + 300
    while ticks < grace {
      hlt()
    }
  }
  preempt-stop(port)

  browser-runtime-probe(port)
  shell(port)

  serial-write-cstr(port, "space: nanokernel ready, total ticks 0x")
  serial-write-hex(port, ticks)
  serial-nl(port)
  serial-write-cstr(port, "space: halting")
  serial-nl(port)
  cli()
  while true {
    hlt()
  }
  return 0
}

fn dynamic-entry-free()->Int{let n=0;let p=free-list;while p!=0 && n<131072{n+=1;p=load64(p);}if p!=0{panic("ET_DYN free-list cycle");}return n;}
