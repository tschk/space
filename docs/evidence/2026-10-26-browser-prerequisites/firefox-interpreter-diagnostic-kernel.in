cpu-mem-copy64(copy,0x10000000,28209);store64(copy+24,-1);if linux-process-elf-entry(copy,225672)!=-8{panic("ET_DYN malformed negative-entry");}
cpu-mem-copy64(copy,0x10000000,28209);store64(copy+24,0);if linux-process-elf-entry(copy,225672)!=-8{panic("ET_DYN malformed non-executable-entry");}
cpu-mem-copy64(copy,0x10000000,28209);store64(copy+136,9223372036854775807);if linux-process-elf-entry(copy,225672)!=-8{panic("ET_DYN malformed overflow-va");}
cpu-mem-copy64(copy,0x10000000,28209);store32(copy+124,7);if linux-process-elf-entry(copy,225672)!=-8{panic("ET_DYN malformed writable-executable");}
cpu-mem-copy64(copy,0x10000000,28209);store64(copy+168,3);if linux-process-elf-entry(copy,225672)!=-8{panic("ET_DYN malformed bad-alignment");}
