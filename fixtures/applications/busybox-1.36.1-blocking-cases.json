{
  "schema_version": 1,
  "classification": "Unmodified pinned upstream BusyBox blocking transfer goals; unchanged nine child cases plus cross-capacity byte-count and exact-output checks",
  "infinite_argv": [
    "/ash",
    "-c",
    "while :; do :; done"
  ],
  "cases": [
    {
      "name": "baseline-echo",
      "argv": [
        "/busybox",
        "echo",
        "child-process corpus"
      ],
      "expected_stdout": "child-process corpus\n",
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "pipeline-bytes",
      "argv": [
        "/ash",
        "-c",
        "printf \"hello\\n\" | wc -c"
      ],
      "expected_stdout": "6\n",
      "expected_exit": 0,
      "expected_stderr": "",
      "repeat": true
    },
    {
      "name": "pipeline-words",
      "argv": [
        "/ash",
        "-c",
        "echo \"one two\" | wc -w"
      ],
      "expected_stdout": "2\n",
      "expected_exit": 0,
      "expected_stderr": ""
    },
    {
      "name": "pipeline-empty-eof",
      "argv": [
        "/ash",
        "-c",
        "printf '' | wc -c"
      ],
      "expected_stdout": "0\n",
      "expected_exit": 0,
      "expected_stderr": ""
    },
    {
      "name": "pipeline-three-stages",
      "argv": [
        "/ash",
        "-c",
        "printf \"hello\\n\" | cat | wc -c"
      ],
      "expected_stdout": "6\n",
      "expected_exit": 0,
      "expected_stderr": ""
    },
    {
      "name": "pipeline-last-status",
      "argv": [
        "/ash",
        "-c",
        "printf x | (exit 23)"
      ],
      "expected_stdout": "",
      "expected_exit": 23,
      "expected_stderr": ""
    },
    {
      "name": "subshell-private-state",
      "argv": [
        "/ash",
        "-c",
        "v=parent; (v=child; echo \"$v\"); echo \"$v\""
      ],
      "expected_stdout": "child\nparent\n",
      "expected_exit": 0,
      "expected_stderr": "",
      "repeat": true
    },
    {
      "name": "background-wait",
      "argv": [
        "/ash",
        "-c",
        "printf child & p=$!; wait \"$p\"; printf ':parent\\n'"
      ],
      "expected_stdout": "child:parent\n",
      "expected_exit": 0,
      "expected_stderr": ""
    },
    {
      "name": "pipeline-file",
      "argv": [
        "/ash",
        "-c",
        "cat @FILE@ | wc -c"
      ],
      "file": "abcdef\n",
      "expected_stdout": "7\n",
      "expected_exit": 0,
      "expected_stderr": "",
      "repeat": true
    },
    {
      "name": "pipeline-beyond-ring",
      "argv": [
        "/ash",
        "-c",
        "cat @FILE@ | wc -c"
      ],
      "file_recipe": {
        "pattern": "abcdefghi\n",
        "repeat": 1090,
        "suffix": "x\n",
        "size": 10902,
        "sha256": "9f0d9b64bb070138288409442265e7d59f779d286cb75f2eb4256d54dc094e93"
      },
      "file_slot": 89,
      "expected_stdout": "10902\n",
      "expected_stderr": "",
      "expected_exit": 0,
      "repeat": true
    },
    {
      "name": "pipeline-110000-bytes",
      "argv": [
        "/ash",
        "-c",
        "cat @FILE@ | wc -c"
      ],
      "file_recipe": {
        "kind": "numbered-lines",
        "count": 10000,
        "width": 10,
        "size": 110000,
        "sha256": "1c7898d6f3630eeddf65917d04f0a07a421f1192d6a6acd122108b5fc747af57"
      },
      "file_slot": 90,
      "expected_stdout": "110000\n",
      "expected_stderr": "",
      "expected_exit": 0,
      "repeat": true
    },
    {
      "name": "pipeline-110000-exact-bytes",
      "argv": [
        "/ash",
        "-c",
        "cat @FILE@ | cat"
      ],
      "file_recipe": {
        "kind": "numbered-lines",
        "count": 10000,
        "width": 10,
        "size": 110000,
        "sha256": "1c7898d6f3630eeddf65917d04f0a07a421f1192d6a6acd122108b5fc747af57"
      },
      "file_slot": 90,
      "create": true,
      "expected_stdout_from_file": true,
      "expected_stderr": "",
      "expected_exit": 0,
      "repeat": true
    }
  ]
}
