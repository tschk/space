{
  "schema_version": 1,
  "classification": "unmodified upstream BusyBox Linux executable; selected upstream minimal Kconfig profile",
  "cases": [
    {
      "name": "echo",
      "argv": [
        "/busybox",
        "echo",
        "hello from BusyBox"
      ],
      "expected_stdout": "hello from BusyBox\n",
      "repeat": true,
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "printf",
      "argv": [
        "/busybox",
        "printf",
        "upstream printf: 42\\n"
      ],
      "expected_stdout": "upstream printf: 42\n",
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "cat-stdin",
      "argv": [
        "/busybox",
        "cat",
        "-"
      ],
      "stdin": "alpha\nbeta\n",
      "expected_stdout": "alpha\nbeta\n",
      "repeat": true,
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "wc-stdin-bytes",
      "argv": [
        "/wc",
        "-c",
        "-"
      ],
      "stdin": "abc\ndef\n",
      "expected_stdout": "8 -\n",
      "repeat": true,
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "wc-stdin-counts",
      "argv": [
        "/busybox",
        "wc",
        "-"
      ],
      "stdin": "one two\nthree\n",
      "expected_stdout": "        2         3        14 -\n",
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "cat-file",
      "argv": [
        "/busybox",
        "cat",
        "@FILE@"
      ],
      "file": "upstream BusyBox file\nsecond line\n",
      "expected_stdout": "upstream BusyBox file\nsecond line\n",
      "repeat": true,
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "wc-file-bytes",
      "argv": [
        "/wc",
        "-c",
        "@FILE@"
      ],
      "file": "abc\ndef\n",
      "expected_stdout": "8 @FILE@\n",
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "ash-arithmetic",
      "argv": [
        "/ash",
        "-c",
        "v=6; echo $((v*7))"
      ],
      "expected_stdout": "42\n",
      "repeat": true,
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "ash-loop",
      "argv": [
        "/ash",
        "-c",
        "i=0; while test \"$i\" -lt 3; do printf \"%s \" \"$i\"; i=$((i+1)); done; echo done"
      ],
      "expected_stdout": "0 1 2 done\n",
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "ash-exit-status",
      "argv": [
        "/ash",
        "-c",
        "exit 23"
      ],
      "expected_stdout": "",
      "expected_exit": 23,
      "expected_stderr": ""
    },
    {
      "name": "echo-unicode",
      "argv": [
        "/busybox",
        "echo",
        "λ 🙂"
      ],
      "expected_stdout": "λ 🙂\n",
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "wc-large-file",
      "argv": [
        "/wc",
        "-c",
        "@FILE@"
      ],
      "file": "",
      "expected_stdout": "10902 @FILE@\n",
      "expected_stderr": "",
      "expected_exit": 0
    }
  ],
  "pending_scenarios": [
