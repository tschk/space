{
  "schema_version": 1,
  "classification": "Separate upstream xargs planning profile; host oracles do not establish Space vfork coverage",
  "cases": [
    {
      "name": "echo-control",
      "argv": [
        "/busybox",
        "echo",
        "control"
      ],
      "expected_stdout": "control\n",
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "xargs-vfork-self-exec",
      "argv": [
        "/xargs",
        "-r",
        "ash"
      ],
      "stdin": "-c printf${IFS}vfork\n",
      "expected_stdout": "vfork",
      "expected_stderr": "",
      "expected_exit": 0
    },
    {
      "name": "xargs-vfork-exec-failure",
      "argv": [
        "/xargs",
        "-r",
        "space-vfork-missing-command"
      ],
      "stdin": "x\n",
      "expected_stdout": "",
      "expected_stderr": "xargs: space-vfork-missing-command: No such file or directory\n",
      "expected_exit": 127
    }
  ]
}
