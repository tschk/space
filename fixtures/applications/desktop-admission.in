package space.kernel

// The trusted test table and original executable are injected separately by
// QEMU. This diagnostic samples bytes; it never enters the foreign application.
fn desktop-admission-entry(mb: Int) -> Int {
  let port = com1(); serial-init(port)
  let size = load64(0x0f000000)
  let count = load64(0x0f000008)
  if size < 64 || size > 0x20000000 || count < 2 || count > 1024 {
    panic("desktop admission table bounds")
  }
  let index = 0
  while index < count {
    let row = 0x0f000010 + index * 16
    let offset = load64(row)
    if offset < 0 || offset > size - 64 { panic("desktop admission sample bounds") }
    let hash = -3750763034362895579
    let byte = 0
    while byte < 64 {
      hash = (hash ^ load8(0x10000000 + offset + byte)) * 1099511628211
      byte += 1
    }
    if hash != load64(row + 8) { panic("desktop admission sampled byte oracle") }
    index += 1
  }
  serial-write-cstr(port,"desktop: sampled original payload PASS"); serial-nl(port)
  let heap = heap-next; let free = free-list
  let domains = domain-count; let caps = cap-count
  let first = linux-process-elf-entry(0x10000000,size)
  let second = linux-process-elf-entry(0x10000000,size)
  if first != second { panic("desktop admission unstable result") }
  if heap-next != heap || free-list != free || domain-count != domains || cap-count != caps {
    panic("desktop admission validator mutated resources")
  }
  serial-write-cstr(port,"desktop: admission "); serial-write-dec-wide(port,first); serial-nl(port)
  serial-write-cstr(port,"desktop: unchanged resources; application not entered PASS"); serial-nl(port)
  outb(0xf4,0x10)
  while true { hlt() }
  return 0
}
