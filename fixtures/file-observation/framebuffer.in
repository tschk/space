package space.kernel
import "../../components/file-observation.in"
var fbc-file-handle:Int=0
var fbc-file-image:Int=0
var fbc-file-owner:Int=0
var fbc-file-clock:Int=-1
var fbc-file-inject:Int=0
var fbc-file-data-reads:Int=0
fn fbc-file-read(block:Int,buffer:Int,owner:Int)->Int{
 let result=fs-directory-read(block,buffer,owner);if result!=0{return result;}
 fbc-file-data-reads+=1;let mode=fbc-file-inject;fbc-file-inject=0;
 if mode==1{fbc-check(0,cap-revoke(owner));}
 if mode==2{store64(cap-table-base+owner*16,root-realm+1);}
 if mode==3{let inode=sf-lookup-path("/original-fbv");let at=sf-inode-addr(inode)+SF-IN-MTIME;store64(at,load64(at)+1);}
 if mode==4{sf-mount-id+=1;}
 if mode==5{store64(cap-table-base+owner*16+8,cap-storage());}
 if mode==6{store64(cap-table-base+owner*16+8,cap-memory());}
 return result;
}
fn fbc-file-controls()->void{
 let mode=1;while mode<=6{
  let grant=cap-mint(root-realm,cap-memory()|cap-storage());let mount=sf-mount-id;let inode=sf-lookup-path("/original-fbv");let at=sf-inode-addr(inode)+SF-IN-MTIME;let modified=load64(at);
  fbc-file-inject=mode;fbc-file-data-reads=0;let expected=-2;if mode==3{expected=-7;}if mode==4{expected=-3;}
  fbc-check(expected,file-observation-open("/original-fbv",grant));fbc-check(1,fbc-file-data-reads);fbc-check(0,fbc-file-inject);
  store64(at,modified);sf-mount-id=mount;cap-revoke(grant);let slot=0;while slot<2{fbc-check(0,load64(file-observation-table+slot*FILE-OBSERVATION-ROW));fbc-check(0,load64(file-observation-table+slot*FILE-OBSERVATION-ROW+24));slot+=1;}mode+=1;
 }
 serial-write-cstr(com1(),"file-observation: six after-read grant/metadata/mount controls PASS");serial-nl(com1());
}
fn fbc-file-private()->void{
 let table=alloc(48);store64(table,BOOT-IMAGE-TABLE-MAGIC);store64(table+8,1);store64(table+16,254);store64(table+24,0x2f0000);store64(table+32,FBC-FILE-PRIVATE-SIZE);store64(table+40,0);
 let boot=load64(0x40d0);store64(0x40d0,table);let heap=heap-next;let free=free-list;let caps=cap-count;let domains=domain-count;let live=runtime-instance-live;
 fbc-check(-1,sci-load-runtime-component(com1(),0x2f0000,"private-file-observation",1,1,0));fbc-check(heap,heap-next);fbc-check(free,free-list);fbc-check(caps,cap-count);fbc-check(domains,domain-count);fbc-check(live,runtime-instance-live);store64(0x40d0,boot);
}
fn fbc-file-filesystem()->void{
 if FBC-FILE-UTC!=0{
  fbc-file-clock=cap-mint(root-realm,cap-timer());
  if FBC-FILE-REOPEN==0{let storage=cap-mint(root-realm,cap-storage());let blocks=256;let count=256;if FBC-FILE-NVME!=0{blocks=16384;count=2048;}fbc-check(0,fs-metadata-format-utc(blocks,count,storage,fbc-file-clock));cap-revoke(storage);}
  else{fbc-check(1,sf-disk-ready);fbc-check(2,load32(sf-super+SF-SB-VERSION));fbc-check(-1,fs-metadata-clock-authority);}
 }
 if FBC-FILE-NVME!=0{
  fbc-check(1,nvme-ready);fbc-check(0,sf-mem-disk);
  if FBC-FILE-REOPEN==0 && FBC-FILE-UTC==0{fbc-check(0,sf-disk-ready);fbc-check(0,load32(sf-super));fbc-check(0,fs-format());}
  fbc-check(1,sf-disk-ready);
 }
}
fn fbc-file-prepare(auth:Int,size:Int)->void{
 fbc-file-private();
 fbc-check(-1,dyn-resolve-idx("file-observation-open"));fbc-check(-1,dyn-resolve-idx("file-observation-borrow"));
 let wrong=cap-mint(root-realm,cap-memory());let heap=heap-next;let free=free-list;let domains=domain-count;
 fbc-check(-2,file-observation-open(0,wrong));fbc-check(heap,heap-next);fbc-check(free,free-list);fbc-check(domains,domain-count);cap-revoke(wrong);
 let path="/original-fbv";if FBC-FILE-REOPEN!=0{path="/fbv-copy";}
 if FBC-FILE-REOPEN==0{if fs-write-file(path,0x14000000,size)!=0{panic("file observation native seed");}}
 let end=heap-end;heap-end=heap-next+16;fbc-check(-6,file-observation-open(path,auth));heap-end=end;fbc-check(heap,heap-next);
 if FBC-FILE-REOPEN==0{fbc-file-controls();}
 let handle=file-observation-open(path,auth);if handle<=0{panic("file observation open");}
 fbc-check(size,file-observation-query(handle,auth,0));fbc-check(0,file-observation-query(handle,auth,2));
 let image=file-observation-borrow(handle,auth);if image<=0{panic("file observation borrow");}fbc-check(1,file-observation-query(handle,auth,2));
 fbc-check(-2,file-observation-borrow(handle,wrong));let second-owner=cap-mint(root-realm,cap-memory()|cap-storage());
 let second=file-observation-open(path,second-owner);if second<=0{panic("file observation second");}
 fbc-check(-3,file-observation-open(path,auth));let other=file-observation-borrow(second,second-owner);if other<=0 || other==image{panic("file observation independent bytes");}
 let i=0;while i<size{fbc-check(load8(image+i),load8(other+i));i+=1;}
 let loans=1;while loans<64{fbc-check(other,file-observation-borrow(second,second-owner));loans+=1;}fbc-check(-3,file-observation-borrow(second,second-owner));fbc-check(64,file-observation-query(second,second-owner,2));
 fbc-check(-5,file-observation-close(second,second-owner));fbc-check(2,file-observation-query(second,second-owner,1));fbc-check(-4,file-observation-borrow(second,second-owner));
 cap-revoke(second-owner);fbc-check(-2,file-observation-query(second,second-owner,0));while loans>0{fbc-check(0,file-observation-return(second,second-owner));loans-=1;}fbc-check(-1,file-observation-return(second,second-owner));fbc-check(0,file-observation-close(second,second-owner));fbc-check(-6,file-observation-borrow(second,second-owner));
 if FBC-FILE-REOPEN==0{fbc-check(0,fs-delete("/original-fbv"));fbc-check(0,fs-write-file("/fbv-copy",image,size));}
 if FBC-FILE-NVME!=0{fbc-check(1,nvme-ready);fbc-check(0,sf-mem-disk);fbc-check(0,nvme-flush());}
 // The original QEMU staging copy is now deliberately unusable as an ELF. The
 // retained native byte observation remains exact after its backing is gone.
 store8(0x14000000,0);fbc-check(-8,linux-process-elf-entry(0x14000000,size));
 fbc-file-handle=handle;fbc-file-image=image;fbc-file-owner=auth;
 if FBC-FILE-UTC!=0 && FBC-FILE-REOPEN!=0{fbc-check(-1,fs-metadata-clock-authority);fbc-check(0,fs-metadata-bind-clock(auth,fbc-file-clock));serial-write-cstr(com1(),"file-observation: UTC executable observation before TimeSource binding PASS");serial-nl(com1());}
 serial-write-cstr(com1(),"file-observation: accepted ");serial-write-dec-wide(com1(),image);serial-put(com1(),32);serial-write-dec-wide(com1(),size);serial-nl(com1());
}
fn fbc-file-cycle(size:Int)->void{
 fbc-check(1,file-observation-query(fbc-file-handle,fbc-file-owner,2));
 let another=file-observation-open("/fbv-copy",fbc-file-owner);if another<=0{panic("file observation repeat");}
 let bytes=file-observation-borrow(another,fbc-file-owner);if bytes<=0{panic("file observation repeat borrow");}
 let i=0;while i<size{if load8(bytes+i)!=load8(fbc-file-image+i){panic("file observation changed accepted bytes");}i+=1;}
 fbc-check(0,file-observation-return(another,fbc-file-owner));fbc-check(0,file-observation-close(another,fbc-file-owner));fbc-check(-6,file-observation-query(another,fbc-file-owner,0));
}
fn fbc-file-finish()->void{
 fbc-check(-5,file-observation-close(fbc-file-handle,fbc-file-owner));fbc-check(0,file-observation-return(fbc-file-handle,fbc-file-owner));fbc-check(0,file-observation-close(fbc-file-handle,fbc-file-owner));fbc-check(-6,file-observation-return(fbc-file-handle,fbc-file-owner));
 if fbc-file-clock>=0{cap-revoke(fbc-file-clock);}
 serial-write-cstr(com1(),"file-observation: native stored original bytes, retained loans and stable reuse PASS");serial-nl(com1());
}
