 while field<8{
  let value=load64(tail+field*8);store64(tail+field*8,value+1);
  if sci-load-retained-component(port,image,"malformed-canvas",20,0)!=-1{panic("canvas malformed profile accepted");}
  store64(tail+field*8,value);field=field+1;
 }
 if sci-load-runtime-component(port,image,"sync-canvas",20,1,0)!=-1 || sci-load-runtime-component(port,image,"async-canvas",20,0,0)!=-1{panic("canvas wrong lifetime accepted");}
 let required=load64(image+8);store64(image+8,3);
 if sci-load-retained-component(port,image,"ungranted-canvas",3,0)!=-1{panic("canvas wrong authority accepted");}store64(image+8,required);
