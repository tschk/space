 let crossing=alloc(8192);let copied=0;
 while copied<64{store8(crossing+copied,load8(image+copied));store8(crossing+8192 - 64+copied,load8(tail+copied));copied=copied+1;}
 store64(crossing+16,0xfffff040);store64(crossing+24,8192);
 let before-heap=heap-next;let before-free=canvas-free-count();let before-caps=cap-count;let before-domains=domain-count;
