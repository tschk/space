fn canvas-free-count()->Int{
 let cursor=free-list;let count=0;
 while cursor!=0{if cursor<0x100000 || cursor>=heap-end || (cursor&4095)!=0 || count>131072{panic("canvas free list");}count=count+1;cursor=load64(cursor);}
 return count;
}
fn canvas-pte(domain:Int,virt:Int)->Int{
 let e4=load64(load64(domain-table+domain*24)+((virt>>39)&511)*8);
 if (e4&1)==0{return 0;}
 let e3=load64((e4&PAGE-ADDRESS-MASK)+((virt>>30)&511)*8);
 if (e3&1)==0 || (e3&128)!=0{return 0;}
 let e2=load64((e3&PAGE-ADDRESS-MASK)+((virt>>21)&511)*8);
 if (e2&1)==0 || (e2&128)!=0{return 0;}
 return load64((e2&PAGE-ADDRESS-MASK)+((virt>>12)&511)*8);
}
fn canvas-check(handle:Int,round:Int)->void{
 let owner=runtime-instance-record(handle,1);if owner==0{panic("canvas live owner");}
 let state=load64(owner);let view=load64(state+40);let ledger=load64(state+112);let domain=load64(state);
 if ledger==0 || load64(state+304)!=288 || runtime-instance-pixel-bytes(state)!=1179648 || view!=0x100000000+domain*0x40000000{panic("canvas ledger extent");}
 let pde=runtime-instance-view-pde(view);
 if pde!=load64(state+312) || (load64(pde)&PAGE-ADDRESS-MASK)!=load64(ledger+4088){panic("canvas table ownership");}
 if load32(view+8)!=canvas-entry-if{panic("canvas caller IF not restored before entry");}
 let page=0;let previous=0;
 while page<288{
  let physical=load64(ledger+page*8);
  if page!=0 && physical - previous!=4096 && physical - previous!=-4096{canvas-fragmented=canvas-fragmented+1;}
  previous=physical;
  let guest=canvas-pte(domain,0x70001000+page*4096);
  let server=canvas-pte(0,view+page*4096);
  if (guest&PAGE-ADDRESS-MASK)!=physical || (guest&7)!=7 || (guest&PAGE-NX)==0 || (server&PAGE-ADDRESS-MASK)!=physical || (server&7)!=3 || (server&PAGE-NX)==0{panic("canvas page permissions or backing");}
  if load32(view+page*4096)!=round*4096+page || load32(physical)!=round*4096+page || load32(view+page*4096+4092)!=0x11000000+round*4096+page{panic("canvas noncontiguous server view");}
  page=page+1;
 }
}
fn canvas-malformed(port:Int,image:Int)->void{
