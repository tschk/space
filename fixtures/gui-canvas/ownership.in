 if heap-next!=before-heap || canvas-free-count()!=before-free || cap-count!=before-caps || domain-count!=before-domains || runtime-instance-live!=0 || runtime-instance-last-handle!=0{panic("canvas profile refusal allocated resources");}
}
fn canvas-run(port:Int)->void{
