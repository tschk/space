 canvas-entry-if=invoke1(load64(0x4198),0)&512;
 let held=alloc(2048*8);let page=0;
 while page<2048{let frame=frame-alloc();store64(held+page*8,frame);store64(frame,0x33110000+page);page=page+1;}
 page=0;while page<2048{frame-free(load64(held+page*8));page=page+2;}
 let cycle=0;
 while cycle<70{
  if sci-load-retained-component(port,image,"canvas-left",20,0)!=42{panic("canvas left initial");}
  let left=runtime-instance-last-handle;let left-entry=sci-sync-entry;let left-info=sci-sync-info;
  let left-state=load64(runtime-instance-record(left,1));let left-parent=load64(load64(left-state+112)+4080);
  canvas-check(left,1);
  if cycle==0 && canvas-fragmented==0{panic("canvas fixture failed to fragment backing");}
  if sci-load-retained-component(port,image,"canvas-right",20,0)!=42{panic("canvas right initial");}
  let right=runtime-instance-last-handle;let right-entry=sci-sync-entry;let right-info=sci-sync-info;
  let right-state=load64(runtime-instance-record(right,1));let right-parent=load64(load64(right-state+112)+4080);
  canvas-check(right,1);canvas-check(left,1);
  if runtime-instance-resume(left,left-entry,left-info)!=42{panic("canvas left resume");}canvas-check(left,2);canvas-check(right,1);
  if runtime-instance-resume(right,right-entry,right-info)!=42{panic("canvas right resume");}canvas-check(right,2);
  if cycle%2==1{let handle=left;left=right;right=handle;let entry=left-entry;left-entry=right-entry;right-entry=entry;let info=left-info;left-info=right-info;right-info=info;}
  if runtime-instance-retire(left)!=0 || runtime-instance-release(left)!=0{panic("canvas first release");}
  if runtime-instance-resume(left,left-entry,left-info)!=-1{panic("canvas stale resume");}
  if runtime-instance-resume(right,right-entry,right-info)!=42{panic("canvas survivor resume");}canvas-check(right,3);
  if runtime-instance-retire(right)!=0 || runtime-instance-release(right)!=0 || load64(left-parent)!=0 || load64(right-parent)!=0{panic("canvas server view not unmapped");}
  let frames=canvas-free-count();
  if canvas-free==-1{canvas-free=frames;canvas-heap=heap-next;canvas-caps=cap-count;canvas-domains=domain-count;canvas-objects=obj-arena-next;canvas-exports=dyn-count;}
  else{if frames!=canvas-free || heap-next!=canvas-heap || cap-count!=canvas-caps || domain-count!=canvas-domains || obj-arena-next!=canvas-objects || dyn-count!=canvas-exports{panic("canvas resources drift");}}
  if runtime-instance-live!=0 || domain-current!=0 || cr3-read()!=load64(domain-table){panic("canvas leaked live state");}
  serial-write-cstr(port,"canvas: cycle ");serial-write-dec-wide(port,cycle+1);serial-nl(port);cycle=cycle+1;
 }
 page=1;while page<2048{let frame=load64(held+page*8);if load64(frame)!=0x33110000+page{panic("canvas overwrote held frame");}frame-free(frame);page=page+2;}
 serial-write-cstr(port,"canvas: noncontiguous pages exact server mappings lifetime malformed refusal and stable resources PASS");serial-nl(port);
}


