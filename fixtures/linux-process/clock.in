  store64(frame+40,0);store64(frame+48,0);store64(frame+56,value);
  linux-process-store64(value,0);linux-process-store64(value+8,0);
  linux-check(0,linux-check-call(frame,23,0,0,0));linux-check(0,linux-check-call(frame,270,0,0,0));
  linux-check(-22,linux-check-call(frame,23,-1,0,0));linux-check(-95,linux-check-call(frame,23,1,0,0));
  linux-process-store64(value,-1);linux-check(-22,linux-check-call(frame,23,0,0,0));
  linux-process-store64(value,0);linux-process-store64(value+8,1000000);linux-check(-22,linux-check-call(frame,23,0,0,0));
  linux-process-store64(value+8,1000000000);linux-check(-22,linux-check-call(frame,270,0,0,0));
  linux-process-store64(value,61);linux-process-store64(value+8,0);linux-check(-95,linux-check-call(frame,23,0,0,0));
  store64(frame+56,0);linux-check(-95,linux-check-call(frame,23,0,0,0));
  store64(frame+56,0x20001000);linux-check(-14,linux-check-call(frame,23,0,0,0));store64(frame+56,value);
  linux-process-store64(value,0);linux-process-store64(value+8,0);store64(frame+48,0x20002000);linux-check(-14,linux-check-call(frame,270,0,0,0));
  linux-process-store64(zone,zone+16);linux-process-store64(zone+8,8);store64(frame+48,zone);linux-check(-95,linux-check-call(frame,270,0,0,0));store64(frame+48,0);
  if counter-frequency-authorized(authority)>0{
   let entry=load64(0x4198);let flags=invoke1(entry,0);let frequency=counter-frequency-authorized(authority);let now=counter-read-authorized(authority);let waits=execution-clock-interrupt-waits;
   linux-check(1,execution-clock-await-interrupt(authority,frequency,now+frequency/20));
   linux-check(waits+1,execution-clock-interrupt-waits);linux-check(flags&512,invoke1(entry,0)&512);
   linux-check(0,domain-current);linux-check(0,user-context-active);linux-check(0,user-budget-active);
  }
  let slot=cap-table-base+authority*16;let mask=load64(slot+8);store64(slot+8,mask&(-1^cap-timer()));
  linux-process-store64(value,0x123456789abcdef);
  linux-check(-13,linux-check-call(frame,96,value,zone,0));linux-check(-13,linux-check-call(frame,201,value,0,0));
  linux-check(-13,linux-check-call(frame,228,0,value,0));linux-check(-13,linux-check-call(frame,229,0,value,0));
  store64(slot+8,mask);
 }
 linux-fixture-copy-in(value,fixture+1024,8);linux-check(0x123456789abcdef,load64(fixture+1024));
 if dyn-resolve-idx("execution-clock-await-interrupt")!=-1 || dyn-resolve-idx("linux-process-time")!=-1 || dyn-resolve-idx("linux-process-gettimeofday")!=-1 || dyn-resolve-idx("linux-process-clock-gettime")!=-1 || dyn-resolve-idx("linux-process-clock-getres")!=-1{panic("Linux clock raw native export");}
