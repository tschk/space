  linux-check(-22,linux-check-call(frame,229,-1,0,0));
  linux-fixture-copy-in(value,fixture+1024,8);linux-check(0x123456789abcdef,load64(fixture+1024));
  linux-check(0,linux-check-call(frame,229,0,value,0));linux-fixture-copy-in(value,fixture+1024,16);
  linux-check(1,load64(fixture+1024));linux-check(0,load64(fixture+1032));
  linux-check(0,linux-check-call(frame,229,0,0,0));
  linux-check(0,linux-check-call(frame,228,0x123400000000,value,0));linux-fixture-copy-in(value,fixture+1024,16);
  if load64(fixture+1024)<before || load64(fixture+1032)!=0{panic("Linux realtime/int width");}
  if counter-frequency-authorized(authority)>0{
   linux-check(0,linux-check-call(frame,229,1,value,0));linux-fixture-copy-in(value,fixture+1024,16);
   linux-check(0,load64(fixture+1024));if load64(fixture+1032)<1 || load64(fixture+1032)>1000000000{panic("Linux counter actual resolution");}
   linux-check(0,linux-check-call(frame,228,0x123400000001,value,0));linux-fixture-copy-in(value,fixture+1024,16);
   let first=load64(fixture+1024);let nanos=load64(fixture+1032);if first<0 || nanos<0 || nanos>=1000000000{panic("Linux monotonic split/range");}
   linux-check(0,linux-check-call(frame,228,1,value,0));linux-fixture-copy-in(value,fixture+1024,16);
   if load64(fixture+1024)<first || (load64(fixture+1024)==first && load64(fixture+1032)<nanos){panic("Linux monotonic reversed");}
  }else{linux-check(-95,linux-check-call(frame,228,1,value,0));linux-check(-95,linux-check-call(frame,229,1,value,0));}
  // Zero-descriptor Linux wait structure and refusal controls. Real timed
