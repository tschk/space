fn linux-check-clock(frame:Int,fixture:Int)->void{
 let value=0x20000400;let zone=value+32;let authority=linux-process-authority;
 linux-process-store64(value,0x123456789abcdef);linux-process-store64(value+8,0x23456789abcdef0);
 if cap-check(authority,cap-timer())==0{
  linux-check(-13,linux-check-call(frame,96,value,zone,0));
  linux-check(-13,linux-check-call(frame,201,value,0,0));
  linux-check(-13,linux-check-call(frame,228,0,value,0));
  linux-check(-13,linux-check-call(frame,229,0,value,0));
 }else{
  let before=time-component-wallclock();linux-check(0,linux-check-call(frame,96,value,zone,0));let after=time-component-wallclock();
  linux-fixture-copy-in(value,fixture+1024,40);
  if before<0 || after<before || load64(fixture+1024)<before || load64(fixture+1024)>after{panic("Linux timeval actual RTC interval");}
  linux-check(0,load64(fixture+1032));linux-check(0,load64(fixture+1056));
  linux-process-store64(value,0x123456789abcdef);
  linux-check(-14,linux-check-call(frame,96,value,0x20001000,0));
  linux-fixture-copy-in(value,fixture+1024,8);linux-check(0x123456789abcdef,load64(fixture+1024));
  linux-check(0,linux-check-call(frame,96,0,zone,0));
