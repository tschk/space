var lvm-refused-entries: Int = 0
fn lvm-refused-hook(frame:Int)->Int {lvm-refused-entries=lvm-refused-entries+1;return 0;}
var lvm-authority: Int = -1
var lvm-foreign: Int = -1
var lvm-witness-buffer: Int = 0
var lvm-witness-reader: Int = 0
var lvm-witness-writer: Int = 0
var lvm-heap: Int = 0
var lvm-free: Int = 0
var lvm-domains: Int = 0
var lvm-owned: Int = 0
var lvm-native: Int = 0
var lvm-caps: Int = 0
var lvm-runs: Int = 0

fn lvm-check(expected:Int,actual:Int)->void {
 if expected!=actual{
  serial-write-cstr(com1(),"linux-vm: expected ");serial-write-dec-wide(com1(),expected);
  serial-write-cstr(com1()," actual ");serial-write-dec-wide(com1(),actual);serial-nl(com1());
  panic("Linux owned VM migration");
 }
}
fn lvm-native-count()->Int {
 let i=3;let count=0;while i<VFS-MAX-FDS{if vfs-fd-valid(i)!=0{count=count+1;}i=i+1;}return count;
}
fn lvm-free-count()->Int {
 let frame=free-list;let count=0;
 while frame!=0 && count<131072{count=count+1;frame=load64(frame);}
 if frame!=0{panic("Linux VM free-list cycle");}return count;
}
fn lvm-init()->void {
 lvm-authority=cap-mint(root-realm,cap-memory()|cap-serial()|cap-storage());
 lvm-foreign=cap-mint(root-realm,cap-memory());
 lvm-witness-buffer=alloc(16);lvm-check(0,vfs-stream-pair(1,1,0,lvm-witness-buffer));
 lvm-witness-reader=load32(lvm-witness-buffer);lvm-witness-writer=load32(lvm-witness-buffer+4);
 lvm-check(8,vfs-stream-write(lvm-witness-writer,"VM-OWNER",8));
 linux-process-budget-ticks=100;linux-process-trace=1;
}
fn lvm-baseline()->void {
 lvm-heap=heap-next;lvm-free=lvm-free-count();lvm-domains=domain-count;
 lvm-owned=domain-user-owned;lvm-native=lvm-native-count();lvm-caps=cap-count;
}
fn lvm-case(image:Int,size:Int,measured:Int)->void {
 let fs=rdmsr(0xC0000100);let gs=rdmsr(0xC0000101);let cap=current-cap;
 lvm-check(42,linux-process-run(image,size,"/vm-migration","","",lvm-authority));
 lvm-check(fs,rdmsr(0xC0000100));lvm-check(gs,rdmsr(0xC0000101));lvm-check(cap,current-cap);
 lvm-check(0,domain-current);lvm-check(load64(domain-table),cr3-read());
 lvm-check(0,user-context-active);lvm-check(0,user-budget-active);lvm-check(0,domain-user-syscall-hook);
 lvm-check(0,linux-process-active);lvm-check(0,linux-process-cleanup-failed);
 lvm-check(0,linux-process-pages);
 if measured!=0{
  lvm-check(lvm-heap,heap-next);lvm-check(lvm-free,lvm-free-count());
  lvm-check(lvm-domains,domain-count);lvm-check(lvm-owned,domain-user-owned);
  lvm-check(lvm-native,lvm-native-count());lvm-check(lvm-caps,cap-count);
 }
 lvm-runs=lvm-runs+1;
 serial-write-cstr(com1(),"linux-vm: migration activation ");serial-write-dec-wide(com1(),lvm-runs);serial-write-cstr(com1()," PASS");serial-nl(com1());
}
fn lvm-finish()->void {
 lvm-check(8,vfs-stream-read(lvm-witness-reader,lvm-witness-buffer,8));
 let i=0;while i<8{lvm-check(load8("VM-OWNER"+i),load8(lvm-witness-buffer+i));i=i+1;}
 lvm-check(0,vfs-close(lvm-witness-reader));lvm-check(0,vfs-close(lvm-witness-writer));
 serial-write-cstr(com1(),"linux-vm: owned resource cleanup PASS");serial-nl(com1());
}

