package space.spdp.proof

import "../../protocol/display.in"

interface PixelMemory { fn map() -> void }
interface PixelDisplay { fn present() -> void }
component PixelProof {
  target "x86_64-unknown-none"
  capability memory: PixelMemory(map)
  capability display: PixelDisplay(present)
}

// Real SCI import: loader binds this shared frame publisher to the kernel.
interrupt fn chan-page-send-frame(page: Int, object: Int, opcode: Int, arg0: Int, arg1: Int) -> Int {}

fn client-entry(cap-info: Int) -> Int {
  if load64(cap-info) != 20 { return 7 }
  let page = load64(cap-info + 32)
  let pixels = load64(cap-info + 72)
  let size = load64(cap-info + 80)
  let pool = load64(cap-info + 88)
  if pixels == 0 || size != 4096 || pool != 0 { return 6 }
  let y = 0
  while y < 16 {
    let x = 0
    while x < 64 {
      let color = 0xFF00FF00
      if x < 20 { color = 0xFFFF0000 }
      store32(pixels + (y * 64 + x) * 4, color)
      x = x + 1
    }
    y = y + 1
  }
  // Forge the writable descriptor after use: kernel adoption must ignore it.
  store64(cap-info + 72, 0xDEAD0000)
  store64(cap-info + 80, 9223372036854775807)
  store64(cap-info + 88, 7)
  store64(cap-info + 40, 63)
  let args = load64(cap-info + 64)
  let x = 40
  if args != 0 && load8(args) == 114 { x = 400 }
  // Surface0/pool0 belong to this reset proof only; no cross-client identity claim.
  if chan-page-send-frame(page, SPDP-OBJ-COMPOSITOR, SPDP-COMPOSITOR-CREATE-SURFACE, 0, 0) != 1 { return 1 }
  if chan-page-send-frame(page, SPDP-OBJ-SURFACE, SPDP-SURFACE-ATTACH, 0, 0) != 1 { return 3 }
  if chan-page-send-frame(page, SPDP-OBJ-SURFACE, SPDP-SURFACE-DAMAGE, 0, (x << 48) | (80 << 32) | (64 << 16) | 16) != 1 { return 4 }
  if chan-page-send-frame(page, SPDP-OBJ-SURFACE, SPDP-SURFACE-COMMIT, 0, 0) != 1 { return 5 }
  return 42
}
