 if kind==1 && load64(context+720)==43{expected=0x4348494c44465831;}
 if load64(context+560)!=expected{panic("context guest FX capture");}
 if load64(context+688)!=kind || domain-current!=0 || cr3-read()!=load64(domain-table) || current-cap!=cap || inb(0x21)!=pic || user-context-active!=0 || user-budget-active!=0 || domain-user-syscall-hook!=context-hook{panic("context supervisor ownership restore");}
 if (invoke1(load64(0x4198),0)&512)!=(flags&512) || rdmsr(0xC0000100)!=fs || rdmsr(0xC0000101)!=gs{panic("context supervisor IRQ TLS restore");}
 let ignored=invoke1(0x280900,fxafter);let i=0;
 while i<512{if load8(fxbefore+i)!=load8(fxafter+i){serial-write-dec-wide(port,i);panic("context kernel FX restore");}i=i+1;}
