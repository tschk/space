// Invoked immediately after domain-init, before any enter_user path can warm
// the relocated kernel FXSAVE area. Reserved MXCSR cannot reach FXRSTOR.
fn user-context-cold-check(port:Int)->void{
 let mask=load32(0x421c);
 if (mask&-65536)!=0 || (mask&0xffbf)!=0xffbf{panic("context cold MXCSR mask uninitialized");}
 let domain=domain-create-user();let stack=frame-alloc();let context=alloc(768);
 domain-map-user-code(domain,0x42000000,0x280000);domain-map-user-data(domain,0x43000000,stack);
 if user-context-init(context,768,domain,0x42000000,0,0x43000ff0)!=0{panic("context cold init");}
 store64(context+184,0x80000000);
 if user-context-valid(context)!=0 || user-context-resume(context,2)!=-1{panic("context cold reserved MXCSR admitted");}
 if domain-destroy-user(domain)!=0{panic("context cold teardown");}frame-free(stack);
 serial-write-cstr(port,"context: cold initialized CPU mask reserved MXCSR refusal PASS");serial-nl(port);
}
fn context-hook(frame:Int)->Int{
 let number=load64(frame+112);
 if number==800{store64(frame+112,84);return 2;}
 if number==801{store64(frame+112,load64(frame+72));return 0;}
 if number==802{store64(frame+112,ticks);return 1;}
 panic("context unexpected syscall");return 0;
}
fn context-scope-check(port:Int,kind:Int,context:Int,cap:Int,pic:Int,flags:Int,fs:Int,gs:Int,fxbefore:Int,fxafter:Int)->void{
