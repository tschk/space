fn us-run(binding:Int,authority:Int,kind:Int,status:Int,context:Int,budget:Int)->void {
 let cap=current-cap;let pic=inb(0x21);let flags=invoke1(load64(0x4198),0);
 let fs=rdmsr(0xC0000100);let gs=rdmsr(0xC0000101);let before=ticks;
 us-check(kind,user-space-resume(binding,authority,budget));us-executions=us-executions+1;
 us-check(kind,load64(context+688));us-check(status,load64(context+720));
