  serial-write-cstr(com1()," actual ");serial-write-dec-wide(com1(),actual);serial-nl(com1());
  panic("native UserAddressSpace contract");
 }
}
fn us-positive(value:Int)->Int {if value<=0{us-check(1,value);}return value;}
fn us-context(index:Int)->Int{return load64(us-contexts+index*8);}
fn us-free-count()->Int {
