 store64(us-source,100);us-check(0,user-space-write(vm,authority,0x44000000,us-source,8));
 us-check(0,load64(user-space-frame(vm,authority,0x43000000)+128));
 return vm;
}
fn us-prepare(vm:Int,authority:Int,index:Int,mode:Int)->Int {
 let context=us-context(index);
 us-check(0,user-context-init(context,768,user-space-domain(vm,authority),0x42000000,mode,0x43000FF0));
 return us-positive(user-space-attach(vm,authority,context));
}
