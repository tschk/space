 us-revocable=cap-mint(root-realm,cap-memory());
 us-contexts=alloc(33*8);us-bindings=alloc(32*8);us-handles=alloc(USER-SPACE-MAX*8);us-source=alloc(64);
 let i=0;while i<33{store64(us-contexts+i*8,(alloc(831)+63)&-64);i=i+1;}
 us-code=alloc(4096);cpu-mem-copy64(us-code,0x10000000,512);

}
fn us-new(authority:Int)->Int {return us-new-limit(authority,3);}
fn us-new-limit(authority:Int,limit:Int)->Int {
 let vm=us-positive(user-space-create(authority,limit));
 us-check(0,user-space-map-zero(vm,authority,0x42000000,USER-SPACE-EXECUTE));
 us-check(0,user-space-map-zero(vm,authority,0x43000000,USER-SPACE-WRITE));
