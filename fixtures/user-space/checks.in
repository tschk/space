}
fn us-private-import(image-size:Int)->void {
 if dyn-resolve-idx("user-space-resume")!=-1 || dyn-resolve-idx("domain-user-object-revoke")!=-1 || dyn-resolve-idx("serial-write-cstr")<0{panic("user-space private registry boundary");}
