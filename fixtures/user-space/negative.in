fn us-cold()->void {
 us-check(0,user-space-table);us-check(0,user-space-bindings);
 let states=alloc(MAX-DOMAINS*8);let frames=alloc(64*8);let i=0;
 while i<64{store64(frames+i*8,frame-alloc());i=i+1;}
 i=0;while i<64{frame-free(load64(frames+i*8));i=i+1;}
 let flags=invoke1(load64(0x4198),0);cli();
 let end=heap-end;let heap=heap-next;let free=free-list;let domains=domain-count;
 let owned=domain-user-owned;let generation=user-space-generation;
 // No frames after the exact bump-cache reservation: refuse before allocations.
 free-list=0;heap-end=((heap+USER-SPACE-CACHE-BYTES+4095)&-4096)+63*4096;
 us-check(-3,user-space-create(us-authority,1));us-cold-unchanged(heap,0,domains,owned,generation);
 // Actual reusable frames cannot substitute for one missing metadata bump byte.
 free-list=free;heap-end=heap+USER-SPACE-CACHE-BYTES - 1;
 us-check(-3,user-space-create(us-authority,1));us-cold-unchanged(heap,free,domains,owned,generation);
 heap-end=end;user-space-generation=0x7fffffffffffff;
 us-check(-3,user-space-create(us-authority,1));us-cold-unchanged(heap,free,domains,owned,0x7fffffffffffff);
 user-space-generation=generation;
 i=0;while i<MAX-DOMAINS{store64(states+i*8,load64(domain-table+i*24+8));if i>0{store64(domain-table+i*24+8,DOMAIN-ACTIVE);}i=i+1;}
 domain-count=MAX-DOMAINS;
 us-check(-3,user-space-create(us-authority,1));us-cold-unchanged(heap,free,MAX-DOMAINS,owned,generation);
 i=0;while i<MAX-DOMAINS{store64(domain-table+i*24+8,load64(states+i*8));i=i+1;}domain-count=domains;
 // Exact cache bump bytes plus actual reusable frames admits a genuine domain.
 heap-end=heap+USER-SPACE-CACHE-BYTES;
 let vm=us-positive(user-space-create(us-authority,1));
 us-check(heap+USER-SPACE-CACHE-BYTES,heap-next);us-check(1,user-space-refs(vm,us-authority));
 us-check(0,user-space-release(vm,us-authority));
 heap-end=end;if (flags&512)!=0{sti();}
 serial-write-cstr(com1(),"user-space: cold frame metadata generation domain admission bounds PASS");serial-nl(com1());
}
