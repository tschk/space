   us-check(14,load64(us-context(6)+696));
   let error=4;if mode==3{error=7;}else if mode==4{error=21;}
   us-check(error,load64(us-context(6)+704));
  }else if mode==6{us-run(binding,us-authority,USER-CONTEXT-EXIT,46,us-context(6),100);}
  else{us-run(binding,us-authority,USER-CONTEXT-DEADLINE,124,us-context(6),2);}
