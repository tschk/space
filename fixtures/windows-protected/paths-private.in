package space.fixture
component PrivatePathImport {
 target "x86_64-unknown-none"
 deterministic true
 checkpoint none
 capability serial: DebugConsole(write)
 export entry: PrivateEntry
}
interface DebugConsole { fn write(msg:String)->void }
interface PrivateEntry { fn private-entry(info:Int)->Int }
interrupt fn fs-path-normalize-into(cwd:Int,cwdbytes:Int,path:Int,pathbytes:Int,output:Int,capacity:Int,scratch:Int,scratchbytes:Int)->Int{}
interrupt fn serial-write-cstr(port:Int,text:Int)->void{}
fn private-entry(info:Int)->Int{
 serial-write-cstr(0x3f8,"INVALID private native path entry");
 return fs-path-normalize-into(0,0,0,0,0,0,0,0);
}
