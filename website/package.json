{
  "name": "space-v86",
  "version": "0.0.266",
  "private": true,
  "type": "module",
  "scripts": {
    "build:kernel": "sh scripts/build-space-v86-32.sh",
    "dev": "sh scripts/build-space-v86-32.sh && bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "build": "sh scripts/build-space-v86-32.sh && bun run typecheck && bun run src/build.ts",
    "preview": "bun run src/server.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "deploy": "bun run build && wrangler pages deploy dist --project-name space"
  },
  "dependencies": {
    "@tschk/moonshine": "^0.4.0",
    "@tschk/moonshine-adapter-conformance": "^0.4.0",
    "@tschk/moonshine-compiler": "^0.4.0",
    "@tschk/moonshine-deploy-bun": "^0.4.0",
    "@tschk/moonshine-framework": "^0.4.0",
    "@tschk/moonshine-react": "^0.4.0",
    "@tschk/moonshine-router": "^0.4.0",
    "@tschk/moonshine-server": "^0.4.0",
    "@tschk/moonshine-shaders": "^0.4.0",
    "ghostty-web": "^0.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "v86": "0.5.445"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2",
    "wrangler": "4.127.0"
  }
}
